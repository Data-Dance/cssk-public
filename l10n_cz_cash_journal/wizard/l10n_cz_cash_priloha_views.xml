<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_cz_cash_priloha_form" model="ir.ui.view">
        <field name="name">l10n.cz.cash.priloha.form</field>
        <field name="model">l10n.cz.cash.priloha</field>
        <field name="arch" type="xml">
            <form string="Příloha č. 1 — údaje z peněžního deníku">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="needs_review" invisible="not needs_review"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not needs_review">
                    Deník obsahuje řádky označené ke kontrole. Dokud nejsou
                    vyřešeny, údaje nejsou úplné.
                </div>
                <field name="line_ids" invisible="not line_ids">
                    <list create="false" delete="false" edit="false">
                        <field name="section"/>
                        <field name="code"/>
                        <field name="label"/>
                        <field name="value" sum="Celkem"/>
                        <field name="opening_value"/>
                        <field name="closing_value"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compute" type="object" string="Vypočítat"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_print_zapis" type="object"
                            string="Zápis podle § 7b odst. 4" class="btn-secondary"/>
                    <button string="Zavřít" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_cz_cash_priloha" model="ir.actions.act_window">
        <field name="name">Příloha č. 1 — údaje z peněžního deníku</field>
        <field name="res_model">l10n.cz.cash.priloha</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
