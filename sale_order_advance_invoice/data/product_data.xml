<?xml version="1.0" encoding="utf-8"?>
<!--
    DO NOT add this file to __manifest__.py's data list.

    Loading a bare product.template here fails on any database with
    website_sale installed: that module adds required NOT NULL fields to
    product.template (base_unit_count, and publish_date) whose defaults are
    not applied on a data-load create, raising a NotNullViolation / ParseError.
    Since this module does not (and should not) depend on website_sale, the XML
    cannot conditionally populate those fields.

    The product is instead created lazily and website_sale-aware by
    sale.order._get_advance_product(), which registers this same external id
    (sale_order_advance_invoice.product_advance_invoice) at runtime. This file
    is kept only as a reference for that external id / expected field values.
-->
<odoo noupdate="1">

    <record id="product_advance_invoice" model="product.template">
        <field name="name">Advance</field>
        <field name="type">service</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
    </record>

</odoo>
