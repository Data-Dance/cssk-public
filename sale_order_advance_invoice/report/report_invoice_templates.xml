<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document" inherit_id="account.report_invoice_document">

        <!-- Replace the "Invoice" / "Draft Invoice" / "Cancelled Invoice" titles
             with "Tax Document" variants for advance-invoice tax documents.
             In 18.0 the titles are inline spans inside layout_document_title. -->
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-if=&quot;o.move_type == 'out_invoice' and o.state == 'posted'&quot;]" position="replace">
            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted' and o.is_advance_invoice_tax_document">Tax Document</span>
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-elif=&quot;o.move_type == 'out_invoice' and o.state == 'draft'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft' and o.is_advance_invoice_tax_document">Draft Tax Document</span>
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-elif=&quot;o.move_type == 'out_invoice' and o.state == 'cancel'&quot;]" position="replace">
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel' and o.is_advance_invoice_tax_document">Cancelled Tax Document</span>
            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
        </xpath>

        <!-- Rename "Invoice Date" label to "Issue Date" for tax documents. -->
        <xpath expr="//div[@name='invoice_date']/t[@t-if=&quot;o.move_type == 'out_invoice'&quot;]" position="replace">
            <t t-if="o.move_type == 'out_invoice' and o.is_advance_invoice_tax_document"><strong>Issue Date</strong></t>
            <t t-elif="o.move_type == 'out_invoice'"><strong>Invoice Date</strong></t>
        </xpath>

        <!-- Hide Due Date for tax documents (the amount is already paid). -->
        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute name="t-if">o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted' and not o.is_advance_invoice_tax_document</attribute>
        </xpath>

        <!-- Hide payment term note for tax documents. -->
        <xpath expr="//span[@id='payment_terms_note_id']" position="attributes">
            <attribute name="t-if">o.invoice_payment_term_id.note and not o.is_advance_invoice_tax_document</attribute>
        </xpath>

        <!-- Hide payment term schedule/details table for tax documents. -->
        <xpath expr="//t[@t-if='o.invoice_payment_term_id.display_on_invoice and payment_term_details']" position="attributes">
            <attribute name="t-if">o.invoice_payment_term_id.display_on_invoice and payment_term_details and not o.is_advance_invoice_tax_document</attribute>
        </xpath>

        <!-- Hide payment communication (reference + bank account) for tax documents. -->
        <xpath expr="//p[@name='payment_communication']/.." position="attributes">
            <attribute name="t-if">o.move_type in ('out_invoice', 'in_refund') and o.payment_reference and not o.is_advance_invoice_tax_document</attribute>
        </xpath>

        <!-- Hide QR code for tax documents. -->
        <xpath expr="//t[@t-set='show_qr']" position="attributes">
            <attribute name="t-value">o.display_qr_code and o.amount_residual > 0 and not o.is_advance_invoice_tax_document</attribute>
        </xpath>

    </template>

</odoo>
