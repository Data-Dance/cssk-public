<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_manual_transfer_link_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.manual.transfer.link.wizard.form</field>
        <field name="model">sale.order.manual.transfer.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Manual Transfer">
                <group>
                    <field name="sale_order_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="payment_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button
                        name="action_link_manual_transfer"
                        type="object"
                        class="btn-primary"
                        string="Link"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_manual_transfer_link_wizard" model="ir.actions.act_window">
        <field name="name">Link Manual Transfer</field>
        <field name="res_model">sale.order.manual.transfer.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>