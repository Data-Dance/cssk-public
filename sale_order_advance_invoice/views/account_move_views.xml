<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_link_advance_invoices" model="ir.ui.view">
        <field name="name">account.move.form.link.advance.invoices</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_link_advance_invoices_wizard"
                    type="object"
                    string="Link Advance Invoices"
                    class="btn-secondary"
                    invisible="move_type != 'out_invoice' or state != 'draft'"/>
            </xpath>
            <xpath expr="//list[@name='journal_items']//field[@name='tax_ids']" position="after">
                <field name="amount_tax" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>