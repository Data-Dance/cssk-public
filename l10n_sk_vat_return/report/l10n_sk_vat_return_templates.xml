                    <fax>
                        <predcislie/>
                        <cislo/>
                    </fax>
                </adresa>
                <opravnenaOsoba>
                    <menoPriezvisko/>
                    <tel>
                        <predcislie/>
                        <cislo/>
                    </tel>
                </opravnenaOsoba>
                <datumVyhlasenia/>
            </hlavicka>
            <telo>
                <r01 t-out="values_fmt.get('r01', '')"/>
