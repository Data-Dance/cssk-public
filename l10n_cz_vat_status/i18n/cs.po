#. module: l10n_cz_vat_status
#. odoo-python
#: code:addons/l10n_cz_vat_status/models/account_move.py:0
msgid ""
"On %(date)s the company is “%(status)s”, and %(n)d line(s) carry taxes that "
"status does not allow. Use “Apply VAT status taxes” to replace them."
msgstr ""
"Ke dni %(date)s je společnost „%(status)s“ a %(n)d řádek (řádků) nese daně, "
"které tento status nepřipouští. Nahraďte je tlačítkem „Použít daně podle "
"statusu DPH“."

#. module: l10n_cz_vat_status
#. odoo-python
#: code:addons/l10n_cz_vat_status/models/account_move.py:0
msgid "Only a draft document's taxes can be changed."
msgstr "Daně lze změnit jen u dokladu v konceptu."

