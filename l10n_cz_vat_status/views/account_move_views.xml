<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_cz_vat_status" model="ir.ui.view">
        <field name="name">account.move.form.cz.vat.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='alerts']/.." position="after">
                <div class="d-flex alert alert-warning w-100 align-items-center gap-1"
                     role="alert"
                     invisible="not l10n_cz_vat_status_warning or state != 'draft'">
                    <field name="l10n_cz_vat_status_warning" nolabel="1"/>
                    <button name="action_l10n_cz_vat_status_apply_taxes"
                            type="object" string="Apply VAT status taxes"
                            class="btn btn-link ms-auto"/>
                </div>
                <div class="alert alert-info w-100" role="status"
                     invisible="not l10n_cz_vat_status_declared_date_note">
                    <field name="l10n_cz_vat_status_declared_date_note" nolabel="1"/>
                </div>
            </xpath>
            <field name="taxable_supply_date" position="after">
                <field name="l10n_cz_vat_status"
                       invisible="not l10n_cz_vat_status or l10n_cz_vat_status == 'payer'"
                       readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
