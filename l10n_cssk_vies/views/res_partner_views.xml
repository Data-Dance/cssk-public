<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form_vies" model="ir.ui.view">
        <field name="name">res.partner.form.vies.proof</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_vat.view_partner_base_vat_form" />
        <field name="arch" type="xml">
            <field name="vies_valid" position="after">
                <button
                    name="action_vies_check_direct"
                    type="object"
                    string="Check VIES (direct)"
                    class="btn-link oe_inline"
                    icon="fa-refresh"
                    invisible="not vat"
                />
                <field
                    name="vies_consultation_number"
                    class="oe_inline"
                    invisible="not vies_consultation_number"
                />
                <field
                    name="vies_check_date"
                    class="oe_inline"
                    invisible="not vies_check_date"
                />
                <field
                    name="vies_request_date"
                    class="oe_inline"
                    invisible="not vies_request_date"
                />
                <field
                    name="vies_trader_name"
                    class="oe_inline"
                    invisible="not vies_trader_name"
                />
                <field
                    name="vies_address"
                    class="oe_inline"
                    invisible="not vies_address"
                />
                <field
                    name="vies_name_match"
                    class="oe_inline"
                    invisible="not vies_name_match"
                />
            </field>
        </field>
    </record>

</odoo>
