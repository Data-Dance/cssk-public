<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_vies" model="ir.ui.view">
        <field name="name">res.config.settings.form.vies.direct</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_vat.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="vies_service_setting" position="inside">
                <div class="content-group mt16">
                    <field name="vies_use_direct" class="oe_inline" />
                    <label for="vies_use_direct" string="Use direct EU VIES (no IAP)" />
                </div>
            </setting>
        </field>
    </record>

</odoo>
