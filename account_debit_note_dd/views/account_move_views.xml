<?xml version="1.0"?>
<odoo>
    <record id="view_move_form_debit_note_dd" model="ir.ui.view">
        <field name="name">account.move.form.debit_note_dd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="account.action_move_out_refund_type_non_legacy" model="ir.actions.act_window">
        <field name="domain">['|', ('move_type', '=', 'out_refund'), ('debit_origin_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_refund', 'display_account_trust': True}</field>
    </record>
</odoo>