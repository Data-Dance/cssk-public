<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the KV ↔ priznanie reconciliation button (umbrella: both the KV and
         the VAT-return modules are installed together here). -->
    <record id="cssk_control_statement_view_form_reconcile" model="ir.ui.view">
        <field name="name">cssk.control.statement.form.reconcile</field>
        <field name="model">cssk.control.statement</field>
        <field name="inherit_id"
               ref="l10n_cssk_kv_kh_base.cssk_control_statement_view_form"/>
        <field name="arch" type="xml">
            <button name="action_export_xml" position="after">
                <button name="action_reconcile_dph" type="object"
                        string="Porovnať s priznaním"
                        invisible="state == 'draft'"/>
            </button>
        </field>
    </record>

</odoo>
