<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_sk_dd" model="ir.ui.view">
        <field name="name">res.config.settings.form.sk.datadance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_cssk_core.res_config_settings_view_form_cssk" />
        <field name="arch" type="xml">
            <!-- Inject the SK-suite toggles INTO the shared CZ/SK localization
                 block (defined by l10n_cssk_core), rather than creating a second
                 "Slovak localization" block on the Accounting settings page. -->
            <xpath expr="//block[@id='l10n_cssk_settings']" position="inside">
                <!-- Community-only: Enterprise ships automatic exchange rates
                     and deferred revenue/expense, so hide these on EE. -->
                <setting id="sk_dd_fx" string="Exchange-rate sync (NBS/ECB)"
                         invisible="l10n_cssk_is_enterprise"
                         help="Daily NBS/ECB + VÚB/Tatra banka FX rates.">
                    <field name="module_currency_rate_update_sk" />
                </setting>
                <setting id="sk_dd_cutoff" string="Časové rozlíšenie (deferrals)"
                         invisible="l10n_cssk_is_enterprise"
                         help="Prepaid/deferred expenses &amp; revenues (381–385).">
                    <field name="module_l10n_sk_account_cutoff" />
                </setting>
                <setting id="sk_dd_reliability" string="Supplier reliability check"
                         help="Verify the supplier's tax reliability + registered bank account before paying.">
                    <field name="module_l10n_sk_payment_reliability" />
                </setting>
                <setting id="sk_dd_assets" string="Dual depreciation"
                         help="Separate tax vs accounting depreciation.">
                    <field name="module_l10n_sk_account_asset_tax" />
                </setting>
                <setting id="sk_dd_methoda" string="Method A inventory"
                         help="Perpetual inventory (required for audited companies).">
                    <field name="module_l10n_sk_stock_account_method_a" />
                </setting>
                <setting id="sk_dd_advance" string="Advance invoices"
                         help="Zálohové faktúry + tax documents.">
                    <field name="module_l10n_sk_sale_order_advance_invoice" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
