<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cssk_receipt_list" model="ir.ui.view">
        <field name="name">cssk.receipt.list</field>
        <field name="model">cssk.receipt</field>
        <field name="arch" type="xml">
            <list string="Captured Receipts"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'review'"
                  decoration-muted="state == 'done'">
                <field name="issue_date"/>
                <field name="partner_id"/>
                <field name="seller_name" optional="hide"/>
                <field name="receipt_uid" optional="hide"/>
                <field name="provider_id" optional="show"/>
                <field name="amount_untaxed" sum="Base"/>
                <field name="amount_tax" sum="VAT"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="move_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'captured'"
                       decoration-warning="state == 'review'"
                       decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cssk_receipt_form" model="ir.ui.view">
        <field name="name">cssk.receipt.form</field>
        <field name="model">cssk.receipt</field>
        <field name="arch" type="xml">
            <form string="Captured Receipt">
                <header>
                    <button name="action_capture" type="object" string="Capture"
                            class="oe_highlight"
                            invisible="state not in ('new', 'error', 'review')"/>
                    <button name="action_create_bill" type="object"
                            string="Create Vendor Receipt" class="oe_highlight"
                            invisible="state != 'captured'"/>
                    <button name="action_create_partner" type="object"
                            string="Create Seller"
                            invisible="partner_id or not seller_name"/>
                    <button name="action_force_captured" type="object"
                            string="Accept Anyway" confirm="The figures on this receipt do not add up. Accept it on your own responsibility?"
                            invisible="state != 'review'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,captured,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'review'">
                        <field name="review_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'error'">
                        <field name="review_reason" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Seller">
                            <field name="partner_id"/>
                            <field name="seller_name"/>
                            <field name="seller_vat"/>
                            <field name="seller_tax_id"/>
                            <field name="seller_reg_id"/>
                            <field name="seller_vat_payer"/>
                            <field name="premises_note"/>
                        </group>
                        <group string="Receipt">
                            <field name="issue_date"/>
                            <field name="receipt_uid"/>
                            <field name="provider_id"/>
                            <field name="qr_raw"/>
                            <field name="attachment_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_label" optional="hide"/>
                                    <field name="vat_rate"/>
                                    <field name="amount_untaxed" readonly="1"/>
                                    <field name="amount_tax" readonly="1"/>
                                    <field name="amount_total"/>
                                    <field name="is_negative" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="VAT Recap" name="tax_summary">
                            <p class="text-muted">
                                The seller's own per-rate recap. This is what the
                                document posts; the items above are detail.
                            </p>
                            <field name="tax_summary_ids">
                                <list editable="bottom">
                                    <field name="vat_rate"/>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Provider Payload" name="payload"
                              groups="base.group_no_one">
                            <field name="payload_raw" readonly="1" nolabel="1"/>
                            <group>
                                <field name="captured_on" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cssk_receipt_search" model="ir.ui.view">
        <field name="name">cssk.receipt.search</field>
        <field name="model">cssk.receipt</field>
        <field name="arch" type="xml">
            <search string="Captured Receipts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="seller_name"/>
                <field name="receipt_uid"/>
                <field name="qr_raw"/>
                <filter name="to_capture" string="To Capture"
                        domain="[('state', '=', 'new')]"/>
                <filter name="needs_review" string="Needs Review"
                        domain="[('state', 'in', ('review', 'error'))]"/>
                <filter name="ready" string="Ready to Post"
                        domain="[('state', '=', 'captured')]"/>
                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="no_seller" string="Unidentified Seller"
                        domain="[('partner_id', '=', False)]"/>
                <separator/>
                <filter name="filter_issue_date" string="Issue Date"
                        date="issue_date"/>
                <separator/>
                <filter name="group_state" string="Status" domain="[]"
                        context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Seller" domain="[]"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_provider" string="Provider" domain="[]"
                        context="{'group_by': 'provider_id'}"/>
                <filter name="group_month" string="Month" domain="[]"
                        context="{'group_by': 'issue_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_cssk_receipt" model="ir.actions.act_window">
        <field name="name">Captured Receipts</field>
        <field name="res_model">cssk.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cssk_receipt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Capture your first receipt</p>
            <p>Paste the QR payload from a fiscal receipt, or attach the
               photograph, and press <b>Capture</b>.</p>
        </field>
    </record>

    <record id="action_cssk_receipt_review" model="ir.actions.act_window">
        <field name="name">Receipts to Review</field>
        <field name="res_model">cssk.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cssk_receipt_search"/>
        <field name="domain">[('state', 'in', ('new', 'review', 'error'))]</field>
    </record>
</odoo>
