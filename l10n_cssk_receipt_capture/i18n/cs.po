#. module: l10n_cssk_receipt_capture
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture/models/cssk_receipt.py:0
msgid ""
"%(count)s item(s) are marked as returns or corrections. Receipts carrying "
"them are not posted automatically — check the signs against the paper before"
" accepting."
msgstr "Položky označené jako vrácení nebo oprava: %(count)s. Účtenky s nimi se nezaúčtují automaticky — před přijetím zkontrolujte znaménka podle papírové účtenky."

#. module: l10n_cssk_receipt_capture
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture/models/cssk_receipt.py:0
msgid ""
"%(count)s item(s) carry a VAT rate the recap does not mention (%(rates)s)."
msgstr "Položky se sazbou DPH, kterou rekapitulace neuvádí: %(count)s (%(rates)s)."

#. module: l10n_cssk_receipt_capture
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture/models/account_move.py:0
msgid ""
"%(move)s carries %(tax).2f of VAT, but it comes from a receipt whose VAT is "
"not deductible (%(receipt)s). Remove the VAT, or tick “Full invoice held” on"
" the receipt if you have one."
msgstr "%(move)s obsahuje DPH %(tax).2f, ale pochází z účtenky, jejíž DPH nelze odečíst (%(receipt)s). Odstraňte DPH, nebo na účtence zaškrtněte „Máme řádnou fakturu“, pokud ji máte."

#. module: l10n_cssk_receipt_capture
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture/models/cssk_receipt.py:0
msgid ""
"%(tax)s is mapped to %(rate)g%% but is a %(actual)g%% tax. Fix the company's"
" VAT-rate mapping — posting it would report the wrong base at both rates."
msgstr "%(tax)s je přiřazena k sazbě %(rate)g%%, ale je to daň %(actual)g%%. Opravte mapování sazeb DPH společnosti — zaúčtování by vykázalo nesprávný základ u obou sazeb."

#. module: l10n_cssk_receipt_capture
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture/models/cssk_receipt.py:0
msgid "%s (VAT not deductible)"
msgstr "%s (DPH nelze odečíst)"

