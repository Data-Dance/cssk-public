<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_cssk_cash_journal_print_form" model="ir.ui.view">
        <field name="name">cssk.cash.journal.print.form</field>
        <field name="model">cssk.cash.journal.print</field>
        <field name="arch" type="xml">
            <form string="Print the Cash Journal">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="output" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cssk_cash_journal_print" model="ir.actions.act_window">
        <field name="name">Print Cash Journal</field>
        <field name="res_model">cssk.cash.journal.print</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
