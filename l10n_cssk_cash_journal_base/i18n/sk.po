msgid ""
"Category %s is a transit (priebežná položka), so it cannot affect the tax "
"base."
msgstr ""
"Kategória %s je priebežná položka, preto nemôže ovplyvňovať základ dane."

#. module: l10n_cssk_cash_journal_base
#. odoo-python
#: code:addons/l10n_cssk_cash_journal_base/models/cssk_cash_category.py:0
