<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Slovak payroll attributes on the classic hr.contract form, inside the
        standard "salary" group, guarded by the OCA payroll group.
    -->
    <record id="hr_contract_view_form_l10n_sk" model="ir.ui.view">
        <field name="name">hr.contract.view.form.l10n_sk_payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary']" position="inside">
                <group string="Slovak Payroll" groups="payroll.group_payroll_user">
                    <field name="l10n_sk_tax_declaration_signed"/>
                    <field name="l10n_sk_ztp"/>
                    <field name="l10n_sk_children_under_15"/>
                    <field name="l10n_sk_children_15_18"/>
                    <field name="l10n_sk_health_oop_claim"
                           invisible="l10n_sk_agreement_type != 'none'"/>
                </group>
                <group string="Meal Allowance (Slovakia)" groups="payroll.group_payroll_user">
                    <field name="l10n_sk_meal_allowance_type"/>
                    <field name="l10n_sk_meal_days"
                           invisible="l10n_sk_meal_allowance_type == 'none'"/>
                    <field name="l10n_sk_meal_voucher_employer"
                           invisible="l10n_sk_meal_allowance_type == 'none'"/>
                    <field name="l10n_sk_meal_voucher_employee"
                           invisible="l10n_sk_meal_allowance_type != 'voucher'"/>
                </group>
                <group string="Agreement (Slovakia)" groups="payroll.group_payroll_user">
                    <field name="l10n_sk_agreement_type"/>
                    <field name="l10n_sk_agreement_oop"
                           invisible="l10n_sk_agreement_type == 'none'"/>
                </group>
                <group string="Garnishment (Slovakia)" groups="payroll.group_payroll_user">
                    <field name="l10n_sk_garnishment_dependents"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
