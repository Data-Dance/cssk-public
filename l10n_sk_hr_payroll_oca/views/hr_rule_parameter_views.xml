<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The dated statutory parameters the Slovak salary rules read through
        payslip.rule_parameter('code'). The OCA payroll engine has no such
        model of its own, so this module ships it - and, until now, no screen
        for it: rolling a rate or a ceiling to a new year meant a database
        shell. Payroll managers edit; payroll users read.
    -->
    <record id="hr_rule_parameter_view_list" model="ir.ui.view">
        <field name="name">hr.rule.parameter.list</field>
        <field name="model">hr.rule.parameter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="hr_rule_parameter_view_form" model="ir.ui.view">
        <field name="name">hr.rule.parameter.form</field>
        <field name="model">hr.rule.parameter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Statutory source, how the value is derived..."/>
                    <field name="parameter_value_ids">
                        <list editable="bottom">
                            <field name="date_from"/>
                            <field name="parameter_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_rule_parameter_view_search" model="ir.ui.view">
        <field name="name">hr.rule.parameter.search</field>
        <field name="model">hr.rule.parameter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </search>
        </field>
    </record>

    <record id="hr_rule_parameter_action" model="ir.actions.act_window">
        <field name="name">Rule Parameters</field>
        <field name="res_model">hr.rule.parameter</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_rule_parameter_view_search"/>
    </record>

    <menuitem id="hr_rule_parameter_menu"
              name="Rule Parameters"
              parent="payroll.payroll_menu_configuration"
              action="hr_rule_parameter_action"
              groups="payroll.group_payroll_manager"
              sequence="40"/>
</odoo>
