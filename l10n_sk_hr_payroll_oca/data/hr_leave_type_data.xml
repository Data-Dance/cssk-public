        <field name="request_unit">day</field>
        <field name="leave_validation_type">no_validation</field>
    </record>

    <!-- Ported from 19.0. Three families, none of which needs a money rule
         beyond the § 142 one:

           § 142 employer-side obstacles — their own codes, because the four
                 reasons carry four different statutory rates
           § 166 materská / rodičovská / otcovská — the employer pays nothing,
                 these are dávky of the Sociálna poisťovňa, so they behave
                 like OČR
           §§ 136-140 general interest and study leave, plus karanténa — each
                 rides an EXISTING code, so the payslip treats it as the
                 bucket it belongs to and the separate type is for recording

         § 140 ships paid AND unpaid variants because the statute leaves paid
         study leave to the employer. Karanténa carries the PN code because
         the money is identical to a sickness. -->
    <record id="l10n_sk_leave_type_employer_prestoj" model="hr.leave.type">
        <field name="name">Employer Obstacle — Downtime / prestoj (§ 142 ods. 1)</field>
        <field name="l10n_sk_payroll_code">PREKAZKA_PRESTOJ</field>
        <field name="country_id" ref="base.sk"/>
        <field name="company_id" eval="False"/>
