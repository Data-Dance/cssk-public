<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Slovak time-off types, each tagged with a stable payroll code
        (l10n_sk_payroll_code) the salary rules key on. The payroll engine's
        _compute_leave_days (overridden in models/hr_payslip.py) turns a
        validated hr.leave of one of these types into a worked-day line keyed
        by that code:

          DOVOLENKA  holiday          paid at priemerný zárobok (insurable+tax)
          PN         sickness         employer sick-pay náhrada (days 1..14)
          OCR        family care      unpaid (Sociálna poisťovňa pays)
          NEPLATENE  unpaid leave     unpaid -> BASIC prorates
          OBSTACLE   paid obstacle    paid at priemerný zárobok (insurable+tax)

        requires_allocation='no' keeps them usable without an allocation step;
        request_unit='day' so a full-day absence maps to whole worked days.
        These are starter types — a deployment may re-tag its own leave types
        by setting l10n_sk_payroll_code instead.
    -->
    <record id="l10n_sk_leave_type_dovolenka" model="hr.leave.type">
        <field name="name">Holiday</field>
        <field name="l10n_sk_payroll_code">DOVOLENKA</field>
        <field name="country_id" ref="base.sk"/>
        <field name="company_id" eval="False"/>
        <field name="requires_allocation">no</field>
        <field name="request_unit">day</field>
        <field name="leave_validation_type">no_validation</field>
    </record>

    <record id="l10n_sk_leave_type_pn" model="hr.leave.type">
        <field name="name">Sick Leave (PN)</field>
        <field name="l10n_sk_payroll_code">PN</field>
