    <!-- ======================================= EMPLOYER-OBSTACLE NÁHRADA -->
    <!-- Náhrada mzdy pri prekážke v práci NA STRANE ZAMESTNÁVATEĽA (§ 142).
         Unlike the § 141 employee-side obstacles, which are all paid at the
         full priemerný zárobok, these carry four DIFFERENT statutory rates, so
         each reason has its own worked-day code and its own dated percentage:

           PREKAZKA_PRESTOJ  § 142 ods. 1  prestoj                    100 %
           PREKAZKA_POCASIE  § 142 ods. 2  nepriaznivé poveternostné   50 %
           PREKAZKA_INE      § 142 ods. 3  iné prekážky               100 %
           PREKAZKA_VAZNE    § 142 ods. 4  vážne prevádzkové dôvody    60 % -->
    <record id="l10n_sk_employer_obstacle_allowance" model="hr.salary.rule">
        <field name="category_id" ref="ALW"/>
        <field name="name">Employer Work Obstacle Pay (§ 142)</field>
        <field name="code">PREKAZKA_NAHRADA</field>
        <field name="sequence">52</field>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = any(_c in worked_days.dict for _c in (
    'PREKAZKA_PRESTOJ', 'PREKAZKA_POCASIE', 'PREKAZKA_INE', 'PREKAZKA_VAZNE'))
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
_rates = (
    ('PREKAZKA_PRESTOJ', 'l10n_sk_prekazka_prestoj_pct'),
    ('PREKAZKA_POCASIE', 'l10n_sk_prekazka_pocasie_pct'),
    ('PREKAZKA_INE', 'l10n_sk_prekazka_ine_pct'),
    ('PREKAZKA_VAZNE', 'l10n_sk_prekazka_vazne_pct'),
)
_avg = payslip.l10n_sk_average_hourly_earnings()
_total = 0.0
for _code, _param in _rates:
    if _code in worked_days.dict:
        _hours = abs(worked_days.dict[_code].number_of_hours)
        _total += _hours * _avg * payslip.rule_parameter(_param) / 100.0
result = round(_total, 2)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>
</odoo>
