    <!-- ================================================ WAGE GARNISHMENT -->
    <!-- Exekučné zrážky zo mzdy with the non-seizable amount (nezabaviteľná
         suma). Input-driven: only computes when a garnishment input is present
         (GARNISHMENT = neprednostná pohľadávka, 1/3; GARNISHMENT_PRIORITY =
         prednostná pohľadávka, e.g. výživné/dane, 2/3). The input's amount is
         the outstanding debt; the rule seizes at most the legally allowed part
         of the net wage. Parented under DED (sequence after the child bonus,
         before NET) so NET subtracts it.

         2026 figures (životné minimum plnoletej FO = 284.13 €, valid
         1.7.2025–30.6.2026):
           * základná nepostihnuteľná suma na povinného = 140% ŽM = 397.78 €
           * na každú vyživovanú osobu = 25% zo základnej sumy = 99.45 €
           * zvyšok čistej mzdy sa zaokrúhli nadol na sumu deliteľnú tromi;
             neprednostná pohľadávka zráža 1/3, prednostná 2/3
           * suma zvyšku nad 3× základná suma (1 193,34 €) sa zráža bez obmedzenia
         Sources (2025/2026): danovy-poradca.sk "Exekúcie a zrážky zo mzdy 2026"
         <https://www.danovy-poradca.sk/blog/exekucie-zrazky-zo-mzdy-2026>,
         finsider.sk "Zrážky zo mzdy 2026"
         <https://www.finsider.sk/servis/zrazky-zo-mzdy/>; Nariadenie vlády
         268/2006 Z. z.; zákon 233/1995 Z. z. (Exekučný poriadok).
         Simplifications: the pensioner variant (50% per dependant), and the
         ordering when several garnishments of different priority coexist, are
         not modelled — one claim per payslip is assumed. -->
    <record id="l10n_sk_wage_garnishment" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_garnishment"/>
        <field name="name">Wage Garnishment</field>
        <field name="code">GARNISHMENT</field>
        <field name="sequence">176</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'GARNISHMENT' in inputs.dict or 'GARNISHMENT_PRIORITY' in inputs.dict</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Priority (prednostná) claim seizes two thirds, ordinary (neprednostná) one.
if 'GARNISHMENT_PRIORITY' in inputs.dict:
    debt = inputs.GARNISHMENT_PRIORITY.amount
    thirds = 2
else:
    debt = inputs.GARNISHMENT.amount
    thirds = 1

# Net wage (čistá mzda) = gross − employee social − employee health − tax, plus
# the child bonus. categories.SOCIALEMPLOYEE (negative) already holds both the
# social and health employee premiums.
net_wage = (result_rules.GROSS.total + categories.SOCIALEMPLOYEE
            + result_rules.INCOMETAX.total + result_rules.CHILD_BONUS.total)

zm = payslip.rule_parameter('l10n_sk_zivotne_minimum')
basic = round(zm * payslip.rule_parameter('l10n_sk_garnishment_basic_coeff'), 2)
per_dep = round(basic * payslip.rule_parameter('l10n_sk_garnishment_dependent_coeff'), 2)
non_seizable = basic + contract.l10n_sk_garnishment_dependents * per_dep

remainder = net_wage - non_seizable
if remainder &lt;= 0:
    result = 0.0
else:
    unlimited_threshold = basic * payslip.rule_parameter('l10n_sk_garnishment_unlimited_mult')
    over = max(0.0, remainder - unlimited_threshold)
    base = remainder - over  # min(remainder, unlimited_threshold)
    # Round the base DOWN to a sum divisible by three (in eurocents).
    base_cents = int(round(base * 100))
    base_cents -= base_cents % 3
    one_third = base_cents / 3.0 / 100.0
    seizable = thirds * one_third + over
    result = -min(debt, seizable)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ============================================ SICKNESS COMPENSATION -->
    <!-- Náhrada príjmu pri dočasnej pracovnej neschopnosti (employer-paid sick
         pay for the first days of a PN). Input-driven: PN_DAYS = number of PN
         calendar days in the period, PN_DVZ = denný vymeriavací základ (€/day).
         Days 1–3 at 25%, days 4..employer_days at 55% of the (capped) DVZ; from
         the day after employer_days the Sociálna poisťovňa pays nemocenské.
         employer_days is dated: 10 days in 2025, 14 days from 1.1.2026.
         Modelled as exempt from the social/health/tax bases (kept out of GROSS)
         and added to NET via DED — a documented SIMPLIFICATION (in reality the
         náhrada is exempt from odvody but is subject to income tax; the tax is
         not modelled here). Sources: podnikajte.sk "PN zamestnanca od 1.1.2026"
         <https://www.podnikajte.sk/socialne-a-zdravotne-odvody/pn-zamestnanca-od-1-1-2026-zmeny>,
         MPSVR SR "Náhrada príjmu pri PN"; max DVZ 2026 = 100,2083 €
         (= 2 × 1524 × 12 / 365). -->
    <record id="l10n_sk_sickness_compensation" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_sickness_comp"/>
        <field name="name">Sickness Income Compensation</field>
        <field name="code">SICK_COMP</field>
        <field name="sequence">178</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = ('PN' in worked_days.dict or 'PN_DAYS' in inputs.dict) and 'PN_DVZ' in inputs.dict</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Sick days are driven from the PN leave (worked_days.PN); the manual PN_DAYS
# input is the fallback when no leave is recorded. The denný vymeriavací základ
# (DVZ) is a separate statutory base (not priemerný zárobok), still taken from
# the PN_DVZ input. SIMPLIFICATION: náhrada príjmu is paid per CALENDAR day for
# the first 10/14 days; the leave gives WORKING days, used here as a proxy.
if 'PN' in worked_days.dict:
    days = abs(worked_days.dict['PN'].number_of_days)
else:
    days = inputs.PN_DAYS.amount
dvz = min(inputs.PN_DVZ.amount, payslip.rule_parameter('l10n_sk_pn_max_dvz'))
tier1_days = payslip.rule_parameter('l10n_sk_pn_tier1_days')
employer_days = payslip.rule_parameter('l10n_sk_pn_employer_days')
rate1 = payslip.rule_parameter('l10n_sk_pn_rate_tier1') / 100.0
rate2 = payslip.rule_parameter('l10n_sk_pn_rate_tier2') / 100.0
paid = min(days, employer_days)
d1 = min(paid, tier1_days)
d2 = max(0.0, paid - tier1_days)
result = round(dvz * (d1 * rate1 + d2 * rate2), 2)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ================================================== DOHODA OOP (INFO) -->
    <!-- Informational line showing the pension OOP actually applied on a dohoda
         (students/pensioners): the amount by which the old-age, disability and
         reserve-fund assessment base was reduced. It sits in the isolated STUB
         category (no parent), so it does NOT feed GROSS/DED/NET/any total — the
         real reduction happens inside the PENSION/DISABILITY/RESERVE rules. -->
    <record id="l10n_sk_dohoda_oop_stub" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_stub"/>
        <field name="name">Agreement OOP — pension base reduction (informational)</field>
        <field name="code">OOP_PENSION</field>
        <field name="sequence">190</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_sk_agreement_type != 'none' and contract.l10n_sk_agreement_oop</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# The OOP reduces the base for old-age (starobné), disability (invalidné) and
# the solidarity reserve fund by up to the OOP amount, but never accident or
# guarantee insurance. Only one such agreement per month may claim it.
base = min(categories.GROSS, payslip.rule_parameter('l10n_sk_monthly_taxable_max'))
result = min(base, payslip.rule_parameter('l10n_sk_dohoda_oop'))
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ============================================ ANNUAL TAX SETTLEMENT -->
    <!-- Ročné zúčtovanie preddavkov na daň (§38 zákona č. 595/2003 Z. z.):
         input-driven settlement of the annual tax reconciliation, posted onto
         the reconciliation-month payslip by the l10n.sk.tax.reconciliation
         model. The input amount is SIGNED: positive => preplatok (refund, adds
         to net), negative => nedoplatok (withheld from net). Category
         ANNUALSETTLEMENT is under DED so NET picks it up. Zero (no line) on a
         standard monthly payslip without a reconciliation input. -->
    <record id="l10n_sk_annual_tax_settlement" model="hr.salary.rule">
