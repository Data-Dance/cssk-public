<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Slovak salary rules (v18.0.2.0.0). Implements the income-tax base, NČZD,
        insurance rates and ceilings, progressive tax bands, the child tax bonus,
        ZŤP handling, the health minimum doplatok and a legal meal-allowance
        model, per Slovak law (see README.rst / docs/sk_payroll_legal.md).

        Engine mapping:
          * rules attach to the structure via rule_ids m2m (no struct_id).
          * contract.wage is the full monthly wage.
          * payslip.rule_parameter(code) is the dated-parameter accessor.
          * BrowsableObject supports attribute access only:
            categories.X, worked_days.WORK100, inputs.X, result_rules.X.total,
            and `'CODE' in obj.dict`.

        Rule ORDER (sequence) is load-bearing: categories accumulate as rules
        run, so TAXBASE (160) sees all employee social+health (110–156), the tax
        rule (170) sees TAXBASE, the bonus (172) sees TAXBASE, and NET (200) sees
        the bonus. Totals stay at 500+ so they never feed NET.
    -->

    <!-- ================================================================ BASIC -->
    <record id="l10n_sk_hr_payroll_structure_sk_employee_salary_basic_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="BASIC"/>
        <field name="name">Basic Salary</field>
        <field name="sequence">1</field>
        <field name="code">BASIC</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# NOTE: no paid_amount on the OCA engine; contract.wage is the full monthly wage.
# Partial-month + absence proration: for a mid-month hire/leaver the worked days
# (WORK100, clamped by the engine to the contract start/end) are fewer than the
# full scheduled working days of the period; and any absence leave (dovolenka /
# PN / OČR / neplatené / prekážka) cuts additional days. Holiday and paid
# obstacle are added back as náhrada at priemerný zárobok by their own rules, so
# reducing BASIC here for them is correct (the wage for those hours is paid via
# the náhrada, not the basic salary). Family care / unpaid leave are simply
# unpaid. For a full worked month (no absence) worked == scheduled, so the result
# is exactly contract.wage and the standard payslip is unchanged.
result = contract.wage
if 'WORK100' in worked_days.dict:
    # PRORATE BY HOURS, NOT DAYS. Every náhrada pays hours x priemerný
    # hodinový zárobok, so cutting BASIC by a DAY fraction only makes GROSS
    # whole when every working day is the same length. On a 40-hour week that
    # is not 8+8+8+8+8 the two disagree: one absent 10-hour day cut 1/19.5 of
    # the wage while the náhrada paid 10 hours, leaving GROSS above the full
    # wage for a reason that must leave it untouched.
    scheduled = payslip.l10n_sk_scheduled_hours()
    worked = worked_days.WORK100.number_of_hours
# OCA models absence leaves as NEGATIVE worked-day lines (the engine's
# payroll.leaves_positive is unset), so take the absolute value of the day count.
    absence = 0.0
    for _code in payslip.l10n_sk_absence_codes():
        if _code in worked_days.dict:
            absence += abs(worked_days.dict[_code].number_of_hours)
    paid_worked = worked - absence
    if scheduled and paid_worked &lt; scheduled:
        result = contract.wage * paid_worked / scheduled
</field>
    </record>

    <!-- =================================================== HOLIDAY NÁHRADA -->
    <!-- Náhrada mzdy za dovolenku: paid at priemerný (hodinový) zárobok per
         §134 Zákonníka práce for each holiday hour. It is regular wage income
         (insurable + taxable), so it sits in ALW and rolls into GROSS. The
         holiday hours come from the leave-derived DOVOLENKA worked-day line
         (see hr_payslip._compute_leave_days); BASIC was prorated down for the
         same hours, so GROSS is made whole again (matrix: "no proration cut").
         Sequence 50 so it runs before GROSS (100). Sources:
         podnikajte.sk "Náhrada mzdy za dovolenku"
         <https://www.podnikajte.sk/pracovne-pravo-bozp/nahrada-mzdy-za-dovolenku-ako-sa-pocita>,
         §116 & §134 zákona č. 311/2001 Z. z. -->
    <record id="l10n_sk_holiday_allowance" model="hr.salary.rule">
        <field name="category_id" ref="ALW"/>
        <field name="name">Holiday Pay</field>
        <field name="code">DOVOLENKA_NAHRADA</field>
        <field name="sequence">50</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'DOVOLENKA' in worked_days.dict</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
hours = abs(worked_days.dict['DOVOLENKA'].number_of_hours) if 'DOVOLENKA' in worked_days.dict else 0.0
result = round(hours * payslip.l10n_sk_average_hourly_earnings(), 2)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ============================================= PAID-OBSTACLE NÁHRADA -->
    <!-- Náhrada mzdy pri prekážke v práci (paid work obstacle, e.g. doctor's
         visit / doprovod): paid at priemerný zárobok, insurable + taxable, same
         mechanism as holiday. Hours come from the OBSTACLE worked-day line.
         Source: §137/§141 zákona č. 311/2001 Z. z.; §134 (priemerný zárobok). -->
    <record id="l10n_sk_obstacle_allowance" model="hr.salary.rule">
        <field name="category_id" ref="ALW"/>
        <field name="name">Paid Work Obstacle Pay</field>
        <field name="code">OBSTACLE_NAHRADA</field>
        <field name="sequence">51</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'OBSTACLE' in worked_days.dict</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
hours = abs(worked_days.dict['OBSTACLE'].number_of_hours) if 'OBSTACLE' in worked_days.dict else 0.0
result = round(hours * payslip.l10n_sk_average_hourly_earnings(), 2)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ================================================================ GROSS -->
    <!-- Assessment base for tax and both contribution systems. Meal allowance is
         deliberately EXCLUDED (legal exemption), so it is not in categories.ALW. -->
    <record id="l10n_sk_hr_payroll_structure_sk_employee_salary_gross_salary_rule" model="hr.salary.rule">
        <field name="category_id" ref="GROSS"/>
        <field name="name">Taxable Salary</field>
        <field name="sequence">100</field>
        <field name="code">GROSS</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.BASIC + categories.ALW
        </field>
    </record>

    <!-- ===================================================== SOCIAL (EMPLOYEE) -->
    <!-- DoVP (irregular income) pays NO sickness or unemployment; DoPČ (regular
         income) and standard employment pay the full set. Guarded so standard
         behaviour is unchanged. Source: podnikajte.sk "Odvody z dohody od 2025"
         and socpoist "Poistné pri dohodároch". -->
    <record id="l10n_sk_sickness_insurance_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employee"/>
        <field name="name">Sickness Insurance</field>
        <field name="code">SICK</field>
        <field name="sequence">110</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_sk_agreement_type != 'dovp'</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = min(categories.GROSS, payslip.rule_parameter('l10n_sk_monthly_taxable_max'))
result_rate = -payslip.rule_parameter('l10n_sk_social_sickness_ee')
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- Old-age (starobné): the dohoda pension OOP for pensioners/students
         reduces this base by up to the OOP amount. -->
    <record id="l10n_sk_pension_contribution_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employee"/>
        <field name="name">Pension Contribution</field>
        <field name="code">PENSION</field>
        <field name="sequence">115</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
base = min(categories.GROSS, payslip.rule_parameter('l10n_sk_monthly_taxable_max'))
if contract.l10n_sk_agreement_type != 'none' and contract.l10n_sk_agreement_oop:
    base = max(0.0, base - payslip.rule_parameter('l10n_sk_dohoda_oop'))
result = base
result_rate = -payslip.rule_parameter('l10n_sk_social_pension_ee')
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

