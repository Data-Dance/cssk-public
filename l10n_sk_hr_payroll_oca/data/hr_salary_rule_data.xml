    <!-- Accident insurance: charged on the FULL gross (no ceiling). -->
    <record id="l10n_sk_accident_insurance_employer" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employer"/>
        <field name="name">Accident Insurance (Employer)</field>
        <field name="code">ACCIDENT</field>
        <field name="sequence">140</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.GROSS
result_rate = payslip.rule_parameter('l10n_sk_social_accident_er')
        </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <record id="l10n_sk_reserve_fund_employer" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employer"/>
        <field name="name">Reserve Fund (Employer)</field>
        <field name="code">RESERVEFUNDEMPLOYER</field>
        <field name="sequence">145</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
base = min(categories.GROSS, payslip.rule_parameter('l10n_sk_monthly_taxable_max'))
if contract.l10n_sk_agreement_type != 'none' and contract.l10n_sk_agreement_oop:
    base = max(0.0, base - payslip.rule_parameter('l10n_sk_dohoda_oop'))
result = base
result_rate = payslip.rule_parameter('l10n_sk_social_reserve_er')
        </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <!-- ===================================================== HEALTH (uncapped) -->
    <!-- Employee rate: standard (4%/5%) or ZŤP halved (2%/2.5%). No max base. -->
    <record id="l10n_sk_health_insurance_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employee"/>
        <field name="name">Health Insurance</field>
        <field name="code">HEALTH</field>
        <field name="sequence">150</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if contract.l10n_sk_ztp:
    rate = payslip.rule_parameter('l10n_sk_health_rate_employee_ztp')
else:
    rate = payslip.rule_parameter('l10n_sk_health_rate_employee')
base = categories.GROSS
# Health OOP (odvodová odpočítateľná položka): reduces ONLY the employee health
# assessment base, for a regular employment relationship (not a dohoda), when
# claimed. OOP = max(0, max - slope*(gross - max)) with slope = max/(end-max)
# (380/190 = 2), so base = max(0, gross - OOP). The employer base is untouched.
if contract.l10n_sk_health_oop_claim and contract.l10n_sk_agreement_type == 'none':
    oop_max = payslip.rule_parameter('l10n_sk_health_oop_max')
    oop_end = payslip.rule_parameter('l10n_sk_health_oop_phaseout_end')
    slope = oop_max / (oop_end - oop_max)
    oop = max(0.0, oop_max - slope * max(0.0, base - oop_max))
    base = max(0.0, base - oop)
result = base
result_rate = -rate
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <record id="l10n_sk_health_insurance_employer" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employer"/>
        <field name="name">Health Insurance (Employer)</field>
        <field name="code">HEALTHEMPLOYER</field>
        <field name="sequence">150</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if contract.l10n_sk_ztp:
    rate = payslip.rule_parameter('l10n_sk_health_rate_employer_ztp')
else:
    rate = payslip.rule_parameter('l10n_sk_health_rate_employer')
result = categories.GROSS
result_rate = rate
        </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <!-- Health minimum-base doplatok (subsistence-minimum floor). If the combined
         ee+er premium falls below the premium computed on the subsistence minimum
         (životné minimum), the shortfall is topped up. Charged here to the
         EMPLOYEE (approximation — see README; only triggers for sub-minimum
         wages, i.e. GROSS < subsistence minimum). Placed in SOCIALEMPLOYEE so it
         feeds TAXBASE and NET like any employee health premium. -->
    <record id="l10n_sk_health_doplatok_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_social_security_employee"/>
        <field name="name">Health Insurance Minimum Top-up</field>
        <field name="code">HEALTHDOPLATOK</field>
        <field name="sequence">155</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
min_base = payslip.rule_parameter('l10n_sk_health_min_base')
if contract.l10n_sk_ztp:
    rate_ee = payslip.rule_parameter('l10n_sk_health_rate_employee_ztp')
    rate_er = payslip.rule_parameter('l10n_sk_health_rate_employer_ztp')
else:
    rate_ee = payslip.rule_parameter('l10n_sk_health_rate_employee')
    rate_er = payslip.rule_parameter('l10n_sk_health_rate_employer')
min_combined = min_base * (rate_ee + rate_er) / 100.0
actual_combined = abs(result_rules.HEALTH.total) + result_rules.HEALTHEMPLOYER.total
result = -max(0.0, min_combined - actual_combined)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ============================================================= TAX BASE -->
    <!-- Income-tax base = gross − employee social − employee health − (health
         doplatok). categories.SOCIALEMPLOYEE is negative (all ee deductions),
         so adding it subtracts them. NČZD is applied inside the tax rule. -->
    <record id="l10n_sk_tax_base" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_taxbase"/>
        <field name="name">Income Tax Base</field>
        <field name="code">TAXBASE</field>
        <field name="sequence">160</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = max(0.0, categories.GROSS + categories.SOCIALEMPLOYEE)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- =========================================================== INCOME TAX -->
    <!-- Monthly advance: apply NČZD (if the Vyhlásenie is signed) with the
         high-income taper, then the progressive monthly bands. -->
    <record id="l10n_sk_income_tax_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_income_tax_employee"/>
        <field name="name">Income Tax (advance)</field>
        <field name="code">INCOMETAX</field>
        <field name="sequence">170</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
base = result_rules.TAXBASE.total

# --- NČZD (non-taxable part per taxpayer) ---
nczd = 0.0
if contract.l10n_sk_tax_declaration_signed:
    nczd = payslip.rule_parameter('l10n_sk_nczd_monthly')
    threshold = payslip.rule_parameter('l10n_sk_nczd_taper_threshold')
    annual_base = base * 12.0
    if annual_base &gt; threshold:
        # High-income taper. Monthly = annual/12. Reaches 0 for high earners.
        taper_const = payslip.rule_parameter('l10n_sk_nczd_taper_const')
        nczd = max(0.0, (taper_const - 0.25 * annual_base) / 12.0)

taxable = max(0.0, base - nczd)

# --- Progressive monthly bands ---
bands = payslip.rule_parameter('l10n_sk_income_tax_bands')
tax = 0.0
prev = 0.0
for rate, ceiling in bands:
    if taxable &gt; prev:
        amt = min(taxable, ceiling) - prev
        tax += amt * rate
    prev = ceiling

result = -tax
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ========================================================= CHILD BONUS -->
    <!-- Daňový bonus na dieťa: per-child amount by age tier, capped at a % of the
         partial tax base (by number of children), then a high-income taper. It is
         a credit added to NET (can exceed the tax => paid out). Gated on the
         signed Vyhlásenie (only one parent may claim). -->
    <record id="l10n_sk_child_bonus" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_child_bonus"/>
        <field name="name">Child Tax Bonus</field>
        <field name="code">CHILD_BONUS</field>
        <field name="sequence">172</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
n_young = contract.l10n_sk_children_under_15
n_teen = contract.l10n_sk_children_15_18
n = n_young + n_teen

if n &lt;= 0 or not contract.l10n_sk_tax_declaration_signed:
    result = 0.0
else:
    amount = (n_young * payslip.rule_parameter('l10n_sk_child_bonus_under_15')
              + n_teen * payslip.rule_parameter('l10n_sk_child_bonus_15_18'))

    # Cap at %-of-(partial)-tax-base by number of children (1..6+).
    caps = payslip.rule_parameter('l10n_sk_child_bonus_pct_caps')
    cap_pct = caps[min(n, len(caps)) - 1]
    base = result_rules.TAXBASE.total
    amount = min(amount, base * cap_pct / 100.0)

    # High-income taper (annual base above threshold).
    threshold = payslip.rule_parameter('l10n_sk_child_bonus_taper_threshold')
    threshold_m = threshold / 12.0
    if base &gt; threshold_m:
        coeff = payslip.rule_parameter('l10n_sk_child_bonus_taper_coeff')
        amount -= coeff * (base - threshold_m)

    result = max(0.0, amount)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ======================================================= MEAL ALLOWANCE -->
    <!-- Legal model: employer contributes >=55% of stravné; the meal allowance is
         EXEMPT from income tax and both contribution bases (it is not in GROSS).
         Employee may choose a voucher or a financial contribution. Backward
         compatible: if the manual per-day override fields are set (>0) they win. -->
    <record id="l10n_sk_meal_voucher_employer" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_meal_employer_cost"/>
        <field name="name">Meal Allowance (Employer contribution)</field>
        <field name="code">MEALEMPLOYER</field>
        <field name="sequence">185</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
mtype = contract.l10n_sk_meal_allowance_type
if mtype == 'none':
    result = 0.0
    result_qty = 0.0
else:
    days = contract.l10n_sk_meal_days
    if not days:
        days = worked_days.WORK100.number_of_days if 'WORK100' in worked_days.dict else 0.0
    if contract.l10n_sk_meal_voucher_employer:
        per_day = contract.l10n_sk_meal_voucher_employer
    else:
        stravne = payslip.rule_parameter('l10n_sk_stravne_5_12h')
        _exact = stravne * payslip.rule_parameter('l10n_sk_meal_employer_pct') / 100.0
        # § 152 sets a MINIMUM, and 55 % of the stravné is 5.115 — a third
        # decimal a payslip line cannot hold. Round UP to the cent: it is the
        # only direction that cannot fall below the minimum.
        _cents = round(_exact, 6) * 100.0
        _whole = int(_cents)
        per_day = (_whole + (1 if _cents - _whole > 0.000001 else 0)) / 100.0
    # total = result_qty * rate(100) * result / 100 = days * per_day
    result_qty = days
    result = per_day
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <record id="l10n_sk_meal_voucher_employee" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll_meal_vouchers_employee"/>
        <field name="name">Meal Voucher (Employee share)</field>
        <field name="code">MEALEMPLOYEE</field>
        <field name="sequence">186</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Only the meal-voucher option leaves an employee share (voucher value less the
# employer contribution). The financial contribution has no employee share.
mtype = contract.l10n_sk_meal_allowance_type
if mtype != 'voucher':
    result = 0.0
    result_qty = 0.0
else:
    days = contract.l10n_sk_meal_days
    if not days:
        days = worked_days.WORK100.number_of_days if 'WORK100' in worked_days.dict else 0.0
    if contract.l10n_sk_meal_voucher_employee:
        per_day = contract.l10n_sk_meal_voucher_employee
    else:
        stravne = payslip.rule_parameter('l10n_sk_stravne_5_12h')
        voucher_value = round(stravne * payslip.rule_parameter('l10n_sk_meal_voucher_min_pct') / 100.0, 4)
        employer_day = round(stravne * payslip.rule_parameter('l10n_sk_meal_employer_pct') / 100.0, 4)
        per_day = max(0.0, voucher_value - employer_day)
    # total = result_qty * rate(100) * result / 100 = days * (-per_day)
    result_qty = days
    result = -per_day
</field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

