    <!-- =================================================================== NET -->
    <record id="l10n_sk_hr_payroll_structure_sk_employee_salary_net_salary" model="hr.salary.rule">
        <field name="category_id" ref="NET"/>
        <field name="name">Net Salary</field>
        <field name="sequence">200</field>
        <field name="condition_select">none</field>
        <field name="code">NET</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# categories.DED already nets the employee social+health (SOCIALEMPLOYEE),
# income tax (INCOMETAX) and the raw statutory deductions. The child bonus and
# the financial meal contribution are added explicitly (both exempt from GROSS).
meal_net = result_rules.MEALEMPLOYEE.total  # employee voucher share (negative or 0)
if contract.l10n_sk_meal_allowance_type == 'financial':
    meal_net += result_rules.MEALEMPLOYER.total  # cash paid with the wage
result = (
    BASIC + categories.ALW + categories.DED
    + result_rules.CHILD_BONUS.total
    + meal_net
)
        </field>
    </record>

