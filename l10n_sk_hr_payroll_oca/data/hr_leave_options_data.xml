    <record id="l10n_sk_accrual_level_obstacle_exam_7d" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="l10n_sk_accrual_plan_obstacle_exam_7d"/>
        <field name="added_value">7</field>
        <field name="added_value_type">day</field>
        <field name="frequency">yearly</field>
        <field name="cap_accrued_time" eval="False"/>
        <field name="cap_accrued_time_yearly" eval="True"/>
        <field name="maximum_leave_yearly">7</field>
        <field name="action_with_unused_accruals">lost</field>
    </record>

    <!-- Sprevádzanie rodinného príslušníka: 7 dní/rok -->
    <record id="l10n_sk_accrual_plan_obstacle_accompany_7d" model="hr.leave.accrual.plan">
        <field name="name">Work obstacle — accompanying a family member, 7 days/year</field>
        <field name="time_off_type_id" ref="l10n_sk_leave_type_obstacle_accompany"/>
        <field name="accrued_gain_time">start</field>
