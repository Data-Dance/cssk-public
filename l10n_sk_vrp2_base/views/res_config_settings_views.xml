<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_vrp2_base" model="ir.ui.view">
        <field name="name">res.config.settings.form.vrp2.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="VRP2 - Slovak Virtual Cash Register" name="vrp2_settings">
                    <setting string="VRP2 Connection"
                             help="Credentials for the VRP2 API (vcrp.financnasprava.sk)"
                             company_dependent="1">
                        <div class="content-group">
                            <div class="row mb-2">
                                <label for="vrp2_login" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_login" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="vrp2_password" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_password" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mb-2">
                                <label for="vrp2_status" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_status" widget="badge" class="col-lg-8"
                                       decoration-success="vrp2_status == 'connected'"
                                       decoration-warning="vrp2_status == 'disconnected'"
                                       decoration-muted="vrp2_status == 'not_configured'"/>
                            </div>
                            <div class="mt-3 mb-3">
                                <button name="action_vrp2_login"
                                        string="Login"
                                        type="object"
                                        class="btn-primary btn-sm"
                                        invisible="vrp2_token or not vrp2_login or not vrp2_password"/>
                                <button name="action_vrp2_logout"
                                        string="Logout"
                                        type="object"
                                        class="btn-secondary btn-sm ms-1"
                                        invisible="not vrp2_token"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="VRP2 Cash Register Info"
                             help="Information fetched from VRP2 after login"
                             invisible="not vrp2_dkp">
                        <div class="content-group">
                            <div class="row mb-1">
                                <label for="vrp2_dkp" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_dkp" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_business_name" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_business_name" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_dic" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_dic" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1" invisible="not vrp2_ico">
                                <label for="vrp2_ico" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_ico" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1" invisible="not vrp2_ic_dph">
                                <label for="vrp2_ic_dph" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_ic_dph" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Round to 0.05 €"
                             help="VRP2 register setting 'Zaokrúhľovať na 5 centov'. When on, paid totals are rounded to the nearest 5 cents before fiscalization.">
                        <field name="vrp2_round_5c"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
