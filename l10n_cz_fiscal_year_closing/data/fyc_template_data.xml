<odoo noupdate="1">

    <record id="fyc_template_cz" model="account.fiscalyear.closing.template">
        <field name="name">Účetní závěrka (CZ) — 701 / 702 / 710</field>
        <field name="chart_template">cz</field>
    </record>

    <!-- ================================================================
         1. Uzavření nákladů a výnosů na účet 710
         Třída 5 (náklady) a třída 6 (výnosy) se uzavřou na 710 — Účet
         zisků a ztrát, jehož zůstatek je výsledek hospodaření
         (ČÚS 002 bod 2.2.2).
         ================================================================ -->
    <record id="fyc_config_cz_pl" model="account.fiscalyear.closing.config.template">
        <field name="name">Uzavření nákladů a výnosů (710)</field>
        <field name="template_id" ref="fyc_template_cz"/>
        <field name="code">CZ_PL</field>
        <field name="sequence">10</field>
        <field name="move_type">loss_profit</field>
        <field name="move_date">last_ending</field>
    </record>

    <record id="fyc_map_cz_pl_5" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Náklady (třída 5) → 710</field>
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="src_accounts">5%</field>
        <field name="dest_account">710000</field>
    </record>
    <record id="fyc_map_cz_pl_6" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Výnosy (třída 6) → 710</field>
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="src_accounts">6%</field>
        <field name="dest_account">710000</field>
    </record>

    <!-- Náklady and výnosy are closed by their balance, not per partner. -->
    <record id="fyc_type_cz_pl_expense" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="account_type">expense</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_pl_expense_dep" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="account_type">expense_depreciation</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_pl_expense_cost" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="account_type">expense_direct_cost</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_pl_income" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="account_type">income</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_pl_income_other" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_pl"/>
        <field name="account_type">income_other</field>
        <field name="closing_type">balance</field>
    </record>

    <!-- ================================================================
         2. Uzavření rozvahových účtů na účet 702
         Třídy 0–4 a zůstatek účtu 710 (výsledek hospodaření),
         ČÚS 002 bod 2.2.3.
         ================================================================ -->
    <record id="fyc_config_cz_closing" model="account.fiscalyear.closing.config.template">
        <field name="name">Uzavření rozvahových účtů (702)</field>
        <field name="template_id" ref="fyc_template_cz"/>
        <field name="code">CZ_CLOSING</field>
        <field name="sequence">20</field>
        <field name="move_type">closing</field>
        <field name="move_date">last_ending</field>
    </record>

    <record id="fyc_map_cz_cl_0" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Dlouhodobý majetek (třída 0) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">0%</field>
        <field name="dest_account">702000</field>
    </record>
    <record id="fyc_map_cz_cl_1" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Zásoby (třída 1) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">1%</field>
        <field name="dest_account">702000</field>
    </record>
    <record id="fyc_map_cz_cl_2" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Krátkodobý finanční majetek a peněžní prostředky (třída 2) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">2%</field>
        <field name="dest_account">702000</field>
    </record>
    <record id="fyc_map_cz_cl_3" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Zúčtovací vztahy (třída 3) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">3%</field>
        <field name="dest_account">702000</field>
    </record>
    <record id="fyc_map_cz_cl_4" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Kapitálové účty a dlouhodobé závazky (třída 4) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">4%</field>
        <field name="dest_account">702000</field>
    </record>
    <record id="fyc_map_cz_cl_710" model="account.fiscalyear.closing.mapping.template">
        <field name="name">Výsledek hospodaření (710) → 702</field>
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="src_accounts">710%</field>
        <field name="dest_account">702000</field>
    </record>

    <record id="fyc_type_cz_cl_receivable" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_receivable</field>
        <field name="closing_type">unreconciled</field>
    </record>
    <record id="fyc_type_cz_cl_payable" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">liability_payable</field>
        <field name="closing_type">unreconciled</field>
    </record>
    <record id="fyc_type_cz_cl_cash" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_cash</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_current" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_current</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_non_current" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_non_current</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_prepayments" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_prepayments</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_fixed" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">asset_fixed</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_liab_current" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">liability_current</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_liab_non_current" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">liability_non_current</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_credit_card" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">liability_credit_card</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_equity" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">equity</field>
        <field name="closing_type">balance</field>
    </record>
    <record id="fyc_type_cz_cl_equity_unaffected" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">equity_unaffected</field>
        <field name="closing_type">balance</field>
    </record>
    <!-- Stock l10n_cz ships 701/702/710 as off_balance; this module retypes
         them to equity (models/account_chart_template.py), so they close
         with the equity type above. The off_balance type stays for any
         account still typed so — one created by hand, or a company whose
         retyping was undone. -->
    <record id="fyc_type_cz_cl_off_balance" model="account.fiscalyear.closing.type.template">
        <field name="template_config_id" ref="fyc_config_cz_closing"/>
        <field name="account_type">off_balance</field>
        <field name="closing_type">balance</field>
    </record>

    <!-- ================================================================
         3. Otevření účtů v novém období přes 701
         Inverze uzavření, zaúčtovaná k prvnímu dni následujícího období
         (ČÚS 002 body 2.1.2 a 2.1.3).
         ================================================================ -->
    <record id="fyc_config_cz_opening" model="account.fiscalyear.closing.config.template">
        <field name="name">Otevření rozvahových účtů (701)</field>
        <field name="template_id" ref="fyc_template_cz"/>
        <field name="code">CZ_OPENING</field>
        <field name="sequence">30</field>
        <field name="move_type">opening</field>
        <field name="move_date">first_opening</field>
        <field name="inverse">CZ_CLOSING</field>
    </record>

</odoo>
