<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cssk_vat_return_view_list" model="ir.ui.view">
        <field name="name">cssk.vat.return.list</field>
        <field name="model">cssk.vat.return</field>
        <field name="arch" type="xml">
            <list string="VAT Returns">
                <field name="name"/>
                <field name="country_id"/>
                <field name="version_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="period_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-info="state == 'exported'"
                       decoration-muted="state == 'legacy'"/>
            </list>
        </field>
    </record>

    <record id="cssk_vat_return_view_form" model="ir.ui.view">
        <field name="name">cssk.vat.return.form</field>
        <field name="model">cssk.vat.return</field>
        <field name="arch" type="xml">
            <form string="VAT Return">
                <header>
                    <!-- A historical filing can do exactly one thing: be
                         compared with what this system computes for its
                         period. Everything else is hidden rather than
                         disabled, because a button that only ever explains
                         why it cannot work is worse than no button. -->
                    <button name="action_cssk_compare_to_computed" type="object"
                            string="Compare with computed" class="btn-primary"
                            invisible="not legacy"/>
                    <button name="action_compute_lines" type="object"
                            string="Compute"
                            invisible="state not in ('draft', 'preview')"/>
                    <button name="action_export_xml" type="object"
                            string="Export XML" class="btn-primary"
                            invisible="state in ('draft', 'submitted', 'legacy')"/>
                    <button name="action_submit" type="object"
                            string="Mark Submitted" class="btn-primary"
                            invisible="state != 'exported'"/>
                    <button name="action_create_submission" type="object"
                            string="File it" class="btn-primary"
                            invisible="state not in ('exported', 'submitted')"
                            help="Open a delivery for this filing. With only the
                                  manual channel installed this records who filed
                                  it on the portal and holds the receipts."/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('exported', 'submitted')"
                            confirm="Reset this filing to draft? The originally filed copy is kept."/>
                    <button name="action_create_amendment" type="object"
                            string="Amended / corrective"
                            invisible="state != 'submitted'"/>
                    <field name="unreconciled_count" invisible="1"/>
                    <button name="action_view_unreconciled" type="object"
                            class="btn-danger" icon="fa-exclamation-triangle"
                            invisible="state in ('draft', 'legacy') or unreconciled_count == 0"
                            string="Unreconciled rows"/>
                    <button name="action_view_unreconciled" type="object"
                            class="btn-success" icon="fa-check" disabled="1"
                            invisible="state in ('draft', 'legacy') or unreconciled_count != 0"
                            string="Rows tie out"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,preview,exported,submitted"/>
                    <field name="submission_state" widget="badge" optional="show"
                           invisible="not submission_state"
                           decoration-success="submission_state in ('accepted',)"
                           decoration-info="submission_state in ('delivered',)"
                           decoration-danger="submission_state in ('rejected','failed')"/>
                </header>
                <sheet>
                    <!-- A filing can have SEVERAL comparisons, one per
                         basis — itself recomputed, the ledger, another filing
                         — so this leads to the list of them rather than to
                         one. Hidden at zero: a stat button reading 0 invites
                         a click that lands on an empty list. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_cssk_open_comparisons" type="object"
                                class="oe_stat_button" icon="fa-balance-scale"
                                invisible="cssk_comparison_count == 0">
                            <field name="cssk_comparison_count"
                                   widget="statinfo" string="Comparisons"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Historical filing"
                            bg_color="text-bg-info" invisible="not legacy"/>
                    <field name="legacy" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="country_id"/>
                            <field name="version_id"/>
                            <field name="statement_type_id"/>
                            <field name="original_return_id" readonly="1"
                                   invisible="not original_return_id"/>
                            <!-- ⚠️ Required to FILE, so not required on a
                                 record that cannot be filed. datumZisteniaDdp
                                 is mandatory on a dodatočné DP, and this
                                 modifier is right for every return we submit.
                                 A LEGACY return is a transcription of a filing
                                 that already happened: it carries `legacy`,
                                 refuses a state change and a recompute, and is
                                 never submitted from here — but the date was on
                                 the original submission and an importer that
                                 did not receive it has nothing true to write.
                                 Leaving the modifier on made every imported
                                 amendment unsaveable, and since a button press
                                 saves first, unable to run ANY action.
                                 Inventing a plausible date instead would put a
                                 fabricated statutory date on a record an
                                 accountant reads as history, which is worse
                                 than a blank one. -->
                            <field name="discovery_date"
                                   required="original_return_id and not legacy"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="period_type"/>
                            <field name="xml_attachment_id"/>
                            <field name="submitted_attachment_id"
                                   invisible="not submitted_attachment_id"/>
                            <field name="submitted_date"
                                   invisible="not submitted_date"/>
                            <field name="submission_reference"/>
                            <!-- Provenance: only shown on a historical
                                 filing, where "which migration produced this
                                 figure" is the question somebody asks. -->
                            <field name="legacy_source" invisible="not legacy"/>
                            <field name="legacy_reference" invisible="not legacy"/>
                            <field name="filed_history_ids" widget="many2many_tags"
                                   invisible="not filed_history_ids"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <p class="text-muted">
                                Tick <b>Override</b> on a line to enter a manual
                                value (carryover / external lines, or to correct
                                a computed line), then press <b>Compute</b> —
                                overrides are preserved and flow into dependent
                                lines.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom" create="false"
                                      delete="false"
                                      decoration-warning="is_overridden"
                                      decoration-muted="kind == 'aggregate'">
                                    <field name="kind" column_invisible="1"/>
                                    <field name="is_leaf" column_invisible="1"/>
                                    <field name="has_source" column_invisible="1"/>
                                    <field name="code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="value" readonly="1"/>
                                    <field name="formula_note" string="Derivation"
                                           optional="show"
                                           invisible="is_leaf"/>
                                    <field name="source_reconciles" string="✓"
                                           widget="boolean" optional="show"
                                           invisible="not is_leaf"/>
                                    <button name="action_view_source_lines"
                                            type="object" icon="fa-search-plus"
                                            string="Documents"
                                            invisible="not has_source"/>
                                    <field name="is_overridden" widget="boolean_toggle"/>
                                    <field name="manual_value"
                                           readonly="not is_overridden"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cssk_vat_return_action" model="ir.actions.act_window">
        <field name="name">VAT Returns</field>
        <field name="res_model">cssk.vat.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Drill-down target: the journal items behind a tag-based DPH line -->
    <record id="view_move_line_dph_audit" model="ir.ui.view">
        <field name="name">account.move.line.dph.audit</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Source documents" create="false" delete="false"
                  edit="false" default_order="move_id, id">
                <field name="move_id" string="Document"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="name" string="Description"/>
                <field name="date"/>
                <field name="balance" string="Balance" sum="Total"/>
                <field name="tax_tag_ids" widget="many2many_tags"
                       string="Tax tags" optional="show"/>
            </list>
        </field>
    </record>

</odoo>
