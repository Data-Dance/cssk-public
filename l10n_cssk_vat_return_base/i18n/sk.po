#. module: l10n_cssk_vat_return_base
#: model:ir.model.fields,help:l10n_cssk_vat_return_base.field_cssk_vat_return_version__diff_line_code
msgid ""
"Line code of the 'difference vs the last known tax' row an amended "
"(dodatočné) return reports, e.g. 'r36' on the SK DPHv25 form. Auto-filled "
"from the original return on recompute; leave empty if the form has no such "
"row."
msgstr ""

#. module: l10n_cssk_vat_return_base
#: model:ir.model.fields,help:l10n_cssk_vat_return_base.field_cssk_vat_return_version__excess_line_code
msgid ""
"Line code of the period's excess deduction (nadmerný odpočet / nadměrný "
"odpočet), e.g. 'r33' on the SK DPHv25 form. Drives the settlement and the "
"carry-forward cap check; leave empty if the form has no such settlement."
msgstr ""

#. module: l10n_cssk_vat_return_base
#: model:ir.model.fields,help:l10n_cssk_vat_return_base.field_cssk_vat_return_version__own_tax_line_code
msgid ""
"Line code of the period's own tax liability (vlastná daňová povinnosť / "
"vlastní daň), e.g. 'r32' on the SK DPHv25 form. Drives the § 79-style "
"settlement (To pay / (refund)); leave empty if the form has no such "
"settlement."
msgstr ""

