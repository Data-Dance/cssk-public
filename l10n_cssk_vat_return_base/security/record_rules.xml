<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cssk_vat_return_company" model="ir.rule">
        <field name="name">VAT return: multi-company</field>
        <field name="model_id" ref="model_cssk_vat_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cssk_vat_return_line_company" model="ir.rule">
        <field name="name">VAT return line: multi-company</field>
        <field name="model_id" ref="model_cssk_vat_return_line"/>
        <field name="domain_force">[('return_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
