#. module: l10n_sk_hr_payroll_base
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_base/models/hr_employee.py:0
msgid ""
"%(employee)s already taxes the month for %(linked)s, so it cannot be taxed "
"on another record. One record taxes the month for all the others."
msgstr ""

#. module: l10n_sk_hr_payroll_base
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_base/models/hr_employee.py:0
msgid ""
"%(employee)s and %(other)s have different birth numbers, so they are not one"
" taxpayer and cannot be taxed together."
msgstr ""

#. module: l10n_sk_hr_payroll_base
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_base/models/hr_version.py:0
msgid ""
"%(employee)s and %(other)s have the same birth number, so they are one "
"taxpayer at this employer. The taxpayer's declaration can be signed on one "
"of them at a time (§ 36 ods. 6 zákona č. 595/2003 Z. z.), and it is ticked "
"on both for a day they share: from %(start)s on %(employee)s and from "
"%(other_start)s on %(other)s. Untick Tax Declaration Signed on one of the "
"two."
msgstr ""

#. module: l10n_sk_hr_payroll_base
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_base/models/hr_employee.py:0
msgid ""
"%(employee)s can be taxed together only with a record of the same company: "
"the tax of the month is the tax of what one employer pays."
msgstr ""

#. module: l10n_sk_hr_payroll_base
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_base/models/hr_employee.py:0
msgid "%(employee)s cannot be taxed together with itself."
msgstr ""

