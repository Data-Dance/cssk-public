<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_cz_eet2_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <!-- In scope: a contact payment line on an EET-enabled till. Without a
                 POK the sale is still owed (queued, retrying, or the sync has not
                 answered yet) and the receipt says so; a rejected or verification
                 message is not resent by itself, so it prints nothing. -->
            <!-- Same test as the backend: contact lines that net to zero (change,
                 an even exchange) register nothing, so they announce nothing. -->
            <t t-set="eet_contact" t-value="order.config.l10n_cz_eet2_enabled and Math.abs(order.payment_ids.filter((p) => p.payment_method_id.l10n_cz_eet2_contact_payment).reduce((sum, p) => sum + p.amount, 0)) &gt;= 0.005"/>
            <t t-if="order.l10n_cz_eet2_pok">
                <div class="pos-receipt-order-data pt-2">
                    <div><b>EET 2.0</b></div>
                    <div>POK: <t t-esc="order.l10n_cz_eet2_pok"/></div>
                    <t t-if="order.l10n_cz_eet2_is_test">
                        <div>NEPRODUKČNÍ / TEST</div>
                    </t>
                </div>
            </t>
            <t t-elif="eet_contact and order.l10n_cz_eet2_state !== 'rejected' and order.l10n_cz_eet2_state !== 'verified'">
                <div class="pos-receipt-order-data pt-2">
                    <div><b>EET 2.0</b></div>
                    <div>Tržba bude odeslána dodatečně</div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
