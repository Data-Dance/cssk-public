<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_eet2" model="ir.ui.view">
        <field name="name">pos.config.form.eet2</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="after">
                <page string="EET 2.0" name="l10n_cz_eet2_page">
                    <group>
                        <group string="Czech EET 2.0">
                            <field name="l10n_cz_eet2_id_pokl"/>
                            <field name="l10n_cz_eet2_id_jednotky"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
