<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- action_l10n_sk_adopt_dic_participant is re-runnable by design: the
         19.0.2.0.0 migration runs before the DIČs are recorded, and so does
         every partner whose DIČ is typed in after its VAT number. -->
    <record id="action_server_adopt_dic_participant" model="ir.actions.server">
        <field name="name">Peppol: use 0245 + DIČ</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_l10n_sk_adopt_dic_participant()</field>
    </record>
</odoo>
