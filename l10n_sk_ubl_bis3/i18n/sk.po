#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_res_partner__l10n_sk_einvoice_incomplete
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_res_users__l10n_sk_einvoice_incomplete
msgid ""
"A Slovak company whose e-invoice the export would refuse: no DIČ, an "
"incomplete address, or a Company ID that is not an IČO."
msgstr ""
"Slovenská firma, ktorej e-faktúru by export odmietol: chýba DIČ, adresa je "
"neúplná alebo IČO nie je platné IČO."

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_cssk_tax_authority__l10n_sk_peppol_endpoint_derived
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_res_partner__l10n_sk_peppol_endpoint_derived
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_res_users__l10n_sk_peppol_endpoint_derived
msgid ""
"A Slovak contact on 0245 or 9950: its Peppol endpoint is the DIČ or the IČ "
"DPH it already carries, so it is not typed again."
msgstr ""
"Slovenský kontakt na 0245 alebo 9950: jeho koncový bod Peppol je DIČ alebo "
"IČ DPH, ktoré už má, preto sa druhýkrát nezadáva."

#. module: l10n_sk_ubl_bis3
#: model:ir.model,name:l10n_sk_ubl_bis3.model_res_partner
msgid "Contact"
msgstr "Kontakt"

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_account_edi_xml_ubl_sk__display_name
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_partner__display_name
msgid "Display Name"
msgstr "Zobrazovaný názov"

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_partner__l10n_sk_einvoice_incomplete
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_users__l10n_sk_einvoice_incomplete
#: model_terms:ir.ui.view,arch_db:l10n_sk_ubl_bis3.view_res_partner_filter_einvoice_incomplete
msgid "E-invoice would be refused"
msgstr "E-faktúra by bola odmietnutá"

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_account_bank_statement_line__l10n_sk_original_invoice_ref
#: model:ir.model.fields,help:l10n_sk_ubl_bis3.field_account_move__l10n_sk_original_invoice_ref
msgid ""
"For a credit note that was not made from an invoice: the number(s) of the "
"invoice(s) it corrects, separated by commas. They go into the e-invoice as "
"the corrected invoices."
msgstr ""
"Pri dobropise, ktorý nevznikol z faktúry: čísla faktúr, ktoré opravuje, "
"oddelené čiarkou. Do e-faktúry sa zapíšu ako opravované faktúry."

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_account_edi_xml_ubl_sk__id
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_partner__id
msgid "ID"
msgstr "ID"

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_edi_xml_ubl_sk.py:0
msgid ""
"No DIČ is recorded for %(partner)s, so it has no Slovak Peppol participant "
"identifier: EAS 0245 carries the DIČ, and it is currently published as "
"%(eas)s. Set 'DIČ' on the contact — it is not the VAT number and cannot be "
"derived from it."
msgstr ""
"Pre %(partner)s nie je zaznamenané DIČ, preto nemá slovenský identifikátor "
"účastníka Peppol: EAS 0245 nesie DIČ a momentálne je publikovaný ako "
"%(eas)s. Vyplňte na kontakte 'DIČ' — nie je to IČ DPH a nedá sa z neho "
"odvodiť."

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_account_bank_statement_line__l10n_sk_original_invoice_ref
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_account_move__l10n_sk_original_invoice_ref
msgid "Original invoice number(s)"
msgstr "Čísla pôvodných faktúr"

#. module: l10n_sk_ubl_bis3
#: model_terms:ir.ui.view,arch_db:l10n_sk_ubl_bis3.view_partner_property_form_peppol_address
msgid "Peppol Address"
msgstr "Peppol adresa"

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_cssk_tax_authority__l10n_sk_peppol_endpoint_derived
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_partner__l10n_sk_peppol_endpoint_derived
#: model:ir.model.fields,field_description:l10n_sk_ubl_bis3.field_res_users__l10n_sk_peppol_endpoint_derived
msgid "Peppol endpoint from the contact"
msgstr "Koncový bod Peppol z kontaktu"

#. module: l10n_sk_ubl_bis3
#: model:ir.actions.server,name:l10n_sk_ubl_bis3.action_server_adopt_dic_participant
msgid "Peppol: use 0245 + DIČ"
msgstr "Peppol: použiť 0245 + DIČ"

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_edi_xml_ubl_sk.py:0
