msgstr "Dôvod opravy: %(reason)s"

#. module: l10n_sk_ubl_bis3
#: model:ir.model,name:l10n_sk_ubl_bis3.model_account_edi_xml_ubl_sk
msgid "SK Peppol BIS Billing 3.0"
msgstr "SK Peppol BIS Billing 3.0"

#. module: l10n_sk_ubl_bis3
#: model:ir.model.fields.selection,name:l10n_sk_ubl_bis3.selection__res_partner__invoice_edi_format__ubl_bis3_sk
msgid "Slovakia (Peppol BIS 3.0)"
msgstr "Slovensko (Peppol BIS 3.0)"

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_edi_xml_ubl_sk.py:0
msgid ""
"The Company ID of %(partner)s, '%(value)s', is not an IČO: an IČO has 8 "
"digits. Correct it on the contact, or clear it if the contact has none."
msgstr ""
"IČO kontaktu %(partner)s, '%(value)s', nie je IČO: IČO má 8 číslic. Opravte "
"ho na kontakte, alebo ho vymažte, ak kontakt žiadne nemá."

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_edi_xml_ubl_sk.py:0
msgid ""
"The address of %(partner)s is incomplete (missing: %(fields)s). A Slovak "
"invoice must carry the full address of the supplier and of the customer (§ "
"74 ods. 1 of the VAT Act)."
msgstr ""
"Adresa kontaktu %(partner)s je neúplná (chýba: %(fields)s). Slovenská "
"faktúra musí obsahovať úplnú adresu dodávateľa aj odberateľa (§ 74 ods. 1 "
"zákona o DPH)."

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_move.py:0
msgid ""
"This credit note is not linked to an invoice, so the e-invoice will not name"
" the invoice it corrects. Fill in 'Original invoice number(s)'."
msgstr ""
"Tento dobropis nie je prepojený s faktúrou, takže e-faktúra neuvedie "
"faktúru, ktorú opravuje. Vyplňte pole „Čísla pôvodných faktúr“."

#. module: l10n_sk_ubl_bis3
#. odoo-python
#: code:addons/l10n_sk_ubl_bis3/models/account_move.py:0
msgid ""
"This invoice has no bank account, so the e-invoice will not say where to "
"pay. Set 'Recipient Bank' unless the invoice is paid in cash or by card."
msgstr ""
"Faktúra nemá bankový účet, takže e-faktúra neuvedie, kam zaplatiť. Nastavte "
"pole „Banka príjemcu“, ak sa faktúra neplatí v hotovosti alebo kartou."

