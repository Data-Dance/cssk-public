<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_vehicle" model="ir.ui.view">
        <field name="name">res.config.settings.form.l10n.sk.vehicle</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Vehicles and fuel" id="l10n_sk_vehicle_settings"
                       invisible="not l10n_sk_vehicle_is_sk_company">
                    <field name="l10n_sk_vehicle_is_sk_company" invisible="1"/>
                    <setting id="l10n_sk_vehicle_ratios" string="Flat rates"
                             help="Dva nezávislé režimy: DPH podľa § 85n (50 %, 1. 1. 2026 – 30. 6. 2028) a daň z príjmov podľa § 19 ods. 2 písm. l) (80 %).">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_sk_vehicle_vat_ratio" class="col-lg-5 o_light_label"/>
                                <field name="l10n_sk_vehicle_vat_ratio"/>
                            </div>
                            <div class="row">
                                <label for="l10n_sk_fuel_income_ratio" class="col-lg-5 o_light_label"/>
                                <field name="l10n_sk_fuel_income_ratio"/>
                            </div>
                            <div class="row">
                                <label for="l10n_sk_vehicle_nondeductible_account_id" class="col-lg-5 o_light_label"/>
                                <field name="l10n_sk_vehicle_nondeductible_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
