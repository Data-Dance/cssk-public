<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_fuel_split" model="ir.ui.view">
        <field name="name">account.move.form.fuel.split</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_sk_fuel_split" type="object"
                        string="Split fuel"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
