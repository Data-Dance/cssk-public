msgstr ""

#. module: l10n_sk_vehicle_expense
#: model:ir.model.fields,help:l10n_sk_vehicle_expense.field_res_company__l10n_sk_vehicle_vat_ratio
#: model:ir.model.fields,help:l10n_sk_vehicle_expense.field_res_config_settings__l10n_sk_vehicle_vat_ratio
msgid ""
"§ 85n: paušálny odpočet DPH pri osobných vozidlách (M1, L1e, L3e) "
"používaných aj na súkromné účely — 50 % od 1. 1. 2026 do 30. 6. 2028. 100 % "
"odpočet vyžaduje registráciu a elektronickú evidenciu jázd."
msgstr ""
