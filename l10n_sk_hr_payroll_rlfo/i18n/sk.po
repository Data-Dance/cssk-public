"The OOP on the ground of maternity, paternity or parental leave exists on a "
"DoVP or DoPČ only; '%(name)s' has another relationship type."
msgstr ""
"OOP z dôvodu materskej, otcovskej alebo rodičovskej dovolenky existuje len "
"pri DoVP alebo DoPČ; '%(name)s' má iný typ vzťahu."

#. module: l10n_sk_hr_payroll_rlfo
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_rlfo/models/l10n_sk_rlfo.py:0
