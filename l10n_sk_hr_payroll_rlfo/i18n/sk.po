"The OOP of '%(name)s' can be reported on an agreement only (relationship "
"types ZECD1 to ZECD3N)."
msgstr ""
"OOP zamestnanca '%(name)s' možno oznámiť len pri dohode (typy vzťahu ZECD1 "
"až ZECD3N)."

#. module: l10n_sk_hr_payroll_rlfo
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_rlfo/models/l10n_sk_rlfo.py:0
msgid ""
"The OOP on the ground of maternity, paternity or parental leave ('%(name)s')"
" is reported on the RLZEC 2027 form: set the batch to January 2027 or later."
msgstr ""
"OOP z dôvodu materskej, otcovskej alebo rodičovskej dovolenky ('%(name)s') "
"sa oznamuje na vzore RLZEC 2027: nastavte dávku na január 2027 alebo neskôr."

#. module: l10n_sk_hr_payroll_rlfo
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_rlfo/models/l10n_sk_rlfo.py:0
