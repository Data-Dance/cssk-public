<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      RLFO / RLZEC (Registračný list zamestnancov zamestnávateľa) — hromadný
      XML matching the official Sociálna poisťovňa schema RLZEC-v2026.xsd (root
      <spRegListZec>, ns http://socpoist.sk/xsd/rlzec2026,
      elementFormDefault="qualified", attributes unqualified). Registration
      (prihláška, typRL=PA) and de-registration (odhláška, typRL=OD) events,
      and a change (zmena, typRL=ZM) carrying the agreement OOP only. The
      RLZEC 2027 vintage is this template with the namespace remapped; its two
      new elements (uplatnOopMdOdRd, datSkonceniaMdOdRd) are refused for a
      2026 batch before rendering.
    -->
    <template id="rlfo_xml">
        <spRegListZec xmlns="http://socpoist.sk/xsd/rlzec2026">
            <typDoc t-out="typ_doc"/>
            <zamestnavatel>
                <identifikacia>
                    <variabilnySymbol t-out="variabilny_symbol"/>
                    <identifikator>
                        <ico t-out="ico"/>
                    </identifikator>
                    <nazov t-out="nazov"/>
                </identifikacia>
            </zamestnavatel>
            <zoznamRLZec>
                <regListyZec>
                    <t t-foreach="events" t-as="ev">
                        <regListZec t-att-typRL="ev['typ_rl']">
                            <identFO>
                                <rc t-out="ev['rc']"/>
                                <priezvisko t-out="ev['priezvisko']"/>
                                <meno t-out="ev['meno']"/>
                                <datumNarodenia t-if="ev['dat_narodenia']"
                                                t-out="ev['dat_narodenia']"/>
                            </identFO>
                            <typRegListuFO>
                                <prihlaska t-if="ev['typ_rl'] == 'PA'">
                                    <identFODopl>
                                        <zamSUcastou t-out="ev['zam_s_ucastou']"/>
                                        <par7ods2 t-out="'false'"/>
                                        <uplatnOopMdOdRd t-if="ev['uplatn_oop_md_od_rd']" t-out="'true'"/>
                                    </identFODopl>
                                    <typPoistPrihl>
                                        <zecPrihl t-att-typZec="ev['typ_zec']">
                                            <datVznikPoist
                                                t-out="ev['dat_vznik_poist']"/>
                                            <datOznUplatnOop
                                                t-if="ev['dat_ozn_uplatn_oop']"
                                                t-out="ev['dat_ozn_uplatn_oop']"/>
                                        </zecPrihl>
                                    </typPoistPrihl>
                                </prihlaska>
                                <zmena t-if="ev['typ_rl'] == 'ZM'"
                                       t-att-datUplatnenia="ev['dat_uplatnenia']">
                                    <identFODoplZmena t-if="ev['uplatn_oop_md_od_rd']">
                                        <uplatnOopMdOdRd t-out="'true'"/>
                                    </identFODoplZmena>
                                    <typPoistZmena>
                                        <zecZmena t-att-typZec="ev['typ_zec']">
                                            <datOznUplatnOop
                                                t-if="ev['dat_ozn_uplatn_oop']"
                                                t-out="ev['dat_ozn_uplatn_oop']"/>
                                            <datOznUkoncUplatnOop
                                                t-if="ev['dat_ozn_ukonc_uplatn_oop']"
                                                t-out="ev['dat_ozn_ukonc_uplatn_oop']"/>
                                            <datSkonceniaMdOdRd
                                                t-if="ev['dat_skoncenia_md_od_rd']"
                                                t-out="ev['dat_skoncenia_md_od_rd']"/>
                                        </zecZmena>
                                    </typPoistZmena>
                                </zmena>
                                <odhlaska t-if="ev['typ_rl'] == 'OD'">
                                    <typPoistOdhl>
                                        <zecDOdhl t-if="ev['is_dohoda']"
                                                  t-att-typZec="ev['typ_zec']">
                                            <zanik
                                                t-att-datVzniku="ev['dat_vzniku']"
                                                t-att-datZaniku="ev['dat_zaniku']"/>
                                        </zecDOdhl>
                                        <zecNPOdhl t-if="not ev['is_dohoda'] and ev['is_zecn']">
                                            <zanik
                                                t-att-datVzniku="ev['dat_vzniku']"
                                                t-att-datZaniku="ev['dat_zaniku']"/>
                                        </zecNPOdhl>
                                        <zecPPOdhl t-if="not ev['is_dohoda'] and not ev['is_zecn']"
                                                   t-att-typZec="ev['typ_zec']">
                                            <zanik
                                                t-att-datVzniku="ev['dat_vzniku']"
                                                t-att-datZaniku="ev['dat_zaniku']"/>
                                        </zecPPOdhl>
                                    </typPoistOdhl>
                                </odhlaska>
                            </typRegListuFO>
                        </regListZec>
                    </t>
                </regListyZec>
            </zoznamRLZec>
            <vystavenie>
                <zostavil t-out="fo['zostavil']"/>
                <tel t-out="fo['tel']"/>
                <mail t-out="fo['mail']"/>
                <datumVyst t-out="datum_vystavenia"/>
            </vystavenie>
        </spRegListZec>
    </template>
</odoo>
