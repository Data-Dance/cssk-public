<odoo>
    <!-- A tile belongs to one company: show only the companies the user has
         selected in the company switcher. -->
    <record id="payroll_kpi_rule_company" model="ir.rule">
        <field name="name">Payroll KPI: multi-company</field>
        <field name="model_id" ref="model_payroll_kpi" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
