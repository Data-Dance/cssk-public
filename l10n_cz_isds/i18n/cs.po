#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid ""
"%(company)s has no data box certificate: upload it on the company's Data box "
"tab."
msgstr ""
"%(company)s nemá certifikát datové schránky: nahrajte ho na záložce firmy "
"Datová schránka."

#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid ""
"%(company)s has no data box login: fill it in on the company's Data box tab."
msgstr ""
"%(company)s nemá přihlašovací údaje k datové schránce: vyplňte je na záložce "
"firmy Datová schránka."

#. module: l10n_cz_isds
#: model:ir.model.fields,help:l10n_cz_isds.field_res_company__l10n_cz_isds_p12
msgid ""
"A commercial certificate with its private key (PostSignum, I.CA, eIdentity), "
"registered for the data box or its user."
msgstr ""
"Komerční certifikát se soukromým klíčem (PostSignum, I.CA, eIdentity), "
"registrovaný pro datovou schránku nebo jejího uživatele."

