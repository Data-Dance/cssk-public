#. module: l10n_cz_isds
#: model:ir.model.fields.selection,name:l10n_cz_isds.selection__res_company__l10n_cz_isds_auth__password
msgid "Login and password"
msgstr "Meno a heslo"

#. module: l10n_cz_isds
#: model:ir.model.fields,help:l10n_cz_isds.field_res_company__l10n_cz_isds_auth
msgid ""
"Login and password: a data box user. Login, password and certificate: a data "
"box user whose login also requires the commercial certificate below. System "
"certificate: a commercial certificate the box's administrator registered on "
"the box for an external application; no login or password, so nothing breaks "
"when a person's password changes."
msgstr ""
"Meno a heslo: používateľ dátovej schránky. Meno, heslo a certifikát: "
"používateľ dátovej schránky, ktorého prihlásenie navyše vyžaduje komerčný "
"certifikát nižšie. Systémový certifikát: komerčný certifikát, ktorý "
"administrátor schránky zaregistroval pre externú aplikáciu; bez mena a "
"hesla, takže sa nič nepokazí, keď sa niečie heslo zmení."

#. module: l10n_cz_isds
#: model:ir.model.fields.selection,name:l10n_cz_isds.selection__res_company__l10n_cz_isds_auth__password_cert
msgid "Login, password and certificate"
msgstr "Meno, heslo a certifikát"

#. module: l10n_cz_isds
#: model:ir.model.fields.selection,name:l10n_cz_isds.selection__res_company__l10n_cz_isds_environment__production
msgid "Production (datovka.gov.cz)"
msgstr "Produkcia (datovka.gov.cz)"

#. module: l10n_cz_isds
#: model_terms:ir.ui.view,arch_db:l10n_cz_isds.res_company_view_form_cz_isds
msgid "Sign in to the data box and show whose it is. Sends nothing."
msgstr "Prihlási sa do dátovej schránky a ukáže, čia je. Nič neposiela."

#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid "Signed in to data box %(box)s (%(name)s)."
msgstr "Prihlásené do dátovej schránky %(box)s (%(name)s)."

#. module: l10n_cz_isds
#: model:ir.model.fields.selection,name:l10n_cz_isds.selection__res_company__l10n_cz_isds_auth__system_cert
msgid "System certificate (no password)"
msgstr "Systémový certifikát (bez hesla)"

#. module: l10n_cz_isds
#: model:ir.model.fields.selection,name:l10n_cz_isds.selection__res_company__l10n_cz_isds_environment__test
msgid "Test (datovka-test.gov.cz)"
msgstr "Test (datovka-test.gov.cz)"

#. module: l10n_cz_isds
#: model_terms:ir.ui.view,arch_db:l10n_cz_isds.res_company_view_form_cz_isds
msgid "Test Connection"
msgstr "Test pripojenia"

#. module: l10n_cz_isds
#: model:ir.model.fields,help:l10n_cz_isds.field_res_company__l10n_cz_isds_environment
msgid ""
"Test: the operator's test environment, with test boxes and no legal effect; "
"production boxes cannot be reached from it. Production: the company's real "
"data box."
msgstr ""
"Test: testovacie prostredie prevádzkovateľa s testovacími schránkami a bez "
"právnych účinkov; produkčné schránky z neho nie sú dostupné. Produkcia: "
"skutočná dátová schránka firmy."

#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid "The data box certificate cannot be opened: %(error)s"
msgstr "Certifikát dátovej schránky nemožno otvoriť: %(error)s"

#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid "The data box certificate expired on %(date)s."
msgstr "Platnosť certifikátu dátovej schránky skončila %(date)s."

#. module: l10n_cz_isds
#: model:ir.model.fields,help:l10n_cz_isds.field_res_company__l10n_cz_isds_login
msgid ""
"The login of a data box user allowed to send messages, preferably one "
"created for this purpose."
msgstr ""
"Prihlasovacie meno používateľa dátovej schránky s právom posielať správy, "
"najlepšie založeného práve na to."
