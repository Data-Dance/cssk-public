#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid ""
"%(company)s has no data box certificate: upload it on the company's Data box "
"tab."
msgstr ""
"%(company)s nemá certifikát dátovej schránky: nahrajte ho na záložke firmy "
"Dátová schránka."

#. module: l10n_cz_isds
#. odoo-python
#: code:addons/l10n_cz_isds/models/res_company.py:0
msgid ""
"%(company)s has no data box login: fill it in on the company's Data box tab."
msgstr ""
"%(company)s nemá prihlasovacie údaje k dátovej schránke: vyplňte ich na "
"záložke firmy Dátová schránka."

#. module: l10n_cz_isds
#: model:ir.model.fields,help:l10n_cz_isds.field_res_company__l10n_cz_isds_p12
msgid ""
"A commercial certificate with its private key (PostSignum, I.CA, eIdentity), "
"registered for the data box or its user."
msgstr ""
"Komerčný certifikát so súkromným kľúčom (PostSignum, I.CA, eIdentity), "
"registrovaný pre dátovú schránku alebo jej používateľa."

