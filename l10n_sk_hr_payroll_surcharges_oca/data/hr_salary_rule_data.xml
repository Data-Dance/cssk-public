        <field name="code">PRIPLATOK_STAZENY</field>
        <field name="sequence">66</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip._l10n_sk_surcharge_hours('STAZENY') &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip._l10n_sk_surcharge_amount('STAZENY')
