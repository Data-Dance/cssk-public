    </record>

    <!-- =========================================================== STANDBY -->
    <record id="l10n_sk_priplatok_pohotovost" model="hr.salary.rule">
        <field name="category_id" ref="l10n_sk_hr_payroll_oca.ALW"/>
        <field name="name">Standby Compensation</field>
        <field name="code">PRIPLATOK_POHOTOVOST</field>
        <field name="sequence">67</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip._l10n_sk_surcharge_hours('POHOTOVOST') &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip._l10n_sk_surcharge_amount('POHOTOVOST')
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="input_ids" eval="[(0, 0, {'name': 'Inactive standby hours (off site)', 'code': 'POHOTOVOST'})]"/>
    </record>

    <!-- ================================================ MINIMUM WAGE CLAIM -->
    <!-- § 120 ods. 1 a 3 — doplatok do minimálneho mzdového nároku for the
         job's stupeň náročnosti. The comparison is made on categories.BASIC
         alone: every surcharge above, the overtime pay and the wage
         replacements sit in ALW and § 120 ods. 3 keeps all of them out of the
         comparison, which is precisely what stops a night-shift surcharge from
         papering over a sub-minimum base wage. -->
    <record id="l10n_sk_min_wage_topup" model="hr.salary.rule">
        <field name="category_id" ref="l10n_sk_hr_payroll_oca.ALW"/>
        <field name="name">Minimum Wage Top-up</field>
        <field name="code">MIN_WAGE_TOPUP</field>
        <field name="sequence">75</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip._l10n_sk_min_wage_topup(categories.BASIC) &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip._l10n_sk_min_wage_topup(categories.BASIC)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- Attach every rule above to the Slovak structure. -->
    <record id="l10n_sk_hr_payroll_oca.hr_payroll_structure_sk_employee_salary" model="hr.payroll.structure">
        <field name="rule_ids" eval="[(4, ref('l10n_sk_priplatok_noc')),
                                      (4, ref('l10n_sk_priplatok_sobota')),
                                      (4, ref('l10n_sk_priplatok_nedela')),
                                      (4, ref('l10n_sk_priplatok_sviatok')),
                                      (4, ref('l10n_sk_nadcas_mzda')),
                                      (4, ref('l10n_sk_priplatok_nadcas')),
                                      (4, ref('l10n_sk_priplatok_stazeny')),
                                      (4, ref('l10n_sk_priplatok_pohotovost')),
                                      (4, ref('l10n_sk_min_wage_topup'))]"/>
    </record>
</odoo>
