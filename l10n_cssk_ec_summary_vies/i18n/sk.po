#. module: l10n_cssk_ec_summary_vies
#: model:ir.model,name:l10n_cssk_ec_summary_vies.model_cssk_ec_summary_statement
msgid "EC Sales List"
msgstr "Súhrnný výkaz"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model,name:l10n_cssk_ec_summary_vies.model_cssk_ec_summary_statement_line
msgid "EC Sales List Line"
msgstr "Riadok súhrnného výkazu"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.module.module,shortdesc:base.module_l10n_cssk_ec_summary_vies
msgid "CZ/SK EC Sales List — VIES proof"
msgstr "CZ/SK súhrnný výkaz — doklad z VIES"

#. module: l10n_cssk_ec_summary_vies
#. odoo-python
#: code:addons/l10n_cssk_ec_summary_vies/models/cssk_ec_summary_statement.py:0
msgid "Compute the statement before exporting."
msgstr "Pred exportom výkaz vypočítajte."

#. module: l10n_cssk_ec_summary_vies
#. odoo-python
#: code:addons/l10n_cssk_ec_summary_vies/models/cssk_ec_summary_statement.py:0
msgid "EC sales list export blocked"
msgstr "Export súhrnného výkazu je zablokovaný"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields.selection,name:l10n_cssk_ec_summary_vies.selection__cssk_ec_summary_statement_line__vies_status__invalid
msgid "Invalid"
msgstr "Neplatné"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,help:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement_line__vies_status
msgid ""
"Outcome of the last direct VIES check of this line: 'Service fault' means "
"VIES was unreachable (tolerated at export so an outage cannot block a "
"statutory deadline)."
msgstr ""
"Výsledok poslednej priamej kontroly tohto riadku vo VIES: „Porucha "
"služby“ znamená, že VIES bol nedostupný (pri exporte sa toleruje, "
"aby výpadok nezablokoval zákonnú lehotu)."

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields.selection,name:l10n_cssk_ec_summary_vies.selection__cssk_ec_summary_statement_line__vies_status__fault
msgid "Service fault"
msgstr "Porucha služby"

#. module: l10n_cssk_ec_summary_vies
#. odoo-python
#: code:addons/l10n_cssk_ec_summary_vies/models/cssk_ec_summary_statement.py:0
msgid "The VIES consultation numbers obtained for the valid lines were kept."
msgstr "Konzultačné čísla VIES získané pre platné riadky boli uchované."

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,help:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement__vies_blocked
msgid ""
"The last VIES verification found INVALID VAT numbers on this statement; the "
"export stays blocked until they are corrected and re-checked."
msgstr ""
"Posledné overenie vo VIES našlo na tomto výkaze NEPLATNÉ IČ DPH; "
"export zostáva zablokovaný, kým sa neopravia a znova neoveria."

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,field_description:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement__vies_blocked
msgid "VIES Blocked"
msgstr "Zablokované VIES"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,field_description:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement_line__vies_check_date
msgid "VIES Checked On"
msgstr "VIES overený dňa"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,field_description:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement_line__vies_consultation_number
msgid "VIES Consultation No."
msgstr "Konzultačné číslo VIES"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,field_description:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement_line__vies_status
msgid "VIES Status"
msgstr "Stav VIES"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields,field_description:l10n_cssk_ec_summary_vies.field_cssk_ec_summary_statement_line__vies_valid
msgid "VIES Valid"
msgstr "Platné vo VIES"

#. module: l10n_cssk_ec_summary_vies
#. odoo-python
#: code:addons/l10n_cssk_ec_summary_vies/models/cssk_ec_summary_statement.py:0
msgid ""
"VIES could not be reached for %(count)s line(s); they were exported without a fresh confirmation. Repeat the check when the service is available:\n"
"%(vats)s"
msgstr ""
"VIES nebol dostupný pre %(count)s riadok(ov); boli exportované bez "
"čerstvého potvrdenia. Keď bude služba dostupná, kontrolu "
"zopakujte:\n"
"%(vats)s"

#. module: l10n_cssk_ec_summary_vies
#. odoo-python
#: code:addons/l10n_cssk_ec_summary_vies/models/cssk_ec_summary_statement.py:0
msgid ""
"VIES reports these VAT numbers as INVALID — the EC sales list cannot be exported (a filing with an invalid VAT is penalised):\n"
"%s"
msgstr ""
"VIES hlási tieto IČ DPH ako NEPLATNÉ — súhrnný výkaz nemožno "
"exportovať (podanie s neplatným IČ DPH je sankcionované):\n"
"%s"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.model.fields.selection,name:l10n_cssk_ec_summary_vies.selection__cssk_ec_summary_statement_line__vies_status__valid
msgid "Valid"
msgstr "Platné"

#. module: l10n_cssk_ec_summary_vies
#: model:ir.module.module,summary:base.module_l10n_cssk_ec_summary_vies
msgid ""
"Validate EC sales list partners against VIES at export and snapshot the "
"consultation number onto each line."
msgstr ""
"Pri exporte overí partnerov súhrnného výkazu voči VIES a na každý "
"riadok zaznamená konzultačné číslo."