msgid "%(created)s new document(s) imported."
msgstr "Importované nové doklady: %(created)s."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid ""
"%(created)s new document(s); %(errored)s inbound message(s) are in error — "
"open EDI Messages to see why."
msgstr ""
"Nové doklady: %(created)s; prijaté správy s chybou: %(errored)s — príčinu "
"zistíte v EDI správach."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s exists on the network but does not advertise the Peppol BIS "
"Billing 3.0 invoice and credit note types. Sending will be refused."
msgstr ""
"%(participant)s existuje v sieti, ale neuvádza typy faktúry a dobropisu "
"Peppol BIS Billing 3.0. Odoslanie bude odmietnuté."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s is not registered in the Peppol directory, so Peppol cannot "
"deliver to it. Check the EAS scheme and the endpoint value — a Slovak DIČ is"
" scheme 0245, an IČ DPH is 9950 — or ask the counterparty for their Peppol "
"address."
msgstr ""
"%(participant)s nie je zaregistrovaný v adresári Peppol, preto mu Peppol "
"nemôže doručiť. Skontrolujte schému EAS a hodnotu koncového bodu — slovenské"
" DIČ má schému 0245, IČ DPH 9950 — alebo si vyžiadajte Peppol adresu od "
"protistrany."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s is registered and accepts Peppol BIS Billing 3.0 invoices "
"and credit notes."
msgstr ""
"%(participant)s je zaregistrovaný a prijíma faktúry a dobropisy Peppol BIS "
"Billing 3.0."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%s has no Peppol address. Set both the Peppol e-address (EAS) and the Peppol"
" Endpoint before checking."
msgstr ""
"%s nemá Peppol adresu. Pred kontrolou nastavte Peppol e-adresu (EAS) aj "
"Peppol koncový bod."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/epostak_connector.py:0
msgid ""
"%s is not a Peppol participant identifier (expected scheme:value, e.g. "
"0245:2121576435)."
msgstr ""
"%s nie je identifikátor účastníka Peppol (očakáva sa schéma:hodnota, napr. "
"0245:2121576435)."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid "(The provider reports the participant as not network-ready.)"
msgstr "(Poskytovateľ hlási, že účastník nie je pripravený v sieti.)"

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "(no Peppol address set)"
msgstr "(Peppol adresa nie je nastavená)"

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "(unnamed)"
msgstr "(bez názvu)"

#. module: edi_epostak_connector_sapi
#: model:ir.model.fields,help:edi_epostak_connector_sapi.field_res_config_settings__epostak_inbound_fail_activity_after
msgid ""
"After this many consecutive inbound poll failures, raise a to-do for the EDI"
" manager (or the admin) so someone is told even if nobody opens this page. "
"It is closed automatically when polling succeeds again. Set to 0 to never "
"raise one."
msgstr ""
"Po tomto počte po sebe idúcich zlyhaní vyzdvihovania prijatých dokladov sa "
"vytvorí aktivita To-Do pre správcu EDI (alebo administrátora), aby sa to "
"niekto dozvedel, aj keď túto stránku nikto neotvorí. Keď vyzdvihovanie znova"
" uspeje, uzavrie sa automaticky. Hodnota 0 ju nevytvorí nikdy."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid ""
"Authenticated against %(url)s as participant %(pid)s. These companies also "
"allow e-invoicing but have no ePošťák credentials of their own, so they "
"neither send nor collect: %(others)s. Switch to each company and fill in its"
" own on this page."
msgstr ""
"Overené voči %(url)s ako účastník %(pid)s. Tieto spoločnosti tiež povoľujú "
"e-fakturáciu, ale nemajú vlastné prihlasovacie údaje k ePošťáku, preto "
"neodosielajú ani nevyzdvihujú: %(others)s. Prepnite sa do každej z nich a na"
" tejto stránke vyplňte jej vlastné."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "Authenticated against %(url)s as participant %(pid)s.%(firm)s"
msgstr "Overené voči %(url)s ako účastník %(pid)s.%(firm)s"

