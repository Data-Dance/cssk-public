#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid ""
"\n"
"Acting for firm %s."
msgstr ""
"\n"
"Jedná se za firmu %s."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "%(created)s new document(s) imported."
msgstr "Importováno nových dokladů: %(created)s."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid ""
"%(created)s new document(s); %(errored)s inbound message(s) are in error — "
"open EDI Messages to see why."
msgstr ""
"Nových dokladů: %(created)s; příchozích zpráv v chybě: %(errored)s — důvod "
"najdete v EDI zprávách."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s exists on the network but does not advertise the Peppol BIS "
"Billing 3.0 invoice and credit note types. Sending will be refused."
msgstr ""
"%(participant)s v síti existuje, ale neuvádí typy faktura a dobropis Peppol "
"BIS Billing 3.0. Odeslání bude odmítnuto."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s is not registered in the Peppol directory, so Peppol cannot "
"deliver to it. Check the EAS scheme and the endpoint value — a Slovak DIČ is"
" scheme 0245, an IČ DPH is 9950 — or ask the counterparty for their Peppol "
"address."
msgstr ""
"%(participant)s není zapsán v adresáři Peppol, takže mu Peppol nemůže "
"doručit. Zkontrolujte schéma EAS a hodnotu koncového bodu — slovenské DIČ má"
" schéma 0245, IČ DPH 9950 — nebo si vyžádejte Peppol adresu od protistrany."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%(participant)s is registered and accepts Peppol BIS Billing 3.0 invoices "
"and credit notes."
msgstr ""
"%(participant)s je zaregistrován a přijímá faktury a dobropisy Peppol BIS "
"Billing 3.0."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid ""
"%s has no Peppol address. Set both the Peppol e-address (EAS) and the Peppol"
" Endpoint before checking."
msgstr ""
"%s nemá Peppol adresu. Před kontrolou nastavte Peppol e-adresu (EAS) i "
"Peppol koncový bod."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/epostak_connector.py:0
msgid ""
"%s is not a Peppol participant identifier (expected scheme:value, e.g. "
"0245:2121576435)."
msgstr ""
"%s není identifikátor účastníka Peppol (očekává se schéma:hodnota, např. "
"0245:2121576435)."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_partner.py:0
msgid "(The provider reports the participant as not network-ready.)"
msgstr "(Poskytovatel hlásí, že účastník není připraven v síti.)"

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "(no Peppol address set)"
msgstr "(není nastavena Peppol adresa)"

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "(unnamed)"
msgstr "(bez názvu)"

#. module: edi_epostak_connector_sapi
#: model:ir.model.fields,help:edi_epostak_connector_sapi.field_res_config_settings__epostak_inbound_fail_activity_after
msgid ""
"After this many consecutive inbound poll failures, raise a to-do for the EDI"
" manager (or the admin) so someone is told even if nobody opens this page. "
"It is closed automatically when polling succeeds again. Set to 0 to never "
"raise one."
msgstr ""
"Po tolika po sobě jdoucích neúspěšných staženích příchozích dokladů vytvořit"
" úkol pro správce EDI (nebo administrátora), aby se o tom někdo dozvěděl, i "
"když tuto stránku nikdo neotevře. Úkol se uzavře automaticky, jakmile "
"stahování opět uspěje. Hodnota 0 úkol nikdy nevytvoří."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid ""
"Authenticated against %(url)s as participant %(pid)s. These companies also "
"allow e-invoicing but have no ePošťák credentials of their own, so they "
"neither send nor collect: %(others)s. Switch to each company and fill in its"
" own on this page."
msgstr ""
"Ověřeno vůči %(url)s jako účastník %(pid)s. Tyto společnosti také povolují "
"e-fakturaci, ale nemají vlastní přístupové údaje k ePošťáku, proto "
"neodesílají ani nevyzvedávají: %(others)s. Přepněte se do každé z nich a na "
"této stránce vyplňte její vlastní."

#. module: edi_epostak_connector_sapi
#. odoo-python
#: code:addons/edi_epostak_connector_sapi/models/res_config_settings.py:0
msgid "Authenticated against %(url)s as participant %(pid)s.%(firm)s"
msgstr "Ověřeno vůči %(url)s jako účastník %(pid)s.%(firm)s"

