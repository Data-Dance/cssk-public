#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Base the correction on the latest retained filing for this company and year."
msgstr "Opravu pripravte z posledného uchovaného podania tejto firmy a roka."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields.selection,name:l10n_sk_vehicle_tax.selection__l10n_sk_vehicle_tax_line__propulsion__cng
