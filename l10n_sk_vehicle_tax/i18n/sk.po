#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Choose a retained filed vehicle tax return before preparing a correction."
msgstr ""
"Pred prípravou opravy vyberte uchované podané priznanie k dani z vozidiel."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Choose the retained filed return for the same company and year before "
"preparing a correction."
msgstr ""
"Pred prípravou opravy vyberte uchované podané priznanie tej istej firmy a "
"roka."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "Choose the vehicle tax return before adding technical facts."
msgstr ""
"Pred pridaním technických podkladov vyberte priznanie k dani z vozidiel."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields.selection,name:l10n_sk_vehicle_tax.selection__l10n_sk_vehicle_tax_line__propulsion__combustion
msgid "Combustion"
msgstr "Spaľovací"

