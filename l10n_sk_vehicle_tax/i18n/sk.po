#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"A calculated vehicle tax return retains this form edition. Create a new "
"edition instead."
msgstr ""
"Vypočítané priznanie uchováva túto verziu formulára. Vytvorte novú verziu."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "A filed return is immutable. Create a correction."
msgstr ""
"Podané priznanie musí zostať zachované. Vytvorte opravné alebo dodatočné "
"priznanie."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"A filed vehicle tax return is immutable. Create a separate corrective "
"return."
msgstr ""
"Podané priznanie k dani z vozidiel musí zostať zachované. Vytvorte "
"samostatné opravné alebo dodatočné priznanie."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"A regular return cannot replace another filing. Select the corrective filing"
" type."
msgstr ""
"Riadne priznanie nemôže nahrádzať iné podanie. Vyberte opravné priznanie."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
#: model:ir.model.constraint,message:l10n_sk_vehicle_tax.constraint_l10n_sk_vehicle_tax_return_one_regular_filing
msgid ""
"A regular vehicle tax return is already filed for this company and year. "
"Prepare a correction of that filing."
msgstr ""
"Za túto firmu a rok už je zaevidované riadne priznanie k dani z vozidiel. "
"Pripravte opravu tohto podania."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "A retained vehicle tax filing cannot be deleted."
msgstr "Uchované podanie dane z vozidiel nemožno vymazať."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "A tax measurement or amount cannot be a boolean."
msgstr "Technický údaj ani suma dane nemôžu byť logická hodnota áno/nie."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "A vehicle difference must refer to the selected previous filed return."
msgstr ""
"Rozdiel za vozidlo musí odkazovať na zvolené predchádzajúce podané "
"priznanie."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,field_description:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__message_needaction
msgid "Action Needed"
msgstr "Potrebná akcia"

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,help:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__filing_evidence
msgid "Actual filing confirmation; export alone does not prove delivery."
msgstr "Skutočné potvrdenie podania; samotný export nepreukazuje doručenie."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,field_description:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__advances_paid
msgid "Actually paid advances"
msgstr "Skutočne zaplatené preddavky"

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Add a new vehicle line instead of reassigning its retained fleet identity."
msgstr ""
"Namiesto zmeny uchovanej identity vozidla pridajte nový riadok vozidla."

#. module: l10n_sk_vehicle_tax
#: model_terms:ir.ui.view,arch_db:l10n_sk_vehicle_tax.vehicle_tax_form
msgid "Add company fleet vehicles"
msgstr "Pridať firemné vozidlá"

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Add the reviewed taxable vehicles, including electric vehicles with zero "
"tax."
msgstr ""
"Pridajte overené vozidlá podliehajúce dani vrátane elektromobilov s nulovou "
"daňou."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields.selection,name:l10n_sk_vehicle_tax.selection__l10n_sk_vehicle_tax_return__filing_type__additional
msgid "Additional"
msgstr "Dodatočné"

#. module: l10n_sk_vehicle_tax
#: model_terms:ir.ui.view,arch_db:l10n_sk_vehicle_tax.vehicle_tax_form
msgid "Advances and projected tax"
msgstr "Preddavky a predpokladaná daň"

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"After the ordinary filing deadline use an additional return with the "
"discovery date."
msgstr ""
"Po riadnej lehote podania použite dodatočné priznanie s dátumom zistenia "
"skutočnosti."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,field_description:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__amount_to_pay
msgid "Amount To Pay"
msgstr "Suma na úhradu"

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"An L or M1 combustion/hybrid vehicle requires documented cylinder capacity."
msgstr ""
"Vozidlo L alebo M1 so spaľovacím či hybridným pohonom vyžaduje doložený "
"zdvihový objem."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"An N1 vehicle needs documented axles and maximum permissible mass up to 3500"
" kg."
msgstr ""
"Vozidlo N1 vyžaduje doložený počet náprav a najväčšiu prípustnú hmotnosť do "
"3500 kg."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "An N1 vehicle requires its documented maximum permissible mass."
msgstr ""
"Vozidlo N1 vyžaduje najväčšiu prípustnú hmotnosť doloženú technickým "
"dokladom."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"An additional return retains the original paid advances; later tax payments "
"are not new advances."
msgstr ""
"Dodatočné priznanie zachováva pôvodné zaplatené preddavky. Neskoršia platba "
"dane nie je novým preddavkom."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "An electric vehicle requires its documented motor power."
msgstr "Elektromobil vyžaduje výkon motora doložený technickým dokladom."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"An overpayment repayment request requires a positive calculated overpayment."
msgstr "Žiadosť o vrátenie preplatku vyžaduje kladný vypočítaný preplatok."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid "An unbounded statutory band must be last."
msgstr "Zákonné pásmo bez hornej hranice musí byť posledné."

#. module: l10n_sk_vehicle_tax
#: model:ir.model,name:l10n_sk_vehicle_tax.model_ir_attachment
msgid "Attachment"
msgstr "Príloha"

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,field_description:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__message_attachment_count
msgid "Attachment Count"
