#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Complete removal of an erroneous liability requires a reviewed previous "
"vehicle in an additional return."
msgstr ""
"Úplné odstránenie chybnej povinnosti vyžaduje overené pôvodné vozidlo v "
"dodatočnom priznaní."

#. module: l10n_sk_vehicle_tax
#. odoo-python
#: code:addons/l10n_sk_vehicle_tax/models/vehicle_tax.py:0
msgid ""
"Complete the company DIČ and registered address before calculating vehicle "
"tax."
msgstr "Pred výpočtom dane z vozidiel doplňte DIČ a sídlo firmy."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields,help:l10n_sk_vehicle_tax.field_l10n_sk_vehicle_tax_return__cssk_export_warnings
msgid ""
"Content checks that did not block the last export but need a look before "
"filing, one per line. Refreshed on every export; empty when the last export "
"raised none."
msgstr ""
"Kontroly obsahu, ktoré posledný export nezablokovali, ale pred podaním si "
"ich treba pozrieť, každá na samostatnom riadku. Obnovujú sa pri každom "
"exporte; prázdne, ak posledný export žiadne nenašiel."

#. module: l10n_sk_vehicle_tax
#: model:ir.model.fields.selection,name:l10n_sk_vehicle_tax.selection__l10n_sk_vehicle_tax_return__filing_type__corrective
