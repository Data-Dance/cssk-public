<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cssk_payroll_declaration_version_list" model="ir.ui.view">
        <field name="name">cssk.payroll.declaration.version.list</field>
        <field name="model">cssk.payroll.declaration.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="xml_root_element"/>
            </list>
        </field>
    </record>

    <record id="view_cssk_payroll_declaration_version_form" model="ir.ui.view">
        <field name="name">cssk.payroll.declaration.version.form</field>
        <field name="model">cssk.payroll.declaration.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="xml_root_element"/>
                            <field name="xml_template_ref_id"/>
                            <field name="xml_schema_module"/>
                            <field name="xml_schema_filename"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cssk_payroll_declaration_version" model="ir.actions.act_window">
        <field name="name">Declaration Versions</field>
        <field name="res_model">cssk.payroll.declaration.version</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
