msgstr "Zadajte konečnú nezápornú sumu dane"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Enter a finite tax amount"
msgstr "Zadajte konečnú sumu dane"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Enter both exact partial-month dates"
msgstr "Zadajte oba presné dátumy neúplného mesiaca"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax_source__euro_quote
msgid "Euro Quote"
msgstr "Kurz: jednotky meny za jedno euro"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,help:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__filed_history_ids
msgid ""
"Every XML that was ever marked submitted for this filing. 'Filed XML' is the"
" latest one; after a reset → recompute → resubmit cycle the previously-filed"
" copies stay reachable here."
msgstr ""
"Každé XML, ktoré bolo pre toto podanie kedy označené ako podané. „Podané "
"XML“ je to najnovšie; po cykle vrátenie → prepočet → opätovné podanie tu "
"zostávajú dostupné aj predchádzajúce podané kópie."

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__period_from
msgid "Exact period from"
msgstr "Presné obdobie od"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__period_to
msgid "Exact period to"
