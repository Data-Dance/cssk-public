#. module: l10n_sk_transaction_tax
#: model_terms:ir.ui.view,arch_db:l10n_sk_transaction_tax.dft_form
msgid "Check earlier recharges"
msgstr "Overiť skoršie preúčtované transakcie"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Choose the IBAN or the foreign non-IBAN refund destination, not both"
msgstr "Vyberte účet IBAN alebo zahraničný účet bez IBAN, nie oba"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax_source__classification_reference
msgid "Classification Reference"
msgstr "Podklad zaradenia"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields.selection,name:l10n_sk_transaction_tax.selection__l10n_sk_transaction_tax_source__kind__bank_collected
