#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax_source__company_id
msgid "Company"
msgstr "Spoločnosť"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__cssk_comparison_count
msgid "Comparisons"
msgstr "Porovnania"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Complete the payer name and registered address"
msgstr "Doplňte názov platiteľa a adresu sídla"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/models/dft.py:0
msgid "Compute the DFT notice before posting its tax."
msgstr "Pred zaúčtovaním dane vypočítajte oznámenie DFT."

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,help:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__cssk_export_warnings
msgid ""
"Content checks that did not block the last export but need a look before "
"filing, one per line. Refreshed on every export; empty when the last export "
"raised none."
msgstr ""
"Kontroly obsahu, ktoré posledný export nezablokovali, ale pred podaním si "
"ich treba pozrieť, každá na samostatnom riadku. Obnovujú sa pri každom "
"exporte; prázdne, ak posledný export žiadne nenašiel."

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/models/dft.py:0
msgid "Correct filed DFT through a separate correction notice."
msgstr "Podanú DFT opravte samostatným opravným alebo dodatočným oznámením."

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Correct inconsistent historical recharge classifications first"
msgstr "Najprv opravte nezhodné historické zaradenie preúčtovaných transakcií"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid ""
"Correct the historical recharge classification before using the same "
"transaction again"
msgstr ""
"Pred opätovným použitím transakcie opravte historické zaradenie preúčtovania"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid ""
"Correct the previously filed identified recharge tax before applying its "
"remaining cap"
msgstr ""
"Pred použitím zostávajúceho limitu opravte skoršiu podanú daň "
"identifikovaného preúčtovania"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields.selection,name:l10n_sk_transaction_tax.selection__l10n_sk_transaction_tax__filing_type__corrective
msgid "Corrective"
msgstr "Opravné"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/models/dft.py:0
msgid "Create a separate correction instead of replacing a filed DFT notice."
msgstr ""
"Vytvorte samostatnú opravu namiesto nahradenia podaného oznámenia DFT."

#. module: l10n_sk_transaction_tax
#: model_terms:ir.ui.view,arch_db:l10n_sk_transaction_tax.dft_form
