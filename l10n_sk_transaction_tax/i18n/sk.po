msgstr "Daň vybratá bankou"

#. module: l10n_sk_transaction_tax
#: model:ir.model,name:l10n_sk_transaction_tax.model_res_company
msgid "Companies"
msgstr "Spoločnosti"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__company_id
