#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/models/dft.py:0
msgid ""
"Current DFT sources differ from the retained export. Review whether a "
"separate correction is required; the exported or filed copy is unchanged."
msgstr ""
"Aktuálne zdroje DFT sa líšia od uchovaného exportu. Overte potrebu "
"samostatnej opravy; exportovaná alebo podaná kópia sa nemení."

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__active_submission_id
