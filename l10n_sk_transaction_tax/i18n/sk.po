msgstr ""
"Zdroje DFT sa zmenili. Pred exportom alebo podaním vráťte oznámenie do "
"návrhu a prepočítajte ho."

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__deadline_reference
msgid "Deadline Reference"
msgstr "Podklad zákonnej lehoty"

#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__submission_state
