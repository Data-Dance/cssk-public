#. module: l10n_sk_transaction_tax
#: model:ir.model.fields,field_description:l10n_sk_transaction_tax.field_l10n_sk_transaction_tax__discovery_date
msgid "Discovery Date"
msgstr "Dátum zistenia"

#. module: l10n_sk_transaction_tax
#. odoo-python
#: code:addons/l10n_sk_transaction_tax/wire.py:0
msgid "Discovery and previous-tax rows belong only to an additional notice"
msgstr "Deň zistenia a posledná známa daň patria len do dodatočného oznámenia"

