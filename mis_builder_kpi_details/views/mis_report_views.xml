<odoo>
    <record id="mis_report_view_kpi_form_details" model="ir.ui.view">
        <field name="name">mis.report.kpi.form.details</field>
        <field name="model">mis.report.kpi</field>
        <field name="inherit_id" ref="mis_builder.mis_report_view_kpi_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_expand_accounts']" position="after">
                <field name="details_field_id" options="{'no_create': True}" invisible="auto_expand_accounts"/>
                <field name="details_limit" invisible="not details_field_id"/>
            </xpath>
        </field>
    </record>
</odoo>
