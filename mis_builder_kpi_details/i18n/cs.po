#. module: mis_builder_kpi_details
#: model:ir.model.fields,field_description:mis_builder_kpi_details.field_mis_report_kpi__details_field_id
msgid "Details by"
msgstr "Detaily podle"

#. module: mis_builder_kpi_details
#. odoo-python
#: code:addons/mis_builder_kpi_details/models/mis_report.py:0
msgid "KPI %s: details by a field replace the details by account; choose one."
msgstr ""
"Ukazatel %s: detaily podle pole nahrazují detaily podle účtů; zvolte jedno."

#. module: mis_builder_kpi_details
#: model:ir.model.fields,help:mis_builder_kpi_details.field_mis_report_kpi__details_limit
msgid "Largest number of detail rows; the busiest values are shown."
msgstr "Největší počet řádků detailu; zobrazí se hodnoty s nejvíce položkami."

#. module: mis_builder_kpi_details
#: model:ir.model.fields,field_description:mis_builder_kpi_details.field_mis_report_kpi__details_limit
msgid "Most detail rows"
msgstr "Nejvíce řádků detailu"

#. module: mis_builder_kpi_details
#. odoo-python
#: code:addons/mis_builder_kpi_details/models/mis_report.py:0
msgid "Undefined"
msgstr "Nezadáno"

#. module: mis_builder_kpi_details
#: model:ir.model.fields,help:mis_builder_kpi_details.field_mis_report_kpi__details_field_id
msgid ""
"Unfold this KPI into one detail row per value of the field (partner, "
"product, journal, month of the date...) instead of per account. Only for "
"KPIs computed directly from accounting expressions."
msgstr ""
"Rozbalí ukazatel na jeden řádek detailu za každou hodnotu pole (partner, "
"produkt, deník, měsíc data...) místo účtů. Jen pro ukazatele vypočtené přímo"
" z účetních výrazů."
