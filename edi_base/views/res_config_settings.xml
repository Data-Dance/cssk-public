<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_edi_base" model="ir.ui.view">
        <field name="name">res.config.settings.view.edi.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="EDI" string="EDI" name="edi_base">
                    <!-- Provider sections are inserted here by each provider module -->
                    <div name="edi_providers_anchor"/>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
