<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_message_tree" model="ir.ui.view">
        <field name="name">edi.message.tree</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <list string="EDI Messages"
                decoration-danger="state == 'error' or blocking_level == 'error'"
                decoration-warning="blocking_level == 'warning' or is_test_mode"
                decoration-muted="state == 'done'">
                <field name="message_date"/>
                <field name="create_date" optional="hide"/>
                <field name="provider"/>
                <field name="name"/>
                <field name="message_type"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="is_test_mode" optional="hide"/>
                <field name="partner_id"/>
                <field name="external_id" optional="hide"/>
                <field name="customer_ref" optional="show"/>
                <field name="provider_interchange_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_edi_message_form" model="ir.ui.view">
        <field name="name">edi.message.form</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <form string="EDI Message">
                <header>
                    <button name="action_reprocess" string="Reprocess" type="object"
                        invisible="direction != 'in' or state not in ('error', 'received')"
                        groups="edi_base.group_edi_manager"/>
                    <button name="action_send" string="Send" type="object"
                        invisible="direction != 'out' or state not in ('draft', 'ready', 'queued', 'error')"
                        groups="edi_base.group_edi_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,ready,queued,sent,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="TEST"
                        invisible="not is_test_mode" bg_color="bg-warning"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider" readonly="1"/>
                            <field name="message_type"/>
                            <field name="direction"/>
                            <field name="provider_mode" readonly="1" string="Environment"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="message_id"/>
                            <field name="message_date"/>
                            <field name="sender_gln"/>
                            <field name="receiver_gln"/>
                            <field name="blocking_level" invisible="not blocking_level"/>
                        </group>
                    </group>
                    <group string="Provider correlation" name="provider_correlation">
                        <group>
                            <field name="external_id"/>
                            <field name="customer_ref"/>
                            <field name="provider_interchange_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="transmission_uuid" readonly="1"/>
                            <field name="attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" widget="text" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="XML Content">
                            <!-- `ace` is Odoo 19's built-in Ace editor
                                 widget for Text fields; mode=xml gives
                                 XML syntax highlighting + line numbers.
                                 The field is stored beautified by
                                 _store_xml() so the indentation is
                                 already consistent here. -->
                            <field name="message_xml"
                                   widget="ace"
                                   options="{'mode': 'xml'}"
                                   readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edi_message_search" model="ir.ui.view">
        <field name="name">edi.message.search</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <search string="EDI Messages">
                <field name="name"/>
                <field name="message_type"/>
                <field name="partner_id"/>
                <field name="message_id"/>
                <field name="customer_ref"/>
                <field name="external_id"/>
                <field name="provider"/>
                <filter string="Inbound" name="inbound" domain="[('direction', '=', 'in')]"/>
                <filter string="Outbound" name="outbound" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter string="Test Mode" name="test_mode" domain="[('is_test_mode', '=', True)]"/>
                <filter string="Production" name="prod_mode" domain="[('is_test_mode', '=', False)]"/>
                <separator/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('draft', 'ready', 'received'))]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Provider" name="by_provider" context="{'group_by': 'provider'}"/>
                    <filter string="Message Type" name="by_type" context="{'group_by': 'message_type'}"/>
                    <filter string="Direction" name="by_direction" context="{'group_by': 'direction'}"/>
                    <filter string="State" name="by_state" context="{'group_by': 'state'}"/>
                    <filter string="Partner" name="by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edi_message" model="ir.actions.act_window">
        <field name="name">EDI Messages</field>
        <field name="res_model">edi.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edi_message_search"/>
    </record>
</odoo>
