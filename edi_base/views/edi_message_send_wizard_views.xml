<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_message_send_wizard_form" model="ir.ui.view">
        <field name="name">edi.message.send.wizard.form</field>
        <field name="model">edi.message.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send EDI Messages">
                <div invisible="not skipped_count" class="alert alert-warning" role="alert">
                    <field name="skipped_count"/> of the selected message(s) cannot be sent and
                    will be skipped (already sent/done, inbound, or otherwise not in a sendable state).
                    Only the <field name="sendable_count" nolabel="1" class="oe_inline"/>
                    sendable message(s) will be queued.
                </div>
                <div invisible="skipped_count" class="alert alert-info" role="alert">
                    <field name="sendable_count" nolabel="1" class="oe_inline"/> message(s) will be
                    queued for sending.
                </div>
                <group string="Will be sent" invisible="not sendable_ids">
                    <field name="sendable_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false" edit="false">
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="state"/>
                            <field name="external_id"/>
                        </list>
                    </field>
                </group>
                <group string="Will be skipped" invisible="not skipped_ids">
                    <field name="skipped_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false" edit="false">
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="direction"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Send"
                        class="btn-primary" invisible="not sendable_ids"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_edi_message_bulk_send" model="ir.actions.server">
        <field name="name">Send (queue dispatch)</field>
        <field name="model_id" ref="model_edi_message"/>
        <field name="binding_model_id" ref="model_edi_message"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_queue_send_selected()</field>
    </record>
</odoo>
