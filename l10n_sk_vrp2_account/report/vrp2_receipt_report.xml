<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_vrp2_receipt" model="ir.actions.report">
        <field name="name">VRP2 Receipt</field>
        <field name="model">vrp2.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_sk_vrp2_account.report_vrp2_receipt</field>
        <field name="report_file">l10n_sk_vrp2_account.report_vrp2_receipt</field>
        <field name="binding_model_id" ref="model_vrp2_receipt"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vrp2_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Pokladničný doklad — úhrada faktúry</h2>
                        <div class="text-center mb-3">
                            <strong t-out="o.company_id.vrp2_business_name or o.company_id.name"/><br/>
                            <span t-if="o.company_id.vrp2_dic">DIČ: <span t-out="o.company_id.vrp2_dic"/> </span>
                            <span t-if="o.company_id.vrp2_ic_dph">IČ DPH: <span t-out="o.company_id.vrp2_ic_dph"/></span><br/>
                            <span t-if="o.company_id.vrp2_dkp">DKP: <span t-out="o.company_id.vrp2_dkp"/></span>
                        </div>

                        <table class="table table-sm">
                            <tr>
                                <td>Číslo dokladu</td>
                                <td class="text-end"><strong t-out="o.name"/></td>
                            </tr>
                            <tr>
                                <td>Faktúra</td>
                                <td class="text-end" t-out="o.move_id.name or ''"/>
                            </tr>
                            <tr>
                                <td>Odberateľ</td>
                                <td class="text-end" t-out="o.partner_id.display_name or ''"/>
                            </tr>
                            <tr>
                                <td>Dátum</td>
                                <td class="text-end" t-out="o.vrp2_created"
                                    t-options="{'widget': 'datetime'}"/>
                            </tr>
                            <tr>
                                <td>Spôsob úhrady</td>
                                <td class="text-end" t-out="o.payment_method or ''"/>
                            </tr>
                            <tr class="border-top">
                                <td><strong>Uhradená suma</strong></td>
                                <td class="text-end">
                                    <strong t-out="o.amount"
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </table>

                        <div t-if="o.okp" class="mt-3" style="font-size: 9px; word-break: break-all;">
                            <div>OKP: <span t-out="o.okp"/></div>
                        </div>

                        <div t-if="o.vrp2_receipt_uuid" class="text-center mt-3">
                            <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % o.vrp2_receipt_uuid"
                                 alt="QR"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
