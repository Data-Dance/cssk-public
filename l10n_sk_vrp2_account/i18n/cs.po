#. module: l10n_sk_vrp2_account
#: model_terms:ir.ui.view,arch_db:l10n_sk_vrp2_account.vrp2_fiscalize_wizard_form
msgid ""
"The receipt registers the invoice total. Register the\n"
"                    payment itself in Odoo as usual."
msgstr ""
"Doklad eviduje celkovou částku faktury. Samotnou\n"
"                    platbu zaregistrujte v Odoo jako obvykle."

#. module: l10n_sk_vrp2_account
#. odoo-python
#: code:addons/l10n_sk_vrp2_account/wizard/vrp2_fiscalize_wizard.py:0
msgid "Select the invoices to fiscalize."
msgstr "Vyberte faktury k fiskalizaci."

#. module: l10n_sk_vrp2_account
#. odoo-python
#: code:addons/l10n_sk_vrp2_account/models/account_payment_register.py:0
msgid "Cash rounding"
msgstr "Zaokrouhlování hotovosti"

#. module: l10n_sk_vrp2_account
#. odoo-python
#: code:addons/l10n_sk_vrp2_account/models/account_payment_register.py:0
msgid ""
"A cash payment is rounded to 0.05 €. Pay %(amount)s in cash only together "
"with the rest of the invoice, or enter an amount that is a multiple of 0.05 "
"€."
msgstr ""
"Hotovostní platba se zaokrouhluje na 0,05 €. Zaplaťte %(amount)s v hotovosti"
" jen spolu se zbytkem faktury, nebo zadejte částku, která je násobkem 0,05 "
"€."

#. module: l10n_sk_vrp2_account
#. odoo-python
#: code:addons/l10n_sk_vrp2_account/models/account_payment_register.py:0
msgid ""
"Invoice %(invoice)s is paid in cash, which is rounded to 0.05 €. Register "
"its payment on its own so the rounding can be booked."
msgstr ""
"Faktura %(invoice)s je placena v hotovosti, která se zaokrouhluje na 0,05 €."
" Zaregistrujte její platbu samostatně, aby bylo možné zaúčtovat "
"zaokrouhlení."

#. module: l10n_sk_vrp2_account
#. odoo-python
#: code:addons/l10n_sk_vrp2_account/models/account_payment_register.py:0
msgid ""
"The 0.05 € rounding of this cash payment has nowhere to be booked. Set the "
"VRP2 cash rounding, with its profit and loss accounts, in Accounting ▸ "
"Settings ▸ VRP2."
msgstr ""
"Zaokrouhlení této hotovostní platby na 0,05 € není kam zaúčtovat. Nastavte "
"zaokrouhlování hotovosti VRP2 včetně účtů zisků a ztrát v nabídce Účetnictví"
" ▸ Nastavení ▸ VRP2."
