#. module: l10n_sk_vrp2_account
#: model:ir.model.fields,help:l10n_sk_vrp2_account.field_vrp2_fiscalize_wizard__payment_type
msgid ""
"How the customer paid. Cash is rounded to 0.05 € when the register rounds; a"
" card payment never is."
msgstr ""
"Jak zákazník zaplatil. Hotovost se zaokrouhluje na 0,05 €, pokud pokladna "
"zaokrouhluje; platba kartou nikdy."

#. module: l10n_sk_vrp2_account
#: model_terms:ir.ui.view,arch_db:l10n_sk_vrp2_account.vrp2_fiscalize_wizard_form
msgid "Fiscalize"
msgstr "Fiskalizovat"

