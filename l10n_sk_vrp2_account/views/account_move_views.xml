<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice form: stat button + Fiscalize / Storno actions -->
    <record id="view_move_form_vrp2" model="ir.ui.view">
        <field name="name">account.move.form.vrp2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_vrp2_view_receipts" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="vrp2_receipt_count == 0">
                    <field name="vrp2_receipt_count" widget="statinfo"
                           string="VRP2 Receipts"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <field name="vrp2_has_active_receipt" invisible="1"/>
                <button name="action_vrp2_fiscalize" type="object"
                        string="Fiscalize in VRP2"
                        invisible="move_type != 'out_invoice' or state != 'posted' or vrp2_has_active_receipt"/>
                <button name="action_vrp2_storno" type="object"
                        string="Storno (VRP2)"
                        confirm="This will issue a VRP2 storno cancelling the fiscal receipt for this invoice. Continue?"
                        invisible="not vrp2_has_active_receipt"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice list: hidden 'VRP2 Fiscalized' column -->
    <record id="view_invoice_tree_vrp2" model="ir.ui.view">
        <field name="name">account.invoice.list.vrp2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="vrp2_has_active_receipt" optional="hide"
                       string="VRP2 Fiscalized" widget="boolean"/>
            </xpath>
        </field>
    </record>

    <!-- Mass action: fiscalize selected invoices, return one joined PDF -->
    <record id="action_vrp2_mass_fiscalize" model="ir.actions.server">
        <field name="name">Fiscalize in VRP2</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_vrp2_mass_fiscalize()</field>
    </record>

</odoo>
