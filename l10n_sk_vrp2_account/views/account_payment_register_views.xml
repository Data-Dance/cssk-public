<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_vrp2" model="ir.ui.view">
        <field name="name">account.payment.register.form.vrp2</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="vrp2_available" invisible="1"/>
                <field name="vrp2_fiscalize" invisible="not vrp2_available"/>
                <field name="vrp2_payment_type"
                       invisible="not vrp2_available or not vrp2_fiscalize"/>
            </xpath>
        </field>
    </record>

</odoo>
