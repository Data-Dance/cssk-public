<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_form_qr_platba" model="ir.ui.view">
        <field name="name">pos.payment.method.form.qr_platba</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_online_payment']" position="after">
                <field name="is_qr_platba_sk" invisible="1"/>
                <field name="qr_platba_timeout_seconds"
                       invisible="not is_qr_platba_sk"/>
            </xpath>
        </field>
    </record>
</odoo>
