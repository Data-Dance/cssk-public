<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_nop_qr_platba_sk.NonConfirmationReceipt">
        <div class="pos-receipt">
            <img t-if="props.logoUrl" t-att-src="props.logoUrl" alt="Logo" class="pos-receipt-logo"/>
            <div class="text-center pt-2">
                <h2 class="mt-0 mb-1" style="font-size: 115%;">
                    DOKLAD O NEPOTVRDENÍ ZREALIZOVANEJ PLATBY
                </h2>
                <div class="text-muted" style="font-size: 75%;">
                    QR Platby / NOP KVERKOM — <t t-esc="receipt.environment.toUpperCase()"/>
                </div>
            </div>

            <div class="pos-receipt-contact text-center pt-2" style="font-size: 90%;">
                <div><strong t-esc="receipt.merchant_name"/></div>
                <div t-if="receipt.merchant_ico">IČO: <t t-esc="receipt.merchant_ico"/></div>
                <div t-if="receipt.merchant_dic">DIČ: <t t-esc="receipt.merchant_dic"/></div>
                <div t-if="receipt.merchant_vat">IČ DPH: <t t-esc="receipt.merchant_vat"/></div>
                <div t-if="receipt.pokladnica_id_ext">
                    Pokladnica: <t t-esc="receipt.pokladnica_id_ext"/>
                </div>
            </div>

            <hr class="my-2"/>

            <table class="w-100" style="font-size: 85%;">
                <tr>
                    <td>ID transakcie</td>
                    <td class="text-end"><code t-esc="receipt.transaction_id"/></td>
                </tr>
                <tr>
                    <td>Vygenerované</td>
                    <td class="text-end"><t t-esc="formatDateTime(receipt.created_at)"/></td>
                </tr>
                <tr>
                    <td>Uzatvorené</td>
                    <td class="text-end"><t t-esc="formatDateTime(receipt.closed_at)"/></td>
                </tr>
                <tr>
                    <td>Suma</td>
                    <td class="text-end">
                        <strong>
                            <t t-esc="receipt.amount.toFixed(2)"/>
                            <t t-esc="' ' + receipt.currency"/>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td>IBAN príjemcu</td>
                    <td class="text-end" style="font-family: monospace; font-size: 80%;">
                        <t t-esc="receipt.iban"/>
                    </td>
                </tr>
            </table>

            <hr class="my-2"/>

            <div class="text-center mt-2" style="font-size: 70%; line-height: 1.3;">
                <div class="mb-1">Systém NOP nepotvrdil úhradu tejto platby v čase uzatvorenia predaja.</div>
                <div class="mb-1"><strong>Stav úhrady si overte na:</strong></div>
                <div style="word-break: break-all;">
                    <t t-esc="receipt.public_history_url"/>
                </div>
            </div>

            <div class="text-center mt-3" style="font-size: 65%;">
                Obsluhu vykonal: <t t-esc="receipt.cashier_name"/>
            </div>
        </div>
    </t>
</templates>
