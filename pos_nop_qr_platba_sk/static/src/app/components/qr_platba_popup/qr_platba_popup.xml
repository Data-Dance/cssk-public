<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_nop_qr_platba_sk.QrPlatbaPopup">
        <Dialog title.translate="QR Platba — scan to pay"
                footer="true"
                bodyClass="'w-100 d-flex flex-column justify-content-center align-items-center gap-2'">
            <p>Scan the QR code with your banking app to pay.</p>
            <img class="w-50 pb-2" t-att-src="props.qrCode" alt="QR Platba"/>
            <div class="fs-3"><strong t-esc="props.formattedAmount"/></div>
            <div class="text-muted">Order: <t t-esc="props.orderName"/></div>
            <div t-att-class="state.promptTimeout ? 'text-danger fw-bold mt-2' : 'text-muted mt-2'">
                <t t-if="!state.promptTimeout">Waiting for confirmation — <t t-esc="timeoutLabel"/></t>
                <t t-else="">
                    Still no confirmation from NOP. Did the customer pay?
                    Choose "Close without confirmation" to issue the non-confirmation
                    receipt and let the customer pay with another method, or "Cancel"
                    if they are not paying.
                </t>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary"
                        t-on-click="_cancel"
                        t-att-disabled="state.busy">
                    Cancel (customer did not pay)
                </button>
                <button class="btn btn-warning"
                        t-on-click="_closeUnconfirmed"
                        t-att-disabled="state.busy">
                    Close without confirmation
                </button>
            </t>
        </Dialog>
    </t>
</templates>
