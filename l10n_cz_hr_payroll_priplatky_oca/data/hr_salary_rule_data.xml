<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The five statutory Czech surcharges as OCA-engine salary rules.

        Each rule is a thin call into the engine-neutral mixin, so both
        engines run byte-identical arithmetic and a statutory change is a data
        change on l10n.cz.wage.surcharge.rate rather than an edit here.

        Hours reach a rule either from a worked-days line or from a payslip
        input of the same code; the OCA engine has no work-entry stack, so in
        practice the inputs declared below are the route.
    -->
    <record id="l10n_cz_priplatek_prescas" model="hr.salary.rule">
        <field name="category_id" ref="l10n_cz_hr_payroll_oca.ALW"/>
        <field name="name">Overtime Surcharge (§ 114)</field>
        <field name="code">PRIPLATEK_PRESCAS</field>
        <field name="sequence">60</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = payslip._l10n_cz_surcharge_hours('PRESCAS') &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = payslip._l10n_cz_surcharge_amount('PRESCAS')
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="input_ids" eval="[(0, 0, {'name': 'Overtime hours', 'code': 'PRESCAS'})]"/>
    </record>
