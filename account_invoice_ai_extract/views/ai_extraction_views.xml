<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_extraction_list" model="ir.ui.view">
        <field name="name">account.invoice.ai.extraction.list</field>
        <field name="model">account.invoice.ai.extraction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="confidence" widget="percentage" optional="show"/>
                <field name="total_cost" sum="Total cost" optional="show"/>
                <field name="cost" optional="hide"/>
                <field name="move_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'resolved'"
                       decoration-warning="state in ('needs_review', 'duplicate')"
                       decoration-danger="state == 'error'"
                       decoration-info="state in ('pending', 'extracting', 'extracted')"/>
            </list>
        </field>
    </record>

    <record id="view_ai_extraction_form" model="ir.ui.view">
        <field name="name">account.invoice.ai.extraction.form</field>
        <field name="model">account.invoice.ai.extraction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" type="object" string="Process"
                            class="btn-primary"
                            invisible="state not in ('pending', 'error')"/>
                    <button name="action_process" type="object" string="Re-run"
                            invisible="state in ('pending', 'extracting')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,extracted,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="attachment_id"/>
                            <field name="model_id"/>
                            <field name="provider_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="confidence" widget="percentage"/>
                            <field name="total_cost"/>
                            <field name="cost"/>
                            <field name="run_count"/>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Model output" name="raw">
                            <field name="raw_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Usage history" name="usage">
                            <field name="run_ids" nolabel="1">
                                <list create="false" edit="false">
                                    <field name="run_date"/>
                                    <field name="model_id"/>
                                    <field name="provider_id"/>
                                    <field name="input_tokens" sum="Input"/>
                                    <field name="output_tokens" sum="Output"/>
                                    <field name="cost" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_extraction" model="ir.actions.act_window">
        <field name="name">AI Invoice Extractions</field>
        <field name="res_model">account.invoice.ai.extraction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
