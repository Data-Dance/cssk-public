<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ai_extract" model="ir.ui.view">
        <field name="name">account.move.form.ai.extract</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_extract" type="object" string="Extract with AI"
                        groups="account.group_account_invoice"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="ai_extract_extraction_id" invisible="1"/>
                <button name="action_view_ai_extraction" type="object"
                        class="oe_stat_button" icon="fa-magic"
                        invisible="not ai_extract_extraction_id"
                        groups="account.group_account_invoice">
                    <div class="o_stat_info">
                        <span class="o_stat_text">AI Extraction</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
