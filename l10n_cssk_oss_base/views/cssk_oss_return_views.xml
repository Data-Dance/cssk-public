<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cssk_oss_return_view_list" model="ir.ui.view">
        <field name="name">cssk.oss.return.list</field>
        <field name="model">cssk.oss.return</field>
        <field name="arch" type="xml">
            <list string="OSS VAT Returns">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="country_id"/>
                <field name="version_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="eur_currency_id" column_invisible="1"/>
                <field name="total_due" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-info="state == 'exported'"
                       decoration-muted="state == 'legacy'"/>
            </list>
        </field>
    </record>

    <record id="cssk_oss_return_view_form" model="ir.ui.view">
        <field name="name">cssk.oss.return.form</field>
        <field name="model">cssk.oss.return</field>
        <field name="arch" type="xml">
            <form string="OSS VAT Return">
                <header>
                    <button name="action_compute_lines" type="object"
                            string="Compute"
                            invisible="state not in ('draft', 'preview')"/>
                    <button name="action_confirm_ecb_rates" type="object"
                            string="Confirm ECB rates"
                            invisible="state not in ('draft', 'preview') or not rate_ids"/>
                    <button name="action_export_xml" type="object"
                            string="Export XML" class="btn-primary"
                            invisible="state in ('draft', 'submitted', 'cancelled', 'legacy')"/>
                    <button name="action_submit" type="object"
                            string="Mark Submitted" class="btn-primary"
                            invisible="state != 'exported'"/>
                    <button name="action_create_submission" type="object"
                            string="File it" class="btn-primary"
                            invisible="state not in ('exported', 'submitted')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('exported', 'submitted')"
                            confirm="Reset this filing to draft? The originally filed copy is kept."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,preview,exported,submitted"/>
                    <field name="submission_state" widget="badge"
                           invisible="not submission_state"
                           decoration-success="submission_state in ('accepted',)"
                           decoration-info="submission_state in ('delivered',)"
                           decoration-danger="submission_state in ('rejected','failed')"/>
                </header>
                <sheet>
                    <field name="legacy" invisible="1"/>
                    <widget name="web_ribbon" title="Historical filing"
                            bg_color="text-bg-info" invisible="not legacy"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"
                                   readonly="state != 'draft'"/>
                            <field name="country_id"/>
                            <field name="version_id"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="year"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="quarter"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="partial_date_from"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="partial_date_to"
                                   readonly="state not in ('draft', 'preview')"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="eur_currency_id" invisible="1"/>
                            <field name="total_vat"/>
                            <field name="total_corrections"/>
                            <field name="total_due"/>
                            <field name="booked_vat"/>
                            <field name="is_nil"/>
                            <field name="xml_attachment_id"/>
                            <field name="submitted_attachment_id"
                                   invisible="not submitted_attachment_id"/>
                            <field name="submitted_date"
                                   invisible="not submitted_date"/>
                            <field name="submission_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supplies" name="supplies">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'preview')">
                                <list editable="bottom"
                                      decoration-warning="is_manual">
                                    <field name="eur_currency_id" column_invisible="1"/>
                                    <field name="member_state_id"/>
                                    <field name="origin_country_id"/>
                                    <field name="origin_vat" optional="hide"/>
                                    <field name="supply_type"/>
                                    <field name="rate_type"/>
                                    <field name="vat_rate"/>
                                    <field name="taxable_amount" sum="Total"/>
                                    <field name="vat_amount" sum="Total"/>
                                    <field name="is_manual"/>
                                    <button name="action_view_move_lines"
                                            type="object" icon="fa-search-plus"
                                            string="Documents"
                                            invisible="is_manual"/>
                                </list>
                            </field>
                        </page>
                        <page string="Corrections of earlier quarters"
                              name="corrections">
                            <field name="correction_ids"
                                   readonly="state not in ('draft', 'preview')">
                                <list editable="bottom"
                                      decoration-warning="is_manual">
                                    <field name="eur_currency_id" column_invisible="1"/>
                                    <field name="year"/>
                                    <field name="quarter"/>
                                    <field name="member_state_id"/>
                                    <field name="taxable_amount" optional="show"/>
                                    <field name="vat_amount" sum="Total"/>
                                    <field name="is_manual"/>
                                    <button name="action_view_move_lines"
                                            type="object" icon="fa-search-plus"
                                            string="Documents"
                                            invisible="is_manual"/>
                                </list>
                            </field>
                        </page>
                        <page string="Exchange rates" name="rates">
                            <p class="text-muted">
                                Amounts not invoiced in EUR are converted at the
                                ECB reference rate for the last day of the quarter
                                (or the next day of publication). Rates proposed
                                from the company's rate table must be checked
                                and confirmed before export.
                            </p>
                            <field name="rate_ids"
                                   readonly="state not in ('draft', 'preview')">
                                <list editable="bottom" create="false"
                                      decoration-danger="source != 'ecb'">
                                    <field name="currency_id" readonly="1"/>
                                    <field name="reference_date" readonly="1"/>
                                    <field name="fixing_date"/>
                                    <field name="rate"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cssk_oss_return_action" model="ir.actions.act_window">
        <field name="name">OSS VAT Returns</field>
        <field name="res_model">cssk.oss.return</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
