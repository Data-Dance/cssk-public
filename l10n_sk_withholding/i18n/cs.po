#. module: l10n_sk_withholding
#: model:ir.model.fields,help:l10n_sk_withholding.field_l10n_sk_withholding__filing_on
msgid ""
"Actual filing date, or the intended date before sending. Reconcile it to the"
" actual filing day. The printed preparation date is a separate fact."
msgstr ""
"Skutečné datum podání, před odesláním zamýšlené datum. Ověřte je podle "
"skutečného dne podání. Vytištěné datum vyhotovení je samostatný údaj."

#. module: l10n_sk_withholding
#: model:ir.model.fields,field_description:l10n_sk_withholding.field_l10n_sk_withholding__original_filing_date
msgid "Actual previous filing date"
msgstr "Skutečné datum předchozího podání"

#. module: l10n_sk_withholding
#: model:ir.model,name:l10n_sk_withholding.model_l10n_sk_withholding_remittance
msgid "Actual tax remittance allocated to reported income"
msgstr "Skutečný odvod daně přiřazený k vykázanému příjmu"

#. module: l10n_sk_withholding
#. odoo-python
#: code:addons/l10n_sk_withholding/models/withholding.py:0
msgid "Add the reviewed actual dividend payments."
msgstr "Přidejte ověřené skutečné úhrady příjmů."

#. module: l10n_sk_withholding
#: model:ir.model.fields,field_description:l10n_sk_withholding.field_l10n_sk_withholding_event__remittance_reviewed
msgid "All receipt evidence reviewed"
msgstr "Všechny doklady o odvodech ověřeny"

#. module: l10n_sk_withholding
#. odoo-python
#: code:addons/l10n_sk_withholding/models/withholding.py:0
msgid "Allocate a positive actual remittance amount in cents."
msgstr "Přiřaďte kladnou částku skutečného odvodu v centech."

#. module: l10n_sk_withholding
#: model:ir.model.fields,field_description:l10n_sk_withholding.field_l10n_sk_withholding_remittance__amount
msgid "Amount"
msgstr "Částka"

#. module: l10n_sk_withholding
#. odoo-python
#: code:addons/l10n_sk_withholding/wire4311.py:0
msgid "An actual remittance needs its actual date; unpaid tax has none"
msgstr "Skutečný odvod potřebuje skutečné datum; nezaplacená daň žádné nemá"

#. module: l10n_sk_withholding
#: model:ir.model.fields,help:l10n_sk_withholding.field_l10n_sk_withholding_remittance__source_kind
msgid ""
"An authority allocation requires the actual decision or verified tax-account"
" settlement, not an application for a transfer."
msgstr ""
"Použití správcem daně vyžaduje skutečné rozhodnutí nebo ověřené vypořádání "
"daňového účtu, samotná žádost o převod nestačí."

#. module: l10n_sk_withholding
#. odoo-python
#: code:addons/l10n_sk_withholding/models/withholding.py:0
msgid ""
"Another process is allocating this company's withholding sources. Reload and"
" retry."
msgstr ""
"Jiný proces přiřazuje zdroje srážkové daně této společnosti. Načtěte znovu a"
" zkuste to znovu."

#. module: l10n_sk_withholding
#. odoo-python
#: code:addons/l10n_sk_withholding/models/withholding.py:0
msgid ""
"Another process is changing this withholding notice or its correction chain."
" Reload and retry."
msgstr ""
"Jiný proces mění toto oznámení o srážkové dani nebo jeho řetězec oprav. "
"Načtěte znovu a zkuste to znovu."

