<odoo>

    <record id="view_advance_saldo_wizard_form" model="ir.ui.view">
        <field name="name">advance.saldo.xlsx.wizard.form</field>
        <field name="model">advance.saldo.xlsx.wizard</field>
        <field name="arch" type="xml">
            <form string="Open Advances Saldo">
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="include_settled" />
                </group>
                <footer>
                    <button
                        name="action_print"
                        string="Export XLSX"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advance_saldo_wizard" model="ir.actions.act_window">
        <field name="name">Open Advances Saldo (XLSX)</field>
        <field name="res_model">advance.saldo.xlsx.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_advance_saldo_wizard"
        name="Open Advances Saldo (XLSX)"
        action="action_advance_saldo_wizard"
        parent="account.menu_finance_reports"
        sequence="90"
    />

</odoo>
