#. module: edi_epostak_base
#. odoo-python
#: code:addons/edi_epostak_base/models/epostak_connector.py:0
msgid ""
"The Peppol address of company %s is not configured. Set the Peppol e-address"
" (EAS) and Peppol Endpoint on the company's partner record — ePošťák scopes "
"every request to that participant identifier."
msgstr ""
"Peppol adresa spoločnosti %s nie je nastavená. Nastavte Peppol e-adresu "
"(EAS) a Peppol koncový bod na kontakte spoločnosti — ePošťák viaže každú "
"požiadavku na tento identifikátor účastníka."

#. module: edi_epostak_base
#. odoo-python
#: code:addons/edi_epostak_base/models/epostak_connector.py:0
