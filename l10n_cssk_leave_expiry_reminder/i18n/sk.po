#. module: l10n_cssk_leave_expiry_reminder
#. odoo-python
#: code:addons/l10n_cssk_leave_expiry_reminder/models/hr_leave_allocation.py:0
msgid ""
"%(employee)s has %(amount)s %(unit)s of %(leave)s that will expire on "
"%(date)s. Please agree with them when they will take this time off before "
"then. Annual leave does not lapse under the Labour Code; this is the date "
"the time-off plan removes it from their balance in Odoo."
msgstr ""
"%(employee)s má %(amount)s %(unit)s dovolenky typu %(leave)s, ktorá vyprší "
"dňa %(date)s. Dohodnite sa, prosím, so zamestnancom, kedy túto dovolenku "
"dovtedy vyčerpá. Podľa Zákonníka práce dovolenka neprepadá; k tomuto dátumu "
"ju plán voľna odoberie z jeho zostatku v Odoo."
