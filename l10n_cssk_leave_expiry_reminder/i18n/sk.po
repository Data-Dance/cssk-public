#. module: l10n_cssk_leave_expiry_reminder
#: model:mail.template,name:l10n_cssk_leave_expiry_reminder.mail_template_leave_expiry
msgid "Time Off: Expiring Leave Reminder"
msgstr "Dovolenka: Pripomienka vypršiavajúcej dovolenky"

#. module: l10n_cssk_leave_expiry_reminder
#: model:ir.actions.server,name:l10n_cssk_leave_expiry_reminder.ir_cron_notify_expiring_carryover_ir_actions_server
msgid "Time Off: Notify expiring carried-over leave (CZ/SK)"
msgstr "Dovolenka: Upozorniť na vypršiavajúcu prenesenú dovolenku (CZ/SK)"

#. module: l10n_cssk_leave_expiry_reminder
#. odoo-python
#: code:addons/l10n_cssk_leave_expiry_reminder/models/hr_leave_allocation.py:0
msgid ""
"You have %(amount)s %(unit)s of %(leave)s that will expire on %(date)s. "
"Please agree with your manager when you will take this time off before "
"then. Annual leave does not lapse under the Labour Code; this is the date "
"the time-off plan removes it from your balance in Odoo."
msgstr ""
"Máte %(amount)s %(unit)s dovolenky typu %(leave)s, ktorá vyprší dňa "
"%(date)s. Dohodnite sa, prosím, s vedúcim, kedy túto dovolenku dovtedy "
"vyčerpáte. Podľa Zákonníka práce dovolenka neprepadá; k tomuto dátumu ju "
"plán voľna odoberie z vášho zostatku v Odoo."

#. module: l10n_cssk_leave_expiry_reminder
#: model:mail.template,subject:l10n_cssk_leave_expiry_reminder.mail_template_leave_expiry
msgid ""
"You have leave expiring on {{ "
"format_date(object.carried_over_days_expiration_date) }}"
msgstr ""
"Vaša prenesená dovolenka vyprší dňa {{ "
"format_date(object.carried_over_days_expiration_date) }}"

#. module: l10n_cssk_leave_expiry_reminder
#. odoo-python
#: code:addons/l10n_cssk_leave_expiry_reminder/models/hr_leave_allocation.py:0
