#. module: l10n_cssk_leave_expiry_reminder
#: model:mail.template,body_html:l10n_cssk_leave_expiry_reminder.mail_template_leave_expiry
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Hello <t t-out=\"object.employee_id.name or ''\">Employee</t>,\n"
"        <br/><br/>\n"
"        You have\n"
"        <span style=\"font-weight: bold;\" t-out=\"object._l10n_cssk_expiry_amount_and_unit()[0]\">5</span>\n"
"        <t t-out=\"object._l10n_cssk_expiry_amount_and_unit()[1]\">day(s)</t> of\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.holiday_status_id.display_name or ''\">Annual Leave</span>\n"
"        that will expire on\n"
"        <span style=\"font-weight: bold;\" t-out=\"format_date(object.carried_over_days_expiration_date) or ''\">12/31/2026</span>.\n"
"        <br/><br/>\n"
"        Please agree with your manager when you will take this time off before then.\n"
"        Annual leave does not lapse under the Labour Code; this is the date the\n"
"        time-off plan removes it from your balance in Odoo.\n"
"        <br/><br/>\n"
"        Kind regards,\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Dobrý den, <t t-out=\"object.employee_id.name or ''\">Zaměstnanec</t>,\n"
"        <br/><br/>\n"
"        Máte\n"
"        <span style=\"font-weight: bold;\" t-out=\"object._l10n_cssk_expiry_amount_and_unit()[0]\">5</span>\n"
"        <t t-out=\"object._l10n_cssk_expiry_amount_and_unit()[1]\">dní</t> dovolené typu\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.holiday_status_id.display_name or ''\">Dovolená</span>\n"
"        , která vyprší dne\n"
"        <span style=\"font-weight: bold;\" t-out=\"format_date(object.carried_over_days_expiration_date) or ''\">12/31/2026</span>.\n"
"        <br/><br/>\n"
"        Domluvte se prosím s vedoucím, kdy tuto dovolenou do té doby vyčerpáte.\n"
"        Podle zákoníku práce dovolená nepropadá; k tomuto datu ji plán volna\n"
"        odebere z vašeho zůstatku v Odoo.\n"
"        <br/><br/>\n"
"        S pozdravem,\n"
"    </p>\n"
"</div>\n"
"        "

#. module: l10n_cssk_leave_expiry_reminder
#: model:mail.activity.type,summary:l10n_cssk_leave_expiry_reminder.mail_activity_type_expiring_leave
msgid "Carried-over leave is about to expire"
msgstr "Převedená dovolená brzy vyprší"

#. module: l10n_cssk_leave_expiry_reminder
#: model:mail.activity.type,name:l10n_cssk_leave_expiry_reminder.mail_activity_type_expiring_leave
msgid "Expiring Leave"
msgstr "Vypršující dovolená"

#. module: l10n_cssk_leave_expiry_reminder
#. odoo-python
#: code:addons/l10n_cssk_leave_expiry_reminder/models/hr_leave_allocation.py:0
