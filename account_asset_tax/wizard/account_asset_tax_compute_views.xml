<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_tax_compute_form" model="ir.ui.view">
        <field name="name">account.asset.tax.compute.form</field>
        <field name="model">account.asset.tax.compute</field>
        <field name="arch" type="xml">
            <form string="Compute Tax Depreciation">
                <p>
                    Recompute the tax-depreciation board for the selected assets.
                    Already-filed fiscal years are preserved; only the open tail is
                    regenerated.
                </p>
                <group>
                    <field name="asset_count" readonly="1"/>
                    <field name="only_enabled"/>
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_asset_tax_compute" model="ir.actions.act_window">
        <field name="name">Compute Tax Depreciation</field>
        <field name="res_model">account.asset.tax.compute</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
