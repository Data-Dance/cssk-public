#: code:addons/l10n_cssk_core/models/cssk_statement_account_map.py:0
msgid ""
"Account %s is mapped for any balance AND for one side. Use either one 'any "
"balance' mapping, or a debit and/or a credit mapping."
msgstr ""
"Účet %s je namapován pro jakýkoli zůstatek A ZÁROVEŇ pro jednu stranu. "
"Použijte buď jedno mapování „jakýkoli zůstatek“, nebo debetní a/nebo "
"kreditní mapování."

#. module: l10n_cssk_core
#: model:ir.model.constraint,message:l10n_cssk_core.constraint_cssk_statement_account_map_company_account_side_uniq
msgid "An account can be mapped only once per balance side."
msgstr "Účet lze namapovat jen jednou pro každou stranu zůstatku."

#. module: l10n_cssk_core
#: model:ir.model.fields.selection,name:l10n_cssk_core.selection__cssk_statement_account_map__balance_side__any
msgid "Any balance"
msgstr "Jakýkoli zůstatek"

#. module: l10n_cssk_core
#: model:ir.model.fields,help:l10n_cssk_core.field_cssk_statement_account_map__balance_side
msgid ""
"Any balance: always reported under the code.\n"
"Debit / credit balance only: reported under the code only when the account's balance at the period end has that sign (an overdrawn bank account reported as a bank loan); otherwise it keeps its own code. Applies to balance-sheet balances only."
msgstr ""
"Jakýkoli zůstatek: účet se vždy vykazuje pod tímto kódem.\n"
"Jen debetní / kreditní zůstatek: pod tímto kódem se vykazuje, jen pokud má zůstatek účtu ke konci období toto znaménko (přečerpaný bankovní účet vykázaný jako bankovní úvěr); jinak si ponechává vlastní kód. Platí jen pro zůstatky v rozvaze."

#. module: l10n_cssk_core
#: model:ir.model.fields,field_description:l10n_cssk_core.field_cssk_statement_account_map__balance_side
msgid "Balance Side"
msgstr "Strana zůstatku"

#. module: l10n_cssk_core
#: model:ir.model.fields.selection,name:l10n_cssk_core.selection__cssk_statement_account_map__balance_side__credit
