msgid "<span class=\"o_stat_text\">Statutory footprint</span>"
msgstr "<span class=\"o_stat_text\">Zákonná stopa</span>"

#. module: l10n_cssk_core
#: model_terms:ir.ui.view,arch_db:l10n_cssk_core.view_move_form_cssk_deduction_date
msgid "<span> entries</span>"
msgstr "<span> zápisů</span>"

#. module: l10n_cssk_core
#: model_terms:ir.ui.view,arch_db:l10n_cssk_core.cssk_statutory_footprint_wizard_form
msgid ""
"A blank filing means no return for this document's period\n"
"                    has been generated yet — the rows above are what it would\n"
"                    feed."
msgstr ""
"Prázdné podání znamená, že za období tohoto dokladu\n"
"                    ještě nebylo vygenerováno žádné přiznání — řádky výše\n"
"                    jsou ty, do kterých by vstupoval."

#. module: l10n_cssk_core
#: model_terms:ir.ui.view,arch_db:l10n_cssk_core.view_cssk_filing_discrepancy_form
msgid ""
"A gap in this direction is structural, not an error: the\n"
"                        KV is a proper subset of the priznanie. Only the\n"
"                        opposite direction is impossible, and only that is\n"
"                        flagged."
msgstr ""
"Rozdíl v tomto směru je strukturální, ne chyba:\n"
"                        kontrolní hlášení je vlastní podmnožinou přiznání.\n"
"                        Nemožný je jen opačný směr a jen ten se\n"
"                        označuje."

