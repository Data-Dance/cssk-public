<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cssk_tax_authority_view_list" model="ir.ui.view">
        <field name="name">cssk.tax.authority.list</field>
        <field name="model">cssk.tax.authority</field>
        <field name="arch" type="xml">
            <list string="Tax Authorities">
                <field name="country_code"/>
                <field name="code"/>
                <field name="name"/>
                <field name="submission_code"/>
                <field name="parent_authority_id" optional="show"/>
                <field name="child_authority_count" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="phone" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cssk_tax_authority_view_search" model="ir.ui.view">
        <field name="name">cssk.tax.authority.search</field>
        <field name="model">cssk.tax.authority</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="submission_code"/>
                <field name="parent_authority_id"/>
                <filter name="regional" string="Regional offices"
                        domain="[('parent_authority_id', '=', False)]"/>
                <filter name="workplaces" string="Workplaces"
                        domain="[('parent_authority_id', '!=', False)]"/>
                <separator/>
                <filter name="group_country" string="Country"
                        context="{'group_by': 'country_code'}"/>
                <filter name="group_parent" string="Regional office"
                        context="{'group_by': 'parent_authority_id'}"/>
            </search>
        </field>
    </record>

    <record id="cssk_tax_authority_view_form" model="ir.ui.view">
        <field name="name">cssk.tax.authority.form</field>
        <field name="model">cssk.tax.authority</field>
        <field name="arch" type="xml">
            <form string="Tax Authority">
                <sheet>
                    <group>
                        <group string="Office">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="country_id" required="1"
                                   domain="[('code', 'in', ['CZ', 'SK'])]"/>
                            <field name="submission_code"/>
                            <field name="parent_authority_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <notebook invisible="child_authority_count == 0">
                        <page string="Workplaces" name="workplaces">
                            <field name="child_authority_ids">
                                <list>
                                    <field name="submission_code"/>
                                    <field name="name"/>
                                    <field name="city"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="child_authority_count" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cssk_tax_authority_action" model="ir.actions.act_window">
        <field name="name">Tax Authorities</field>
        <field name="res_model">cssk.tax.authority</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_regional': 1}</field>
    </record>

</odoo>
