<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Priority 10 is load-bearing.

        `base_vat` (priority 15) MOVES `<field name="vat"/>` into
        `<div name="vat_vies_container">`. Applied after it, a spec of
        `<field name="vat" position="before">` resolves to a node that is by
        then inside that div, and fields placed in a div inside a group render
        with NO LABEL — which is how DIČ and Typ osoby ended up as two bare,
        unlabelled values with a blank gap where their labels should have been.

        Running before base_vat means `vat` is still a plain child of the group,
        so these two land as proper group rows and stay there when base_vat
        subsequently moves only `vat` away.
    -->
    <record id="res_partner_view_form_cssk" model="ir.ui.view">
        <field name="name">res.partner.form.cssk</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!--
                The IČO of a Czech or Slovak partner, beside the VAT number.

                Core keeps `company_registry` in Sales & Purchase > Misc and
                hides it with `parent_id or not is_company`. Odoo's own
                l10n_sk / l10n_cz each add a second copy before the VAT number
                for partners of their own country, and that is where anyone
                looks for it. But only for the country whose module is
                installed: on a Slovak database without l10n_cz a Czech
                customer's IČO was two clicks away in a tab, which read as
                "there is none" (a signed-up Czech sole trader, 2026-11-24).

                So this module puts it there itself for CZ/SK, and steps back
                (`l10n_cssk_registry_by_country_view`) where the country
                module already does, or it would be there twice.

                Shown on a person and on a child contact as well: stock
                website_sale creates the buyer as a PERSON carrying its own
                `company_registry` (production has ~34 of them), and it is
                the number the invoice depends on. Read-only on a child,
                where the value is the commercial parent's and editing it
                rewrites it for the whole group.
            -->
            <field name="vat" position="before">
                <field name="l10n_cssk_person_type_id"
                       domain="[('country_code', '=', country_code)]"
                       invisible="country_code not in ['CZ', 'SK']"
                       options="{'no_create': True}"/>
                <field name="l10n_cssk_registry_by_country_view" invisible="1"/>
                <field name="company_registry"
                       invisible="country_code not in ['CZ', 'SK'] or l10n_cssk_registry_by_country_view"
                       readonly="parent_id"/>
            </field>

            <!-- Core's copy in Misc stays for every other country and goes
                 for CZ/SK, which now have it above.

                 The spec names the Misc group on purpose. An unqualified
                 //field[@name='company_registry'] resolves to the FIRST one in
                 the combined form, which is the copy beside the VAT number:
                 the rule landed there, core's Misc copy kept showing for
                 companies, and a Slovak company had its IČO twice. -->
            <xpath expr="//group[@name='misc']/field[@name='company_registry']" position="attributes">
                <attribute name="invisible">parent_id or not is_company or country_code in ['CZ', 'SK']</attribute>
            </xpath>
        </field>
    </record>

</odoo>
