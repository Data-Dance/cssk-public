<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reverse drill: smart button on the invoice / journal entry.

         Gated to the groups that can read the filings. The action resolves
         each filing's display_name as the current user, so an Invoicing-only
         ("Billing") user used to see the button and get an access error on
         clicking it. Both groups are listed on purpose: on Community,
         group_account_manager does NOT imply group_account_user. -->
    <record id="view_move_form_cssk_footprint" model="ir.ui.view">
        <field name="name">account.move.form.cssk.footprint</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_cssk_statutory_footprint"
                        class="oe_stat_button" icon="fa-sitemap"
                        groups="account.group_account_user,account.group_account_manager"
                        invisible="state != 'posted'">
                    <span class="o_stat_text">Statutory footprint</span>
                </button>
            </div>
        </field>
    </record>

    <!-- Deduction date: only meaningful on the input side, and only worth
         showing when it actually differs from the accounting date. -->
    <record id="view_move_form_cssk_deduction_date" model="ir.ui.view">
        <field name="name">account.move.form.cssk.deduction.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <!-- Customer documents too. The field's own help documents
                     the § 42 / late-entry OUTPUT case, and
                     ``_cssk_period_move_ids`` deliberately prefers it over the
                     tax point for the tax-point move types — so hiding it on
                     out_invoice / out_refund left the one date that overrides
                     the period settable only by server action or import. -->
                <field name="cssk_vat_deduction_date"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"/>
            </field>
        </field>
    </record>

    <!-- The footprint result dialog -->
    <record id="cssk_statutory_footprint_wizard_form" model="ir.ui.view">
        <field name="name">cssk.statutory.footprint.wizard.form</field>
        <field name="model">cssk.statutory.footprint.wizard</field>
        <field name="arch" type="xml">
            <form string="Statutory footprint">
                <field name="move_id" invisible="1"/>
                <p class="text-muted">
                    Statutory report lines this document feeds:
                </p>
                <field name="line_ids" nolabel="1">
                    <list create="false" delete="false" edit="false"
                          default_order="form, code">
                        <field name="form" string="Report"/>
                        <field name="code" string="Line"/>
                        <field name="name" string="Description"/>
                        <field name="filing_count" column_invisible="1"/>
                        <field name="filing_res_model" column_invisible="1"/>
                        <field name="filing_name" string="Filing"/>
                        <button name="action_open_filing" type="object"
                                icon="fa-arrow-right" title="Open the filing"
                                invisible="not filing_res_model"/>
                    </list>
                </field>
                <!-- Said here rather than left to be inferred: the footprint
                     matches the line DEFINITIONS, so it answers before any
                     return exists. A blank Filing column is that case, not a
                     row that failed to resolve. -->
                <p class="text-muted">
                    A blank filing means no return for this document's period
                    has been generated yet — the rows above are what it would
                    feed.
                </p>
                <footer>
                    <button string="Close" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
