<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cssk_person_type_view_list" model="ir.ui.view">
        <field name="name">cssk.person.type.list</field>
        <field name="model">cssk.person.type</field>
        <field name="arch" type="xml">
            <list string="Person / Entity Types">
                <field name="sequence" widget="handle"/>
                <field name="country_code"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_legal_entity"/>
            </list>
        </field>
    </record>

    <record id="cssk_person_type_view_form" model="ir.ui.view">
        <field name="name">cssk.person.type.form</field>
        <field name="model">cssk.person.type</field>
        <field name="arch" type="xml">
            <form string="Person / Entity Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="country_code"/>
                        </group>
                        <group>
                            <field name="is_legal_entity"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cssk_person_type_action" model="ir.actions.act_window">
        <field name="name">Person / Entity Types</field>
        <field name="res_model">cssk.person.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
