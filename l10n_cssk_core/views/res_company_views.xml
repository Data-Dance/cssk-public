<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_company_view_form_cssk" model="ir.ui.view">
        <field name="name">res.company.form.cssk</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- After the registry number, not after the country: the country
                 sits inside the address block, where a field shows no label. -->
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="l10n_cssk_tax_authority_id"/>
                <field name="l10n_cssk_person_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>
