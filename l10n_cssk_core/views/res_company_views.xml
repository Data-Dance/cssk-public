<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_company_view_form_cssk" model="ir.ui.view">
        <field name="name">res.company.form.cssk</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="l10n_cssk_tax_authority_id"/>
                <field name="l10n_cssk_person_type_id"/>
                <field name="l10n_cssk_registration_info" placeholder="Spoločnosť zapísaná v obchodnom registri…"/>
            </field>
        </field>
    </record>

</odoo>
