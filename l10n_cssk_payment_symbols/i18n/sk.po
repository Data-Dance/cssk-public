#. module: l10n_cssk_payment_symbols
#: model:ir.model.fields,help:l10n_cssk_payment_symbols.field_res_company__l10n_cssk_default_constant_symbol
#: model:ir.model.fields,help:l10n_cssk_payment_symbols.field_res_config_settings__l10n_cssk_default_constant_symbol
msgid ""
"Constant symbol preset on customer documents (e.g. 0008 goods, 0308 "
"services). Leave empty for none."
msgstr ""
"Konštantný symbol predvyplnený na dokladoch vydaných zákazníkom (napr. 0008 "
"tovar, 0308 služby). Ponechajte prázdne, ak žiadny."

#. module: l10n_cssk_payment_symbols
#: model:ir.model.fields,help:l10n_cssk_payment_symbols.field_account_bank_statement_line__l10n_cssk_constant_symbol
#: model:ir.model.fields,help:l10n_cssk_payment_symbols.field_account_move__l10n_cssk_constant_symbol
