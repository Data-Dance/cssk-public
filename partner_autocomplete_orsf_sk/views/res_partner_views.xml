<odoo>
    <!--
        Distinct from the dispatcher's "Update", deliberately.

        Update reads the full company record per partner — everything, but 30
        requests a minute, so a bulk run silently stops after about twenty.
        This one trades depth for reach: identity only, 100 IČOs a call.
    -->
    <record id="action_orsf_bulk_refresh" model="ir.actions.server">
        <field name="name">Refresh identity from ORSF (bulk)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">records.action_orsf_bulk_refresh()</field>
    </record>

    <!--
        Writes l10n_sk_dic where it is empty and nothing else, for partners
        that need a DIČ (Peppol 0245) without having their identity rewritten.
        A no-op without l10n_sk_base, which defines the field.
    -->
    <record id="action_orsf_fill_missing_dic" model="ir.actions.server">
        <field name="name">Fill missing DIČ from ORSF</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_orsf_fill_missing_dic()</field>
    </record>
</odoo>
