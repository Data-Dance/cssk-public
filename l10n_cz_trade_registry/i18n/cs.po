#. module: l10n_cz_trade_registry
#: model:ir.model.fields,help:l10n_cz_trade_registry.field_cssk_tax_authority__l10n_cz_register_office
#: model:ir.model.fields,help:l10n_cz_trade_registry.field_res_company__l10n_cz_register_office
