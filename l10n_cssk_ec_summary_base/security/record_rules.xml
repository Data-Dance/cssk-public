<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cssk_ec_summary_statement_company" model="ir.rule">
        <field name="name">EC sales list: multi-company</field>
        <field name="model_id" ref="model_cssk_ec_summary_statement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cssk_ec_summary_statement_line_company" model="ir.rule">
        <field name="name">EC sales list line: multi-company</field>
        <field name="model_id" ref="model_cssk_ec_summary_statement_line"/>
        <field name="domain_force">[('statement_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
