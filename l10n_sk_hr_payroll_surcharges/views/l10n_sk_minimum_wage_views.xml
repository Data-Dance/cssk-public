<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_sk_minimum_wage_view_list" model="ir.ui.view">
        <field name="name">l10n.sk.minimum.wage.list</field>
        <field name="model">l10n.sk.minimum.wage</field>
        <field name="arch" type="xml">
            <list string="Minimum Wage Claims">
                <field name="date_from"/>
                <field name="level"/>
                <field name="amount_monthly"/>
                <field name="amount_hourly"/>
            </list>
        </field>
    </record>

    <record id="l10n_sk_minimum_wage_view_form" model="ir.ui.view">
        <field name="name">l10n.sk.minimum.wage.form</field>
        <field name="model">l10n.sk.minimum.wage</field>
        <field name="arch" type="xml">
            <form string="Minimum Wage Claim">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="amount_monthly"/>
                            <field name="amount_hourly"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_sk_minimum_wage_view_search" model="ir.ui.view">
        <field name="name">l10n.sk.minimum.wage.search</field>
        <field name="model">l10n.sk.minimum.wage</field>
        <field name="arch" type="xml">
            <search string="Minimum Wage Claims">
                <field name="date_from"/>
                <field name="level"/>
                <group>
                    <filter name="group_date_from" string="Effective From"
                            context="{'group_by': 'date_from'}"/>
                    <filter name="group_level" string="Stupeň náročnosti"
                            context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_sk_minimum_wage_action" model="ir.actions.act_window">
        <field name="name">Minimum Wage Claims</field>
        <field name="res_model">l10n.sk.minimum.wage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_date_from': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a minimum wage claim</p>
            <p>
                Minimálne mzdové nároky for the six stupne náročnosti práce
                (§ 120 Zákonníka práce). The level-1 hourly figure is also the
                base of the night, weekend and difficult-work surcharges.
            </p>
        </field>
    </record>
</odoo>
