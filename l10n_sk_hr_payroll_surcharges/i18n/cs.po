#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_hr_employee__l10n_sk_wage_level
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_hr_job__l10n_sk_wage_level
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_hr_version__l10n_sk_wage_level
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_l10n_sk_minimum_wage__level
#: model_terms:ir.ui.view,arch_db:l10n_sk_hr_payroll_surcharges.l10n_sk_minimum_wage_view_search
msgid "Stupeň náročnosti"
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_sk_surcharge_payslip_mixin__l10n_sk_surcharge_total
msgid ""
"Sum of every statutory wage surcharge on this payslip. Shown for reference; "
"the individual amounts are separate payslip lines."
msgstr ""
"Součet všech zákonných příplatků ke mzdě na této výplatní pásce. Jen pro "
"informaci; jednotlivé částky jsou samostatné řádky výplatní pásky."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nedela_pct
msgid "Sunday %"
msgstr "Neděle %"

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nedela_reduced_pct
msgid "Sunday % (reduced)"
msgstr "Neděle % (snížená)"

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.ui.menu,name:l10n_sk_hr_payroll_surcharges.menu_l10n_sk_wage_surcharge_rate
msgid "Surcharge Rates"
msgstr "Sazby příplatků"

#. module: l10n_sk_hr_payroll_surcharges
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_surcharges/models/hr_version.py:0
msgid ""
"The agreed wage of %(wage).2f is below the minimum wage claim of %(due).2f "
"for stupeň náročnosti %(level)s (§ 120 Zákonníka práce). The payslip will "
"top it up, but the contract itself does not meet the statutory minimum."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_surcharges/models/sk_surcharge_payslip_mixin.py:0
msgid ""
"The average-earnings helper is missing. Install one of the Slovak payroll "
"modules (l10n_sk_hr_payroll_oca or l10n_sk_hr_payroll_ee) — the holiday and "
"overtime surcharges are percentages of average earnings and cannot be "
"computed without it."
msgstr ""
"Chybí pomocník pro výpočet průměrného výdělku. Nainstalujte jeden ze "
"slovenských mzdových modulů (l10n_sk_hr_payroll_oca nebo "
"l10n_sk_hr_payroll_ee) — příplatky za svátek a přesčas jsou procentem "
"průměrného výdělku a bez něj je nelze vypočítat."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_employee__l10n_sk_risk_work
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_version__l10n_sk_risk_work
msgid ""
"The work is classified in category 3 or 4 (riziková práca), raising the "
"night surcharge to 50 % and the overtime surcharge to 35 %. It also rules "
"out the reduced night rate."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__standard_weekly_hours
msgid ""
"Ustanovený týždenný pracovný čas per § 85 ods. 5 ZP — the reference week the"
" hourly minimum-wage claims are stated against. § 120 ods. 5 raises those "
"claims in proportion where the employer's established week is shorter. Dated"
" here rather than hardcoded so an amendment is a data change."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model_terms:ir.ui.view,arch_db:l10n_sk_hr_payroll_surcharges.l10n_sk_wage_surcharge_rate_view_form
msgid "Wage Surcharge Rate"
msgstr "Sazba mzdového příplatku"

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.actions.act_window,name:l10n_sk_hr_payroll_surcharges.l10n_sk_wage_surcharge_rate_action
#: model_terms:ir.ui.view,arch_db:l10n_sk_hr_payroll_surcharges.l10n_sk_wage_surcharge_rate_view_list
msgid "Wage Surcharge Rates"
msgstr "Sazby mzdových příplatků"

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,field_description:l10n_sk_hr_payroll_surcharges.field_sk_surcharge_payslip_mixin__l10n_sk_surcharge_total
msgid "Wage Surcharges"
msgstr "Příplatky ke mzdě"

#. module: l10n_sk_hr_payroll_surcharges
#. odoo-python
#: code:addons/l10n_sk_hr_payroll_surcharges/models/l10n_sk_wage_surcharge_rate.py:0
msgid "Wage surcharges from %(date)s"
msgstr "Mzdové příplatky od %(date)s"

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nadcas_pct
msgid ""
"§ 121 ods. 1 — at least 25 % of average earnings on top of the wage for the "
"overtime hour itself."
msgstr ""
"§ 121 odst. 1 — nejméně 25 % průměrného výdělku navíc ke mzdě za samotnou "
"hodinu práce přesčas."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nadcas_risk_pct
msgid ""
"§ 121 ods. 1 — at least 35 % where the work is classified as risky (riziková"
" práca)."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__sviatok_pct
msgid ""
"§ 122 ods. 1 — at least 100 % of average earnings for work performed on a "
"public holiday."
msgstr "§ 122 odst. 1 — nejméně 100 % průměrného výdělku za práci ve svátek."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__sobota_pct
msgid "§ 122a ods. 1 — at least 50 % of the minimum hourly wage."
msgstr "§ 122a odst. 1 — nejméně 50 % minimální hodinové mzdy."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_employee__l10n_sk_saturday_reduced
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_version__l10n_sk_saturday_reduced
msgid ""
"§ 122a ods. 2 — a collective agreement (or, at an employer with no trade "
"union and fewer than 20 employees on 31 December of the previous year, the "
"employment contract) sets the Saturday surcharge at the lower statutory "
"floor because the nature of the work requires regular work on Saturdays."
msgstr ""
"§ 122a odst. 2 — kolektivní smlouva (nebo u zaměstnavatele bez odborové "
"organizace s méně než 20 zaměstnanci k 31. prosinci předchozího roku "
"pracovní smlouva) stanoví příplatek za sobotu na nižší zákonné hranici, "
"protože povaha práce vyžaduje pravidelnou práci v sobotu."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__sobota_reduced_pct
msgid ""
"§ 122a ods. 2 — at least 45 %, agreed in a collective agreement (or in the "
"employment contract at an employer with no trade union and fewer than 20 "
"employees on 31 December of the previous year) where the nature of the work "
"requires regular work on Saturdays."
msgstr ""
"§ 122a odst. 2 — nejméně 45 %, sjednáno v kolektivní smlouvě (nebo v "
"pracovní smlouvě u zaměstnavatele bez odborové organizace s méně než 20 "
"zaměstnanci k 31. prosinci předchozího roku), pokud povaha práce vyžaduje "
"pravidelnou práci v sobotu."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nedela_pct
msgid "§ 122b ods. 1 — at least 100 % of the minimum hourly wage."
msgstr "§ 122b odst. 1 — nejméně 100 % minimální hodinové mzdy."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_employee__l10n_sk_sunday_reduced
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_version__l10n_sk_sunday_reduced
msgid ""
"§ 122b ods. 2 — a collective agreement (or, at an employer with no trade "
"union and fewer than 20 employees on 31 December of the previous year, the "
"employment contract) sets the Sunday surcharge at the lower statutory floor "
"because the nature of the work requires regular work on Sundays."
msgstr ""
"§ 122b odst. 2 — kolektivní smlouva (nebo u zaměstnavatele bez odborové "
"organizace s méně než 20 zaměstnanci k 31. prosinci předchozího roku "
"pracovní smlouva) stanoví příplatek za neděli na nižší zákonné hranici, "
"protože povaha práce vyžaduje pravidelnou práci v neděli."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__nedela_reduced_pct
msgid ""
"§ 122b ods. 2 — at least 90 %, agreed in a collective agreement (or in the "
"employment contract at an employer with no trade union and fewer than 20 "
"employees on 31 December of the previous year) where the nature of the work "
"requires regular work on Sundays."
msgstr ""
"§ 122b odst. 2 — nejméně 90 %, sjednáno v kolektivní smlouvě (nebo v "
"pracovní smlouvě u zaměstnavatele bez odborové organizace s méně než 20 "
"zaměstnanci k 31. prosinci předchozího roku), pokud povaha práce vyžaduje "
"pravidelnou práci v neděli."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__noc_pct
msgid "§ 123 ods. 1 — at least 40 % of the minimum hourly wage."
msgstr "§ 123 odst. 1 — nejméně 40 % minimální hodinové mzdy."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__noc_risk_pct
msgid ""
"§ 123 ods. 1 — at least 50 % where the work is classified as risky (riziková"
" práca)."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_employee__l10n_sk_night_reduced
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_hr_version__l10n_sk_night_reduced
msgid ""
"§ 123 ods. 2 — a collective agreement (or, at an employer with no trade "
"union and fewer than 20 employees on 31 December of the previous year, the "
"employment contract) sets the night surcharge at the lower statutory floor "
"because the predominant part of the work is performed at night. Ignored for "
"risky work."
msgstr ""
"§ 123 odst. 2 — kolektivní smlouva (nebo u zaměstnavatele bez odborové "
"organizace s méně než 20 zaměstnanci k 31. prosinci předchozího roku "
"pracovní smlouva) stanoví příplatek za noční práci na nižší zákonné hranici,"
" protože převážná část práce se vykonává v noci. U rizikové práce se "
"nepoužije."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__noc_reduced_pct
msgid ""
"§ 123 ods. 2 — at least 35 %, agreed in a collective agreement (or in the "
"employment contract at an employer with no trade union and fewer than 20 "
"employees on 31 December of the previous year) where the predominant part of"
" the work is performed at night; never for risky work."
msgstr ""
"§ 123 odst. 2 — nejméně 35 %, sjednáno v kolektivní smlouvě (nebo v pracovní"
" smlouvě u zaměstnavatele bez odborové organizace s méně než 20 zaměstnanci "
"k 31. prosinci předchozího roku), pokud se převážná část práce vykonává v "
"noci; nikdy u rizikové práce."

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__stazeny_pct
msgid ""
"§ 124 ods. 3 — mzdová kompenzácia za sťažený výkon práce, at least 20 % of "
"the minimum hourly wage."
msgstr ""

#. module: l10n_sk_hr_payroll_surcharges
#: model:ir.model.fields,help:l10n_sk_hr_payroll_surcharges.field_l10n_sk_wage_surcharge_rate__pohotovost_pct
msgid ""
"§ 96 ods. 5 — at least 20 % of the minimum hourly wage for each hour of "
"inactive standby away from the workplace."
msgstr ""
"§ 96 odst. 5 — nejméně 20 % minimální hodinové mzdy za každou hodinu "
"neaktivní pracovní pohotovosti mimo pracoviště."
