<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Minimálne mzdové nároky pre stupne náročnosti práce (§ 120 Zákonníka
        práce, zákon č. 311/2001 Z. z.).

        § 120 ods. 4 derives each level from the 2020 anchor of €580 and the
        coefficients 1.0 / 1.2 / 1.4 / 1.6 / 1.8 / 2.0:

            nárok(stupeň) = (MM_rok − 580) + 580 × koeficient(stupeň)

        The results are published annually and those published figures are
        shipped verbatim here rather than recomputed — see the model docstring.
        Level 1 equals the plain monthly minimum wage of the year, and its
        hourly figure is the ``minimálna mzda v eurách za hodinu`` that the
        night / Saturday / Sunday / difficult-work / standby surcharges are
        percentages of.

        Hourly figures are the monthly amount over the statutory 174 hours,
        rounded to three decimals, and apply to a 40-hour week; a shorter
        established week raises them (§ 120 ods. 5, handled in code).
    -->

    <!-- ================================================================ 2024 -->
    <!-- Monthly minimum wage €750 (nariadenie vlády č. 300/2023 Z. z.). -->
    <record id="min_wage_2024_1" model="l10n.sk.minimum.wage">
        <field name="date_from" eval="datetime(2024, 1, 1).date()"/>
        <field name="level">1</field>
        <field name="amount_monthly">750</field>
        <field name="amount_hourly">4.310</field>
