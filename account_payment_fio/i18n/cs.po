#. module: account_payment_fio
#: model:ir.model.fields.selection,name:account_payment_fio.selection__account_payment_line__iso20022_priority__urgp
msgid "Urgent"
msgstr "Urgentní"

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__iso20022_priority
msgid ""
"Urgent asks the bank for express processing, at its express fee. Used by "
"MultiCash CFA, KB BEST and Fio."
msgstr ""
"Urgentní žádá banku o expresní zpracování za její expresní poplatek. "
"Používají MultiCash CFA, KB BEST a Fio."

#. module: account_payment_fio
#: model:ir.model.fields,field_description:account_payment_fio.field_account_payment_line__variable_symbol
msgid "Variable Symbol"
msgstr "Variabilní symbol"

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__iso20022_charge_bearer
msgid ""
"Who pays the bank charges of a foreign payment. Into the EEA, banks accept "
"Shared only."
msgstr ""
"Kdo platí bankovní poplatky zahraniční platby. Do EHP banky přijímají jen "
"sdílené."

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__fio_payment_reason
msgid ""
"ČNB payment reason. Fio requires one on every foreign payment and, for "
"accounts at its Slovak branch, on a Europlatba above EUR 50 000. Defaults "
"from the partner."
msgstr ""
"Platební titul ČNB. Fio jej vyžaduje u každé zahraniční platby a u účtů "
"vedených na slovenské pobočce také u Europlatby nad 50 000 EUR. Výchozí "
"hodnota se přebírá z partnera."

#. module: account_payment_fio
