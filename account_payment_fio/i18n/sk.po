#. module: account_payment_fio
#. odoo-python
#: code:addons/account_payment_fio/models/account_payment_line.py:0
msgid "%(label)s must be a numeric string up to %(max_len)s digits."
msgstr "%(label)s musí byť číselný reťazec s najviac %(max_len)s číslicami."

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid ""
".\n"
"                    It is <b>not paid yet</b>: somebody with signing rights has\n"
"                    to authorise the batch in Fio internet banking."
msgstr ""
". Ešte <b>nie je zaplatené</b>: dávku musí v internetbankingu Fio "
"autorizovať niekto s podpisovým právom."

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid ""
"<b>The bank's answer to the last upload was lost.</b>\n"
"                    Fio may or may not be holding this batch. Open internet\n"
"                    banking, look for an unauthorised batch, and tell Odoo what\n"
"                    you found — sending again without checking would pay\n"
"                    everything twice."
msgstr ""
"<b>Odpoveď banky na posledné odoslanie sa stratila.</b> Fio túto dávku možno"
" má, možno nie. Otvorte internetbanking, vyhľadajte neautorizovanú dávku a "
"oznámte Odoo, čo ste našli — opätovné odoslanie bez kontroly by všetko "
"zaplatilo dvakrát."

