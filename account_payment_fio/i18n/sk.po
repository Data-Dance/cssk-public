msgid "Constant Symbol"
msgstr "Konštantný symbol"

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__constant_symbol
msgid ""
"Czech/Slovak payment Constant Symbol (KS). Up to 4 digits. If empty, falls "
"back to a `KS:` token in the communication."
msgstr ""
"Český/slovenský konštantný symbol (KS). Najviac 4 číslice. Ak zostane "
"prázdny, použije sa údaj `KS:` zo správy pre príjemcu."

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__specific_symbol
msgid ""
"Czech/Slovak payment Specific Symbol (SS). Up to 10 digits. If empty, falls "
"back to a `SS:` token in the communication."
msgstr ""
"Český/slovenský špecifický symbol (SS). Najviac 10 číslic. Ak zostane "
"prázdny, použije sa údaj `SS:` zo správy pre príjemcu."

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__variable_symbol
msgid ""
"Czech/Slovak payment Variable Symbol (VS). Up to 10 digits. If empty, falls "
"back to a `VS:` token in the communication."
msgstr ""
"Český/slovenský variabilný symbol (VS). Najviac 10 číslic. Ak zostane "
"prázdny, použije sa údaj `VS:` zo správy pre príjemcu."

