#. module: account_payment_fio
#. odoo-python
#: code:addons/account_payment_fio/models/account_payment_line.py:0
msgid "%(label)s must be a numeric string up to %(max_len)s digits."
msgstr "%(label)s musí byť číselný reťazec s najviac %(max_len)s číslicami."

#. module: account_payment_fio
#: model:ir.module.module,summary:base.module_account_payment_fio
msgid ""
"Build Fio XML payment orders and send them to the bank from an OCA payment "
"order."
msgstr ""
"Zostaví platobné príkazy vo formáte Fio XML a odošle ich do banky z "
"platobného príkazu OCA."

#. module: account_payment_fio
#: model:ir.model.fields,field_description:account_payment_fio.field_account_payment_line__constant_symbol
msgid "Constant Symbol"
msgstr "Konštantný symbol"

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__constant_symbol
msgid ""
"Czech/Slovak payment Constant Symbol (KS). Up to 4 digits. If empty, falls "
"back to a `KS:` token in the communication."
msgstr ""
"Český/slovenský konštantný symbol (KS). Najviac 4 číslice. Ak zostane "
"prázdny, použije sa údaj `KS:` zo správy pre príjemcu."

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__specific_symbol
msgid ""
"Czech/Slovak payment Specific Symbol (SS). Up to 10 digits. If empty, falls "
"back to a `SS:` token in the communication."
msgstr ""
"Český/slovenský špecifický symbol (SS). Najviac 10 číslic. Ak zostane "
"prázdny, použije sa údaj `SS:` zo správy pre príjemcu."

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__variable_symbol
msgid ""
"Czech/Slovak payment Variable Symbol (VS). Up to 10 digits. If empty, falls "
"back to a `VS:` token in the communication."
msgstr ""
"Český/slovenský variabilný symbol (VS). Najviac 10 číslic. Ak zostane "
"prázdny, použije sa údaj `VS:` zo správy pre príjemcu."

#. module: account_payment_fio
#: model:ir.module.module,shortdesc:base.module_account_payment_fio
msgid "Fio banka — payment orders"
msgstr "Fio banka — platobné príkazy"

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid "It IS in the bank"
msgstr "V banke JE"

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid "It is NOT in the bank"
msgstr "V banke NIE JE"

#. module: account_payment_fio
#. odoo-python
#: code:addons/account_payment_fio/models/account_payment_order.py:0
msgid ""
"Journal %(journal)s has no bank account, so Fio cannot be told which account"
" the money leaves."
msgstr ""
"Denník %(journal)s nemá bankový účet, takže nemožno Fio oznámiť, z ktorého "
"účtu peniaze odchádzajú."

#. module: account_payment_fio
#. odoo-python
#: code:addons/account_payment_fio/models/account_payment_order.py:0
msgid "No payment file on this order — generate it first."
msgstr "K tomuto príkazu nie je platobný súbor — najprv ho vygenerujte."

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid ""
"Only press this after checking Fio internet banking and finding no batch. It"
" allows Odoo to send these payments again."
msgstr ""
"Stlačte až potom, čo v internet bankingu Fio žiadnu dávku nenájdete. Umožní "
"to Odoo odoslať tieto platby znova."

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid ""
"Only press this after finding the batch in Fio internet banking. It stops "
"Odoo from sending these payments again."
msgstr ""
"Stlačte až potom, čo dávku nájdete v internet bankingu Fio. Zabráni to Odoo "
"odoslať tieto platby znova."

#. module: account_payment_fio
#: model:ir.model.fields,field_description:account_payment_fio.field_account_payment_line__fio_payment_reason
msgid "Platební titul"
msgstr "Platobný titul"

#. module: account_payment_fio
#: model_terms:ir.ui.view,arch_db:account_payment_fio.account_payment_order_view_form_fio
msgid "Send to Fio"
msgstr "Odoslať do Fio"

#. module: account_payment_fio
#: model:ir.model.fields,field_description:account_payment_fio.field_account_payment_line__specific_symbol
msgid "Specific Symbol"
msgstr "Špecifický symbol"

#. module: account_payment_fio
#. odoo-python
#: code:addons/account_payment_fio/models/account_payment_order.py:0
msgid ""
"This payment order cannot be sent to Fio yet:\n"
"\n"
"%(problems)s"
msgstr ""
"Tento platobný príkaz zatiaľ nemožno odoslať do Fio:\n"
"\n"
"%(problems)s"

#. module: account_payment_fio
#: model:ir.model.fields,field_description:account_payment_fio.field_account_payment_line__variable_symbol
msgid "Variable Symbol"
msgstr "Variabilný symbol"

#. module: account_payment_fio
#: model:ir.model.fields,help:account_payment_fio.field_account_payment_line__fio_payment_reason
msgid ""
"ČNB payment reason. Fio requires one on every foreign payment and, for "
"accounts at its Slovak branch, on a Europlatba above EUR 50 000. Defaults "
"from the partner."
msgstr ""
"Platobný titul ČNB. Fio ho vyžaduje pri každej zahraničnej platbe a pri "
"účtoch vedených na slovenskej pobočke aj pri Europlatbe nad 50 000 EUR. "
"Predvolená hodnota sa preberá z partnera."
