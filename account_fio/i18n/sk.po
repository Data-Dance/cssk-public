#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"A Fio token is a 64-character string (§2 of the API documentation). Got "
"%(length)s characters — the value was probably truncated when it was copied."
msgstr ""
"Token Fio je 64-znakový reťazec (§2 dokumentácie API). Zadaných %(length)s "
"znakov — hodnota sa pravdepodobne pri kopírovaní skrátila."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"Another Fio operation is running on %(name)s. Fio allows one call per token "
"every 30 seconds, so this one has to wait — try again shortly."
msgstr ""
"Na %(name)s práve prebieha iná operácia Fio. Fio povoľuje jedno volanie na "
"token za 30 sekúnd, takže táto musí počkať — skúste to prosím o chvíľu "
"znova."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Cannot tell what format the payment file is in, so Fio cannot be told "
"either."
msgstr ""
"Nedá sa určiť formát platobného súboru, takže ho nemožno oznámiť ani Fio."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Confirmed by %(user)s: the batch IS in Fio internet banking and must not be "
"sent again."
msgstr ""
"Potvrdil %(user)s: dávka V internet bankingu Fio JE a nesmie byť odoslaná "
"znova."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Confirmed by %(user)s: the batch is NOT in Fio internet banking, so it can "
"be sent again."
msgstr ""
"Potvrdil %(user)s: dávka v internet bankingu Fio NIE JE, takže ju možno "
"odoslať znova."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"Connected. Fio reports account %(account)s/%(bank)s (%(iban)s), currency "
"%(currency)s."
msgstr ""
"Pripojené. Fio hlási účet %(account)s/%(bank)s (%(iban)s), mena "
"%(currency)s."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid "Fio %(label)s expires"
msgstr "Platnosť tokenu Fio (%(label)s) končí"

