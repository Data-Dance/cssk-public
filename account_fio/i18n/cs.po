#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"A Fio token is a 64-character string (§2 of the API documentation). Got "
"%(length)s characters — the value was probably truncated when it was copied."
msgstr ""
"Token Fio je 64znakový řetězec (§2 dokumentace API). Zadáno %(length)s znaků"
" — hodnota se pravděpodobně při kopírování zkrátila."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"Another Fio operation is running on %(name)s. Fio allows one call per token "
"every 30 seconds, so this one has to wait — try again shortly."
msgstr ""
"Na %(name)s právě probíhá jiná operace Fio. Fio povoluje jedno volání na "
"token za 30 sekund, takže tato musí počkat — zkuste to prosím za chvíli "
"znovu."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Cannot tell what format the payment file is in, so Fio cannot be told "
"either."
msgstr ""
"Nelze určit formát platebního souboru, takže jej nelze sdělit ani Fio."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Confirmed by %(user)s: the batch IS in Fio internet banking and must not be "
"sent again."
msgstr ""
"Potvrzeno uživatelem %(user)s: dávka V internetovém bankovnictví Fio JE a "
"nesmí být odeslána znovu."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/fio_upload_mixin.py:0
msgid ""
"Confirmed by %(user)s: the batch is NOT in Fio internet banking, so it can "
"be sent again."
msgstr ""
"Potvrzeno uživatelem %(user)s: dávka v internetovém bankovnictví Fio NENÍ, "
"takže ji lze odeslat znovu."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid ""
"Connected. Fio reports account %(account)s/%(bank)s (%(iban)s), currency "
"%(currency)s."
msgstr ""
"Připojeno. Fio hlásí účet %(account)s/%(bank)s (%(iban)s), měna "
"%(currency)s."

#. module: account_fio
#. odoo-python
#: code:addons/account_fio/models/account_journal.py:0
msgid "Fio %(label)s expires"
msgstr "Platnost tokenu Fio (%(label)s) končí"

