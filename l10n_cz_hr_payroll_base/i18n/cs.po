#. module: l10n_cz_hr_payroll_base
#: model_terms:ir.ui.view,arch_db:l10n_cz_hr_payroll_base.res_config_settings_view_form_l10n_cz_payroll
msgid "Short-time work compensation (§ 209)"
msgstr "Náhrada mzdy při částečné nezaměstnanosti (§ 209)"

#. module: l10n_cz_hr_payroll_base
#. odoo-python
#: code:addons/l10n_cz_hr_payroll_base/models/res_company.py:0
msgid "The short-time work compensation must be between 0 % and 100 %."
msgstr "Náhrada mzdy při částečné nezaměstnanosti musí být mezi 0 % a 100 %."

#. module: l10n_cz_hr_payroll_base
#: model_terms:ir.ui.view,arch_db:l10n_cz_hr_payroll_base.res_config_settings_view_form_l10n_cz_payroll
msgid ""
"Percentage of average earnings paid for částečná nezaměstnanost. 100 % "
"unless an agreement with the trade union or an internal regulation sets less"
" (not below 60 %)."
msgstr "Procento průměrného výdělku vyplácené při částečné nezaměstnanosti. 100 %, nestanoví-li nižší sazbu dohoda s odborovou organizací nebo vnitřní předpis (nejméně 60 %)."

#. module: l10n_cz_hr_payroll_base
#: model:ir.model.fields,help:l10n_cz_hr_payroll_base.field_res_company__l10n_cz_partial_unemployment_pct
#: model:ir.model.fields,help:l10n_cz_hr_payroll_base.field_res_config_settings__l10n_cz_partial_unemployment_pct
msgid ""
"Wage compensation for částečná nezaměstnanost (§ 209 of the Labour Code), as"
" a percentage of average earnings. Without an agreement with the trade "
"union, or an internal regulation where there is no union, it is a jiná "
"překážka na straně zaměstnavatele under § 208 and paid in full: leave 100 %."
" Enter the agreed rate only when such an agreement or regulation exists; "
"payslips never pay less than the statutory minimum of 60 %."
msgstr "Náhrada mzdy při částečné nezaměstnanosti (§ 209 zákoníku práce) v procentech průměrného výdělku. Bez dohody s odborovou organizací, nebo vnitřního předpisu tam, kde odborová organizace nepůsobí, jde o jinou překážku na straně zaměstnavatele podle § 208 a náhrada přísluší v plné výši: ponechte 100 %. Sjednanou sazbu zadejte jen tehdy, když taková dohoda nebo předpis existuje; výplatní páska nikdy nezaplatí méně než zákonných 60 %."

#. module: l10n_cz_hr_payroll_base
