<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Statutory Czech annual leave (dovolená) accrual plans.

        LEGAL BASIS (zákoník práce, zák. č. 262/2006 Sb., stav 2025/2026;
        dovolená is HOURS-based since 1. 1. 2021):
          * § 212 Výměra dovolené: minimum 4 týdny/rok (odst. 1); 5 týdnů pro
            zaměstnavatele dle § 109 odst. 3 (stát, ÚSC, příspěvkové organizace)
            (odst. 2); 8 týdnů pedagogičtí a akademičtí pracovníci (odst. 3).
            Zaměstnavatel může poskytnout více (5 týdnů je běžné v soukromém sektoru).
          * § 213 Dovolená za kalendářní rok a její poměrná část:
              - odst. 1: kdo odpracoval 52 týdnů v rozsahu stanovené týdenní
                pracovní doby -> plná dovolená = (týdenní pracovní doba) x (výměra).
                Např. 40 h/týden x 4 týdny = 160 h/rok; 40 h x 5 týdnů = 200 h/rok.
              - odst. 3: poměrná část náleží při odpracování alespoň 4 týdnů.
              - odst. 4: za každou odpracovanou stanovenou (nebo kratší) týdenní
                pracovní dobu náleží 1/52 z (týdenní pracovní doba x výměra).
            Práce přesčas se do odpracované doby započítává a zvyšuje nárok poměrně.
          * § 218 Čerpání / převod: dovolenou, kterou nelze vyčerpat v roce vzniku
            (odst. 1), nebo její část nad 4 týdny převedenou na písemnou žádost
            zaměstnance (odst. 2), je zaměstnavatel povinen určit tak, aby byla
            vyčerpána nejpozději do konce následujícího kalendářního roku (odst. 3).
            Neurčí-li ji do 30. června následujícího roku, smí čerpání určit i
            zaměstnanec (odst. 4); brání-li čerpání pracovní neschopnost nebo
            mateřská/rodičovská dovolená, určí se po jejich skončení (odst. 5).
            ZÁKON NEZNÁ PROPADNUTÍ DOVOLENÉ: převedený nárok trvá, dokud není
            vyčerpán, a při skončení pracovního poměru se nahradí (§ 222 odst. 2).
            Proto can_be_carryover = True a ŽÁDNÁ platnost převedených hodin
            (accrual_validity = False). Lhůta konce následujícího roku je povinnost
            zaměstnavatele dovolenou určit, nikoli datum zániku nároku.

        MODELLING ASSUMPTION (human-verify):
        Odoo accrual plans grant a FIXED number of hours per period; they cannot
        read the employee's contractual weekly hours. These plans are therefore
        calibrated for the standard full-time týdenní pracovní doba of 40 h/týden.
        The § 213 odst. 4 mechanic (1/52 of weekly hours per worked week) is encoded
        as a WEEKLY accrual of výměra x 40 / 52 hours, based on worked time, so a
        full year yields the full entitlement (160 h / 200 h) and a partial year
        yields the poměrná část automatically. For other weekly hours (part-time,
        37.5 h, DPP/DPČ fiktivních 20 h) an admin must scale added_value pro rata
        (e.g. 20 h/týden 4 týdny -> 80 h/rok -> added_value = 80/52 = 1.538462).
        The § 213 odst. 3 "at least 4 weeks" threshold and rounding to whole hours
        are simplifications not enforced by the plan.

        The plans are GENERIC (no time_off_type_id) so their hour-based levels are
        not coerced to days by the day-based CZ holiday leave type; an admin assigns
        the appropriate plan when creating an employee's dovolená allocation.
        Sources:
          https://www.pracomat.cz/poradna/zakonik-prace/138-zakonik-prace-cast-9-hlava-2-dil-1.html
          https://ppropo.mpsv.cz/X1Dovolenazakalendarnirokajejipo
    -->

    <!-- 4 týdny (statutory minimum, private sector) = 160 h/rok @ 40 h/týden -->
    <record id="accrual_plan_cz_holiday_4w" model="hr.leave.accrual.plan">
        <field name="name">Statutory annual leave — 4 weeks (160 h/year)</field>
        <field name="accrued_gain_time">end</field>
        <field name="is_based_on_worked_time" eval="True"/>
        <field name="can_be_carryover" eval="True"/>
        <field name="carryover_date">year_start</field>
    </record>
    <record id="accrual_plan_cz_holiday_4w_level" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="accrual_plan_cz_holiday_4w"/>
        <!-- 1/52 of (40 h x 4 týdny) per worked week = 160/52 = 3.076923 h/týden -->
        <field name="added_value">3.076923</field>
        <field name="added_value_type">hour</field>
        <field name="frequency">weekly</field>
        <field name="week_day">0</field>
        <field name="cap_accrued_time" eval="False"/>
        <field name="action_with_unused_accruals">all</field>
        <!-- § 218: carried-over dovolená does NOT lapse. The employer must schedule
             it by the end of the following year (odst. 3), the employee may do so
             from 1 July (odst. 4), and unused leave is compensated only when the
             employment ends (§ 222 odst. 2). So no validity on carried hours. -->
        <field name="accrual_validity" eval="False"/>
    </record>

    <!-- 5 týdnů (common private-sector benefit / § 109 odst. 3) = 200 h/rok @ 40 h/týden -->
    <record id="accrual_plan_cz_holiday_5w" model="hr.leave.accrual.plan">
        <field name="name">Annual leave — 5 weeks (200 h/year)</field>
        <field name="accrued_gain_time">end</field>
        <field name="is_based_on_worked_time" eval="True"/>
        <field name="can_be_carryover" eval="True"/>
        <field name="carryover_date">year_start</field>
    </record>
    <record id="accrual_plan_cz_holiday_5w_level" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="accrual_plan_cz_holiday_5w"/>
        <!-- 1/52 of (40 h x 5 týdnů) per worked week = 200/52 = 3.846154 h/týden -->
        <field name="added_value">3.846154</field>
        <field name="added_value_type">hour</field>
        <field name="frequency">weekly</field>
        <field name="week_day">0</field>
        <field name="cap_accrued_time" eval="False"/>
        <field name="action_with_unused_accruals">all</field>
        <!-- § 218: carried-over dovolená does NOT lapse - no validity. -->
        <field name="accrual_validity" eval="False"/>
    </record>

    <!--
        ============================================================================
        DOVOLENÁ — "full annual entitlement granted on 1 January"
        ============================================================================
        Alternative to the per-worked-week accrual (accrual_plan_cz_holiday_4w/_5w).
        Some employers grant the WHOLE year's dovolená up front on 1. 1. instead of
        letting it accrue 1/52 per worked week (zák. č. 262/2006 Sb., § 213). These
        plans grant the full entitlement in one yearly milestone at the start of the
        period and are NOT based on worked time, so a leaver who has taken more than
        the pro-rata share must be settled/reclaimed manually (§ 222 odst. 4).
        Like the default plans they carry unused days over (§ 218) WITHOUT any
        expiry: the law has no forfeiture of dovolená. The employer must schedule
        carried leave by the end of the following year (§ 218 odst. 3), the employee
        may schedule it from 1 July of that year (odst. 4), and leave still unused
        when the employment ends is compensated (§ 222 odst. 2).
        Calibrated for the standard 40 h/týden full-time week:
          4 týdny = 40 h × 4 = 160 h/rok ; 5 týdnů = 40 h × 5 = 200 h/rok.

        Shipped ARCHIVED (active=False): an alternative to the per-worked-week
        plans above, to be un-archived explicitly by a company that wants it.
    -->
    <record id="accrual_plan_cz_holiday_4w_yearstart" model="hr.leave.accrual.plan">
        <field name="name">Annual leave — 4 weeks, full entitlement on 1 Jan (160 h)</field>
        <field name="active" eval="False"/>
        <field name="accrued_gain_time">start</field>
        <field name="is_based_on_worked_time" eval="False"/>
        <field name="can_be_carryover" eval="True"/>
        <field name="carryover_date">year_start</field>
    </record>
    <record id="accrual_plan_cz_holiday_4w_yearstart_level" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="accrual_plan_cz_holiday_4w_yearstart"/>
        <!-- whole year granted in one milestone: 40 h × 4 týdny = 160 h -->
        <field name="added_value">160</field>
        <field name="added_value_type">hour</field>
        <field name="frequency">yearly</field>
        <field name="yearly_month">1</field>
        <field name="yearly_day">1</field>
        <field name="cap_accrued_time" eval="False"/>
        <field name="action_with_unused_accruals">all</field>
        <!-- § 218: carried-over dovolená does NOT lapse - no validity. -->
        <field name="accrual_validity" eval="False"/>
    </record>

    <record id="accrual_plan_cz_holiday_5w_yearstart" model="hr.leave.accrual.plan">
        <field name="name">Annual leave — 5 weeks, full entitlement on 1 Jan (200 h)</field>
        <field name="active" eval="False"/>
        <field name="accrued_gain_time">start</field>
        <field name="is_based_on_worked_time" eval="False"/>
        <field name="can_be_carryover" eval="True"/>
        <field name="carryover_date">year_start</field>
    </record>
    <record id="accrual_plan_cz_holiday_5w_yearstart_level" model="hr.leave.accrual.level">
        <field name="accrual_plan_id" ref="accrual_plan_cz_holiday_5w_yearstart"/>
        <!-- whole year granted in one milestone: 40 h × 5 týdnů = 200 h -->
        <field name="added_value">200</field>
        <field name="added_value_type">hour</field>
        <field name="frequency">yearly</field>
        <field name="yearly_month">1</field>
        <field name="yearly_day">1</field>
        <field name="cap_accrued_time" eval="False"/>
        <field name="action_with_unused_accruals">all</field>
        <!-- § 218: carried-over dovolená does NOT lapse - no validity. -->
        <field name="accrual_validity" eval="False"/>
    </record>
</odoo>
