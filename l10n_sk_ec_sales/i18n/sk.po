#. module: l10n_sk_ec_sales
#: model_terms:ir.ui.view,arch_db:l10n_sk_ec_sales.sdv_2025
msgid "SK"
msgstr "SK"

#. module: l10n_sk_ec_sales
#: model:ir.module.module,summary:base.module_l10n_sk_ec_sales
msgid ""
"Slovak EC sales list (Súhrnný výkaz) — codes 0/1/2 (goods / triangulation / "
"services), FS SR SDV XML export. Built on the shared "
"l10n_cssk_ec_summary_base framework."
msgstr ""
"Slovenský súhrnný výkaz — kódy 0/1/2 (tovar / trojstranný obchod / "
"služby), export XML SDV pre FS SR. Postavené na spoločnom rámci "
"l10n_cssk_ec_summary_base."

#. module: l10n_sk_ec_sales
#: model:ir.module.module,shortdesc:base.module_l10n_sk_ec_sales
msgid "Slovakia — Súhrnný výkaz (EC Sales List)"
msgstr "Slovensko — Súhrnný výkaz"

#. module: l10n_sk_ec_sales
#. odoo-python
#: code:addons/l10n_sk_ec_sales/models/cssk_ec_summary_statement.py:0
msgid ""
"The súhrnný výkaz cannot be exported — %(n)d line(s) carry a customer VAT "
"number that does not start with a plausible country code (fix the partner's "
"Tax ID in Contacts): %(refs)s"
msgstr ""
"Súhrnný výkaz nemožno exportovať — %(n)d riadok(ov) nesie IČ DPH "
"odberateľa, ktoré nezačína vierohodným kódom krajiny (opravte IČ DPH "
"partnera v Kontaktoch): %(refs)s"

#. module: l10n_sk_ec_sales
#. odoo-python
#: code:addons/l10n_sk_ec_sales/models/cssk_ec_summary_statement.py:0
msgid ""
"The súhrnný výkaz cannot be exported — these lines have a missing or non-EU VAT number, or report a service to a Northern Ireland (XI) number, which is valid for goods only (hard block):\n"
"%s"
msgstr ""
"Súhrnný výkaz nemožno exportovať — tieto riadky nemajú IČ DPH alebo majú IČ DPH mimo EÚ, alebo vykazujú službu pre IČ DPH Severného Írska (XI), ktoré platí len pre tovar (tvrdá blokácia):\n"
"%s"

