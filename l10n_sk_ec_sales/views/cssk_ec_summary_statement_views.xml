<odoo>
    <!-- The last block of the súhrnný výkaz hlavička: who files and the date
         of the declaration. -->
    <record id="cssk_ec_summary_statement_view_form_sk" model="ir.ui.view">
        <field name="name">cssk.ec.summary.statement.form.sk</field>
        <field name="model">cssk.ec.summary.statement</field>
        <field name="inherit_id" ref="l10n_cssk_ec_summary_base.cssk_ec_summary_statement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='lines']" position="after">
                <field name="l10n_sk_country_code" invisible="1"/>
                <page string="Hlavička" name="l10n_sk_header"
                      invisible="l10n_sk_country_code != 'SK' or legacy">
                    <group>
                        <group string="Konateľ / oprávnená osoba">
                            <field name="l10n_sk_authorized_name" string="Meno a priezvisko"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="l10n_sk_authorized_phone" string="Telefón"
                                   readonly="state not in ('draft', 'preview')"/>
                            <field name="l10n_sk_authorized_email" string="E-mail"
                                   readonly="state not in ('draft', 'preview')"/>
                        </group>
                        <group>
                            <field name="l10n_sk_declaration_date"
                                   readonly="state not in ('draft', 'preview')"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
