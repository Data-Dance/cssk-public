<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nop_transaction_tree" model="ir.ui.view">
        <field name="name">nop.transaction.list</field>
        <field name="model">nop.transaction</field>
        <field name="arch" type="xml">
            <list string="NOP Transactions"
                  decoration-success="state == 'confirmed'"
                  decoration-warning="state in ('mismatch', 'refund_pending')"
                  decoration-muted="state in ('cancelled', 'expired', 'expired_unreceived', 'refunded')"
                  decoration-info="state in ('received', 'unconfirmed_closed')">
                <field name="create_date"/>
                <field name="transaction_id"/>
                <field name="pos_config_id"/>
                <field name="state"/>
                <field name="expected_amount"/>
                <field name="received_amount"/>
                <field name="debtor_iban" optional="hide"/>
                <field name="received_at" optional="show"/>
                <field name="integrity_ok" widget="boolean_toggle" readonly="1" optional="hide"/>
                <field name="amount_ok" widget="boolean_toggle" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nop_transaction_form" model="ir.ui.view">
        <field name="name">nop.transaction.form</field>
        <field name="model">nop.transaction</field>
        <field name="arch" type="xml">
            <form string="NOP Transaction">
                <header>
                    <button name="action_print_non_confirmation" type="object"
                            string="Print non-confirmation receipt"
                            icon="fa-print"
                            invisible="state not in ('unconfirmed_closed', 'refund_pending', 'refunded', 'expired_unreceived')"/>
                    <button name="action_mark_refunded" type="object"
                            string="Mark as refunded"
                            class="oe_highlight"
                            invisible="state != 'refund_pending'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,received,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="transaction_id" readonly="1"/></h1>
                        <field name="public_history_url" widget="url" readonly="1"
                               invisible="not public_history_url"/>
                    </div>
                    <group>
                        <group string="Expected">
                            <field name="pos_config_id"/>
                            <field name="expected_iban"/>
                            <field name="expected_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="expires_at"/>
                            <field name="comment"/>
                        </group>
                        <group string="Received">
                            <field name="received_at"/>
                            <field name="bank_iban"/>
                            <field name="bank_creditor_name"/>
                            <field name="debtor_iban"/>
                            <field name="received_amount"/>
                            <field name="integrity_ok"/>
                            <field name="amount_ok"/>
                        </group>
                    </group>
                    <group invisible="state not in ('unconfirmed_closed', 'refund_pending', 'refunded', 'expired_unreceived')"
                           string="Close-without-confirmation">
                        <group>
                            <field name="closed_unconfirmed_at" readonly="1"/>
                            <field name="closed_unconfirmed_by_id" readonly="1"/>
                        </group>
                        <group invisible="state not in ('refund_pending', 'refunded')">
                            <field name="refunded_at" readonly="state == 'refunded'"/>
                            <field name="refunded_by_id" readonly="1"/>
                            <field name="refund_reference"/>
                        </group>
                    </group>
                    <group invisible="state != 'unconfirmed_closed' or history_lookup_count == 0"
                           string="Public history lookups">
                        <field name="history_lookup_count" readonly="1"/>
                        <field name="history_last_lookup_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Source" name="source">
                            <group>
                                <field name="source_model"/>
                                <field name="source_id"/>
                                <field name="payment_transaction_id"/>
                                <field name="qr_code_url"/>
                            </group>
                        </page>
                        <page string="Raw payload" name="raw">
                            <field name="raw_payload" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nop_transaction_search" model="ir.ui.view">
        <field name="name">nop.transaction.search</field>
        <field name="model">nop.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_id"/>
                <field name="pos_config_id"/>
                <field name="debtor_iban"/>
                <field name="expected_amount"/>
                <filter string="Pending" name="f_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Confirmed" name="f_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Refund pending" name="f_refund_pending" domain="[('state', '=', 'refund_pending')]"/>
                <filter string="Unconfirmed closed" name="f_unconfirmed" domain="[('state', '=', 'unconfirmed_closed')]"/>
                <filter string="Mismatch" name="f_mismatch" domain="[('state', '=', 'mismatch')]"/>
                <group>
                    <filter string="State" name="g_state" context="{'group_by': 'state'}"/>
                    <filter string="POS" name="g_pos_config" context="{'group_by': 'pos_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nop_transaction" model="ir.actions.act_window">
        <field name="name">NOP Transactions</field>
        <field name="res_model">nop.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nop_transaction_search"/>
    </record>

    <record id="action_nop_transaction_refund_pending" model="ir.actions.act_window">
        <field name="name">Refunds owed (QR Platby)</field>
        <field name="res_model">nop.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'refund_pending')]</field>
        <field name="context">{'search_default_f_refund_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No outstanding refunds.</p>
            <p>
                Transactions appear here when a NOP notification arrives <em>after</em>
                the cashier closed the sale without confirmation. The customer was
                already charged through a different payment method, so the late-arriving
                QR payment is a duplicate that must be refunded.
            </p>
            <p>
                NOP's notification does not include the payer's IBAN. Look up the
                matching incoming transfer on your bank statement (match by amount
                and receipt-time), send the refund via your bank's standard SEPA
                channel, then hit <em>Mark as refunded</em> with a reference string
                so the transaction closes out.
            </p>
        </field>
    </record>
</odoo>
