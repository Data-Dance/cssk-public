<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_non_confirmation" model="ir.actions.report">
        <field name="name">Non-confirmation receipt</field>
        <field name="model">nop.transaction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nop_kverkom_base.report_non_confirmation_receipt</field>
        <field name="report_file">nop_kverkom_base.report_non_confirmation_receipt</field>
        <field name="print_report_name">'Non-confirmation %s' % object.transaction_id</field>
        <field name="binding_model_id" ref="model_nop_transaction"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_non_confirmation_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2 class="mt-0 mb-1">DOKLAD O NEPOTVRDENÍ ZREALIZOVANEJ PLATBY</h2>
                            <small class="text-muted">
                                Receipt of a non-confirmed executed payment (QR Platby / NOP KVERKOM)
                            </small>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Obchodník / Merchant</strong>
                                <div t-field="doc.company_id.name"/>
                                <div t-if="doc.company_id.company_registry">
                                    <span>IČO: </span><span t-field="doc.company_id.company_registry"/>
                                </div>
                                <div t-if="doc.pos_config_id.vatsk">
                                    <span>DIČ: </span><span t-field="doc.pos_config_id.vatsk"/>
                                </div>
                                <div t-if="doc.company_id.vat">
                                    <span>IČ DPH: </span><span t-field="doc.company_id.vat"/>
                                </div>
                                <div t-if="doc.pos_config_id.pokladnica_id_ext">
                                    <span>Pokladnica: </span>
                                    <span t-field="doc.pos_config_id.pokladnica_id_ext"/>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Prostredie / Environment</strong>
                                <div t-esc="doc.pos_config_id.environment.upper()"/>
                            </div>
                        </div>

                        <hr class="mt-3 mb-3"/>

                        <table class="table table-sm">
                            <tr>
                                <th class="w-50">ID transakcie</th>
                                <td><code t-field="doc.transaction_id"/></td>
                            </tr>
                            <tr>
                                <th>Dátum a čas vygenerovania</th>
                                <td>
                                    <span t-field="doc.create_date"
                                          t-options='{"widget": "datetime"}'/>
                                    <small class="text-muted ms-1">UTC</small>
                                </td>
                            </tr>
                            <tr>
                                <th>Suma</th>
                                <td>
                                    <strong>
                                        <span t-field="doc.expected_amount"
                                              t-options='{"widget": "monetary", "display_currency": "doc.currency_id"}'/>
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <th>IBAN príjemcu</th>
                                <td><code t-field="doc.expected_iban"/></td>
                            </tr>
                        </table>

                        <div class="alert alert-info mt-4">
                            <p class="mb-1">
                                Systém NOP nepotvrdil úhradu tejto QR platby v čase uzatvorenia
                                predaja. Stav úhrady si môžete overiť pomocou verejného rozhrania:
                            </p>
                            <p class="mb-0">
                                <code t-field="doc.public_history_url"/>
                            </p>
                        </div>

                        <div class="mt-4 small text-muted">
                            <p class="mb-1">
                                Tento doklad bol vystavený v súlade s požiadavkami Finančnej správy SR
                                pre prípad nepotvrdenia zrealizovanej platby (QR Platby, NOP KVERKOM).
                            </p>
                            <p class="mb-0">
                                Vystavené: <span t-field="doc.closed_unconfirmed_at"
                                                 t-options='{"widget": "datetime"}'/>
                                <span t-if="doc.closed_unconfirmed_by_id"
                                      > / <span t-field="doc.closed_unconfirmed_by_id.name"/></span>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
