<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_nop_poll_pending" model="ir.cron">
        <field name="name">NOP KVERKOM: Drain pending notifications</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_nop_poll_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_nop_expire_pending" model="ir.cron">
        <field name="name">NOP KVERKOM: Expire stale transactions</field>
        <field name="model_id" ref="model_nop_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_pending()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="cron_nop_fetch_history" model="ir.cron">
        <field name="name">NOP KVERKOM: Check public history for unconfirmed-closed</field>
        <field name="model_id" ref="model_nop_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_history()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
