<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document_cz" inherit_id="account.report_invoice_document">

        <!-- Customer DIČ next to the IČO / DIČ DPH core already prints -->
        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="after">
            <div t-if="o.partner_id.l10n_cssk_dic and o.company_id.country_code == 'CZ'">
                DIČ: <span t-field="o.partner_id.l10n_cssk_dic" />
            </div>
        </xpath>
        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="after">
            <div t-if="o.partner_id.l10n_cssk_dic and o.company_id.country_code == 'CZ'">
                DIČ: <span t-field="o.partner_id.l10n_cssk_dic" />
            </div>
        </xpath>
        <xpath expr="//div[@id='partner_vat_no_shipping']" position="after">
            <div t-if="o.partner_id.l10n_cssk_dic and o.company_id.country_code == 'CZ'">
                DIČ: <span t-field="o.partner_id.l10n_cssk_dic" />
            </div>
        </xpath>

        <!-- Payment symbols (variabilní/konstantní/specifický) in the info row -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col-auto col-3 mw-100 mb-2"
                 t-if="o.l10n_cssk_variable_symbol and o.company_id.country_code == 'CZ'"
                 name="l10n_cz_variable_symbol">
                <strong>Variabilní symbol</strong>
                <div t-field="o.l10n_cssk_variable_symbol" />
            </div>
            <div class="col-auto col-3 mw-100 mb-2"
                 t-if="o.l10n_cssk_constant_symbol and o.company_id.country_code == 'CZ'"
                 name="l10n_cz_constant_symbol">
                <strong>Konstantní symbol</strong>
                <div t-field="o.l10n_cssk_constant_symbol" />
            </div>
            <div class="col-auto col-3 mw-100 mb-2"
                 t-if="o.l10n_cssk_specific_symbol and o.company_id.country_code == 'CZ'"
                 name="l10n_cz_specific_symbol">
                <strong>Specifický symbol</strong>
                <div t-field="o.l10n_cssk_specific_symbol" />
            </div>
        </xpath>

        <!-- Mandatory statutory phrases -->
        <xpath expr="//div[@name='comment']" position="after">
            <p t-if="o.l10n_cz_legal_notes and o.company_id.country_code == 'CZ'"
               name="l10n_cz_legal_notes" class="mt-2"
               style="white-space: pre-line;">
                <span t-field="o.l10n_cz_legal_notes" />
            </p>
        </xpath>

    </template>
</odoo>
