<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- In the Expenses app's settings, where whoever runs expenses looks. The
         receipt readers themselves (eKasa, AI model chain) are accounting
         configuration and stay under Invoicing ▸ Fiscal Receipt Capture. -->
    <record id="res_config_settings_view_form_receipt_expense" model="ir.ui.view">
        <field name="name">res.config.settings.form.receipt.expense</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='expenses_setting_container']" position="after">
                <block title="Receipt Capture" name="cssk_receipt_expense_block">
                    <setting string="Capture on Expense Upload"
                             help="When receipt images are uploaded in the Expenses app, read each one — the QR code through eKasa, or the photograph with the AI reader — and fill the expense from it. The readers are configured under Invoicing ▸ Settings ▸ Fiscal Receipt Capture.">
                        <field name="cssk_receipt_capture_on_expense_upload"/>
                    </setting>
                    <setting string="Receipt Expense Category"
                             help="The expense category of expenses filled from a receipt. Empty: Odoo's general expense category.">
                        <field name="cssk_receipt_expense_product_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
