<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cssk_receipt_form_expense" model="ir.ui.view">
        <field name="name">cssk.receipt.form.expense</field>
        <field name="model">cssk.receipt</field>
        <field name="inherit_id" ref="l10n_cssk_receipt_capture.view_cssk_receipt_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_bill']" position="after">
                <button name="action_create_expenses" type="object"
                        string="Create Expenses" class="oe_highlight"
                        groups="account.group_account_invoice"
                        invisible="state != 'captured' or expense_count > 0"/>
            </xpath>
            <xpath expr="//field[@name='move_id']" position="after">
                <field name="expense_count" invisible="1"/>
            </xpath>
            <!-- Into the form's own button box: a second oe_button_box is not
                 lifted into the control panel and renders inline. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_expenses" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="expense_count == 0">
                    <field name="expense_count" widget="statinfo"
                           string="Expenses"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
