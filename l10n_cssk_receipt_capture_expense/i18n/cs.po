#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/hr_expense.py:0
msgid ""
"%(expense)s no longer matches its receipt (%(total).2f with VAT at "
"%(rates)s). Its VAT is posted rate by rate from the receipt, so the amount "
"and the taxes cannot be edited; reset them, or detach the receipt and enter "
"the expense by hand."
msgstr "%(expense)s už neodpovídá své účtence (%(total).2f s DPH v sazbách %(rates)s). Jeho DPH se účtuje po sazbách z účtenky, proto částku a daně nelze upravovat; vraťte je, nebo účtenku odpojte a výdaj zadejte ručně."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid "%(name)s already has %(count)s expense(s)."
msgstr "Počet výdajů, které už %(name)s má: %(count)s."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid ""
"%(name)s is already claimed as %(count)s expense(s). A vendor receipt would "
"book the same purchase twice."
msgstr "%(name)s je už uplatněna jako výdaje (%(count)s). Nákupní účtenka by stejný nákup zaúčtovala dvakrát."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid "%s (VAT not deductible)"
msgstr "%s (DPH nelze odečíst)"

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/hr_expense.py:0
