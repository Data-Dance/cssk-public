#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/hr_expense.py:0
msgid ""
"%(expense)s no longer matches its receipt (%(total).2f with VAT at "
"%(rates)s). Its VAT is posted rate by rate from the receipt, so the amount "
"and the taxes cannot be edited; reset them, or detach the receipt and enter "
"the expense by hand."
msgstr "%(expense)s už nezodpovedá svojmu dokladu (%(total).2f s DPH v sadzbách %(rates)s). Jeho DPH sa účtuje po sadzbách z dokladu, preto sumu a dane nemožno upravovať; vráťte ich, alebo doklad odpojte a výdavok zadajte ručne."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid "%(name)s already has %(count)s expense(s)."
msgstr "Počet výdavkov, ktoré už %(name)s má: %(count)s."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid ""
"%(name)s is already claimed as %(count)s expense(s). A vendor receipt would "
"book the same purchase twice."
msgstr "%(name)s je už uplatnený ako výdavky (%(count)s). Nákupná účtenka by ten istý nákup zaúčtovala dvakrát."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid "%s (VAT not deductible)"
msgstr "%s (DPH nemožno odpočítať)"

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/hr_expense.py:0
msgid "%s could not be read"
msgstr "Neprečítané: %s"

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid ""
"%s has no VAT recap, so there is no way to split it into expenses. Post it "
"as a vendor bill instead."
msgstr "%s nemá rekapituláciu DPH, preto sa nedá rozdeliť na výdavky. Zaúčtujte ho radšej ako prijatú faktúru."

#. module: l10n_cssk_receipt_capture_expense
#. odoo-python
#: code:addons/l10n_cssk_receipt_capture_expense/models/cssk_receipt.py:0
msgid ""
"%s has no employee record, so an expense cannot be created for them. Create "
"the employee, or post the receipt as a vendor bill instead."
msgstr "%s nemá záznam zamestnanca, preto preň nemožno vytvoriť výdavok. Vytvorte zamestnanca, alebo doklad zaúčtujte ako prijatú faktúru."

