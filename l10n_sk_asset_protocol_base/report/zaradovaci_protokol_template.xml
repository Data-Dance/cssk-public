<odoo>
    <template id="report_zaradovaci_protokol">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="v" t-value="doc._l10n_sk_protocol_values()" />
                    <div class="page">
                        <h2>Protokol o zaradení dlhodobého majetku do používania</h2>
                        <p class="text-muted">
                            interný účtovný doklad podľa § 10 zákona č. 431/2002 Z. z.
                        </p>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Účtovná jednotka:</strong>
                                <span t-field="doc.company_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Dátum zaradenia:</strong>
                                <span t-esc="v['acquisition_date']"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <tr>
                                <th style="width: 35%">Názov majetku</th>
                                <td><span t-esc="v['name']"/></td>
                            </tr>
                            <tr>
                                <th>Inventárne číslo</th>
                                <td>
                                    <span t-field="doc.l10n_sk_inventory_number"/>
                                    <span t-if="not doc.l10n_sk_inventory_number"
                                          t-esc="v['inventory_number']"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Obstarávacia cena</th>
                                <td>
                                    <span t-esc="v['purchase_value']"
                                          t-options='{"widget": "monetary", "display_currency": v["currency"]}'/>
                                </td>
                            </tr>
                            <tr>
                                <th>Odpisový plán</th>
                                <td>
                                    <span t-esc="v['plan']"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Miesto umiestnenia</th>
                                <td><span t-field="doc.l10n_sk_location"/></td>
                            </tr>
                            <tr>
                                <th>Zodpovedná osoba</th>
                                <td><span t-field="doc.l10n_sk_responsible_person_id.name"/></td>
                            </tr>
                        </table>
                        <p t-if="doc.l10n_sk_commissioning_note">
                            <strong>Poznámka:</strong>
                            <span t-field="doc.l10n_sk_commissioning_note"/>
                        </p>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Majetok odovzdal:</p>
                                <p>.................................................</p>
                            </div>
                            <div class="col-6">
                                <p>Majetok prevzal:</p>
                                <p>.................................................</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
