<odoo>
    <template id="report_vyradovaci_protokol">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="v" t-value="doc._l10n_sk_protocol_values()" />
                    <div class="page">
                        <h2>Protokol o vyradení dlhodobého majetku</h2>
                        <p class="text-muted">
                            interný účtovný doklad podľa § 10 zákona č. 431/2002 Z. z.
                        </p>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Účtovná jednotka:</strong>
                                <span t-field="doc.company_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Dátum vyradenia:</strong>
                                <span t-esc="v['disposal_date']"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <tr>
                                <th style="width: 35%">Názov majetku</th>
                                <td><span t-esc="v['name']"/></td>
                            </tr>
                            <tr>
                                <th>Inventárne číslo</th>
                                <td>
                                    <span t-field="doc.l10n_sk_inventory_number"/>
                                    <span t-if="not doc.l10n_sk_inventory_number"
                                          t-esc="v['inventory_number']"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Dátum zaradenia</th>
                                <td><span t-esc="v['acquisition_date']"/></td>
                            </tr>
                            <tr>
                                <th>Obstarávacia cena</th>
                                <td>
                                    <span t-esc="v['purchase_value']"
                                          t-options='{"widget": "monetary", "display_currency": v["currency"]}'/>
                                </td>
                            </tr>
                            <tr>
                                <th>Oprávky (odpísané)</th>
                                <td>
                                    <span t-esc="v['depreciated']"
                                          t-options='{"widget": "monetary", "display_currency": v["currency"]}'/>
                                </td>
                            </tr>
                            <tr>
                                <th>Zostatková cena</th>
                                <td>
                                    <span t-esc="v['residual']"
                                          t-options='{"widget": "monetary", "display_currency": v["currency"]}'/>
                                </td>
                            </tr>
                            <tr>
                                <th>Spôsob vyradenia</th>
                                <td><span t-field="doc.l10n_sk_disposal_method"/></td>
                            </tr>
                        </table>
                        <p>
                            <strong>Dôvod vyradenia:</strong><br/>
                            <span t-field="doc.l10n_sk_disposal_reason"/>
                        </p>
                        <p class="text-muted">
                            Neoddeliteľnou súčasťou protokolu sú prílohy dokladujúce
                            spôsob vyradenia.
                        </p>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Vyradenie navrhol:</p>
                                <p>.................................................</p>
                            </div>
                            <div class="col-6">
                                <p>Vyradenie schválil:</p>
                                <p>.................................................</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
