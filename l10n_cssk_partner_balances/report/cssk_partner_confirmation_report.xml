<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_partner_confirmation" model="ir.actions.report">
        <field name="name">Balance Confirmation (Saldokonto)</field>
        <field name="model">cssk.partner.confirmation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cssk_partner_balances.report_partner_confirmation</field>
        <field name="report_file">l10n_cssk_partner_balances.report_partner_confirmation</field>
        <field name="binding_model_id" ref="model_cssk_partner_confirmation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_partner_confirmation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <!-- Czech or Slovak wording by the company's fiscal
                         country. The parties are named neutrally: a
                         confirmation of payables makes the company the
                         debtor, not the supplier or the creditor. -->
                    <t t-set="cz" t-value="(doc.company_id.account_fiscal_country_id or doc.company_id.country_id).code == 'CZ'"/>
                    <t t-set="vat_label" t-value="'DIČ' if cz else 'IČ DPH'"/>
                    <div class="page" t-translation="off">
                        <h2 t-if="cz">Odsouhlasení zůstatků / Balance confirmation</h2>
                        <h2 t-else="">Odsúhlasenie zostatkov / Balance confirmation</h2>
                        <p>
                            <strong t-out="doc.name"/> —
                            k <t t-if="cz">datu</t><t t-else="">dátumu</t> / as of
                            <strong t-out="doc.as_of_date"/>
                        </p>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong t-if="cz">Účetní jednotka / Company:</strong>
                                <strong t-else="">Účtovná jednotka / Company:</strong><br/>
                                <span t-field="doc.company_id.partner_id"
                                      t-options='{"widget": "contact"}'/>
                                <div t-if="doc.company_id.company_registry">IČO: <span t-out="doc.company_id.company_registry"/></div>
                                <div t-if="doc.company_id.vat"><t t-out="vat_label"/>:
                                    <span t-out="doc.company_id.vat"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <strong>Partner:</strong><br/>
                                <span t-field="doc.partner_id"
                                      t-options='{"widget": "contact"}'/>
                                <div t-if="doc.partner_id.company_registry">IČO: <span t-out="doc.partner_id.company_registry"/></div>
                                <div t-if="doc.partner_id.vat"><t t-out="vat_label"/>:
                                    <span t-out="doc.partner_id.vat"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Doklad / Document</th>
                                    <th><t t-if="cz">Datum</t><t t-else="">Dátum</t> / Date</th>
                                    <th><t t-if="cz">Splatnost</t><t t-else="">Splatnosť</t> / Due</th>
                                    <th>Typ / Type</th>
                                    <th class="text-end"><t t-if="cz">Částka</t><t t-else="">Suma</t> / Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line"
                                    t-att-class="'text-muted' if line.blocked else ''">
                                    <td t-out="line.move_name"/>
                                    <td t-out="line.move_date"/>
                                    <td t-out="line.date_maturity or ''"/>
                                    <td t-out="dict(line._fields['account_type'].selection).get(line.account_type, '')"/>
                                    <td class="text-end">
                                        <span t-out="line.amount_residual"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        <span t-if="line.blocked"> (sporné)</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><t t-if="cz">Pohledávky</t><t t-else="">Pohľadávky</t> / Receivables</td>
                                        <td class="text-end">
                                            <span t-field="doc.total_receivable"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><t t-if="cz">Závazky</t><t t-else="">Záväzky</t> / Payables</td>
                                        <td class="text-end">
                                            <span t-field="doc.total_payable"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Saldo / Net</th>
                                        <th class="text-end">
                                            <span t-field="doc.net_balance"/>
                                        </th>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                ____________________________<br/>
                                <t t-if="cz">Za účetní jednotku</t><t t-else="">Za účtovnú jednotku</t> / For the company
                            </div>
                            <div class="col-6 text-center">
                                ____________________________<br/>
                                Za partnera / For the partner
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
