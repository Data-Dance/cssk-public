<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_partner_netting" model="ir.actions.report">
        <field name="name">Set-off (Zápočet)</field>
        <field name="model">cssk.partner.netting.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cssk_partner_balances.report_partner_netting</field>
        <field name="report_file">l10n_cssk_partner_balances.report_partner_netting</field>
        <field name="binding_model_id" ref="model_cssk_partner_netting_agreement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_partner_netting">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <!-- Czech or Slovak wording by the company's fiscal
                         country: the legal basis differs (CZ § 1982 NOZ,
                         SK § 580 OZ + § 358 a nasl. ObZ), and so does what
                         the tax number on the record is called. -->
                    <t t-set="cz" t-value="(doc.company_id.account_fiscal_country_id or doc.company_id.country_id).code == 'CZ'"/>
                    <t t-set="vat_label" t-value="'DIČ' if cz else 'IČ DPH'"/>
                    <div class="page" t-translation="off">
                        <!-- Title depends on the legal mode -->
                        <h2 t-if="doc.netting_mode == 'bilateral' and cz">
                            Dohoda o vzájemném započtení pohledávek<br/>
                            <small class="text-muted">Agreement on mutual set-off of receivables and payables</small>
                        </h2>
                        <h2 t-elif="doc.netting_mode == 'bilateral'">
                            Dohoda o vzájomnom započítaní pohľadávok a záväzkov<br/>
                            <small class="text-muted">Agreement on mutual set-off of receivables and payables</small>
                        </h2>
                        <h2 t-elif="cz">
                            Oznámení o jednostranném započtení pohledávek<br/>
                            <small class="text-muted">Notice of unilateral set-off of receivables and payables</small>
                        </h2>
                        <h2 t-else="">
                            Oznámenie o jednostrannom započítaní pohľadávok a záväzkov<br/>
                            <small class="text-muted">Notice of unilateral set-off of receivables and payables</small>
                        </h2>
                        <p>
                            <strong t-out="doc.name"/> —
                            <t t-if="cz">ze dne</t><t t-else="">zo dňa</t> / dated <strong t-out="doc.agreement_date"/>
                        </p>

                        <div class="row mt-3">
                            <div class="col-6">
                                <strong t-if="cz">Navrhovatel / Proposing party:</strong>
                                <strong t-else="">Navrhovateľ / Proposing party:</strong><br/>
                                <span t-field="doc.company_id.partner_id"
                                      t-options='{"widget": "contact"}'/>
                                <div t-if="doc.company_id.company_registry">IČO: <span t-out="doc.company_id.company_registry"/></div>
                                <div t-if="doc.company_id.vat"><t t-out="vat_label"/>: <span t-out="doc.company_id.vat"/></div>
                            </div>
                            <div class="col-6">
                                <strong>Partner / Counterparty:</strong><br/>
                                <span t-field="doc.partner_id"
                                      t-options='{"widget": "contact"}'/>
                                <div t-if="doc.partner_id.company_registry">IČO: <span t-out="doc.partner_id.company_registry"/></div>
                                <div t-if="doc.partner_id.vat"><t t-out="vat_label"/>: <span t-out="doc.partner_id.vat"/></div>
                            </div>
                        </div>

                        <p class="mt-3" t-if="doc.netting_mode == 'bilateral' and cz">
                            Smluvní strany se dohodly na vzájemném započtení níže
                            uvedených pohledávek.
                            <span class="text-muted">The parties agree to mutually
                            set off the receivables and payables listed below.</span>
                        </p>
                        <p class="mt-3" t-elif="doc.netting_mode == 'bilateral'">
                            Zmluvné strany sa dohodli na vzájomnom započítaní nižšie
                            uvedených pohľadávok a záväzkov.
                            <span class="text-muted">The parties agree to mutually
                            set off the receivables and payables listed below.</span>
                        </p>
                        <p class="mt-3" t-elif="cz">
                            Tímto Vám oznamujeme, že podle § 1982 a násl. občanského
                            zákoníku započítáváme níže uvedené vzájemné pohledávky.
                            Pohledávky zanikají v rozsahu, v jakém se vzájemně kryjí,
                            k okamžiku, kdy se obě staly způsobilými k započtení.
                            <span class="text-muted">We hereby give notice of the
                            set-off of the mutual claims listed below. The claims are
                            extinguished to the extent they cover each other as of the
                            moment both became capable of set-off.</span>
                        </p>
                        <p class="mt-3" t-else="">
                            Týmto Vám oznamujeme jednostranné započítanie nižšie
                            uvedených pohľadávok a záväzkov podľa § 580 Občianskeho
                            zákonníka a § 358 a nasl. Obchodného zákonníka. Pohľadávky
                            zanikajú v rozsahu, v akom sa vzájomne kryjú, okamihom,
                            keď sa stretli pohľadávky spôsobilé na započítanie.
                            <span class="text-muted">We hereby give notice of the
                            unilateral set-off of the receivables and payables listed
                            below. The claims are extinguished to the extent they cover
                            each other as of the moment they became capable of
                            set-off.</span>
                        </p>

                        <h4 class="mt-4"><t t-if="cz">Pohledávky</t><t t-else="">Pohľadávky</t> / Receivables</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Doklad / Document</th>
                                    <th><t t-if="cz">Datum</t><t t-else="">Dátum</t> / Date</th>
                                    <th><t t-if="cz">Splatnost</t><t t-else="">Splatnosť</t> / Due</th>
                                    <th class="text-end"><t t-if="cz">Započtená částka</t><t t-else="">Započítaná suma</t> / Set-off amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.receivable_line_ids" t-as="line">
                                    <td t-out="line.move_name"/>
                                    <td t-out="line.move_line_id.move_id.invoice_date or line.move_line_id.date"/>
                                    <td t-out="line.move_line_id.date_maturity or ''"/>
                                    <td class="text-end">
                                        <span t-out="line.amount_to_offset"
                                              t-options='{"widget": "monetary", "display_currency": doc.netting_currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-3"><t t-if="cz">Závazky</t><t t-else="">Záväzky</t> / Payables</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Doklad / Document</th>
                                    <th><t t-if="cz">Datum</t><t t-else="">Dátum</t> / Date</th>
                                    <th><t t-if="cz">Splatnost</t><t t-else="">Splatnosť</t> / Due</th>
                                    <th class="text-end"><t t-if="cz">Započtená částka</t><t t-else="">Započítaná suma</t> / Set-off amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.payable_line_ids" t-as="line">
                                    <td t-out="line.move_name"/>
                                    <td t-out="line.move_line_id.move_id.invoice_date or line.move_line_id.date"/>
                                    <td t-out="line.move_line_id.date_maturity or ''"/>
                                    <td class="text-end">
                                        <span t-out="line.amount_to_offset"
                                              t-options='{"widget": "monetary", "display_currency": doc.netting_currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <th><t t-if="cz">Započtená částka</t><t t-else="">Započítaná suma</t> / Set-off amount</th>
                                        <th class="text-end">
                                            <span t-field="doc.netting_amount"/>
                                        </th>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Signatures: both parties (bilateral) vs one (unilateral) -->
                        <div class="row mt-5" t-if="doc.netting_mode == 'bilateral'">
                            <div class="col-6 text-center">
                                ____________________________<br/>
                                <t t-if="cz">Za navrhovatele</t><t t-else="">Za navrhovateľa</t> / For the proposing party
                            </div>
                            <div class="col-6 text-center">
                                ____________________________<br/>
                                Za partnera / For the counterparty
                            </div>
                        </div>
                        <div class="row mt-5" t-else="">
                            <div class="col-6 text-center">
                                ____________________________<br/>
                                <t t-if="cz">Za navrhovatele</t><t t-else="">Za navrhovateľa</t> / For the proposing party
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
