<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cssk_partner_netting_view_list" model="ir.ui.view">
        <field name="name">cssk.partner.netting.agreement.list</field>
        <field name="model">cssk.partner.netting.agreement</field>
        <field name="arch" type="xml">
            <list string="Netting Agreements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agreement_date"/>
                <field name="netting_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state in ('sent', 'countersigned')"/>
            </list>
        </field>
    </record>

    <record id="cssk_partner_netting_view_form" model="ir.ui.view">
        <field name="name">cssk.partner.netting.agreement.form</field>
        <field name="model">cssk.partner.netting.agreement</field>
        <field name="arch" type="xml">
            <form string="Netting Agreement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Mark Sent"
                            invisible="state != 'confirmed'"/>
                    <button name="action_countersigned" type="object"
                            string="Countersigned" class="btn-primary"
                            invisible="state != 'sent' or netting_mode != 'bilateral'"/>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary"
                            invisible="not (state == 'countersigned' or (state == 'sent' and netting_mode == 'unilateral'))"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state in ('draft', 'posted', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('posted', 'cancelled')"/>
                    <button name="action_cancel_with_reversal" type="object"
                            string="Cancel with reversal"
                            confirm="This reverses the clearing entry. Continue?"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,sent,countersigned,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="responsible_user_id"/>
                            <field name="clearing_journal_id"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="agreement_date"/>
                            <field name="netting_currency_id" readonly="state != 'draft'"/>
                            <field name="netting_mode"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="receivable_total"/>
                            <field name="payable_total"/>
                            <field name="netting_amount"/>
                            <field name="is_balanced"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receivables (pohľadávky)" name="recv">
                            <field name="receivable_line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="move_line_id"/>
                                    <field name="move_name"/>
                                    <field name="full_amount"/>
                                    <field name="amount_to_offset"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payables (záväzky)" name="pay">
                            <field name="payable_line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="move_line_id"/>
                                    <field name="move_name"/>
                                    <field name="full_amount"/>
                                    <field name="amount_to_offset"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cssk_partner_netting_action" model="ir.actions.act_window">
        <field name="name">Netting Agreements</field>
        <field name="res_model">cssk.partner.netting.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
