<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        On the invoice/bill "Other Info" page (id other_tab — the journal-entry
        page shares its name, not its id). Readonly once posted: the flag
        decides which DPHDP3 row and KH section the document lands on, so it
        is a property of the document as filed.
    -->
    <record id="view_move_form_cz_bad_debt" model="ir.ui.view">
        <field name="name">account.move.form.cz.bad.debt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']"
                   position="inside">
                <field name="l10n_cz_bad_debt"
                       invisible="country_code != 'CZ'"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
