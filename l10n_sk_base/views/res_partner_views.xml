<odoo>
    <!--
        Priority 10, before base_vat's 15.

        `base_vat` MOVES `<field name="vat"/>` into `<div
        name="vat_vies_container">`. A view applied after it and anchored on
        `vat` lands inside that div, and a field in a div inside a group
        renders with no label at all.
    -->
    <record id="res_partner_view_form_l10n_sk_base" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_sk.base</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="before">
                <field name="l10n_sk_dic" invisible="country_code != 'SK'"/>
            </field>
        </field>
    </record>
</odoo>
