<odoo>
    <record id="view_account_payment_form_cash_limit" model="ir.ui.view">
        <field name="name">account.payment.form.sk.cash.limit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div role="alert" class="alert alert-warning" invisible="not l10n_sk_cash_limit_warning">
                    <field name="l10n_sk_cash_limit_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_register_form_cash_limit" model="ir.ui.view">
        <field name="name">account.payment.register.form.sk.cash.limit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/*[1]" position="before">
                <div role="alert" class="alert alert-warning" invisible="not l10n_sk_cash_limit_warning">
                    <field name="l10n_sk_cash_limit_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
