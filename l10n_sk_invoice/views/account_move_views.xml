<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_move_form_sk_legal_note" model="ir.ui.view">
        <field name="name">account.move.form.sk.legal.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="narration" position="after">
                <field
                    name="l10n_sk_legal_note_manual"
                    placeholder="Additional statutory note printed on the SK invoice…"
                    invisible="move_type not in ('out_invoice','out_refund')"
                />
            </field>
        </field>
    </record>

</odoo>
