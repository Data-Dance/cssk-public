<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Czech payroll code decides how the payslip pays a time-off type
         (holiday pay, sickness compensation, the §§ 207-209 rates, unpaid). It
         had no view, so a leave type created by hand could not get one. -->
    <record id="hr_leave_type_view_form_l10n_cz_payroll" model="ir.ui.view">
        <field name="name">hr.leave.type.view.form.l10n_cz_payroll_oca</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <field name="time_type" position="after">
                <field name="l10n_cz_payroll_code" groups="payroll.group_payroll_user"/>
            </field>
        </field>
    </record>
</odoo>
