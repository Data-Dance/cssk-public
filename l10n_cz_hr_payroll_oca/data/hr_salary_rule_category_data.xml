<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The payroll engine ships no default salary-rule categories, so we define
        the base ones (BASIC/GROSS/NET/ALW/DED/COMP) here, then the CZ-specific
        categories parented to them so category totals roll up correctly
        (categories.DED aggregates all its descendants).
    -->

    <!-- Base categories -->
    <record id="BASIC" model="hr.salary.rule.category">
        <field name="name">Basic</field>
        <field name="code">BASIC</field>
    </record>
    <record id="GROSS" model="hr.salary.rule.category">
        <field name="name">Gross</field>
        <field name="code">GROSS</field>
    </record>
    <record id="NET" model="hr.salary.rule.category">
        <field name="name">Net</field>
        <field name="code">NET</field>
    </record>
    <record id="ALW" model="hr.salary.rule.category">
        <field name="name">Allowance</field>
        <field name="code">ALW</field>
    </record>
    <record id="DED" model="hr.salary.rule.category">
        <field name="name">Deduction</field>
        <field name="code">DED</field>
    </record>
    <record id="COMP" model="hr.salary.rule.category">
        <field name="name">Company Contribution</field>
        <field name="code">COMP</field>
    </record>

    <!-- Employee-borne deductions (roll up into DED so NET is correct) -->
    <record id="hr_payroll_social_employee" model="hr.salary.rule.category">
        <field name="name">Social Insurance (Employee)</field>
        <field name="code">SOCIALEE</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <record id="hr_payroll_health_employee" model="hr.salary.rule.category">
        <field name="name">Health Insurance (Employee)</field>
        <field name="code">HEALTHEE</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <record id="hr_payroll_income_tax" model="hr.salary.rule.category">
        <field name="name">Income Tax Advance</field>
        <field name="code">INCOMETAX</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <!-- Srážková daň (final withholding tax on below-threshold dohody with no
         taxpayer declaration). Parents to DED so it reduces NET. -->
    <record id="hr_payroll_wh_tax" model="hr.salary.rule.category">
        <field name="name">Withholding Tax</field>
        <field name="code">WHTAX</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <!-- Tax credits and child benefit are positive lines that offset tax, so they
         also parent to DED (their positive total lifts categories.DED). -->
    <record id="hr_payroll_tax_credit" model="hr.salary.rule.category">
        <field name="name">Tax Credits</field>
        <field name="code">TAXCREDIT</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <record id="hr_payroll_child_benefit" model="hr.salary.rule.category">
        <field name="name">Child Tax Benefit</field>
        <field name="code">CHILDBEN</field>
        <field name="parent_id" ref="DED"/>
    </record>

    <!-- Employer-borne contributions (roll up into COMP) -->
    <record id="hr_payroll_social_employer" model="hr.salary.rule.category">
        <field name="name">Social Insurance (Employer)</field>
        <field name="code">SOCIALER</field>
        <field name="parent_id" ref="COMP"/>
    </record>

    <record id="hr_payroll_health_employer" model="hr.salary.rule.category">
        <field name="name">Health Insurance (Employer)</field>
        <field name="code">HEALTHER</field>
        <field name="parent_id" ref="COMP"/>
    </record>

    <!-- Memo categories (NOT parented into GROSS/NET so they stay out of the
         taxable base / net computation unless a rule explicitly reads them). -->
    <record id="hr_payroll_tax_base" model="hr.salary.rule.category">
        <field name="name">Tax Base</field>
        <field name="code">TAXBASE</field>
    </record>

    <record id="hr_payroll_meal_employee" model="hr.salary.rule.category">
        <field name="name">Meal Allowance (Employee)</field>
        <field name="code">MEALEE</field>
    </record>

    <!-- Reporting totals (memo only) -->
    <record id="hr_payroll_social_employee_total" model="hr.salary.rule.category">
        <field name="name">Social Total (Employee)</field>
        <field name="code">SOCIALEETOT</field>
    </record>
    <record id="hr_payroll_social_employer_total" model="hr.salary.rule.category">
        <field name="name">Social Total (Employer)</field>
        <field name="code">SOCIALERTOT</field>
    </record>
    <record id="hr_payroll_health_employee_total" model="hr.salary.rule.category">
        <field name="name">Health Total (Employee)</field>
        <field name="code">HEALTHEETOT</field>
    </record>
    <record id="hr_payroll_health_employer_total" model="hr.salary.rule.category">
        <field name="name">Health Total (Employer)</field>
        <field name="code">HEALTHERTOT</field>
    </record>
    <record id="hr_payroll_income_tax_total" model="hr.salary.rule.category">
        <field name="name">Income Tax Total</field>
        <field name="code">INCOMETAXTOT</field>
    </record>

    <!-- Sickness compensation (náhrada mzdy) - memo category kept OUT of
         GROSS/tax/insurance (not subject to pojistné); added back at NET.
         P3, input-driven. -->
    <record id="hr_payroll_sick_nahrada" model="hr.salary.rule.category">
        <field name="name">Sickness Compensation</field>
        <field name="code">SICKNAHRADA</field>
    </record>

    <!-- Holiday pay (náhrada mzdy za dovolenou, §222) and paid-obstacle pay
         (náhrada za překážky v práci, §199 + NV 590/2006). Both are paid at the
         průměrný výdělek and ARE subject to pojistné + daň, so they parent to
         ALW and are computed before the GROSS rule (sequence < 100) so they land
         in the taxable/insurable GROSS. -->
    <record id="hr_payroll_holiday_nahrada" model="hr.salary.rule.category">
        <field name="name">Holiday Pay</field>
        <field name="code">HOLIDAYNAHRADA</field>
        <field name="parent_id" ref="ALW"/>
    </record>
    <record id="hr_payroll_obstacle_nahrada" model="hr.salary.rule.category">
        <field name="name">Paid Obstacle</field>
        <field name="code">OBSTACLENAHRADA</field>
        <field name="parent_id" ref="ALW"/>
    </record>

    <!-- Employer social-insurance discount (sleva na pojistném, §7a zák. 589/1992).
         Kept in its OWN category (not SOCIALER) so SOCIALERTOT keeps reporting the
         gross premium; EMPLOYERCOST subtracts this negative bucket explicitly. -->
    <record id="hr_payroll_social_discount" model="hr.salary.rule.category">
        <field name="name">Social Insurance Discount</field>
        <field name="code">SOCIAL_DISCOUNT</field>
        <field name="parent_id" ref="COMP"/>
    </record>
</odoo>
