#. module: l10n_sk_vat_registration
#: model:ir.model.fields,help:l10n_sk_vat_registration.field_account_bank_statement_line__l10n_sk_vat_registration_warning
#: model:ir.model.fields,help:l10n_sk_vat_registration.field_account_move__l10n_sk_vat_registration_warning
msgid ""
"Raised when the customer's VAT-registration paragraph is inconsistent with "
"how this invoice is taxed."
msgstr ""
"Zobrazí sa, keď druh registrácie DPH odberateľa nezodpovedá spôsobu zdanenia"
" tejto faktúry."

#. module: l10n_sk_vat_registration
