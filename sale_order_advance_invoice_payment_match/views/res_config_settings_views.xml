<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_advance_match" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advance.match</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="after">
                <block
                    title="Advance Invoices — Bank Matching"
                    id="advance_invoice_payment_match_settings"
                >
                    <setting
                        id="advance_auto_match_statement"
                        string="Auto-match bank statements"
                        help="Match unreconciled incoming transactions to open advance invoices by number / variable symbol and register the payment automatically (cron; also the Enterprise reconciliation widget when installed)."
                    >
                        <field name="advance_invoice_auto_match_statement" />
                    </setting>
                    <setting
                        id="advance_auto_tax_doc"
                        string="Tax document on matched payment"
                        help="Leave for manual creation, create as draft, or create and post (the advance clearing account then nets to zero automatically)."
                    >
                        <field name="advance_invoice_auto_tax_doc" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
