<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_advance_statement_match_wizard_form" model="ir.ui.view">
        <field name="name">advance.statement.match.wizard.form</field>
        <field name="model">advance.statement.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Match Advance Invoice">
                <group>
                    <group>
                        <field name="statement_line_id" />
                        <field name="payment_ref" />
                        <field name="amount" />
                        <field name="currency_id" invisible="1" />
                        <field name="company_id" invisible="1" />
                    </group>
                    <group>
                        <field name="candidate_order_ids" invisible="1" />
                        <field name="order_id" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="Register Payment"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advance_statement_match_wizard" model="ir.actions.act_window">
        <field name="name">Match Advance Invoice</field>
        <field name="res_model">advance.statement.match.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line" />
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
