<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_vrp2.Vrp2LoadCredentials">
        <button type="button" class="btn btn-secondary btn-sm me-1"
                t-on-click="onClick"
                title="Copy the VRP2 login and password from the company default register into this till.">
            <i class="fa fa-copy me-1"/>Load Credentials from Company
        </button>
    </t>

    <t t-name="pos_vrp2.Vrp2LoginButton">
        <button type="button" class="btn btn-primary btn-sm" t-on-click="onClick">
            Login
        </button>
    </t>

    <t t-name="pos_vrp2.Vrp2LogoutButton">
        <button type="button" class="btn btn-secondary btn-sm ms-1" t-on-click="onClick">
            Logout
        </button>
    </t>

</templates>
