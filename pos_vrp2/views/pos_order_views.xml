<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_pos_form_vrp2" model="ir.ui.view">
        <field name="name">pos.order.form.vrp2</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vrp2_fiscalize" type="object"
                        string="Fiscalize in VRP2"
                        class="btn-primary"
                        invisible="vrp2_state == 'fiscalized' or state not in ('paid', 'done') or not config_id"
                        groups="point_of_sale.group_pos_manager"/>
                <button name="action_vrp2_print_receipt" type="object"
                        string="Print VRP2 Receipt"
                        class="btn-secondary"
                        invisible="not vrp2_pdf"/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="VRP2 Fiscalization" name="vrp2"
                       invisible="vrp2_state == 'not_fiscalized' and not vrp2_error_message">
                    <group>
                        <field name="vrp2_state"/>
                        <field name="vrp2_receipt_number"
                               invisible="not vrp2_receipt_number"/>
                        <field name="vrp2_receipt_uuid"
                               invisible="not vrp2_receipt_uuid"/>
                        <field name="vrp2_created"
                               invisible="not vrp2_created"/>
                    </group>
                    <group>
                        <field name="vrp2_okp" invisible="not vrp2_okp"/>
                        <field name="vrp2_qr_content"
                               invisible="not vrp2_qr_content"/>
                        <field name="vrp2_pdf_filename" invisible="1"/>
                    </group>
                    <field name="vrp2_error_message" nolabel="1" colspan="2"
                           invisible="not vrp2_error_message"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='lines']/list/field[@name='full_product_name']" position="after">
                <field name="vrp2_item_name" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_vrp2" model="ir.ui.view">
        <field name="name">pos.order.list.vrp2</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vrp2_fiscalize" type="object"
                        string="Fiscalize in VRP2"
                        groups="point_of_sale.group_pos_manager"/>
            </xpath>
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="vrp2_state" optional="hide" widget="badge"
                       decoration-success="vrp2_state == 'fiscalized'"
                       decoration-danger="vrp2_state == 'error'"/>
                <field name="vrp2_receipt_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter_vrp2" model="ir.ui.view">
        <field name="name">pos.order.search.vrp2</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cancelled']" position="after">
                <separator/>
                <filter string="VRP2 Error" name="vrp2_error"
                        domain="[('vrp2_state', '=', 'error')]"/>
                <filter string="Not Fiscalized in VRP2" name="vrp2_not_fiscalized"
                        domain="[('vrp2_state', '!=', 'fiscalized'), ('config_id.vrp2_enabled', '=', True), ('state', 'in', ('paid', 'done'))]"/>
            </xpath>
        </field>
    </record>

</odoo>
