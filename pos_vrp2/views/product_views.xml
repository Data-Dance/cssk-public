<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_vrp2" model="ir.ui.view">
        <field name="name">product.template.form.vrp2</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="VRP2" invisible="not available_in_pos">
                    <group>
                        <field name="vrp2_code" readonly="1"/>
                        <field name="vrp2_synced" readonly="1"/>
                        <field name="vrp2_returnable_packaging"/>
                        <field name="vrp2_favourite"/>
                    </group>
                    <group>
                        <field name="vrp2_special_regulation"/>
                        <field name="vrp2_note"
                               placeholder="Internal note (max 1000 chars)"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
