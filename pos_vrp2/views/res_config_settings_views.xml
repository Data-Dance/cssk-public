<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_vrp2" model="ir.ui.view">
        <field name="name">res.config.settings.form.vrp2</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="VRP2 - Slovak Virtual Cash Register" name="vrp2_settings">
                    <setting string="VRP2 Tax Mapping"
                             help="Map VRP2 VAT rates to Odoo sales taxes. Each till's own VRP2 credentials are set on the Point of Sale (under Settings ▸ Edit), where you also log in and sync its catalog."
                             company_dependent="1">
                        <div class="content-group">
                            <div class="row mb-1">
                                <label for="vrp2_tax_0" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_0" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_tax_5" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_5" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_tax_10" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_10" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_tax_19" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_19" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_tax_20" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_20" class="col-lg-8"/>
                            </div>
                            <div class="row mb-1">
                                <label for="vrp2_tax_23" class="col-lg-4 o_light_label"/>
                                <field name="vrp2_tax_23" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
