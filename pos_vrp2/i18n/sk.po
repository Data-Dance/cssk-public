#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %(order)s was invoiced, so VRP2 holds an invoice payment for it, not a"
" sale. Cancel that payment receipt rather than returning items against it."
msgstr ""
"Objednávka %(order)s bola vyfakturovaná, takže VRP2 k nej eviduje úhradu "
"faktúry, nie predaj. Namiesto vrátenia položiek voči nej stornujte tento "
"doklad o úhrade."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %(order)s was paid %(paid)s but its VRP2 receipt totals %(total)s; the"
" difference is too large to be tax rounding."
msgstr ""
"Objednávka %(order)s bola uhradená sumou %(paid)s, ale jej doklad VRP2 je na"
" %(total)s; rozdiel je príliš veľký na to, aby šlo o zaokrúhlenie dane."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %(order)s was paid more by non-cash means (%(non_cash)s) than it costs"
" (%(total)s) and also in cash; that cannot be put on a receipt."
msgstr ""
"Objednávka %(order)s bola bezhotovostne uhradená viac (%(non_cash)s), než je"
" jej suma (%(total)s), a zároveň aj v hotovosti; takýto doklad nemožno "
"vystaviť."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %(order)s was paid more by non-cash means than it costs and also in "
"cash; that cannot be put on a receipt."
msgstr ""
"Objednávka %(order)s bola bezhotovostne uhradená viac, než je jej suma, a "
"zároveň aj v hotovosti; takýto doklad nemožno vystaviť."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %(order)s, which this refund returns goods from, has no VRP2 receipt "
"to reference. Fiscalize it first."
msgstr ""
"Objednávka %(order)s, z ktorej sa tovar vracia, nemá doklad VRP2, na ktorý "
"by sa dalo odkázať. Najprv ju zaevidujte."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid "Order %s has no lines to fiscalize."
msgstr "Objednávka %s nemá žiadne riadky na zaevidovanie."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid "Order %s is already fiscalized in VRP2."
msgstr "Objednávka %s je už vo VRP2 zaevidovaná."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order %s is an invoiced refund. A credit note is not fiscalized as an "
"invoice payment; cancel the original payment receipt instead."
msgstr ""
"Objednávka %s je vyfakturované vrátenie. Dobropis sa neeviduje ako úhrada "
"faktúry; namiesto toho stornujte pôvodný doklad o úhrade."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid "Order %s must be paid before it can be fiscalized."
msgstr "Objednávka %s musí byť pred zaevidovaním zaplatená."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order line '%(line)s' carries taxes VRP2 cannot express: a receipt item has "
"exactly one percentage VAT rate."
msgstr ""
"Riadok objednávky „%(line)s“ obsahuje dane, ktoré VRP2 nevie vyjadriť: "
"položka dokladu má práve jednu percentuálnu sadzbu DPH."

#. module: pos_vrp2
#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Order line '%(line)s' has VAT %(rate)s %%, which is not a VRP2 VAT rate "
"(%(allowed)s)."
msgstr ""
"Riadok objednávky „%(line)s“ má DPH %(rate)s %%, čo nie je sadzba DPH vo "
"VRP2 (%(allowed)s)."

#. module: pos_vrp2
