#. odoo-python
#: code:addons/pos_vrp2/models/pos_order.py:0
msgid ""
"Payment method '%(method)s' has no VRP2 payment type. A sale settled on a "
"customer account is not a cash-register sale; set the type on the payment "
"method if it is one."
msgstr ""
"Platební metoda „%(method)s“ nemá typ platby VRP2. Prodej uhrazený na účet "
"zákazníka není prodejem přes pokladnu; pokud jím je, nastavte typ u platební"
" metody."

#. module: pos_vrp2
#: model:ir.model.fields.selection,name:pos_vrp2.selection__pos_payment_method__vrp2_payment_type__card
