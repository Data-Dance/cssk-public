#. module: hr_attendance_holidays_kiosk
#: model:ir.model.fields,help:hr_attendance_holidays_kiosk.field_hr_attendance__checkout_reason_id
msgid ""
"Reason selected at the kiosk when checking out. Empty means a normal check-"
"out (work ended)."
msgstr ""
"Dôvod zvolený na kiosku pri odchode. Prázdne znamená bežný odchod (koniec "
"práce)."

#. module: hr_attendance_holidays_kiosk
