<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_holiday_status_form_kiosk" model="ir.ui.view">
        <field name="name">hr.leave.type.form.kiosk</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='visual']" position="before">
                <group name="kiosk_attendance" string="Attendance Kiosk" class="mw-100 col-lg-12">
                    <field name="kiosk_visible" widget="checkbox"/>
                    <field name="kiosk_sequence" invisible="not kiosk_visible"/>
                    <div class="text-warning" colspan="2"
                         invisible="not kiosk_visible or not requires_allocation">
                        Kiosk reasons should normally not require an allocation, otherwise
                        the time off generated at check-out is skipped when the employee
                        has no valid allocation.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_holiday_status_normal_tree_kiosk" model="ir.ui.view">
        <field name="name">hr.leave.type.normal.list.kiosk</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <field name="requires_allocation" position="after">
                <field name="kiosk_visible" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Dedicated, reorderable list of the kiosk reasons -->
    <record id="view_leave_type_kiosk_list" model="ir.ui.view">
        <field name="name">hr.leave.type.kiosk.list</field>
        <field name="model">hr.leave.type</field>
        <!-- High priority so this never becomes the model's default list view;
             it is used only through action_kiosk_leave_reasons (pinned view_id). -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="kiosk_sequence">
                <field name="kiosk_sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="request_unit"/>
                <field name="requires_allocation"/>
                <field name="leave_validation_type" optional="hide"/>
                <field name="kiosk_visible"/>
            </list>
        </field>
    </record>

    <record id="action_kiosk_leave_reasons" model="ir.actions.act_window">
        <field name="name">Kiosk Reasons</field>
        <field name="res_model">hr.leave.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_leave_type_kiosk_list"/>
        <field name="domain">[('kiosk_visible', '=', True)]</field>
        <field name="context">{
            'default_kiosk_visible': True,
            'default_request_unit': 'hour',
            'default_requires_allocation': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reason for leaving</p>
            <p>
                These Time Off Types appear as buttons when employees check out at the
                attendance kiosk. Drag the handle to change their order, and set a colour
                to tell them apart on the touchscreen.
            </p>
        </field>
    </record>

    <menuitem id="menu_kiosk_leave_reasons"
        name="Kiosk Reasons"
        parent="hr_holidays.menu_hr_holidays_configuration"
        action="action_kiosk_leave_reasons"
        groups="hr_holidays.group_hr_holidays_manager"
        sequence="2"/>

</odoo>
