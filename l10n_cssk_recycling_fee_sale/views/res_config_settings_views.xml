<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_cssk_recycling_fee_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_cssk_recycling_fee.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <field name="recycling_fee_presentation" position="after">
                <div class="content-group mt16" invisible="recycling_fee_presentation != 'on_top'">
                    <div class="row">
                        <label for="recycling_fee_product_id" class="col-lg-4 o_light_label" />
                        <field name="recycling_fee_product_id" />
                    </div>
                </div>
            </field>
        </field>
    </record>
</odoo>
