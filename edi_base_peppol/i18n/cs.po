#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid "%(kind)s sent via Peppol: %(link)s (%(state)s)."
msgstr "%(kind)s odeslán(a) přes Peppol: %(link)s (%(state)s)."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid ""
"%(name)s was already delivered via Peppol (%(msg)s). Correct it with a "
"credit note instead of sending it again."
msgstr ""
"%(name)s již byl(a) doručen(a) přes Peppol (%(msg)s). Místo opětovného "
"odeslání jej opravte dobropisem."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid ""
"%s cannot be responded to via Peppol: it must be a vendor bill received over"
" Peppol, with both parties Peppol-addressable and a transport provider "
"installed."
msgstr ""
"Na %s nelze odpovědět přes Peppol: musí jít o přijatou fakturu doručenou "
"přes Peppol, obě strany musí mít Peppol adresu a musí být nainstalován "
"poskytovatel přenosu."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid "%s does not send e-invoices."
msgstr "%s neodesílá e-faktury."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid "%s has no Peppol address."
msgstr "%s nemá Peppol adresu."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid ""
"%s has no VAT number: the Slovak mandate binds a VAT payer (§ 85o ods. 2 of "
"the VAT Act)."
msgstr ""
"%s nemá DIČ: slovenský mandát se vztahuje na plátce DPH (§ 85o ods. 2 "
"slovenského zákona o DPH)."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid "%s is a Slovak business in the mandate but has no Peppol address."
msgstr ""
"%s je slovenský podnikatel spadající pod mandát, ale nemá Peppol adresu."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid ""
"%s is not eligible for Peppol sending: it must be a posted customer "
"invoice/credit note, a Peppol transport provider must be installed, and both"
" your company and the customer must have a Peppol address (EAS + endpoint) "
"configured."
msgstr ""
"%s nelze odeslat přes Peppol: musí jít o zaúčtovanou fakturu nebo dobropis "
"odběrateli, musí být nainstalován poskytovatel přenosu Peppol a vaše "
"společnost i odběratel musí mít nastavenou Peppol adresu (EAS + koncový "
"bod)."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid "%s is set to receive e-invoices but has no Peppol address."
msgstr "%s má nastaveno přijímání e-faktur, ale nemá Peppol adresu."

#. module: edi_base_peppol
#. odoo-python
#: code:addons/edi_base_peppol/models/account_move.py:0
msgid ""
"A Peppol document for %(name)s is already being sent (status: %(state)s). "
"Manage it from the linked EDI message before re-sending."
msgstr ""
"Peppol doklad pro %(name)s se již odesílá (stav: %(state)s). Před opětovným "
"odesláním jej spravujte z propojené EDI zprávy."

#. module: edi_base_peppol
#: model:ir.model.fields,help:edi_base_peppol.field_res_company__peppol_send_enabled
#: model:ir.model.fields,help:edi_base_peppol.field_res_config_settings__peppol_send_enabled
msgid ""
"A permission for this company, not a routing decision: it says e-invoicing MAY be used, never that a given invoice will be. Which documents actually leave through Peppol is decided per contact, by 'Invoice sending' on the contact, and for contacts that state no preference by the Peppol scope below.\n"
"\n"
"Off: no customer invoice or credit note of this company ever goes out through Peppol, whatever a contact is set to — the invoice says so on its Peppol badge. Receiving vendor bills is unaffected; that is the provider's inbound poll, not this."
msgstr ""
"Oprávnění této společnosti, nikoli rozhodnutí o směrování: říká, že "
"e-fakturaci SMÍ používat, nikdy že ji použije konkrétní faktura. Které "
"doklady skutečně odejdou přes Peppol, se rozhoduje u každého kontaktu "
"volbou 'Invoice sending' na kontaktu a u kontaktů bez preference rozsahem "
"Peppol níže.\n"
"\n"
"Vypnuto: žádná faktura ani dobropis odběrateli této společnosti nikdy "
"neodejde přes Peppol, ať je kontakt nastaven jakkoli — faktura to uvádí na "
"svém štítku Peppol. Příjem přijatých faktur tím není dotčen; ten zajišťuje "
"příchozí stahování poskytovatele, ne toto nastavení."

#. module: edi_base_peppol
#: model_terms:ir.ui.view,arch_db:edi_base_peppol.view_res_config_settings_peppol
msgid ""
"A permission, not a routing decision. On, this\n"
"                            company <b>may</b> e-invoice; which documents\n"
"                            actually do is set per contact, in\n"
"                            <i>Invoice sending</i> on the contact\n"
"                            (\"by e-invoice (Peppol)\"), and for contacts that\n"
"                            state no preference by the scope below.\n"
"                            <br/>\n"
"                            Off, no customer invoice or credit note of this\n"
"                            company goes out through Peppol, whatever a contact\n"
"                            says — each invoice shows why on its Peppol badge.\n"
"                            Receiving vendor bills is unaffected."
msgstr ""
"Oprávnění, nikoli rozhodnutí o směrování. Je-li zapnuto, tato společnost "
"<b>smí</b> e-fakturovat; které doklady to skutečně dělají, se nastavuje u "
"každého kontaktu v <i>Invoice sending</i> na kontaktu (\"by e-invoice "
"(Peppol)\") a u kontaktů bez preference rozsahem níže.\n"
"                            <br/>\n"
"                            Je-li vypnuto, žádná faktura ani dobropis "
"odběrateli této společnosti neodejde přes Peppol, ať kontakt uvádí cokoli — "
"každá faktura ukazuje důvod na svém štítku Peppol. Příjem přijatých faktur "
"tím není dotčen."

#. module: edi_base_peppol
