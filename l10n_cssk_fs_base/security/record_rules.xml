<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cssk_fs_statement_company" model="ir.rule">
        <field name="name">Financial statement: multi-company</field>
        <field name="model_id" ref="model_cssk_fs_statement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cssk_fs_statement_line_company" model="ir.rule">
        <field name="name">Financial statement line: multi-company</field>
        <field name="model_id" ref="model_cssk_fs_statement_line"/>
        <field name="domain_force">[('statement_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cssk_fs_statement_unmapped_company" model="ir.rule">
        <field name="name">Financial statement unmapped account: multi-company</field>
        <field name="model_id" ref="model_cssk_fs_statement_unmapped"/>
        <field name="domain_force">[('statement_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
