<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_cssk_fs_base.FsTreeField">
        <div class="o_fs_tree" t-ref="root">
            <div class="btn-group btn-group-sm mb-2">
                <button type="button" class="btn btn-outline-secondary"
                        t-on-click="() => this.collapseAll()">
                    <i class="fa fa-compress me-1"/>Collapse all
                </button>
                <button type="button" class="btn btn-outline-secondary"
                        t-on-click="() => this.expandAll()">
                    <i class="fa fa-expand me-1"/>Expand all
                </button>
            </div>
            <table class="table table-sm o_fs_tree_table mb-0">
                <thead>
                    <tr>
                        <th>Line / Item</th>
                        <th class="text-end" style="width:14rem">Current period</th>
                        <th class="text-end" style="width:12rem">Prior period</th>
                        <th class="text-center" style="width:3rem" title="Ties to source documents">✓</th>
                        <th style="width:3rem"/>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="rows" t-as="row" t-key="row.id">
                        <tr t-att-class="{
                                'fw-bold': row.depth === 0,
                                'o_fs_aggregate text-700': row.hasChildren,
                            }">
                            <td>
                                <span t-att-style="'display:inline-block;width:' + (row.depth * 1.3) + 'em'"/>
                                <span t-if="row.hasChildren" class="o_fs_caret me-1"
                                      t-on-click="() => this.toggle(row.id)">
                                    <i t-att-class="row.collapsed ? 'fa fa-caret-right' : 'fa fa-caret-down'"/>
                                </span>
                                <span t-else="" class="me-1 d-inline-block" style="width:1em"/>
                                <small class="text-muted me-2" t-esc="row.code"/>
                                <span t-esc="row.name"/>
                            </td>
                            <t t-call="l10n_cssk_fs_base.FsTreeField.cell">
                                <t t-set="column" t-value="'current'"/>
                                <t t-set="manual" t-value="row.manual"/>
                                <t t-set="value" t-value="row.value"/>
                                <t t-set="cellClass" t-value="''"/>
                            </t>
                            <t t-call="l10n_cssk_fs_base.FsTreeField.cell">
                                <t t-set="column" t-value="'prior'"/>
                                <t t-set="manual" t-value="row.priorManual"/>
                                <t t-set="value" t-value="row.prior"/>
                                <t t-set="cellClass" t-value="'text-muted'"/>
                            </t>
                            <td class="text-center">
                                <i t-if="row.isLeaf and row.hasSource"
                                   t-att-class="row.reconciles ? 'fa fa-check text-success' : 'fa fa-exclamation-triangle text-warning'"
                                   t-att-title="row.reconciles ? titles.tie : titles.noTie"/>
                            </td>
                            <td class="text-center">
                                <button t-if="row.isLeaf and row.hasSource" type="button"
                                        class="btn btn-link btn-sm p-0"
                                        t-on-click="() => this.drill(row.id)"
                                        title="View source documents">
                                    <i class="fa fa-search-plus"/>
                                </button>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <!-- One figure: plain, or an input while entered by hand. -->
    <t t-name="l10n_cssk_fs_base.FsTreeField.cell">
        <td t-if="manual or isEditing(row, column)" class="text-end o_fs_manual"
            t-att-title="titles.manual">
            <div class="d-flex align-items-center justify-content-end gap-1">
                <input t-if="row.editable" type="text" inputmode="decimal"
                       class="o_input text-end o_fs_manual_input"
                       t-att-class="{'o_field_invalid': state.invalid[cellKey(row, column)]}"
                       t-att-data-cell="cellKey(row, column)"
                       t-att-value="inputValue(row, column)"
                       t-on-change="(ev) => this.setManual(row, column, ev)"
                       t-on-blur="(ev) => this.onBlur(row, column, ev)"/>
                <span t-else="" class="fst-italic" t-esc="fmt(value)"/>
                <button t-if="row.editable" type="button"
                        class="btn btn-link btn-sm p-0 text-muted"
                        t-att-title="titles.reset"
                        t-on-click="() => this.resetOverride(row, column)">
                    <i class="fa fa-undo"/>
                </button>
            </div>
        </td>
        <td t-else="" t-att-class="'text-end ' + cellClass">
            <button t-if="row.editable" type="button"
                    class="btn btn-link btn-sm p-0 me-1 o_fs_edit"
                    t-att-title="titles.edit"
                    t-on-click="() => this.startOverride(row, column)">
                <i class="fa fa-pencil"/>
            </button>
            <t t-esc="fmt(value)"/>
        </td>
    </t>

</templates>
