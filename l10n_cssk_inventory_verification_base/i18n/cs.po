msgstr "Zbývá vyúčtovat"

#. module: l10n_cssk_inventory_verification_base
#: model:ir.model.fields.selection,name:l10n_cssk_inventory_verification_base.selection__l10n_cssk_inventory_difference_line__kind__surplus model:ir.model.fields.selection,name:l10n_cssk_inventory_verification_base.selection__l10n_cz_inventarizacni_rozdil__kind__surplus model:ir.model.fields.selection,name:l10n_cssk_inventory_verification_base.selection__l10n_sk_inventarizacny_rozdiel__kind__surplus
