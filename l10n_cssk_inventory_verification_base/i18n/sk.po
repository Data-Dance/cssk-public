#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%(entry)s books inventory differences of %(date)s, which lies in a locked period (%(locks)s). Posted now it would be moved into another accounting period. Unlock the period first."
msgstr "%(entry)s účtuje inventarizačné rozdiely k %(date)s, čo je v uzamknutom období (%(locks)s). Pri zaúčtovaní by sa teraz presunul do iného účtovného obdobia. Najprv obdobie odomknite."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid ""
"%(name)s: choose both accounts on:\n"
"%(lines)s"
msgstr ""
"%(name)s: zvoľte oba účty na riadkoch:\n"
"%(lines)s"

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid ""
"%(name)s: the account and its counterpart are the same on:\n"
"%(lines)s"
msgstr ""
"%(name)s: účet a súvzťažný účet sú rovnaké na riadkoch:\n"
"%(lines)s"

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%(name)s: the differences belong to %(date)s, which lies in a locked period (%(locks)s). Unlock the period first: booked later, they would fall into another accounting period."
msgstr "%(name)s: rozdiely patria k %(date)s, čo je v uzamknutom období (%(locks)s). Najprv obdobie odomknite: zaúčtované neskôr by pripadli do iného účtovného obdobia."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid ""
"%(name)s: these count sheets have a difference that is neither settled in full nor marked as not booked here:\n"
"%(sheets)s"
msgstr ""
"%(name)s: tieto súpisy majú rozdiel, ktorý nie je celý vyúčtovaný ani označený ako neúčtovaný:\n"
"%(sheets)s"

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: choose the journal the differences are booked in."
msgstr "%s: zvoľte denník, v ktorom sa rozdiely účtujú."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: differences are booked once the inventory verification has started."
msgstr "%s: rozdiely sa účtujú až po začatí inventarizácie."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: say why the difference is not booked here."
msgstr "%s: uveďte, prečo sa rozdiel tu neúčtuje."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: the amount of a difference must be positive; the kind says whether it is a shortage or a surplus."
msgstr "%s: suma rozdielu musí byť kladná; či ide o manko alebo prebytok, určuje druh."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: the day the state was verified as at is missing."
msgstr "%s: chýba deň, ku ktorému sa stav overuje."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: the difference is marked as not booked here, so it takes no settlement lines."
msgstr "%s: rozdiel je označený ako neúčtovaný, preto nemôže mať riadky vyúčtovania."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: the difference is marked as not booked here, yet it has settlement lines. Remove one or the other."
msgstr "%s: rozdiel je označený ako neúčtovaný, a predsa má riadky vyúčtovania. Jedno alebo druhé odstráňte."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "%s: there is no difference left to book."
msgstr "%s: nezostáva žiadny rozdiel na zaúčtovanie."

#. module: l10n_cssk_inventory_verification_base
#. odoo-python
#: code:addons/l10n_cssk_inventory_verification_base/models/inventory_difference.py:0
msgid "A journal entry was already created from this difference. Cancel the booking of the differences first."
msgstr "Z tohto rozdielu už vznikol účtovný zápis. Najprv zrušte zaúčtovanie rozdielov."

