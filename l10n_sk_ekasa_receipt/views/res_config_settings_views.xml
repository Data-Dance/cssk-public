<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sk_ekasa" model="ir.ui.view">
        <field name="name">res.config.settings.form.sk.ekasa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="l10n_cssk_receipt_capture.res_config_settings_view_form_receipt_capture"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cssk_receipt_block']" position="after">
                <block title="Slovak eKasa Receipt Lookup" name="sk_ekasa_block">
                    <setting string="Enable eKasa Lookup"
                             help="Fetch the registered receipt from Finančná správa using the QR code">
                        <field name="l10n_sk_ekasa_enabled"/>
                    </setting>
                    <setting string="IP Address Notified (§ 18/11)"
                             help="Act 384/2025 Z. z. requires an overovateľ to notify Finančná správa of the IP address it calls from, and to send truthful verification results. Lookups are refused until this is confirmed."
                             invisible="not l10n_sk_ekasa_enabled">
                        <field name="l10n_sk_ekasa_ip_notified"/>
                        <div class="content-group mt16"
                             invisible="not l10n_sk_ekasa_ip_notified">
                            <div class="row">
                                <label for="l10n_sk_ekasa_ip_address" class="col-lg-4 o_light_label"/>
                                <field name="l10n_sk_ekasa_ip_address"/>
                            </div>
                            <div class="row">
                                <label for="l10n_sk_ekasa_ip_notified_on" class="col-lg-4 o_light_label"/>
                                <field name="l10n_sk_ekasa_ip_notified_on"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Hourly Lookup Budget"
                             help="The service allows roughly 60 lookups per clock hour per IP address and blocks the address beyond that. Several companies sharing an egress address share one real budget."
                             invisible="not l10n_sk_ekasa_enabled">
                        <field name="l10n_sk_ekasa_hourly_budget"/>
                    </setting>
                    <setting string="Lookup Timeout (s)"
                             invisible="not l10n_sk_ekasa_enabled">
                        <field name="l10n_sk_ekasa_timeout"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
