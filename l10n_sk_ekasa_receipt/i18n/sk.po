msgid ""
"Overovací kód podnikateľa, as returned by the service. Stored upper-cased: "
"the service emits it in either case."
msgstr ""
"Overovací kód podnikateľa, ako ho vrátila služba. Ukladá sa veľkými "
"písmenami: služba ho vracia v oboch tvaroch."

#. module: l10n_sk_ekasa_receipt
#: model:ir.model.fields,field_description:l10n_sk_ekasa_receipt.field_cssk_receipt__l10n_sk_ekasa_is_paragon
