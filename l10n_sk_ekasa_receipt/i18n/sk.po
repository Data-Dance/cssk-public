#. module: l10n_sk_ekasa_receipt
#. odoo-python
#: code:addons/l10n_sk_ekasa_receipt/models/cssk_receipt_provider_sk_ekasa.py:0
msgid ""
"Could not reach Finančná správa's verification service (%s). The receipt was"
" left untouched; try again."
msgstr ""
"Službu finančnej správy na overovanie dokladov sa nepodarilo zastihnúť (%s)."
" Doklad zostal nezmenený; skúste to znova."

#. module: l10n_sk_ekasa_receipt
#: model_terms:ir.ui.view,arch_db:l10n_sk_ekasa_receipt.res_config_settings_view_form_sk_ekasa
msgid "Enable eKasa Lookup"
msgstr "Zapnúť overenie v eKase"

#. module: l10n_sk_ekasa_receipt
#: model:ir.model.fields,help:l10n_sk_ekasa_receipt.field_res_company__l10n_sk_ekasa_enabled
msgid ""
"Fetch registered receipts from Finančná správa's document-verification "
"service when a receipt's QR code is known."
msgstr ""
"Načítať registrované doklady zo služby finančnej správy na overovanie "
"dokladov, keď je známy QR kód dokladu."

#. module: l10n_sk_ekasa_receipt
#: model_terms:ir.ui.view,arch_db:l10n_sk_ekasa_receipt.res_config_settings_view_form_sk_ekasa
msgid "Fetch the registered receipt from Finančná správa using the QR code"
msgstr "Načítať registrovaný doklad z finančnej správy podľa QR kódu"

#. module: l10n_sk_ekasa_receipt
#. odoo-python
#: code:addons/l10n_sk_ekasa_receipt/models/cssk_receipt_provider_sk_ekasa.py:0
msgid ""
"Finančná správa holds no receipt for this code. Either the seller never "
"registered it — which is worth reporting — or the code was misread."
msgstr ""
"Finančná správa pre tento kód nemá žiadny doklad. Buď ho predávajúci nikdy "
"nezaevidoval — čo stojí za oznámenie —, alebo bol kód prečítaný nesprávne."

