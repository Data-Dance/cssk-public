#. module: l10n_cssk_accrual
#: model:ir.module.module,shortdesc:base.module_l10n_cssk_accrual
msgid "CZ/SK Estimated Accruals (dohadné položky)"
msgstr "CZ/SK dohadné položky"

#. module: l10n_cssk_accrual
#. odoo-python
#: code:addons/l10n_cssk_accrual/models/cssk_accrual_estimate.py:0
msgid ""
"Cannot reverse accrual %(name)s on %(date)s: that date falls in a locked "
"period (%(locks)s). Adjust the lock date or use a later reversal date."
msgstr ""
"Dohadnou položku %(name)s nelze stornovat k %(date)s: toto datum "
"spadá do uzamčeného období (%(locks)s). Upravte datum uzamčení nebo "
"použijte pozdější datum storna."

#. module: l10n_cssk_accrual
#: model:ir.module.module,summary:base.module_l10n_cssk_accrual
msgid ""
"Estimated unbilled items — book an estimate to the accrual account (CZ "
"388/389, SK 326), then link the actual invoice to true it up."
msgstr ""
"Odhad nevyfakturovaných položek — zaúčtujte odhad na účet dohadných "
"položek (CZ 388/389, SK 326) a následně na něj navažte skutečnou "
"fakturu k dorovnání."

#. module: l10n_cssk_accrual
#. odoo-python
#: code:addons/l10n_cssk_accrual/models/cssk_accrual_estimate.py:0
msgid ""
"Only a draft or posted estimate can be cancelled (%(name)s is %(state)s)."
msgstr ""
"Zrušit lze jen odhad ve stavu návrh nebo zaúčtovaný (%(name)s je "
"%(state)s)."

#. module: l10n_cssk_accrual
#. odoo-python
#: code:addons/l10n_cssk_accrual/models/cssk_accrual_estimate.py:0
msgid ""
"The accrual account %(account)s of %(name)s must allow reconciliation, "
"otherwise the estimate cannot be cleared against its reversal when settled."
msgstr ""
"Účet dohadných položek %(account)s záznamu %(name)s musí povolovat "
"párování, jinak nelze odhad při vypořádání spárovat s jeho stornem."

#. module: l10n_cssk_accrual
#. odoo-python
#: code:addons/l10n_cssk_accrual/models/cssk_accrual_estimate.py:0
msgid ""
"The accrual line of %(name)s on account %(account)s is already reconciled "
"(moves: %(moves)s). Unreconcile it first if you really want to reverse this "
"estimate."
msgstr ""
"Řádek dohadné položky %(name)s na účtu %(account)s je již spárován "
"(doklady: %(moves)s). Chcete-li tento odhad opravdu stornovat, "
"nejprve zrušte párování."