#. module: account_statement_fio
#: model:ir.model.fields,help:account_statement_fio.field_account_journal__fio_last_movement_id
msgid ""
"Highest Fio movement id imported so far. Informational — duplicate detection"
" uses the statement line's import key."
msgstr ""
"Nejvyšší dosud naimportované ID pohybu Fio. Pouze informativní — duplicity "
"se rozpoznávají podle importního klíče řádku výpisu."

#. module: account_statement_fio
#: model:ir.model.fields,field_description:account_statement_fio.field_fio_statement_pull__history_unlocked
msgid "History unlocked in internet banking"
msgstr "Historie odemčena v internetovém bankovnictví"

