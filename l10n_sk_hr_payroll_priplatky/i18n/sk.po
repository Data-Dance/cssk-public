#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_hr_job__l10n_sk_wage_level
msgid ""
"Difficulty level of this post (§ 120 ods. 2 and Annex 1 to the Zákonník "
"práce). New contracts on this job start from it. Left empty, contracts fall "
"back to level 1 — the plain minimum wage."
msgstr ""

#. module: l10n_sk_hr_payroll_priplatky
#: model_terms:ir.ui.view,arch_db:l10n_sk_hr_payroll_priplatky.l10n_sk_minimum_wage_view_search
