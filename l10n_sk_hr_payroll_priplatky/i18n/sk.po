#: model:ir.module.module,summary:base.module_l10n_sk_hr_payroll_priplatky
msgid ""
"Engine-neutral statutory wage surcharges for night, Saturday, Sunday, "
"public-holiday, overtime, difficult-conditions and standby work (§§ 121–123 "
"Zákonníka práce), plus the six stupne náročnosti minimum wage claims and the"
" top-up to them."
msgstr ""

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__date_from
msgid "First day on which these percentages apply."
msgstr "Prvý deň, od ktorého tieto percentá platia."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_minimum_wage__date_from
msgid ""
"First day on which this claim applies. The Slovak minimum wage changes on 1 "
"January."
msgstr ""
"Prvý deň, od ktorého tento nárok platí. Slovenská minimálna mzda sa mení 1. "
"januára."

