msgstr "Mzdové príplatky od %(date)s"

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__nadcas_pct
msgid ""
"§ 121 ods. 1 — at least 25 % of average earnings on top of the wage for the "
"overtime hour itself."
msgstr ""
"§ 121 ods. 1 — najmenej 25 % priemerného zárobku nad rámec mzdy za samotnú "
"hodinu nadčasu."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__nadcas_risk_pct
msgid ""
"§ 121 ods. 1 — at least 35 % where the work is classified as risky (riziková"
" práca)."
msgstr ""

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__sviatok_pct
msgid ""
"§ 122 ods. 1 — at least 100 % of average earnings for work performed on a "
"public holiday."
msgstr ""
"§ 122 ods. 1 — najmenej 100 % priemerného zárobku za prácu vo sviatok."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__noc_pct
msgid "§ 122a ods. 1 — at least 40 % of the minimum hourly wage."
msgstr "§ 122a ods. 1 — najmenej 40 % minimálnej hodinovej mzdy."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__noc_risk_pct
msgid ""
"§ 122a ods. 2 — at least 50 % where the work is classified as risky "
"(riziková práca)."
msgstr ""

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_hr_version__l10n_sk_night_reduced
msgid ""
"§ 122a ods. 3 — a collective agreement sets the night surcharge at the lower"
" statutory floor because the predominant part of the work is performed at "
"night. Ignored for risky work."
msgstr ""
"§ 122a ods. 3 — kolektívna zmluva určuje nočný príplatok na nižšej zákonnej "
"hranici, pretože prevažná časť práce sa vykonáva v noci. Pri rizikovej práci"
" sa neuplatní."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__noc_reduced_pct
msgid ""
"§ 122a ods. 3 — at least 35 %, available only by collective agreement to "
"employers whose work is predominantly performed at night, and never for "
"risky work."
msgstr ""
"§ 122a ods. 3 — najmenej 35 %, dostupné len na základe kolektívnej zmluvy "
"zamestnávateľom, u ktorých sa práca vykonáva prevažne v noci, a nikdy pri "
"rizikovej práci."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__sobota_pct
msgid "§ 122b ods. 1 — at least 50 % of the minimum hourly wage."
msgstr "§ 122b ods. 1 — najmenej 50 % minimálnej hodinovej mzdy."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_hr_version__l10n_sk_saturday_reduced
msgid ""
"§ 122b ods. 2 — a collective agreement sets the Saturday surcharge at the "
"lower statutory floor because the nature of the work requires regular work "
"on Saturdays."
msgstr ""
"§ 122b ods. 2 — kolektívna zmluva určuje sobotňajší príplatok na nižšej "
"zákonnej hranici, pretože povaha práce vyžaduje pravidelnú prácu v sobotu."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__sobota_reduced_pct
msgid ""
"§ 122b ods. 2 — at least 45 % by collective agreement where the nature of "
"the work requires regular work on Saturdays."
msgstr ""
"§ 122b ods. 2 — najmenej 45 % na základe kolektívnej zmluvy, ak povaha práce"
" vyžaduje pravidelnú prácu v sobotu."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__nedela_pct
msgid "§ 122c ods. 1 — at least 100 % of the minimum hourly wage."
msgstr "§ 122c ods. 1 — najmenej 100 % minimálnej hodinovej mzdy."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_hr_version__l10n_sk_sunday_reduced
msgid ""
"§ 122c ods. 2 — a collective agreement sets the Sunday surcharge at the "
"lower statutory floor because the nature of the work requires regular work "
"on Sundays."
msgstr ""
"§ 122c ods. 2 — kolektívna zmluva určuje nedeľný príplatok na nižšej "
"zákonnej hranici, pretože povaha práce vyžaduje pravidelnú prácu v nedeľu."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__nedela_reduced_pct
msgid ""
"§ 122c ods. 2 — at least 90 % by collective agreement where the nature of "
"the work requires regular work on Sundays."
msgstr ""
"§ 122c ods. 2 — najmenej 90 % na základe kolektívnej zmluvy, ak povaha práce"
" vyžaduje pravidelnú prácu v nedeľu."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__stazeny_pct
msgid ""
"§ 123 — mzdová kompenzácia za sťažený výkon práce, at least 20 % of the "
"minimum hourly wage."
msgstr ""

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model.fields,help:l10n_sk_hr_payroll_priplatky.field_l10n_sk_wage_surcharge_rate__pohotovost_pct
msgid ""
"§ 96 ods. 5 — at least 20 % of the minimum hourly wage for each hour of "
"inactive standby away from the workplace."
msgstr ""
"§ 96 ods. 5 — najmenej 20 % minimálnej hodinovej mzdy za každú hodinu "
"neaktívnej pracovnej pohotovosti mimo pracoviska."

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model,name:l10n_sk_hr_payroll_priplatky.model_l10n_sk_minimum_wage
msgid "Slovak Minimum Wage Claim (stupeň náročnosti)"
msgstr "Slovenský minimálny mzdový nárok (stupeň náročnosti)"

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model,name:l10n_sk_hr_payroll_priplatky.model_sk_surcharge_payslip_mixin
msgid "Slovak Wage Surcharge Payslip Mixin"
msgstr "Mixin výplatnej pásky pre slovenské mzdové príplatky"

#. module: l10n_sk_hr_payroll_priplatky
#: model:ir.model,name:l10n_sk_hr_payroll_priplatky.model_l10n_sk_wage_surcharge_rate
msgid "Slovak Wage Surcharge Rate"
msgstr "Slovenská sadzba mzdových príplatkov"