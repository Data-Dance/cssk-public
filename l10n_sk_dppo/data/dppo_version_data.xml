  <record id="dppo_ld_r100_2025" model="cssk.income.tax.line.def">
    <field name="version_id" ref="dppo_version_2025"/><field name="code">r100</field>
    <field name="name">r100</field><field name="sequence">10</field>
    <!-- VH pred zdanením = výnosy (6) − náklady (5), excluding daň z príjmov
         (591 splatná, 592 odložená, 595 dodatočné) and prevod podielov na VH
         spoločníkom (596) — i.e. = VZS r56. § 17 ods. 1 zák. 595/2003 + DPPOv25
         poučenie ("výsledok hospodárenia pred zdanením zistený v účtovníctve"). -->
