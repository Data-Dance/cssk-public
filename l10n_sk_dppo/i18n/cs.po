msgstr "%(code)s nesouhlasí se svou tabulkou"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"%(code)s is overridden to %(value).2f, but %(formula)s over the table gives "
"%(expected).2f. Correct the table or remove the override."
msgstr "%(code)s je přepsán na %(value).2f, ale %(formula)s z tabulky dává %(expected).2f. Opravte tabulku nebo zrušte přepis."

