"%(country)s — section 31 conversion: %(source).2f %(currency)s × %(rate).8f "
"EUR = %(converted).2f EUR; eligible %(tax).2f EUR. %(evidence)s"
msgstr ""
"%(country)s — přepočet podle § 31: %(source).2f %(currency)s × %(rate).8f "
"EUR = %(converted).2f EUR; způsobilá daň %(tax).2f EUR. %(evidence)s"

