#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"r410 is %(loss).2f but § 30 ods. 1 písm. b) allows %(limit).2f unless the "
"company is a mikrodaňovník."
msgstr "Řádek r410 je %(loss).2f, ale § 30 ods. 1 písm. b) umožňuje %(limit).2f, pokud společnost není mikrodaňovníkem."

#. module: l10n_sk_dppo
