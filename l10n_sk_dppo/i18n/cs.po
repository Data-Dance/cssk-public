#: code:addons/l10n_sk_dppo/models/dppo_table_i.py:0
msgid ""
"Review the Table I transaction code, tax-residence country code and related "
"person's name."
msgstr ""
"Zkontrolujte kód transakce, kód země daňové rezidence a název závislé osoby "
"v tabulce I."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "Review the first, second or third subsequent tax period for Table K."
msgstr ""
"Zkontrolujte první, druhé nebo třetí následující zdaňovací období pro "
"tabulku K."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "Review the foreign tax source status."
msgstr "Zkontrolujte stav zdroje zahraniční daně."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"Review the legacy section 35/35a relief, its evidence and the blank row "
"1110."
msgstr ""
"Zkontrolujte dřívější úlevu podle § 35/35a, její podklady a prázdný řádek "
"1110."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid ""
"Review the ordinary loss period and its following-tax-period number from 1 "
"to 5."
msgstr ""
"Zkontrolujte běžné období ztráty a číslo následujícího zdaňovacího období od"
" 1 do 5."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_pdf.py:0
msgid "Review the tax-period dates."
msgstr "Zkontrolujte data zdaňovacího období."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_f_cost
msgid "Reviewed Table F costs before income tax"
msgstr "Ověřené náklady tabulky F před daní z příjmů"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_f_revenue
msgid "Reviewed Table F revenue"
msgstr "Ověřené výnosy tabulky F"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_k_line__evidence
msgid "Reviewed filed return, payment and intervening-period evidence"
msgstr "Ověřené podané přiznání, platba a podklady mezilehlých období"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_e_line__evidence
msgid "Reviewed income, treaty and tax evidence"
msgstr "Ověřené podklady k příjmům, smlouvě a dani"

#. module: l10n_sk_dppo
#: model:ir.model.fields,help:l10n_sk_dppo.field_l10n_sk_dppo_table_d_line__subsequent_period_number
msgid ""
"Reviewed ordinal from 1 to 5 for ordinary section 30 losses. Count tax "
"periods, including short periods, not elapsed calendar years."
msgstr ""
"Ověřené pořadové číslo od 1 do 5 pro běžné ztráty podle § 30. Počítejte "
"zdaňovací období včetně krátkých období, nikoli uplynulé kalendářní roky."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_form_nace
msgid "SK NACE for the form"
msgstr "SK NACE pro formulář"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_i_line__section
msgid "Section"
msgstr "Část"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_e_line__fx_evidence
msgid "Section 31 conversion evidence"
msgstr "Podklady k přepočtu podle § 31"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Section 45(2) estimates require a different, evidenced foreign tax period."
msgstr ""
"Odhady podle § 45 odst. 2 vyžadují odlišné doložené zahraniční zdaňovací "
"období."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_i_line__sequence
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_l_line__sequence
msgid "Sequence"
msgstr "Pořadí"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_i_line__tax_effect
msgid "Signed effect on row 400"
msgstr "Vliv na řádek 400 se znaménkem"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_l_line__amount
msgid "Signed taxable-revenue adjustment"
msgstr "Úprava zdanitelných výnosů se znaménkem"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_e_line__tax_currency_id
msgid "Source tax currency"
msgstr "Měna zdrojové daně"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_k_line__date_to
msgid "Source tax-period end"
msgstr "Konec zdrojového zdaňovacího období"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_k_line__date_from
msgid "Source tax-period start"
msgstr "Začátek zdrojového zdaňovacího období"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_form_currency_start
msgid "Start special exchange-difference treatment"
msgstr "Zahájení zvláštního režimu kurzových rozdílů"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_k_line__subsequent_period_number
msgid "Subsequent tax-period ordinal"
msgstr "Pořadí následujícího zdaňovacího období"

#. module: l10n_sk_dppo
#: model_terms:ir.ui.view,arch_db:l10n_sk_dppo.dppo_table_d_form
msgid "Table D - prior tax losses"
msgstr "Tabulka D – dřívější daňové ztráty"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid ""
"Table D deductions cannot exceed the positive originally declared loss."
msgstr "Odpočty tabulky D nesmí překročit kladnou původně přiznanou ztrátu."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid ""
"Table D must describe an earlier loss period; the current-period loss stays "
"in row 400."
msgstr ""
"Tabulka D musí uvádět dřívější období ztráty; ztráta aktuálního období "
"zůstává na řádku 400."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_table_d_ids
msgid "Table D prior tax losses"
msgstr "Dřívější daňové ztráty tabulky D"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Table E %(country)s: net base %(base).2f EUR; hybrid %(hybrid).2f EUR; "
"treaty tax %(tax).2f EUR; source %(source).2f %(currency)s (%(status)s)."
msgstr ""
"Tabulka E %(country)s: čistý základ %(base).2f EUR; hybridní příjem "
"%(hybrid).2f EUR; smluvní daň %(tax).2f EUR; zdroj %(source).2f %(currency)s"
" (%(status)s)."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_table_e_ids
msgid "Table E - foreign tax credit"
msgstr "Tabulka E – zápočet zahraniční daně"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "Table E requires a positive native row 400."
msgstr "Tabulka E vyžaduje kladný nativní řádek 400."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_fl.py:0
msgid ""
"Table F revenue less costs must equal row 100; review the ledger or enter "
"reviewed source figures."
msgstr ""
"Výnosy tabulky F snížené o náklady musí odpovídat řádku 100; zkontrolujte "
"hlavní knihu nebo zadejte ověřené zdrojové částky."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_f_evidence
msgid "Table F source evidence"
msgstr "Zdrojové podklady tabulky F"

#. module: l10n_sk_dppo
#: model_terms:ir.ui.view,arch_db:l10n_sk_dppo.dppo_table_i_form
msgid "Table I - controlled transactions"
msgstr "Tabulka I – kontrolované transakce"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_i.py:0
msgid ""
"Table I allows at most 99 transactions and 99 loans; review the statutory "
"reporting priorities."
msgstr ""
"Tabulka I umožňuje nejvýše 99 transakcí a 99 úvěrů; zkontrolujte zákonné "
"priority vykazování."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_table_i_ids
msgid "Table I transactions"
msgstr "Transakce tabulky I"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Table K %(start)s–%(end)s: %(expired).2f EUR expires after the third "
"subsequent tax period."
msgstr ""
"Tabulka K %(start)s–%(end)s: %(expired).2f EUR zaniká po třetím následujícím"
" zdaňovacím období."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_table_k_ids
msgid "Table K - prior minimum-tax credits"
msgstr "Tabulka K – zápočty dřívější minimální daně"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Table K current claims cannot exceed the tax above the current minimum tax."
msgstr ""
"Aktuální zápočty tabulky K nesmí překročit daň nad aktuální minimální daní."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Table K needs a positive eligible difference, a fully paid original minimum "
"tax and claims within that difference."
msgstr ""
"Tabulka K vyžaduje kladný způsobilý rozdíl, plně zaplacenou původní "
"minimální daň a zápočty v rámci tohoto rozdílu."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid ""
"Table K requires a prior, non-overlapping minimum-tax period starting in "
"2024 or later."
msgstr ""
"Tabulka K vyžaduje dřívější nepřekrývající se období minimální daně "
"začínající v roce 2024 nebo později."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "Table K source periods must not overlap or be duplicated."
msgstr "Zdrojová období tabulky K se nesmí překrývat ani opakovat."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_fl.py:0
msgid "Table L taxable revenue cannot be negative."
msgstr "Zdanitelné výnosy tabulky L nesmí být záporné."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_table_l_ids
msgid "Table L taxable-revenue adjustments"
msgstr "Úpravy zdanitelných výnosů tabulky L"

#. module: l10n_sk_dppo
#: model_terms:ir.ui.view,arch_db:l10n_sk_dppo.dppo_table_ek_form
msgid "Tables E/K - reviewed tax credits"
msgstr "Tabulky E/K – ověřené zápočty daně"

#. module: l10n_sk_dppo
#: model_terms:ir.ui.view,arch_db:l10n_sk_dppo.dppo_table_fl_form
msgid "Tables F/L - ordinary double-entry accounting"
msgstr "Tabulky F/L – běžné podvojné účetnictví"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_i_line__resident_country_code
msgid "Tax-residence country code"
msgstr "Kód země daňové rezidence"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_l_line__description
msgid "Taxable-revenue adjustment"
msgstr "Úprava zdanitelných výnosů"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_l_line__evidence
msgid "Taxable-revenue classification evidence"
msgstr "Podklady ke klasifikaci zdanitelných výnosů"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_fl.py:0
msgid ""
"The Table L adjustment linked to a return row cannot exceed that row's "
"amount."
msgstr ""
"Úprava tabulky L propojená s řádkem přiznání nesmí překročit částku tohoto "
"řádku."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_i.py:0
msgid ""
"The controlled-transactions declaration must agree with the entered Table I "
"facts."
msgstr ""
"Prohlášení o kontrolovaných transakcích musí souhlasit se zadanými údaji "
"tabulky I."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"The form version %(version)s does not apply to this return. Under oznámenie "
"MF/014310/2026-721 the DPPO form follows the last day of the filing "
"deadline, here %(deadline)s: the 2025 form (MF/012187/2025-721) only when it"
" ends on or before 31 December 2026, the 2026 form (MF/014309/2026-721) when"
" it ends later. Choose a version the return offers for its period and "
"deadline, including any effective extension."
msgstr ""
"Verze tiskopisu %(version)s se na toto přiznání nevztahuje. Podle "
"slovenského oznámení MF/014310/2026-721 se tiskopis DPPO řídí posledním dnem"
" lhůty pro podání, zde %(deadline)s: tiskopis z roku 2025 "
"(MF/012187/2025-721) jen tehdy, uplyne-li nejpozději 31. prosince 2026, "
"tiskopis z roku 2026 (MF/014309/2026-721), uplyne-li později. Zvolte verzi,"
" kterou přiznání nabízí pro své období a lhůtu, včetně účinného prodloužení "
"lhůty."

#. module: l10n_sk_dppo
#: model:ir.model.fields,help:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_dppo_filing_deadline
msgid ""
"The legal deadline including an effective extension, when it differs from "
"the ordinary three-calendar-month deadline. This is not the actual filing "
"date."
msgstr ""
"Zákonná lhůta včetně účinného prodloužení, liší-li se od běžné tříměsíční "
"lhůty. Nejde o skutečné datum podání."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid ""
"The linked native loss return must match the company, loss period and "
"declared loss amount."
msgstr ""
"Propojené nativní přiznání se ztrátou musí odpovídat společnosti, období "
"ztráty a přiznané částce ztráty."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_pdf.py:0
msgid ""
"The minimum-tax declaration must agree with the reviewed row 810 amount."
msgstr ""
"Prohlášení o minimální dani musí souhlasit s ověřenou částkou na řádku 810."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_pdf.py:0
msgid "The official DPPO form cannot be printed: %s"
msgstr "Oficiální formulář DPPO nelze vytisknout: %s"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_pdf.py:0
msgid "The official Slovak form requires amounts in EUR."
msgstr "Oficiální slovenský formulář vyžaduje částky v EUR."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid ""
"The ordinary Table D loss deduction cannot exceed 50 percent of row 400."
msgstr ""
"Běžný odpočet ztráty v tabulce D nesmí překročit 50 procent řádku 400."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_pdf.py:0
msgid "The prior minimum-tax credit declaration must agree with row 920."
msgstr ""
"Prohlášení o zápočtu dřívější minimální daně musí souhlasit s řádkem 920."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"The published DPPO form can be calculated, but its official XML schema is "
"not installed. Install the published electronic version before XML export."
msgstr ""
"Zveřejněný formulář DPPO lze vypočítat, ale jeho oficiální schéma XML není "
"nainstalováno. Před exportem XML nainstalujte zveřejněnou elektronickou "
"verzi."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "The published Table K has four source-period rows."
msgstr "Zveřejněná tabulka K obsahuje čtyři řádky zdrojových období."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_fl.py:0
msgid "The published Table L has adjustment rows 2 through 98."
msgstr "Zveřejněná tabulka L obsahuje řádky úprav 2 až 98."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_i.py:0
msgid "The related contact must be shared or belong to the return's company."
msgstr ""
"Související kontakt musí být sdílený nebo patřit společnosti přiznání."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"The reviewed prior minimum-tax credit (row 920) must be nonnegative and "
"cannot exceed row 910. Review Table K."
msgstr ""
"Ověřený zápočet dřívější minimální daně (řádek 920) musí být nezáporný a "
"nesmí překročit řádek 910. Zkontrolujte tabulku K."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid "The total Table D deduction cannot exceed the positive row 400 base."
msgstr "Celkový odpočet tabulky D nesmí překročit kladný základ na řádku 400."

#. module: l10n_sk_dppo
#: model:ir.model.fields,help:l10n_sk_dppo.field_l10n_sk_dppo_table_l_line__return_row
msgid "Three-digit row number of the income adjustment in the return."
msgstr "Třímístné číslo řádku úpravy příjmů v přiznání."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_form_title_after
msgid "Title after the person's name"
msgstr "Titul za jménem osoby"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_cssk_income_tax_return__l10n_sk_form_title_before
msgid "Title before the person's name"
msgstr "Titul před jménem osoby"

#. module: l10n_sk_dppo
#: model:ir.model.fields.selection,name:l10n_sk_dppo.selection__l10n_sk_dppo_table_i_line__section__transaction
msgid "Transaction"
msgstr "Transakce"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_ek.py:0
msgid "Treaty-eligible tax cannot exceed the converted source tax."
msgstr ""
"Daň způsobilá podle smlouvy nesmí překročit přepočtenou zdrojovou daň."

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_e_line__eligible_tax
msgid "Treaty-eligible tax in EUR"
msgstr "Daň způsobilá podle smlouvy v EUR"

#. module: l10n_sk_dppo
#: model:ir.model.fields,field_description:l10n_sk_dppo.field_l10n_sk_dppo_table_d_line__expired
msgid "Unused balance expiring after this period"
msgstr "Nevyužitý zůstatek zanikající po tomto období"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_d.py:0
msgid "Use each official Table D column only once."
msgstr "Každý oficiální sloupec tabulky D použijte pouze jednou."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/dppo_table_fl.py:0
msgid "Use finite Table F amounts."
