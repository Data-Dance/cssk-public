#. module: l10n_sk_dppo
#: model:ir.model,name:l10n_sk_dppo.model_cssk_income_tax_return
msgid "Income Tax Return"
msgstr "Daňové priznanie k dani z príjmov právnických osôb"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"DPPO version '%(version)s' carries no usable %(label)s (field '%(field)s'): "
"expected an ordered list of [upper_bound, value] pairs whose last band has a"
" null upper bound. Fill the bands on the version record (they are noupdate "
"data — on an existing database reload the l10n_sk_dppo version data). "
"Refusing to guess a statutory rate."
msgstr ""
"Verzia DPPO „%(version)s“ neobsahuje použiteľné %(label)s (pole "
"„%(field)s“): očakáva sa usporiadaný zoznam dvojíc [horná hranica, hodnota],"
" ktorého posledné pásmo má hornú hranicu prázdnu. Doplňte pásma na zázname "
"verzie (sú to noupdate dáta — na existujúcej databáze znova načítajte dáta "
"verzií l10n_sk_dppo). Zákonná sadzba sa hádať nebude."

#. module: l10n_sk_dppo
#: model:ir.module.module,shortdesc:base.module_l10n_sk_dppo
msgid "SK Corporate Income Tax Return (DPPO)"
msgstr "SK priznanie k dani z príjmov právnických osôb (DPPO)"

#. module: l10n_sk_dppo
#: model:ir.module.module,summary:base.module_l10n_sk_dppo
msgid ""
"Slovak DPPO return on the income-tax framework: full r-line set + header "
"mapping + XSD-validated XML export against the official dppo2025 schema."
msgstr ""
"Slovenské priznanie DPPO na rámci dane z príjmov: úplná sada riadkov r + "
"mapovanie hlavičky + export XML validovaný voči oficiálnej schéme dppo2025."

