#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid "Loss deduction above 50 % of the tax base"
msgstr "Odpočet daňovej straty nad 50 % základu dane"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"r410 is %(loss).2f but § 30 ods. 1 písm. b) allows %(limit).2f unless the "
"company is a mikrodaňovník."
msgstr "Riadok r410 je %(loss).2f, ale § 30 ods. 1 písm. b) umožňuje %(limit).2f, ak spoločnosť nie je mikrodaňovníkom."

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid "%(code)s disagrees with its table"
msgstr "%(code)s nesúhlasí so svojou tabuľkou"

#. module: l10n_sk_dppo
#. odoo-python
#: code:addons/l10n_sk_dppo/models/cssk_income_tax.py:0
msgid ""
"%(code)s is overridden to %(value).2f, but %(formula)s over the table gives "
"%(expected).2f. Correct the table or remove the override."
msgstr "%(code)s je prepísaný na %(value).2f, ale %(formula)s z tabuľky dáva %(expected).2f. Opravte tabuľku alebo zrušte prepis."

