<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dppo_table_d_form" model="ir.ui.view">
        <field name="name">cssk.income.tax.return.sk.table.d</field>
        <field name="model">cssk.income.tax.return</field>
        <field name="inherit_id" ref="l10n_sk_dppo.dppo_official_pdf_form"/>
        <field name="arch" type="xml">
            <page name="sk_official_form" position="inside">
                <group string="Table D - prior tax losses">
                    <button name="action_apply_table_d_deduction" type="object"
                            string="Apply reviewed Table D deduction" invisible="state not in ('draft', 'preview')"/>
                    <field name="l10n_sk_table_d_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="column"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="source_return_id" optional="show"/>
                            <field name="loss_amount"/>
                            <field name="prior_deducted"/>
                            <field name="deducted"/>
                            <field name="subsequent_period_number"/>
                            <field name="remaining"/>
                            <field name="expired"/>
                            <field name="evidence" optional="show"/>
                        </list>
                    </field>
                    <field name="l10n_sk_form_notes"/>
                </group>
            </page>
        </field>
    </record>
</odoo>
