<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dppo_applicability_form" model="ir.ui.view">
        <field name="name">cssk.income.tax.return.sk.applicability</field>
        <field name="model">cssk.income.tax.return</field>
        <field name="inherit_id" ref="l10n_cssk_income_tax_base.cssk_income_tax_return_view_form"/>
        <field name="arch" type="xml">
            <field name="version_id" position="before">
                <field name="l10n_sk_dppo_applicable_version_ids" invisible="1"/>
            </field>
            <field name="date_to" position="after">
                <field name="l10n_sk_dppo_filing_deadline"
                       invisible="country_id != %(base.sk)d"
                       readonly="state not in ('draft', 'preview')"/>
            </field>
        </field>
    </record>
</odoo>
