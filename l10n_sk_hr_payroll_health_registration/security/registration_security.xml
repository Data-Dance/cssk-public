<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="health_registration_company_rule" model="ir.rule">
        <field name="name">Health registration: multi-company</field>
        <field name="model_id" ref="model_l10n_sk_health_registration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="health_registration_event_company_rule" model="ir.rule">
        <field name="name">Health registration event: multi-company</field>
        <field name="model_id" ref="model_l10n_sk_health_registration_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
