#. module: currency_rate_update
#: model_terms:ir.ui.view,arch_db:currency_rate_update.res_currency_rate_provider_form_view
msgid ""
"<strong>!</strong>\n"
"                                You are using European Central Bank exchange rate\n"
"                                service with a base currency different from EUR.\n"
"                                <br/>\n"
"                                As long as the European Central Bank only provides\n"
"                                exchange rates based on EUR, other foreign currency\n"
"                                rates are recalculated and might differ from real rates."
msgstr ""
"<strong>!</strong>\n"
"                                Používate službu výmenných kurzov Európskej centrálnej banky\n"
"                                so základnou menou inou ako EUR.\n"
"                                <br/>\n"
"                                Keďže Európska centrálna banka poskytuje len\n"
"                                výmenné kurzy voči EUR, kurzy ostatných cudzích mien\n"
"                                sa prepočítavajú a môžu sa líšiť od skutočných kurzov."

