#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid "Cannot change the parent because it will cause a cyclic."
msgstr "Nadřazený záznam nelze změnit, protože by vznikl cyklus."

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid "Hierarchy child can only be field or template, got %s"
msgstr "Potomkem hierarchie může být pouze pole nebo šablona, zadáno: %s"

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid "Hierarchy view can contain only one templates tag"
msgstr "Hierarchický pohled může obsahovat pouze jeden tag templates"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_renderer.js:0
msgid ""
"Impossible to update the parent node of the dragged node because no parent "
"has been found."
msgstr ""
"Nadřazený uzel přetaženého uzlu nelze aktualizovat, protože nebyl nalezen "
"žádný nadřazený záznam."

#. module: web_hierarchy
#. odoo-python
#: code:addons/web_hierarchy/models/ir_ui_view.py:0
msgid ""
"Invalid attributes (%(invalid_attributes)s) in hierarchy view. Attributes "
"must be in (%(valid_attributes)s)"
msgstr ""
"Neplatné atributy (%(invalid_attributes)s) v hierarchickém pohledu. Povolené"
" atributy jsou (%(valid_attributes)s)"

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid ""
"The parent of \"%s\" was successfully updated. Reloading records to account "
"for other changes."
msgstr ""
"Nadřazený záznam „%s“ byl úspěšně aktualizován. Záznamy se znovu načítají, "
"aby se projevily další změny."

#. module: web_hierarchy
#. odoo-javascript
#: code:addons/web_hierarchy/static/src/hierarchy_model.js:0
msgid "The parent record cannot be the record dragged."
msgstr "Nadřazeným záznamem nemůže být přetažený záznam."
