#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Ááách, to je naozaj milé, ale viete, boti takto nefungujú. Ste na mňa príliš"
" ľudskí! Zostaňme profesionálni ❤️"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "Zobrazovaný názov"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app."
msgstr ""
"Výborne! %(bold_start)sPrednastavené odpovede%(bold_end)s si môžete "
"prispôsobiť v aplikácii Diskusie."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your "
"sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting "
"help."
msgstr ""
"Výborne! 👍%(new_line)sŠpeciálne príkazy použijete tak, že "
"%(bold_start)szačnete vetu znakom%(bold_end)s "
"%(command_start)s/%(command_end)s. Skúste požiadať o pomoc."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello,"
msgstr "Dobrý deň,"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Obávam sa, že nerozumiem. Prepáčte!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide,"
" ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"Nie som dosť múdry, aby som vám na otázku odpovedal.%(new_line)sAk chcete "
"prejsť mojím sprievodcom, napíšte: %(command_start)szačať "
"prehliadku%(command_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Mailový bot"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not exactly. To continue the tour, send an emoji: "
"%(bold_start)stype%(bold_end)s%(command_start)s :)%(command_end)s and press "
"enter."
msgstr ""
"Nie celkom. Ak chcete v prehliadke pokračovať, pošlite emoji: "
"%(bold_start)snapíšte%(bold_end)s%(command_start)s :)%(command_end)s a "
"stlačte Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s/%(command_end)s "
"and wait for the propositions. Select %(command_start)shelp%(command_end)s "
"and press enter."
msgstr ""
"Nie je mi jasné, čo robíte. Napíšte %(command_start)s/%(command_end)s a "
"počkajte na návrhy. Vyberte %(command_start)shelp%(command_end)s a stlačte "
"Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s:%(command_end)s "
"and wait for the propositions. Select one of them and press enter."
msgstr ""
"Nie je mi jasné, čo robíte. Napíšte %(command_start)s:%(command_end)s a "
"počkajte na návrhy. Vyberte jeden z nich a stlačte Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's chat helps employees collaborate efficiently. I'm here to help you "
"discover its features."
msgstr ""
"Chat v Odoo pomáha zamestnancom efektívne spolupracovať. Som tu, aby som vám"
" pomohol objaviť jeho funkcie."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "OdooBot zlyhal"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "Úvodná prehliadka: príloha"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "Úvodná prehliadka: prednastavená odpoveď"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "Úvodná prehliadka: príkaz"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "Úvodná prehliadka: emoji"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "Úvodná prehliadka: označenie"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: "
"%(command_start)sstart the tour%(command_end)s."
msgstr ""
"Prepáčte, som ospalý. Alebo nie! Možno sa len snažím zakryť, že ľudskej reči"
" nerozumiem...%(new_line)sAk napíšete %(command_start)szačať "
"prehliadku%(command_end)s, ukážem vám funkcie."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I am not listening. To get someone's attention, %(bold_start)sping "
"him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select "
"me."
msgstr ""
"Prepáčte, nepočúvam. Ak chcete niekoho upozorniť, %(bold_start)soznačte "
"ho%(bold_end)s. Napíšte %(command_start)s@OdooBot%(command_end)s a vyberte "
"mňa."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "Ďakujem"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "Ďakujem za spätnú väzbu. Dovidenia!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "To nebolo pekné! Som bot, ale mám city... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That’s the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the "
"tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"Toto je koniec prehľadu. Môžete %(bold_start)szavrieť túto "
"konverzáciu%(bold_end)s alebo napísať %(command_start)szačať "
"prehliadku%(command_end)s a pozrieť si ju znova. Príjemné objavovanie Odoo!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"Toto je dočasná prednastavená odpoveď, aby ste videli, ako prednastavené "
"odpovede fungujú."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, click on the "
"%(paperclip_icon)s icon and select a file."
msgstr ""
"Ak chcete %(bold_start)sposlať prílohu%(bold_end)s, kliknite na ikonu "
"%(paperclip_icon)s a vyberte súbor."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To start, try to send me an emoji :)"
msgstr "Na začiatok mi skúste poslať emoji :)"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Try to send me an emoji"
msgstr "Skúste mi poslať emoji"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand! If you need help "
"discovering our product, please check %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour "
"videos%(slides_link_end)s."
msgstr ""
"Bohužiaľ, som len bot 😞 Nerozumiem! Ak potrebujete pomoc so spoznávaním "
"nášho produktu, pozrite si %(document_link_start)snašu "
"dokumentáciu%(document_link_end)s alebo %(slides_link_start)snaše "
"videá%(slides_link_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to use"
" canned responses. I've created a temporary one for you."
msgstr ""
"Úžasné! 😇%(new_line)sSkúste napísať %(command_start)s::%(command_end)s a "
"použiť prednastavené odpovede. Jednu dočasnú som vám vytvoril."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow you are a natural!%(new_line)sPing someone with @username to grab their "
"attention. %(bold_start)sTry to ping me using%(bold_end)s "
"%(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr ""
"Výborne, ide vám to samo!%(new_line)sAk chcete niekoho upozorniť, označte ho"
" pomocou @používateľské_meno. %(bold_start)sSkúste vo vete označiť mňa "
"pomocou%(bold_end)s %(command_start)s@OdooBot%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an "
"attachment%(bold_end)s, like a picture of your cute dog..."
msgstr ""
"Áno, som tu! 🎉 %(new_line)sTeraz skúste %(bold_start)sposlať "
"prílohu%(bold_end)s, napríklad fotku vášho roztomilého psa..."
