#. module: iap
#: model:ir.model.fields,field_description:iap.field_iap_account__account_token
msgid "Account Token"
msgstr "Token účtu"

#. module: iap
#: model:ir.model.fields,help:iap.field_iap_account__account_token
msgid ""
"Account token is your authentication key for this service. Do not share it."
msgstr "Token účtu je váš ověřovací klíč k této službě. Nesdílejte ho."

#. module: iap
#. odoo-python
#: code:addons/iap/tools/iap_tools.py:0
msgid ""
"An error occurred while reaching %s. Please contact Odoo support if this "
"error persists."
msgstr ""
"Při připojování k %s došlo k chybě. Pokud chyba přetrvává, kontaktujte "
"podporu Odoo."

#. module: iap
#: model:ir.model.fields.selection,name:iap.selection__iap_account__state__banned
msgid "Banned"
msgstr "Zablokováno"

#. module: iap
#: model:ir.model,name:iap.model_res_config_settings
msgid "Config Settings"
msgstr "Konfigurační nastavení"

#. module: iap
#: model:ir.model.fields,field_description:iap.field_iap_account__warning_user_ids
msgid "Email Alert Recipients"
msgstr "Příjemci e-mailových upozornění"

#. module: iap
#: model:ir.model.fields,field_description:iap.field_iap_account__warning_threshold
msgid "Email Alert Threshold"
msgstr "Práh e-mailového upozornění"

#. module: iap
#: model:iap.service,description:iap.iap_service_reveal
msgid ""
"Get quality leads and opportunities: convert your website visitors into "
"leads, generate leads based on a set of criteria and enrich the company data"
" of your opportunities."
msgstr ""
"Získejte kvalitní leady a příležitosti: převeďte návštěvníky webu na leady, "
"generujte leady podle zvolených kritérií a obohaťte údaje o společnostech u "
"svých příležitostí."

#. module: iap
#: model:ir.model,name:iap.model_iap_service
msgid "IAP Service"
msgstr "Služba IAP"

#. module: iap
#: model_terms:ir.ui.view,arch_db:iap.iap_account_view_tree
msgid "In-App Purchase Accounts"
msgstr "Účty nákupů v aplikaci"

#. module: iap
#: model_terms:ir.ui.view,arch_db:iap.iap_account_view_tree
msgid "Manage"
msgstr "Spravovat"

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid "No service exists with the provided technical name"
msgstr "Služba se zadaným technickým názvem neexistuje"

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid ""
"One of the email alert recipients doesn't have an email address set. Users: "
"%s"
msgstr ""
"Jeden z příjemců e-mailových upozornění nemá nastavenou e-mailovou adresu. "
"Uživatelé: %s"

#. module: iap
#: model:ir.model.constraint,message:iap.constraint_iap_service_unique_technical_name
msgid "Only one service can exist with a specific technical_name"
msgstr ""
"Se stejným technickým názvem (technical_name) může existovat pouze jedna "
"služba"

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid "Please set a positive email alert threshold."
msgstr "Nastavte kladný práh e-mailového upozornění."

#. module: iap
#: model_terms:ir.ui.view,arch_db:iap.iap_account_view_tree
msgid "Rotate"
msgstr "Obměnit"

#. module: iap
#: model:ir.model.fields,field_description:iap.field_iap_account__service_locked
msgid "Service Locked"
msgstr "Služba uzamčena"

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid ""
"The IAP server is unreachable and the information may not be up to date. "
"Please try again later."
msgstr ""
"Server IAP je nedostupný a informace nemusí být aktuální. Zkuste to později."

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid "The IAP token provided is invalid or empty."
msgstr "Zadaný token IAP je neplatný nebo prázdný."

#. module: iap
#. odoo-python
#: code:addons/iap/tools/iap_tools.py:0
msgid ""
"The request to the service timed out. Please contact the author of the app. "
"The URL it tried to contact was %s"
msgstr ""
"Vypršel časový limit požadavku na službu. Kontaktujte autora aplikace. "
"Volaná URL byla %s"

#. module: iap
#: model_terms:ir.ui.view,arch_db:iap.iap_account_view_tree
msgid ""
"This is useful if you think it may have leaked. It will also deactivate "
"auto-refill if set. Are you sure to rotate your IAP token?"
msgstr ""
"To se hodí, pokud se domníváte, že mohl uniknout. Zároveň se tím vypne "
"automatické dobíjení, je-li nastaveno. Opravdu chcete obměnit svůj token "
"IAP?"

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid "Unable to rotate token, another process is busy. Please try later."
msgstr "Token nelze obměnit, jiný proces je zaneprázdněn. Zkuste to později."

#. module: iap
#. odoo-python
#: code:addons/iap/models/iap_account.py:0
msgid "Unexpected while contacting IAP. Please contact the support."
msgstr "Neočekávaná chyba při komunikaci s IAP. Kontaktujte podporu."

#. module: iap
#: model:ir.model.fields,field_description:iap.field_iap_service__unit_name
msgid "Unit Name"
msgstr "Název jednotky"

