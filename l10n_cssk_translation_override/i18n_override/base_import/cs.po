#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_model.js:0
msgid ""
"After each batch import, this delay is applied to avoid unthrottled calls"
msgstr ""
"Po každé dávce importu se použije tato prodleva, aby se zabránilo "
"neomezenému volání"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.xml:0
msgid "But, you can also use .csv files"
msgstr "Můžete ale použít i soubory .csv"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Data to import"
msgstr "Data k importu"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_model.js:0
msgid "Defines how many megabytes can be imported in each batch import"
msgstr "Určuje, kolik megabajtů lze importovat v jedné dávce"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Delay after each batch"
msgstr "Prodleva po každé dávce"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.xml:0
msgid "Drop or upload a file to import"
msgstr "Přetáhněte sem nebo nahrajte soubor k importu"

#. module: base_import
#. odoo-python
#: code:addons/base_import/models/base_import.py:0
msgid "Field '%(field)s' does not accept date/time values."
msgstr "Pole „%(field)s“ nepřijímá hodnoty data a času."

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Files to import"
msgstr "Soubory k importu"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.js:0
msgid "Imported records"
msgstr "Importované záznamy"

#. module: base_import
#. odoo-python
#: code:addons/base_import/models/base_import.py:0
msgid ""
"Invalid cell format at row %(row)s, column %(col)s: %(cell_value)s, with "
"format: %(cell_format)s, as (%(format_type)s) formats are not supported."
msgstr ""
"Neplatný formát buňky na řádku %(row)s, sloupci %(col)s: %(cell_value)s, s "
"formátem %(cell_format)s, protože formáty (%(format_type)s) nejsou "
"podporovány."

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.xml:0
msgid "Load Data File"
msgstr "Načíst datový soubor"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Max size per batch"
msgstr "Maximální velikost dávky"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Mb"
msgstr "MB"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.js:0
msgid "No file selected"
msgstr "Není vybrán žádný soubor"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.js:0
msgid "Please upload a single file."
msgstr "Nahrajte prosím jediný soubor."

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.js:0
msgid "Please upload an Excel (.xls or .xlsx) or .csv file to import."
msgstr "Nahrajte prosím k importu soubor Excel (.xls nebo .xlsx) nebo .csv."

#. module: base_import
#. odoo-python
#: code:addons/base_import/models/base_import.py:0
msgid ""
"There was an issue decoding the file using encoding “%s”.\n"
"This encoding was automatically detected."
msgstr ""
"Při dekódování souboru s kódováním „%s“ došlo k potížím.\n"
"Toto kódování bylo zjištěno automaticky."

#. module: base_import
#. odoo-python
#: code:addons/base_import/models/base_import.py:0
msgid ""
"There was an issue decoding the file using encoding “%s”.\n"
"This encoding was manually selected."
msgstr ""
"Při dekódování souboru s kódováním „%s“ došlo k potížím.\n"
"Toto kódování bylo vybráno ručně."

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_action/import_action.xml:0
msgid "Upload Data File"
msgstr "Nahrát datový soubor"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid "Upload your files"
msgstr "Nahrajte své soubory"

#. module: base_import
#. odoo-javascript
#: code:addons/base_import/static/src/import_data_sidepanel/import_data_sidepanel.xml:0
msgid ""
"Warning: ignores the labels line, empty lines and lines composed only of "
"empty cells"
msgstr ""
"Upozornění: ignoruje řádek s popisky, prázdné řádky a řádky obsahující pouze"
" prázdné buňky"

#. module: base_import
#. odoo-python
#: code:addons/base_import/models/base_import.py:0
msgid ""
"You can not import file via URL, check with your administrator or support "
"for the reason."
msgstr ""
"Soubor nelze importovat přes URL. Důvod vám sdělí administrátor nebo "
"podpora."
