#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range1."
msgstr "Vzor alebo test, ktorý sa použije na criteria_range1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range2."
msgstr "Vzor alebo test, ktorý sa použije na criteria_range2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to range."
msgstr "Vzor alebo test, ktorý sa použije na rozsah."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
