msgstr "Počet číselných hodnôt v množine údajov."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of payments to be made."
msgstr "Počet platieb, ktoré sa majú uskutočniť."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods over which the asset is depreciated."
msgstr "Počet období, počas ktorých sa majetok odpisuje."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods."
msgstr "Počet období."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows (%s) must be positive."
msgstr "Počet riadkov (%s) musí byť kladný."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows in the constrained array."
msgstr "Počet riadkov v obmedzenom poli."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows in the expanded array. If missing, rows will not be "
"expanded."
msgstr "Počet riadkov v rozšírenom poli. Ak chýba, riadky sa nerozšíria."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows must be positive."
msgstr "Počet riadkov musí byť kladný."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows of the range to return starting at the offset target."
msgstr "Počet riadkov vráteného rozsahu, počínajúc posunutým cieľom."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to be returned."
msgstr "Počet riadkov, ktoré sa majú vrátiť."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to offset by."
msgstr "Počet riadkov, o ktoré sa má posunúť."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to return"
msgstr "Počet riadkov, ktoré sa majú vrátiť"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of significant digits to the right of the decimal point to "
"retain."
msgstr ""
"Počet platných číslic napravo od desatinnej čiarky, ktoré sa majú zachovať."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of the character to look up from the current Unicode table in "
"decimal format."
msgstr ""
"Číslo znaku v aktuálnej tabuľke Unicode v desiatkovom formáte, ktorý sa má "
"vyhľadať."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to begin the cumulative calculation."
msgstr "Číslo platobného obdobia, ktorým sa začne kumulatívny výpočet."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to end the cumulative calculation."
msgstr "Číslo platobného obdobia, ktorým sa skončí kumulatívny výpočet."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of values in a dataset."
msgstr "Počet hodnôt v množine údajov."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of which to return the absolute value."
msgstr "Číslo, ktorého absolútna hodnota sa má vrátiť."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole months between start_date and end_date"
msgstr "Počet celých mesiacov medzi start_date a end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of whole months between start_date and end_date after subtracting"
" whole years"
msgstr ""
"Počet celých mesiacov medzi start_date a end_date po odčítaní celých rokov"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole years between start_date and end_date"
msgstr "Počet celých rokov medzi start_date a end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of working days to advance from start_date. If negative, counts "
"backwards."
msgstr ""
"Počet pracovných dní, o ktoré sa posunie od start_date. Ak je záporný, "
"počíta sa dozadu."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number pi."
msgstr "Číslo pí."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
