"The purchase_date (%(purchaseDate)s) must be before the first_period_end "
"(%(firstPeriodEnd)s)."
msgstr ""
"Hodnota purchase_date (%(purchaseDate)s) musí byť pred first_period_end "
"(%(firstPeriodEnd)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The purchase_date (%s) must be positive or null."
msgstr "Hodnota purchase_date (%s) musí byť nezáporná."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the dataset to consider."
msgstr "Rozsah obsahujúci množinu údajov, ktorá sa má zohľadniť."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range containing the return value. Should have the same dimensions as "
"lookup_range."
msgstr ""
"Rozsah obsahujúci návratovú hodnotu. Mal by mať rovnaké rozmery ako "
"lookup_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the set of classes."
