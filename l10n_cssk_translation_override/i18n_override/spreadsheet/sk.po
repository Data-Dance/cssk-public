"The other range whose entries will be multiplied with corresponding entries "
"in the other ranges."
msgstr ""
"Ďalší rozsah, ktorého položky sa vynásobia zodpovedajúcimi položkami v "
"ostatných rozsahoch."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range."
msgstr "Vzor alebo test, ktorý sa použije na criteria_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
