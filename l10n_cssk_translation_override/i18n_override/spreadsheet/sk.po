#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function [[FUNCTION_NAME]] result cannot be negative"
msgstr "Výsledok funkcie [[FUNCTION_NAME]] nemôže byť záporný"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] result must be greater than or equal "
"01/01/1900."
msgstr ""
"Výsledok funkcie [[FUNCTION_NAME]] musí byť väčší alebo rovný 01/01/1900."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function code (%s) must be between 1 to 11 or 101 to 111."
msgstr "Kód funkcie (%s) musí byť od 1 do 11 alebo od 101 do 111."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function to use in subtotal aggregation."
msgstr "Funkcia, ktorá sa použije pri agregácii medzisúčtu."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
