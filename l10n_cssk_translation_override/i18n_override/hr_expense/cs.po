msgstr "Historie komunikace na webu"

#. module: hr_expense
#: model_terms:ir.ui.view,arch_db:hr_expense.product_product_expense_form_view
msgid ""
"When the cost of an expense product is different than 0, then the user"
"                                             using this product won't be "
"able to change the amount of the expense,"
"                                             only the quantity. Use a cost "
"different than 0 for expense categories funded by"
"                                             the company at fixed cost like "
"allowances for mileage, per diem, accommodation"
"                                             or meal."
msgstr ""
"Pokud je náklad výdajového produktu jiný než 0, uživatel tohoto produktu "
"nebude moci měnit částku výdaje, pouze množství. Náklad jiný než 0 použijte "
"pro kategorie výdajů, které společnost hradí pevnou sazbou, například "
"náhrady za ujeté kilometry, stravné, ubytování nebo jídlo."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You can not submit an expense without a category."
msgstr "Výdaj bez kategorie nelze předložit."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You can only generate an accounting entry for approved expense(s)."
msgstr "Účetní záznam lze vytvořit pouze pro schválené výdaje."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You can't add an attachment to an expense once it has been approved."
msgstr "Ke schválenému výdaji nelze přidat přílohu."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_attachment.py:0
msgid "You can't add attachments to an expense once it has been approved."
msgstr "Ke schválenému výdaji nelze přidávat přílohy."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/ir_attachment.py:0
msgid ""
"You can't delete attachments from an expense once it has been submitted."
msgstr "Z předloženého výdaje nelze mazat přílohy."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"You can't post simultaneously employee-paid expenses belonging to different "
"companies"
msgstr ""
"Výdaje hrazené zaměstnanci, které patří různým společnostem, nelze zaúčtovat"
" současně"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"You cannot approve:\n"
" %(reasons)s"
msgstr ""
"Nelze schválit:\n"
" %(reasons)s"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot cancel an expense linked to a posted journal entry"
msgstr "Výdaj propojený se zaúčtovaným účetním záznamem nelze zrušit"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/account_payment.py:0
msgid ""
"You cannot do this modification since the payment is linked to an expense."
msgstr "Tuto změnu nelze provést, protože platba je propojena s výdajem."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot edit the security fields of an expense manually"
msgstr "Bezpečnostní pole výdaje nelze upravovat ručně"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid ""
"You cannot refuse:\n"
" %(reasons)s"
msgstr ""
"Nelze odmítnout:\n"
" %(reasons)s"

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot reset to draft an expense linked to a posted journal entry."
msgstr ""
"Výdaj propojený se zaúčtovaným účetním záznamem nelze vrátit do návrhu."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You cannot split an expense that is already posted."
msgstr "Již zaúčtovaný výdaj nelze rozdělit."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You do not have the required permission to submit this expense."
msgstr "Nemáte potřebné oprávnění k předložení tohoto výdaje."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
msgid "You do not have the rights to edit this expense."
msgstr "Nemáte oprávnění upravovat tento výdaj."

#. module: hr_expense
#. odoo-python
#: code:addons/hr_expense/models/hr_expense.py:0
#: code:addons/hr_expense/wizard/hr_expense_post_wizard.py:0
