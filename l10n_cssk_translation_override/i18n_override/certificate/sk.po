"This certificate could not be loaded. Please provide the certificate "
"password."
msgstr "Tento certifikát sa nepodarilo načítať. Zadajte heslo certifikátu."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid "This certificate is not valid, its validity has expired."
msgstr "Tento certifikát nie je platný, jeho platnosť vypršala."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"This key could not be loaded. Either its content or its password is "
"erroneous."
msgstr ""
"Tento kľúč sa nepodarilo načítať. Jeho obsah alebo heslo je nesprávne."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"Unsupported asymmetric cryptography algorithm '%s'. Currently supported for "
"decryption: RSA."
msgstr ""
"Nepodporovaný algoritmus asymetrickej kryptografie '%s'. Na dešifrovanie je "
"momentálne podporovaný: RSA."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
