#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid ""
"This certificate could not be loaded. Either the content or the password is "
"erroneous."
msgstr ""
"Tento certifikát sa nepodarilo načítať. Obsah alebo heslo je nesprávne."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
