msgstr "Certifikát a soukromý klíč nejsou kompatibilní."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid "The certificate and public key are not compatible."
msgstr "Certifikát a veřejný klíč nejsou kompatibilní."

#. module: certificate
#: model:ir.model.fields,help:certificate.field_certificate_certificate__date_end
msgid "The date on which the certificate expires"
msgstr "Datum, kdy platnost certifikátu končí"

#. module: certificate
#: model:ir.model.fields,help:certificate.field_certificate_certificate__date_start
msgid "The date on which the certificate starts to be valid"
msgstr "Datum, od kterého je certifikát platný"

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid "The key size should be at least 512 bytes."
msgstr "Velikost klíče musí být alespoň 512 bajtů."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid "The private key could not be loaded."
msgstr "Soukromý klíč se nepodařilo načíst."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid "The public exponent should be 65537 (or 3 for legacy purposes)."
msgstr "Veřejný exponent musí být 65537 (nebo 3 kvůli zpětné kompatibilitě)."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid "The public key could not be loaded."
msgstr "Veřejný klíč se nepodařilo načíst."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid "The public key from the certificate could not be loaded."
msgstr "Veřejný klíč z certifikátu se nepodařilo načíst."

#. module: certificate
#: model:ir.model.fields,help:certificate.field_certificate_certificate__serial_number
msgid "The serial number to add to electronic documents"
msgstr "Sériové číslo, které se přidává do elektronických dokumentů"

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid ""
"This certificate could not be loaded. Either the content or the password is "
"erroneous."
msgstr "Certifikát se nepodařilo načíst. Obsah nebo heslo je chybné."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid ""
"This certificate could not be loaded. Please provide the certificate "
"password."
msgstr "Certifikát se nepodařilo načíst. Zadejte heslo k certifikátu."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/certificate.py:0
msgid "This certificate is not valid, its validity has expired."
msgstr "Certifikát není platný, jeho platnost vypršela."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"This key could not be loaded. Either its content or its password is "
"erroneous."
msgstr "Klíč se nepodařilo načíst. Jeho obsah nebo heslo je chybné."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"Unsupported asymmetric cryptography algorithm '%s'. Currently supported for "
"decryption: RSA."
msgstr ""
"Nepodporovaný algoritmus asymetrické kryptografie '%s'. Pro dešifrování je "
"aktuálně podporován: RSA."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"Unsupported asymmetric cryptography algorithm '%s'. Currently supported for "
"signature: EC and RSA."
msgstr ""
"Nepodporovaný algoritmus asymetrické kryptografie '%s'. Pro podpis jsou "
"aktuálně podporovány: EC a RSA."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"Unsupported asymmetric cryptography algorithm '%s'. Currently supported for "
"signature: ED25519, EC and RSA."
msgstr ""
"Nepodporovaný algoritmus asymetrické kryptografie '%s'. Pro podpis jsou "
"aktuálně podporovány: ED25519, EC a RSA."

#. module: certificate
#. odoo-python
#: code:addons/certificate/models/key.py:0
msgid ""
"Unsupported asymmetric cryptography algorithm '%s'. Currently supported: EC,"
" RSA."
msgstr ""
"Nepodporovaný algoritmus asymetrické kryptografie '%s'. Aktuálně "
"podporovány: EC, RSA."

#. module: certificate
#: model:ir.model.fields,help:certificate.field_certificate_certificate__public_key_id
msgid ""
"Used to set a public key in case the one self-contained in the certificate is erroneus.\n"
"                When a public key is set this way, it will be used instead of the one in the certificate.\n"
"             "
msgstr ""
"Slouží k nastavení veřejného klíče pro případ, že klíč obsažený v certifikátu je chybný.\n"
"                Je-li veřejný klíč nastaven tímto způsobem, použije se místo klíče z certifikátu.\n"
"             "

