#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid "The Bank Accounting Account is not set on the journal '%s'."
msgstr "V deníku „%s“ není nastaven účet bankovních prostředků."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The bank account with number '%(account_number)s' exists in Odoo but it is "
"not set on any bank journal. You should set it on the related bank journal. "
"If the related bank journal doesn't  exist yet, you should create a new one."
msgstr ""
"Bankovní účet s číslem „%(account_number)s“ v Odoo existuje, ale není "
"nastaven v žádném bankovním deníku. Nastavte jej v příslušném bankovním "
"deníku. Pokud příslušný bankovní deník ještě  neexistuje, vytvořte nový."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The bank statement file uses currency '%s' but there is no such currency in "
"Odoo."
msgstr ""
"Soubor bankovního výpisu používá měnu „%s“, ale tato měna v Odoo neexistuje."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The currency of the bank statement (%(currency_name)s) is not the same as "
"the currency of the journal '%(journal_name)s' (%(journal_currency_name)s)."
msgstr ""
"Měna bankovního výpisu (%(currency_name)s) se neshoduje s měnou deníku "
"„%(journal_name)s“ (%(journal_currency_name)s)."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The format of this bank statement file doesn't contain the bank account "
"number, so you must start the wizard from the right bank journal in the "
"dashboard."
msgstr ""
"Formát tohoto souboru bankovního výpisu neobsahuje číslo bankovního účtu, "
"proto musíte průvodce spustit ze správného bankovního deníku na nástěnce."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"The journal found for the file (%(journal_match)s) is different from the "
"selected journal (%(journal_selected)s)."
msgstr ""
"Deník nalezený pro soubor (%(journal_match)s) se liší od vybraného deníku "
"(%(journal_selected)s)."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid "The parsing of the statement file returned an invalid result."
msgstr "Zpracování souboru výpisu vrátilo neplatný výsledek."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"This bank statement file format is not supported.\n"
"Did you install the Odoo module to support this format?"
msgstr ""
"Tento formát souboru bankovního výpisu není podporován.\n"
"Nainstalovali jste modul Odoo pro podporu tohoto formátu?"

#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.account_statement_import_form
msgid "Upload Bank Statements"
msgstr "Nahrát bankovní výpisy"

#. module: account_statement_import_file
#: model_terms:ir.ui.view,arch_db:account_statement_import_file.account_statement_import_form
msgid "Upload a bank statement file"
msgstr "Nahrát soubor bankovního výpisu"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/wizard/account_statement_import.py:0
msgid ""
"You have already imported this file, or this file only contains already "
"imported transactions."
msgstr ""
"Tento soubor jste již importovali, nebo obsahuje pouze již importované "
"transakce."
