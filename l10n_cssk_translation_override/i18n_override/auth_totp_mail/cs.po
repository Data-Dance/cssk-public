"                        </span>"
msgstr ""
"<span class=\"text-muted\">\n"
"                            Doporučeno pro větší bezpečnost.\n"
"                       </span>"

#. module: auth_totp_mail
#: model_terms:ir.ui.view,arch_db:auth_totp_mail.account_security_alert
