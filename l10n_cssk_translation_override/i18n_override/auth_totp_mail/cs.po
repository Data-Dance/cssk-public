msgstr "<span>Zvažte také</span>"

#. module: auth_totp_mail
#: model_terms:ir.ui.view,arch_db:auth_totp_mail.res_users_view_form
msgid "Click to enable 2FA."
msgstr "Kliknutím zapnete 2FA."
