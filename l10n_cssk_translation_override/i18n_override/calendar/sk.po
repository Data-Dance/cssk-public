"        <t t-if=\"is_online and target_responsible\">\n"
"            <t t-if=\"customer\">\n"
"                Vaša schôdzka s <t t-out=\"customer.name or ''\">Jesse Brown</t> bola aktualizovaná:\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                Vaša schôdzka bola aktualizovaná:\n"
