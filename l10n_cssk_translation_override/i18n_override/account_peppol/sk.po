msgstr "Chyba pri importe dokladu %(proxy_type)s (UUID: %(uuid)s):"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"For tax(es) %(taxes)s: Tax Category 'O' must be used when the exemption "
"reason code is 'VATEX-EU-O'. You can change this in the Advanced Options of "
"the tax configuration."
msgstr ""
"Pre daň(e) %(taxes)s: ak je kód dôvodu oslobodenia „VATEX-EU-O“, musí sa "
"použiť daňová kategória „O“. Môžete to zmeniť v rozšírených možnostiach "
"nastavenia dane."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/res_config_settings.py:0
msgid "France - E-Invoicing (Approved Platform)"
msgstr "Francúzsko – elektronická fakturácia (schválená platforma)"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/res_config_settings.py:0
msgid "Go to module"
msgstr "Prejsť na modul"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"If you are not subject to VAT, you should not have a VAT number on your "
"company/contacts and your clients should not have one either."
msgstr ""
"Ak nie ste platiteľom DPH, nemali by ste mať IČ DPH vo svojej spoločnosti "
"ani kontaktoch a nemali by ho mať ani vaši zákazníci."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/controllers/portal.py:0
msgid ""
"If you want to be invoiced via %(network_name)s, your configuration must be "
"valid."
msgstr ""
"Ak chcete dostávať faktúry cez %(network_name)s, vaše nastavenie musí byť "
"platné."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_move_send.py:0
msgid ""
"Invoice %(invoice_name)s exceeds the size limit of 64 MB to be sent via "
"%(network_name)s."
msgstr ""
"Faktúra %(invoice_name)s presahuje limit veľkosti 64 MB pre odoslanie cez "
"%(network_name)s."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Invoice lines using Tax Category 'O' cannot use a percentage-based tax. "
"Please update the tax type in Advanced Options."
msgstr ""
"Riadky faktúry s daňovou kategóriou „O“ nemôžu používať percentuálnu daň. "
"Upravte, prosím, typ dane v rozšírených možnostiach."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Invoice lines with Tax Category 'Exempt from VAT' must have a tax rate of 0."
" You can change this in the Advanced Options of the tax configuration."
msgstr ""
"Riadky faktúry s daňovou kategóriou „Oslobodené od DPH“ musia mať sadzbu "
"dane 0. Môžete to zmeniť v rozšírených možnostiach nastavenia dane."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Invoice lines with Tax Category 'Reverse charge' must have a tax rate of 0. "
"You can change this in the Advanced Options of the tax configuration."
msgstr ""
"Riadky faktúry s daňovou kategóriou „Prenesenie daňovej povinnosti“ musia "
"mať sadzbu dane 0. Môžete to zmeniť v rozšírených možnostiach nastavenia "
"dane."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Missing Buyer Country. Please add the Country Code to the client's contact "
"information."
msgstr ""
"Chýba krajina odberateľa. Doplňte, prosím, kód krajiny do kontaktných údajov"
" zákazníka."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Missing Invoiced Item VAT category code. Action Required: Install the module"
" account_edi_ubl_cii_tax_extension."
msgstr ""
"Chýba kód kategórie DPH fakturovanej položky. Potrebná akcia: nainštalujte "
"modul account_edi_ubl_cii_tax_extension."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Missing Reverse Charge details. Please set the Exemption Reason to 'Reverse "
"charge' in the Advanced Options of the tax configuration."
msgstr ""
"Chýbajú údaje o prenesení daňovej povinnosti. Nastavte, prosím, dôvod "
"oslobodenia na „Prenesenie daňovej povinnosti“ v rozšírených možnostiach "
"nastavenia dane."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Missing VAT category code. Action Required: Install the module "
"account_edi_ubl_cii_tax_extension."
msgstr ""
"Chýba kód kategórie DPH. Potrebná akcia: nainštalujte modul "
"account_edi_ubl_cii_tax_extension."

