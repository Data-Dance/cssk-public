#. module: account_peppol
#: model_terms:ir.ui.view,arch_db:account_peppol.peppol_registration_form
msgid ""
"You accept that any fraudulent activity or spam will result in immediate and"
" permanent exclusion from the Peppol network."
msgstr ""
"Beriete na vedomie, že akákoľvek podvodná činnosť alebo spam budú mať za "
"následok okamžité a trvalé vylúčenie zo siete Peppol."

#. module: account_peppol
#: model_terms:ir.ui.view,arch_db:account_peppol.peppol_registration_form
msgid ""
"You authorize Odoo to act as your Peppol Service Provider to send and "
"receive e-invoices on your behalf."
msgstr ""
"Splnomocňujete Odoo, aby ako váš poskytovateľ služieb Peppol vo vašom mene "
"odosielal a prijímal e-faktúry."

#. module: account_peppol
#: model_terms:ir.ui.view,arch_db:account_peppol.peppol_registration_form
msgid ""
"You confirm that you are authorized to register this company on the Peppol "
"network as a legal representative."
msgstr ""
"Potvrdzujete, že ste ako štatutárny zástupca oprávnený(á) zaregistrovať túto"
" spoločnosť v sieti Peppol."

#. module: account_peppol
#: model_terms:ir.ui.view,arch_db:account_peppol.peppol_registration_form
msgid ""
"You remain fully responsible for the content, accuracy, and legal compliance"
" of your invoices."
msgstr ""
"Za obsah, správnosť a súlad vašich faktúr s právnymi predpismi naďalej "
"nesiete plnú zodpovednosť."

#. module: account_peppol
#. odoo-javascript
#: code:addons/account_peppol/static/src/components/peppol_auth/peppol_auth_service.js:0
msgid ""
"Your details are being verified. There is nothing else to do on your end: "
"your Peppol registration will be finalized automatically."
msgstr ""
"Vaše údaje sa overujú. Z vašej strany už netreba nič robiť: registrácia do "
"siete Peppol sa dokončí automaticky."

