#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"The Peppol endpoint is missing in the XML file. Action Required: Update the "
"account and account_edi_ubl_cii modules to resolve this."
msgstr ""
"V súbore XML chýba koncový bod Peppol. Potrebná akcia: aktualizujte moduly "
"account a account_edi_ubl_cii."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"The Tax Category must be 'AE' when using Exemption Reason code 'VATEX-EU-"
"AE'. You can change this in the Advanced Options of the tax configuration."
msgstr ""
"Pri kóde dôvodu oslobodenia „VATEX-EU-AE“ musí byť daňová kategória „AE“. "
"Môžete to zmeniť v rozšírených možnostiach nastavenia dane."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"The exemption reason code is invalid. Action Required: Install the module "
"account_edi_ubl_cii_tax_extension."
msgstr ""
"Kód dôvodu oslobodenia je neplatný. Potrebná akcia: nainštalujte modul "
"account_edi_ubl_cii_tax_extension."

