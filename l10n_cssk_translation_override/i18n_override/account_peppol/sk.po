#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"A 0% tax cannot use Tax Category 'S' (Standard). Please update the Tax "
"Category in the Advanced Options of the tax configuration."
msgstr ""
"Daň 0 % nemôže používať daňovú kategóriu „S“ (štandardná). Upravte, prosím, "
"daňovú kategóriu v rozšírených možnostiach nastavenia dane."

#. module: account_peppol
#. odoo-javascript
#: code:addons/account_peppol/static/src/components/peppol_auth/peppol_auth_service.js:0
msgid "Authentication canceled"
msgstr "Overenie zrušené"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_move.py:0
msgid "Cannot cancel an entry that has already been sent via %(network_name)s"
msgstr ""
"Záznam, ktorý už bol odoslaný cez %(network_name)s, nie je možné zrušiť"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"Cannot initiate KYC for the selected scheme (unsupported, deprecated, or "
"removed). Please select a different scheme."
msgstr ""
"Pre vybranú schému nie je možné spustiť KYC (nepodporovaná, zastaraná alebo "
"odstránená). Vyberte, prosím, inú schému."

#. module: account_peppol
#. odoo-javascript
#: code:addons/account_peppol/static/src/components/peppol_info/peppol_info.xml:0
msgid "Create, send, and receive e-invoices for free."
msgstr "Vytvárajte, odosielajte a prijímajte e-faktúry zadarmo."

