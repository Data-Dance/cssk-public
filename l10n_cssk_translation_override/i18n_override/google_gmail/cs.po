#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/controllers/main.py:0
msgid "An error occurred during the authentication process."
msgstr "Během ověřování došlo k chybě."

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/ir_mail_server.py:0
msgid ""
"Incorrect Connection Security for Gmail mail server “%s”. Please set it to "
"\"TLS (STARTTLS)\"."
msgstr ""
"Nesprávné zabezpečení připojení pro poštovní server Gmail „%s“. Nastavte jej"
" na \"TLS (STARTTLS)\"."

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/google_gmail_mixin.py:0
msgid "Oops, we could not authenticate you. Please try again later."
msgstr "Jejda, nepodařilo se vás ověřit. Zkuste to prosím později."

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/controllers/main.py:0
msgid ""
"Oops, you're creating an authorization to send from %(email_login)s but your"
" address is %(email_server)s. Make sure your addresses match!"
msgstr ""
"Jejda, vytváříte autorizaci k odesílání z adresy %(email_login)s, ale vaše "
"adresa je %(email_server)s. Zkontrolujte, že se adresy shodují!"

#. module: google_gmail
#: model:ir.model.fields,field_description:google_gmail.field_res_users__outgoing_mail_server_type
msgid "Outgoing Mail Server Type"
msgstr "Typ odchozího mailového serveru"

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/google_gmail_mixin.py:0
msgid "Please enter a valid email address."
msgstr "Zadejte platnou e-mailovou adresu."

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/ir_mail_server.py:0
msgid ""
"Please leave the password field empty for Gmail mail server “%s”. The OAuth "
"process does not require it"
msgstr ""
"U poštovního serveru Gmail „%s“ ponechte pole hesla prázdné. Proces OAuth "
"heslo nevyžaduje"

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/fetchmail_server.py:0
msgid "SSL is required for server “%s”."
msgstr "Server „%s“ vyžaduje SSL."

#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/tools.py:0
msgid "Something went wrong. Try again later"
msgstr "Něco se pokazilo. Zkuste to později"

