msgid "You can't disable locations %s because they still contain products."
msgstr "Místa %s nelze deaktivovat, protože stále obsahují produkty."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_location.py:0
msgid ""
"You cannot archive location %(location)s because it is used by warehouse "
"%(warehouse)s"
msgstr ""
"Místo %(location)s nelze archivovat, protože jej používá sklad %(warehouse)s"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_picking.py:0
msgid "You cannot change the Scheduled Date on a cancelled transfer."
msgstr "U zrušeného převodu nelze měnit plánované datum."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_lot.py:0
msgid ""
"You cannot change the company of a lot/serial number currently in a location"
" belonging to another company."
msgstr ""
"Nelze změnit společnost šarže / sériového čísla, které se aktuálně nachází v"
" místě patřícím jiné společnosti."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_quant.py:0
msgid "You cannot duplicate stock quants."
msgstr "Skladová množství (quants) nelze duplikovat."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move_line.py:0
msgid ""
"You cannot pack products into the same package when they are from different "
"transfers with different operation types"
msgstr ""
"Produkty z různých převodů s různými typy operací nelze zabalit do stejného "
"balení"

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_location.py:0
msgid ""
"You cannot set a location as a scrap location when it is assigned as a "
"destination location for a manufacturing type operation."
msgstr ""
"Místo nelze nastavit jako místo vyřazení, pokud je přiřazeno jako cílové "
"místo výrobní operace."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_picking.py:0
msgid ""
"You can’t validate an empty transfer. Please add some products to move "
"before proceeding."
msgstr ""
"Prázdný převod nelze potvrdit. Než budete pokračovat, přidejte produkty k "
"přesunu."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move.py:0
msgid "You need a transfer to add these packages to."
msgstr "Pro přidání těchto balení potřebujete převod."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_move_line.py:0
msgid ""
"You need to supply a Lot/Serial Number for product:\n"
"%(products)s"
msgstr ""
"Zadejte šarži / sériové číslo pro produkt:\n"
"%(products)s"

#. module: stock
#: model_terms:res.company,invoice_terms_html:stock.res_company_1
msgid "You should update this document to reflect your T&amp;C."
msgstr ""
"Tento dokument byste měli aktualizovat tak, aby odrážel vaše všeobecné "
"obchodní podmínky."

#. module: stock
#. odoo-python
#: code:addons/stock/models/stock_warehouse.py:0
msgid ""
"You still have ongoing operations for operation types %(operations)s in "
"warehouse %(warehouse)s"
msgstr "Ve skladu %(warehouse)s stále probíhají operace typů %(operations)s"

#. module: stock
#: model_terms:ir.ui.view,arch_db:stock.view_warehouse_orderpoint_tree_editable
