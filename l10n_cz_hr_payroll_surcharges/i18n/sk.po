#. module: l10n_cz_hr_payroll_surcharges
#. odoo-python
#: code:addons/l10n_cz_hr_payroll_surcharges/models/l10n_cz_minimum_wage.py:0
msgid ""
"No Czech minimum wage is configured for %(date)s. Add the record under "
"Employees ▸ Configuration ▸ Czech Wage Surcharges ▸ Czech Minimum Wage."
msgstr ""
"Pre %(date)s nie je nastavená žiadna česká minimálna mzda. Pridajte záznam v"
" ponuke Zamestnanci ▸ Konfigurácia ▸ České mzdové príplatky ▸ Česká "
"minimálna mzda."

#. module: l10n_cz_hr_payroll_surcharges
#. odoo-python
#: code:addons/l10n_cz_hr_payroll_surcharges/models/l10n_cz_wage_surcharge_rate.py:0
