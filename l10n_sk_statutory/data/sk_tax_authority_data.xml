<?xml version="1.0" encoding="utf-8"?>
<!-- Slovak tax offices (daňové úrady): the 8 regional offices (one per kraj)
     plus the Daňový úrad pre vybrané daňové subjekty.
     submission_code = the free-text "danovyUrad" string emitted in the FS SR
     hlavička (dph2025.xsd / svdph20.xsd declare it as an unconstrained
     xsd:string). The full office name is used; verify the exact convention
     against a real submission if your DÚ rejects it.
     Addresses/phones: Finančná správa SR published contacts — verify against the
     live FS SR pages, as switchboard numbers change. -->
