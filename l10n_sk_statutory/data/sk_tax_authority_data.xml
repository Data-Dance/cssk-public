      <field name="name">Daňový úrad Bratislava</field>
      <field name="code">SK-BA</field>
      <field name="submission_code">Daňový úrad Bratislava</field>
      <field name="country_id" ref="base.sk"/>
      <field name="street">Ševčenkova 32</field>
      <field name="zip">850 00</field>
      <field name="city">Bratislava</field>
      <field name="phone">02/68272111</field>
    </record>
