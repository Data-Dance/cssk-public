<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="dphdp3_xml">
    <Pisemnost nazevSW="Odoo / Data Dance">
      <DPHDP3 verzePis="03.01.04">
        <VetaD
            dokument="DP3"
            t-att-c_okec="company.partner_id.nace_code or None"
            t-att-d_poddp="datetime.date.today().strftime('%d.%m.%Y')"
            t-att-rok="statement.date_from.strftime('%Y')"
            t-att-mesic="('%d' % statement.date_from.month) if statement.period_type == 'month' else None"
            t-att-ctvrt="('%d' % ((statement.date_from.month - 1) // 3 + 1)) if statement.period_type == 'quarter' else None"
            t-att-dapdph_forma="statement.statement_type_id.fa_xml_value"
            t-att-d_zjist="statement.cz_discovery_date.strftime('%d.%m.%Y') if statement.cz_discovery_date else None"
            t-att-typ_platce="company._l10n_cz_typ_platce(statement.date_to)"
            k_uladis="DPH"/>
        <VetaP t-att="company._l10n_cz_epo_vetap()"/>
        <Veta1
                    t-att-dan23="cz_epo.get('dan23', '0')"
                    t-att-dan5="cz_epo.get('dan5', '0')"
                    t-att-dan_dzb23="cz_epo.get('dan_dzb23', '0')"
                    t-att-dan_dzb5="cz_epo.get('dan_dzb5', '0')"
                    t-att-dan_pdop_nrg="cz_epo.get('dan_pdop_nrg', '0')"
                    t-att-dan_psl23_e="cz_epo.get('dan_psl23_e', '0')"
                    t-att-dan_psl23_z="cz_epo.get('dan_psl23_z', '0')"
                    t-att-dan_psl5_e="cz_epo.get('dan_psl5_e', '0')"
                    t-att-dan_psl5_z="cz_epo.get('dan_psl5_z', '0')"
                    t-att-dan_pzb23="cz_epo.get('dan_pzb23', '0')"
                    t-att-dan_pzb5="cz_epo.get('dan_pzb5', '0')"
                    t-att-dan_rpren23="cz_epo.get('dan_rpren23', '0')"
                    t-att-dan_rpren5="cz_epo.get('dan_rpren5', '0')"
                    t-att-dov_zb23="cz_epo.get('dov_zb23', '0')"
                    t-att-dov_zb5="cz_epo.get('dov_zb5', '0')"
                    t-att-obrat23="cz_epo.get('obrat23', '0')"
                    t-att-obrat5="cz_epo.get('obrat5', '0')"
                    t-att-p_dop_nrg="cz_epo.get('p_dop_nrg', '0')"
                    t-att-p_sl23_e="cz_epo.get('p_sl23_e', '0')"
                    t-att-p_sl23_z="cz_epo.get('p_sl23_z', '0')"
                    t-att-p_sl5_e="cz_epo.get('p_sl5_e', '0')"
                    t-att-p_sl5_z="cz_epo.get('p_sl5_z', '0')"
                    t-att-p_zb23="cz_epo.get('p_zb23', '0')"
                    t-att-p_zb5="cz_epo.get('p_zb5', '0')"
                    t-att-rez_pren23="cz_epo.get('rez_pren23', '0')"
                    t-att-rez_pren5="cz_epo.get('rez_pren5', '0')"/>
                <Veta2
                    t-att-dod_dop_nrg="cz_epo.get('dod_dop_nrg', '0')"
                    t-att-dod_zb="cz_epo.get('dod_zb', '0')"
                    t-att-pln_ost="cz_epo.get('pln_ost', '0')"
                    t-att-pln_rez_pren="cz_epo.get('pln_rez_pren', '0')"
                    t-att-pln_sluzby="cz_epo.get('pln_sluzby', '0')"
                    t-att-pln_vyvoz="cz_epo.get('pln_vyvoz', '0')"
                    t-att-pln_zaslani="cz_epo.get('pln_zaslani', '0')"/>
                <Veta3
                    t-att-dov_osv="cz_epo.get('dov_osv', '0')"
                    t-att-opr_dluz="cz_epo.get('opr_dluz', '0')"
                    t-att-opr_verit="cz_epo.get('opr_verit', '0')"
                    t-att-tri_dozb="cz_epo.get('tri_dozb', '0')"
                    t-att-tri_pozb="cz_epo.get('tri_pozb', '0')"/>
                <Veta4
                    t-att-dov_cu="cz_epo.get('dov_cu', '0')"
                    t-att-nar_maj="cz_epo.get('nar_maj', '0')"
                    t-att-nar_zdp23="cz_epo.get('nar_zdp23', '0')"
                    t-att-nar_zdp5="cz_epo.get('nar_zdp5', '0')"
                    t-att-od_maj="cz_epo.get('od_maj', '0')"
                    t-att-od_zdp23="cz_epo.get('od_zdp23', '0')"
                    t-att-od_zdp5="cz_epo.get('od_zdp5', '0')"
                    t-att-odkr_maj="cz_epo.get('odkr_maj', '0')"
                    t-att-odkr_zdp23="cz_epo.get('odkr_zdp23', '0')"
                    t-att-odkr_zdp5="cz_epo.get('odkr_zdp5', '0')"
                    t-att-odp_cu="cz_epo.get('odp_cu', '0')"
                    t-att-odp_cu_nar="cz_epo.get('odp_cu_nar', '0')"
                    t-att-odp_rez_nar="cz_epo.get('odp_rez_nar', '0')"
                    t-att-odp_rezim="cz_epo.get('odp_rezim', '0')"
                    t-att-odp_sum_kr="cz_epo.get('odp_sum_kr', '0')"
                    t-att-odp_sum_nar="cz_epo.get('odp_sum_nar', '0')"
                    t-att-odp_tuz23="cz_epo.get('odp_tuz23', '0')"
                    t-att-odp_tuz23_nar="cz_epo.get('odp_tuz23_nar', '0')"
                    t-att-odp_tuz5="cz_epo.get('odp_tuz5', '0')"
                    t-att-odp_tuz5_nar="cz_epo.get('odp_tuz5_nar', '0')"
                    t-att-pln23="cz_epo.get('pln23', '0')"
                    t-att-pln5="cz_epo.get('pln5', '0')"/>
                <Veta5
                    t-att-koef_p20_nov="cz_epo.get('koef_p20_nov', '0')"
                    t-att-koef_p20_vypor="cz_epo.get('koef_p20_vypor', '0')"
                    t-att-odp_uprav_kf="cz_epo.get('odp_uprav_kf', '0')"
                    t-att-pln_nkf="cz_epo.get('pln_nkf', '0')"
                    t-att-plnosv_kf="cz_epo.get('plnosv_kf', '0')"
                    t-att-plnosv_nkf="cz_epo.get('plnosv_nkf', '0')"
                    t-att-vypor_odp="cz_epo.get('vypor_odp', '0')"/>
                <Veta6
                    t-att-dan_vrac="cz_epo.get('dan_vrac', '0')"
                    t-att-dan_zocelk="cz_epo.get('dan_zocelk', '0')"
                    t-att-dano="(cz_epo.get('dano', '0')) if statement.cz_filing_code in ('D', 'E') else None"
                    t-att-dano_da="None if statement.cz_filing_code in ('D', 'E') else cz_epo.get('dano_da', '0')"
                    t-att-dano_no="None if statement.cz_filing_code in ('D', 'E') else cz_epo.get('dano_no', '0')"
                    t-att-odp_zocelk="cz_epo.get('odp_zocelk', '0')"
                    t-att-uprav_odp="cz_epo.get('uprav_odp', '0')"/>
            
      </DPHDP3>
    </Pisemnost>
  </template>
</odoo>
