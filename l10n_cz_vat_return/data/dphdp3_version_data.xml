    <field name="country_id" ref="base.cz"/>
    <field name="valid_from">2016-01-01</field>
    <field name="xml_template_ref_id" ref="l10n_cz_vat_return.dphdp3_xml"/>
    <field name="xml_root_element">Pisemnost</field>
    <field name="xml_schema_filename">dphdp3_epo2.xsd</field>
    <field name="xml_schema_data" type="base64" file="l10n_cz_vat_return/data/dphdp3_epo2.xsd"/>
