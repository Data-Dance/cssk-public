#. module: l10n_cz_dppo
#. odoo-python
#: code:addons/l10n_cz_dppo/models/cssk_income_tax.py:0
msgid ""
"%(file)s cannot be filed as an e-příloha. EPO accepts DOC, DOCX, RTF, XLS, "
"XLSX, PDF, JPG, JPEG, TXT and CSV files, or one of them signed (P7S) or "
"zipped (ZIP)."
msgstr ""

