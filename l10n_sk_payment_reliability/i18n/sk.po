#. module: l10n_sk_payment_reliability
#: model:ir.model.fields,help:l10n_sk_payment_reliability.field_res_config_settings__fa_api_key
msgid ""
"API key for the Slovak Financial Administration open-data service "
"(opendata.financnasprava.sk), used to look up registered bank accounts and "
"the tax-reliability index."
msgstr ""
"API kľúč pre službu otvorených dát Finančnej správy SR "
"(opendata.financnasprava.sk), používaný na vyhľadanie registrovaných "
"bankových účtov a indexu daňovej spoľahlivosti."

