                            t-att-bezne="'%.2f' % line.current_value"
                            t-att-minule="'%.2f' % line.prior_value"/>
                </t>
            </Telo>
        </UZVZS>
    </template>

    <!--
      Prehľad peňažných tokov (cash flow) — structured stand-in (no official
      FS SR XML form; it is a component of the poznámky, usually filed as PDF).
      bezne = current period, minule = prior period.
    -->
    <template id="cashflow_2025">
