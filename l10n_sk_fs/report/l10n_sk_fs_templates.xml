<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Súvaha (UZSUV) XML template — WORKING STAND-IN (see data/uzsuv_schema.xsd).
      bezne = current period, minule = comparison (prior) period.
      Replace with the official FS SR UZPODv14 structure before live filing.
    -->
    <template id="suvaha_2025">
        <UZSUV>
            <Hlavicka>
                <IcDphPlatitela t-out="company.vat or ''"/>
                <Nazov t-out="company.name or ''"/>
                <Rok t-out="statement.date_to.year"/>
            </Hlavicka>
            <Telo>
                <t t-foreach="lines" t-as="line">
                    <Riadok t-att-kod="line.code"
                            t-att-bezne="'%.2f' % line.current_value"
                            t-att-minule="'%.2f' % line.prior_value"/>
                </t>
            </Telo>
        </UZSUV>
    </template>

    <template id="vzs_2025">
        <UZVZS>
            <Hlavicka>
                <IcDphPlatitela t-out="company.vat or ''"/>
                <Nazov t-out="company.name or ''"/>
                <Rok t-out="statement.date_to.year"/>
            </Hlavicka>
            <Telo>
                <t t-foreach="lines" t-as="line">
