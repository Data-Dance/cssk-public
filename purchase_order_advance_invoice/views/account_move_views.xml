<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_move_form_purchase_advance" model="ir.ui.view">
        <field name="name">account.move.form.purchase.advance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_open_link_purchase_advance_wizard"
                    string="Deduct Advance Invoices"
                    type="object"
                    invisible="move_type != 'in_invoice' or state != 'draft'"
                />
            </header>
            <field name="payment_reference" position="after">
                <field
                    name="advance_purchase_order_id"
                    invisible="not advance_purchase_order_id"
                />
            </field>
        </field>
    </record>

</odoo>
