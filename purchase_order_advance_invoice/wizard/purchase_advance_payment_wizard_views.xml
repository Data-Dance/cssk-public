<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_advance_payment_wizard_form" model="ir.ui.view">
        <field name="name">purchase.advance.payment.wizard.form</field>
        <field name="model">purchase.advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <group>
                        <field name="order_id" />
                        <field name="partner_id" />
                        <field name="amount_remaining" />
                        <field name="amount" />
                        <field name="payment_date" />
                        <field name="company_id" invisible="1" />
                        <field name="currency_id" invisible="1" />
                    </group>
                    <group>
                        <field name="available_journal_ids" invisible="1" />
                        <field name="journal_id" />
                        <field
                            name="available_payment_method_line_ids"
                            invisible="1"
                        />
                        <field name="payment_method_line_id" />
                        <field name="memo" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create_payment"
                        string="Create Payment"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_advance_payment_wizard" model="ir.actions.act_window">
        <field name="name">Register Payment</field>
        <field name="res_model">purchase.advance.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
