<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record
        id="view_account_move_link_purchase_advance_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">account.move.link.purchase.advance.wizard.form</field>
        <field name="model">account.move.link.purchase.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Deduct Advance Invoices">
                <group>
                    <field name="move_id" />
                    <field name="available_advance_ids" invisible="1" />
                    <field name="advance_ids" widget="many2many_tags" />
                </group>
                <footer>
                    <button
                        name="action_link"
                        string="Deduct"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_account_move_link_purchase_advance_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Deduct Advance Invoices</field>
        <field name="res_model">account.move.link.purchase.advance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
