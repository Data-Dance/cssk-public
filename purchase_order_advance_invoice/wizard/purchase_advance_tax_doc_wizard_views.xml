<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_advance_tax_doc_wizard_form" model="ir.ui.view">
        <field name="name">purchase.advance.tax.doc.wizard.form</field>
        <field name="model">purchase.advance.tax.doc.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Received Tax Document">
                <group>
                    <group>
                        <field name="order_id" />
                        <field name="supplier_ref" />
                        <field name="amount" />
                        <field name="company_id" invisible="1" />
                        <field name="currency_id" invisible="1" />
                    </group>
                    <group>
                        <field name="invoice_date" />
                        <field name="taxable_supply_date" />
                        <field name="accounting_date" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create"
                        string="Create Draft Bill"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_advance_tax_doc_wizard" model="ir.actions.act_window">
        <field name="name">Register Received Tax Document</field>
        <field name="res_model">purchase.advance.tax.doc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
