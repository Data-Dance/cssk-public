<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_l10n_cz_eet2" model="ir.module.category">
        <field name="name">Czech EET 2.0</field>
    </record>

    <record id="privilege_l10n_cz_eet2" model="res.groups.privilege">
        <field name="name">Czech EET 2.0</field>
        <field name="category_id" ref="module_category_l10n_cz_eet2"/>
    </record>

    <record id="group_eet2_user" model="res.groups">
        <field name="name">EET 2.0 User</field>
        <field name="privilege_id" ref="privilege_l10n_cz_eet2"/>
    </record>

    <record id="group_eet2_manager" model="res.groups">
        <field name="name">EET 2.0 Manager</field>
        <field name="privilege_id" ref="privilege_l10n_cz_eet2"/>
        <field name="implied_ids" eval="[(4, ref('group_eet2_user'))]"/>
    </record>
</odoo>
