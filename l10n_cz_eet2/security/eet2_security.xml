<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_l10n_cz_eet2" model="ir.module.category">
        <field name="name">Czech EET 2.0</field>
    </record>

    <!-- 18.0 port: res.groups.privilege is a 19.0-only model; on 18.0 groups are
         categorised directly via category_id -> ir.module.category. -->
    <record id="group_eet2_user" model="res.groups">
        <field name="name">EET 2.0 User</field>
        <field name="category_id" ref="module_category_l10n_cz_eet2"/>
    </record>

    <record id="group_eet2_manager" model="res.groups">
        <field name="name">EET 2.0 Manager</field>
        <field name="category_id" ref="module_category_l10n_cz_eet2"/>
        <field name="implied_ids" eval="[(4, ref('group_eet2_user'))]"/>
    </record>

    <!-- Without these, nobody can open the EET menus after install until the groups are
         assigned by hand (found in a browser check 2026-10-29: the administrator got an
         Access Error on every EET view). Accounting managers run the agenda, invoicing
         users see it. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_eet2_manager'))]"/>
    </record>
    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_eet2_user'))]"/>
    </record>
</odoo>
