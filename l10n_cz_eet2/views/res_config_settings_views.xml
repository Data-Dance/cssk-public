<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_cz_eet2</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Anchor to invoicing_settings: it is core Invoicing (present in both
                 Community and Enterprise). bank_cash is Enterprise-only at runtime. -->
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Czech EET 2.0" id="l10n_cz_eet2_block">
                <setting id="l10n_cz_eet2_setting" string="Enable EET 2.0"
                        help="Electronic Registration of Sales 2.0">
                    <field name="l10n_cz_eet2_enabled"/>
                    <div class="content-group mt16" invisible="not l10n_cz_eet2_enabled">
                        <div class="row">
                            <label for="l10n_cz_eet2_environment" class="col-lg-4 o_light_label"/>
                            <field name="l10n_cz_eet2_environment"/>
                        </div>
                        <div class="row">
                            <label for="l10n_cz_eet2_eic_popl" class="col-lg-4 o_light_label"/>
                            <field name="l10n_cz_eet2_eic_popl"/>
                        </div>
                        <div class="row">
                            <label for="l10n_cz_eet2_id_jednotky" class="col-lg-4 o_light_label"/>
                            <field name="l10n_cz_eet2_id_jednotky"/>
                        </div>
                        <div class="row">
                            <label for="l10n_cz_eet2_certificate_id" class="col-lg-4 o_light_label"/>
                            <field name="l10n_cz_eet2_certificate_id"/>
                        </div>
                        <div class="row">
                            <label for="l10n_cz_eet2_max_attempts" class="col-lg-4 o_light_label"/>
                            <field name="l10n_cz_eet2_max_attempts"/>
                        </div>
                    </div>
                </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
