<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_eet2" model="ir.ui.view">
        <field name="name">account.payment.form.eet2</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="l10n_cz_eet2_action_send" type="object"
                        string="Send to EET" groups="l10n_cz_eet2.group_eet2_user"
                        invisible="not l10n_cz_eet2_needed or l10n_cz_eet2_state == 'accepted'"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="l10n_cz_eet2_needed" invisible="1"/>
                <field name="l10n_cz_eet2_state" readonly="1"
                    invisible="not l10n_cz_eet2_needed"/>
                <field name="l10n_cz_eet2_pok" readonly="1"
                    invisible="not l10n_cz_eet2_pok"/>
                <field name="l10n_cz_eet2_transaction_id" readonly="1"
                    invisible="not l10n_cz_eet2_transaction_id"
                    groups="l10n_cz_eet2.group_eet2_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
