<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eet2_transaction_list" model="ir.ui.view">
        <field name="name">l10n.cz.eet2.transaction.list</field>
        <field name="model">l10n.cz.eet2.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='accepted'"
                decoration-info="state=='verified'"
                decoration-warning="state in ('to_send','retry')"
                decoration-danger="state in ('rejected','error')">
                <field name="create_date"/>
                <field name="eic_popl"/>
                <field name="id_jednotky"/>
                <field name="id_pokl"/>
                <field name="porad_cis"/>
                <field name="celk_trzba"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="environment"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count" optional="hide"/>
                <field name="next_attempt" optional="hide"/>
                <field name="pok" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_eet2_transaction_form" model="ir.ui.view">
        <field name="name">l10n.cz.eet2.transaction.form</field>
        <field name="model">l10n.cz.eet2.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send to EET"
                            class="btn-primary"
                            invisible="state in ('accepted','verified')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,to_send,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Message">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="environment"/>
                            <field name="certificate_id"/>
                            <field name="uuid_zpravy" readonly="1"/>
                            <field name="prvni_zaslani"/>
                            <field name="overeni"/>
                        </group>
                        <group string="Result">
                            <field name="pok" readonly="1"/>
                            <field name="is_test_response" readonly="1"/>
                            <field name="dat_prij" readonly="1"/>
                            <field name="dat_odmit" readonly="1"/>
                            <field name="chyba_kod" readonly="1"/>
                            <field name="chyba_text" readonly="1"/>
                            <field name="xgtid" readonly="1"/>
                            <field name="attempt_count" readonly="1"/>
                            <field name="next_attempt" readonly="1"
                                invisible="state not in ('to_send','retry')"/>
                        </group>
                    </group>
                    <group string="Sale data (Data)">
                        <group>
                            <field name="eic_popl"/>
                            <field name="eic_poverujiciho"/>
                            <field name="povereni_vice_popl"/>
                            <field name="id_jednotky"/>
                            <field name="id_pokl"/>
                            <field name="porad_cis"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="dat_trzby"/>
                            <field name="celk_trzba"/>
                            <field name="urceno_cerp_zuct"/>
                            <field name="cerp_zuct"/>
                        </group>
                    </group>
                    <field name="warning_text" readonly="1"
                        invisible="not warning_text"/>
                    <notebook>
                        <page string="Request XML">
                            <field name="request_xml" readonly="1"/>
                        </page>
                        <page string="Response XML">
                            <field name="response_xml" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eet2_transaction_search" model="ir.ui.view">
        <field name="name">l10n.cz.eet2.transaction.search</field>
        <field name="model">l10n.cz.eet2.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="eic_popl"/>
                <field name="id_pokl"/>
                <field name="porad_cis"/>
                <field name="pok"/>
                <field name="uuid_zpravy"/>
                <filter name="pending" string="Pending"
                        domain="[('state','in',('to_send','retry'))]"/>
                <filter name="accepted" string="Accepted" domain="[('state','=','accepted')]"/>
                <filter name="rejected" string="Rejected/Error"
                        domain="[('state','in',('rejected','error'))]"/>
                <separator/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_env" string="Environment" context="{'group_by':'environment'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eet2_transaction" model="ir.actions.act_window">
        <field name="name">EET 2.0 Messages</field>
        <field name="res_model">l10n.cz.eet2.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
