<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_eet2" model="ir.ui.view">
        <field name="name">account.journal.form.eet2</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group string="Czech EET 2.0" name="l10n_cz_eet2">
                    <field name="l10n_cz_eet2_contact"/>
                    <field name="l10n_cz_eet2_id_pokl"
                        invisible="not l10n_cz_eet2_contact"/>
                    <field name="l10n_cz_eet2_id_jednotky"
                        invisible="not l10n_cz_eet2_contact"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
