#. module: l10n_cz_eet2
#. odoo-python
#: code:addons/l10n_cz_eet2/models/eet2_certificate.py:0
msgid ""
"Certificate %(name)s (%(env)s) is valid until %(to)s. Generate a new "
"pokladní certifikát in DIS+, upload it here or as a new record, test it and "
"select it in the EET 2.0 settings."
msgstr ""
"Certifikát %(name)s (%(env)s) platí do %(to)s. Vygenerujte v DIS+ nový "
"pokladní certifikát, nahrajte jej sem nebo jako nový záznam, otestujte jej a "
"vyberte v nastavení EET 2.0."

#. module: l10n_cz_eet2
#. odoo-python
#: code:addons/l10n_cz_eet2/models/eet2_certificate.py:0
msgid ""
"Certificate %s has expired; the CA renews only a valid certificate. Generate "
"a new one in DIS+ and upload it."
msgstr ""
"Certifikát %s vypršel; CA obnovuje jen platný certifikát. Vygenerujte nový v "
"DIS+ a nahrajte ho."

