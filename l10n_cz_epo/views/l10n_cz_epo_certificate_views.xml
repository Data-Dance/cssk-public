<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_cz_epo_certificate_view_list" model="ir.ui.view">
        <field name="name">l10n.cz.epo.certificate.list</field>
        <field name="model">l10n.cz.epo.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="valid_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="l10n_cz_epo_certificate_view_form" model="ir.ui.view">
        <field name="name">l10n.cz.epo.certificate.form</field>
        <field name="model">l10n.cz.epo.certificate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This certificate signs filings to the tax office in the
                        company's name — EPO knows no other identity. Only
                        users allowed to file can read or change it.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="p12_file" filename="p12_filename"/>
                            <field name="p12_filename" invisible="1"/>
                            <field name="password" password="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="issuer"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_cz_epo_certificate_action" model="ir.actions.act_window">
        <field name="name">EPO certificates</field>
        <field name="res_model">l10n.cz.epo.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="l10n_cz_epo_certificate_menu"
              name="EPO certificates"
              parent="account.account_account_menu"
              action="l10n_cz_epo_certificate_action"
              groups="l10n_cssk_submission_base.group_cssk_submission_manager"
              sequence="90"/>
</odoo>
