#. module: l10n_cz_epo
#: model_terms:ir.ui.view,arch_db:l10n_cz_epo.cssk_submission_view_form_epo
msgid ""
"EPO's checks are a subset of the tax office's: a clean\n"
"                        result is not a guarantee that the filing will be\n"
"                        accepted."
msgstr ""
"Kontroly EPO jsou podmnožinou kontrol finančního úřadu:\n"
"                        bezchybný výsledek není zárukou, že podání bude\n"
"                        přijato."

#. module: l10n_cz_epo
