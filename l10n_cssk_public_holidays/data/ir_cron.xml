<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cssk_public_holidays" model="ir.cron">
        <field name="name">Public holidays: generate next year (SK, CZ)</field>
        <field name="model_id" ref="calendar_public_holiday.model_calendar_public_holiday"/>
        <field name="state">code</field>
        <field name="code">model.cssk_generate_next_year()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
