#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) of § 69 ods. 12 goods whose unit converts to none of kg, "
"t, m, ks — the only units the form accepts; invoice them in one of those: "
"%(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
