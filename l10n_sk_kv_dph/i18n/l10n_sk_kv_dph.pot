#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(n)d odberateľ(ov) v oddiele D.2 nemá IČ DPH ani IČO, ale podľa vlastného "
"záznamu ide o podnikateľa: %(names)s. Ak IČO chýba len v evidencii, doplňte "
"ho — dodanie potom patrí do A.1 (IČ DPH sa v A.1 neuvádza povinne). D.2 je "
"súhrn, takže v samotnom výkaze odberateľa nevidno."
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose counterparty IČ DPH is not Slovak — this section"
" reports domestic supplies only (the form types it SK+10 digits), so the "
"document belongs in another section or the partner's country/VAT disagree: "
"%(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose document reference is longer than the 32 "
"characters the form allows — shorten it on the document; it is cross-matched"
" against the supplier's own filing, so it cannot be truncated here: %(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the counterparty's IČ DPH — set the VAT number"
" on the partner (Contacts → partner → Tax ID): %(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the supply date (Den) — set the "
"invoice/delivery date on the document: %(refs)s"
msgstr ""

