#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(n)d odberateľ(ov) v oddiele D.2 nemá IČ DPH ani IČO, ale podľa vlastného "
"záznamu ide o podnikateľa: %(names)s. Ak IČO chýba len v evidencii, doplňte "
"ho — dodanie potom patrí do A.1 (IČ DPH sa v A.1 neuvádza povinne). D.2 je "
"súhrn, takže v samotnom výkaze odberateľa nevidno."
msgstr ""
"%(n)d odberateľ(ov) v oddiele D.2 nemá IČ DPH ani IČO, ale podľa vlastného "
"záznamu ide o podnikateľa: %(names)s. Ak IČO chýba len v evidencii, doplňte "
"ho — dodanie potom patrí do A.1 (IČ DPH sa v A.1 neuvádza povinne). D.2 je "
"súhrn, takže v samotnom výkaze odberateľa nevidno."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose counterparty IČ DPH is not Slovak — this section"
" reports domestic supplies only (the form types it SK+10 digits), so the "
"document belongs in another section or the partner's country/VAT disagree: "
"%(refs)s"
msgstr ""
"%(sec)s: %(n)d riadok(ov), ktorých IČ DPH protistrany nie je slovenské — "
"tento oddiel vykazuje len tuzemské dodania (formulár ho typuje ako SK + 10 "
"číslic), takže doklad patrí do iného oddielu alebo si krajina a IČ DPH "
"partnera odporujú: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose document reference is longer than the 32 "
"characters the form allows — shorten it on the document; it is cross-matched"
" against the supplier's own filing, so it cannot be truncated here: %(refs)s"
msgstr ""
"%(sec)s: %(n)d riadok(ov), ktorých referencia dokladu je dlhšia než 32 "
"znakov povolených formulárom — skráťte ju na doklade; krížovo sa porovnáva s"
" podaním dodávateľa, takže ju nemožno skrátiť tu: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the counterparty's IČ DPH — set the VAT number"
" on the partner (Contacts → partner → Tax ID): %(refs)s"
msgstr ""
"%(sec)s: %(n)d riadok(ov) bez IČ DPH protistrany — nastavte IČ DPH na "
"partnerovi (Kontakty → partner → IČ DPH): %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the supply date (Den) — set the "
"invoice/delivery date on the document: %(refs)s"
msgstr ""
"%(sec)s: %(n)d riadok(ov) bez dátumu dodania (Den) — nastavte na doklade "
"dátum faktúry/dodania: %(refs)s"

#. module: l10n_sk_kv_dph
#: model_terms:ir.ui.view,arch_db:l10n_sk_kv_dph.cssk_control_statement_view_form_sk
msgid "A.1"
msgstr "A.1"

#. module: l10n_sk_kv_dph
#: model_terms:ir.ui.view,arch_db:l10n_sk_kv_dph.cssk_control_statement_view_form_sk
msgid "A.2"
msgstr "A.2"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) of § 69 ods. 12 goods whose unit converts to none of kg, "
"t, m, ks — the only units the form accepts; invoice them in one of those: "
"%(refs)s"
msgstr ""
"A.2: %(n)d riadok(ov) tovaru podľa § 69 ods. 12, ktorého mernú jednotku "
"nemožno previesť na kg, t, m ani ks — iné jednotky tlačivo neprijíma; "
"fakturujte v niektorej z nich: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) of § 69 ods. 12 písm. f)/g) goods without the 4-digit "
"commodity code — set it on the product (KV DPH commodity code, or its "
"intrastat/HS code): %(refs)s"
msgstr ""
"A.2: %(n)d riadok(ov) tovaru podľa § 69 ods. 12 písm. f)/g) bez "
"štvormiestneho číselného kódu tovaru — doplňte ho na produkte (Číselný kód "
"tovaru (KV DPH) alebo kód Intrastat/HS): %(refs)s"

