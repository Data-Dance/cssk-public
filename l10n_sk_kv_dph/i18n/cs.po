#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) of § 69 ods. 12 goods whose unit converts to none of kg, "
"t, m, ks — the only units the form accepts; invoice them in one of those: %"
"(refs)s"
msgstr ""
"A.2: %(n)d řádků zboží podle § 69 odst. 12, jejichž jednotku nelze převést "
"na žádnou z kg, t, m, ks — jediných jednotek, které formulář přijímá; "
"fakturujte je v jedné z nich: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) of § 69 ods. 12 písm. f)/g) goods without the 4-digit "
"commodity code — set it on the product (KV DPH commodity code, or its "
"intrastat/HS code): %(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"A.2: %(n)d row(s) whose commodity code is outside the chapters § 69 ods. 12 "
"names for its goods (písm. f: %(f)s; písm. g: %(g)s) — correct the product's "
"KV DPH commodity code or its HS code, or its § 69 ods. 12 category: %(refs)s"
msgstr ""
"A.2: %(n)d řádek/řádků, jejichž kód zboží je mimo kapitoly, které § 69 ods. "
"12 pro dané zboží uvádí (písm. f: %(f)s; písm. g: %(g)s) — opravte kód zboží "
"pro KV DPH nebo kód HS produktu, případně jeho kategorii podle § 69 ods. 12: "
"%(refs)s"

