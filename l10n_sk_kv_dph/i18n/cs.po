#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/account_move.py:0
msgid ""
"%(doc)s: enter the supplier's number of the invoice it corrects (Other Info "
"→ Original document number), or the Bill Reference on the linked original "
"bill."
msgstr ""
"%(doc)s: zadejte číslo opravované faktury od dodavatele (Další informace → "
"Číslo původního dokladu) nebo referenci faktury na propojené původní faktuře."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/account_move.py:0
msgid ""
"%(doc)s: enter the supplier's number of this credit or debit note as the "
"Bill Reference."
msgstr ""
"%(doc)s: zadejte číslo tohoto dobropisu nebo vrubopisu od dodavatele jako "
"referenci faktury."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/account_move.py:0
msgid ""
"%(goods)s: the base on this invoice is %(total).2f €, so reverse charge "
"applies if the customer is a VAT payer."
msgstr ""
"%(goods)s: základ daně na této faktuře je %(total).2f €, proto se uplatní "
"přenesení daňové povinnosti, pokud je odběratel plátcem DPH."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/account_move.py:0
msgid ""
"%(goods)s: the base on this invoice is %(total).2f €, under 5 000 €, so "
"reverse charge does not apply and VAT is due."
msgstr ""
"%(goods)s: základ daně na této faktuře je %(total).2f €, tedy pod 5 000 €, "
"proto se přenesení daňové povinnosti neuplatní a daň je třeba uvést."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(n)d interný(ch) dobropis(ov) bez čísla dokladu dodávateľa sa do "
"kontrolného výkazu neuvádza: %(docs)s. Opravovaný doklad je v inom období "
"alebo nie je stornovaný celý, takže výkaz sa rozchádza s daňovým priznaním, "
"v ktorom daň interného dobropisu ostáva. Počkajte na dobropis od dodávateľa, "
"alebo otvorte obdobie pôvodného dokladu, opravte ho a podajte dodatočné "
"daňové priznanie a kontrolný výkaz."
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(n)d odberateľ(ov) v oddiele D.2 nemá IČ DPH ani IČO, ale podľa vlastného "
"záznamu ide o podnikateľa: %(names)s. Ak IČO chýba len v evidencii, doplňte "
"ho — dodanie potom patrí do A.1 (IČ DPH sa v A.1 neuvádza povinne). D.2 je "
"súhrn, takže v samotnom výkaze odberateľa nevidno."
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/product.py:0
msgid ""
"%(product)s: commodity code %(code)s is outside § 69 ods. 12 písm. %"
"(goods)s) (%(scope)s)."
msgstr ""
"%(product)s: kód zboží %(code)s nespadá pod § 69 ods. 12 písm. %(goods)s) (%"
"(scope)s)."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/product.py:0
msgid ""
"%(product)s: the KV DPH commodity code must be four digits, not \"%(code)s\"."
msgstr ""
"%(product)s: kód zboží pro KV DPH musí mít čtyři číslice, ne „%(code)s“."

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose counterparty IČ DPH is not Slovak — this section "
"reports domestic supplies only (the form types it SK+10 digits), so the "
"document belongs in another section or the partner's country/VAT disagree: %"
"(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) whose document reference is longer than the 32 "
"characters the form allows — shorten it on the document; it is cross-matched "
"against the supplier's own filing, so it cannot be truncated here: %(refs)s"
msgstr ""
"%(sec)s: %(n)d řádků, jejichž označení dokladu je delší než 32 znaků "
"povolených formulářem — zkraťte ho na dokladu; páruje se s vlastním hlášením "
"dodavatele, proto ho zde nelze oříznout: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the counterparty's IČ DPH — set the VAT number "
"on the partner (Contacts → partner → Tax ID): %(refs)s"
msgstr ""

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the number of the invoice being corrected — "
"the credit note is not linked to it; enter it on the credit note (Other Info "
"→ Original document number; on a vendor credit note the Source Document is "
"read too) and recompute: %(refs)s"
msgstr ""
"%(sec)s: %(n)d řádek/řádků bez čísla opravované faktury — dobropis s ní není "
"propojen; zadejte ho na dobropisu (Další informace → Číslo původního "
"dokladu; u dobropisu od dodavatele se čte i Zdrojový doklad) a přepočítejte: "
"%(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the supplier's invoice number; enter it as the "
"Bill Reference and recompute: %(refs)s"
msgstr ""
"%(sec)s: %(n)d řádek/řádků bez čísla faktury od dodavatele; zadejte ho jako "
"referenci faktury a přepočítejte: %(refs)s"

#. module: l10n_sk_kv_dph
#. odoo-python
#: code:addons/l10n_sk_kv_dph/models/cssk_control_statement.py:0
msgid ""
"%(sec)s: %(n)d row(s) without the supply date (Den) — set the invoice/"
"delivery date on the document: %(refs)s"
msgstr ""
"%(sec)s: %(n)d řádků bez data dodání (Den) — nastavte na dokladu datum "
"faktury/dodání: %(refs)s"

