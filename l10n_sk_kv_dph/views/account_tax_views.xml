<odoo>
    <record id="view_tax_form_kv_supplier_excluded" model="ir.ui.view">
        <field name="name">account.tax.form.sk.kv.supplier.excluded</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_group_id'][1]" position="after">
                <field name="l10n_sk_kv_supplier_excluded"
                       invisible="type_tax_use != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>
