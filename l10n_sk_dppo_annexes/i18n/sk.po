#: model:ir.model.fields,field_description:l10n_sk_dppo_annexes.field_l10n_sk_dppo_annex_a_line__row_code
msgid "Row Code"
msgstr "Riadok tabuľky"

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Select the DPPO company before changing its annex workpapers."
msgstr "Pred zmenou podkladov príloh vyberte firmu priznania DPPO."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Table A items cannot be reassigned to another return or company."
msgstr "Položky tabuľky A nemožno presunúť do iného priznania alebo firmy."

#. module: l10n_sk_dppo_annexes
#: model:ir.model.fields,field_description:l10n_sk_dppo_annexes.field_cssk_income_tax_return__l10n_sk_annex_a_ids
msgid "Table A non-deductible expenses"
msgstr "Tabuľka A: daňovo neuznané náklady"

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Table B6 cannot be negative. Reconcile B2, B3, B4 and B5."
msgstr "Riadok B6 nesmie byť záporný. Zosúlaďte B2, B3, B4 a B5."

#. module: l10n_sk_dppo_annexes
#: model:ir.model.fields,field_description:l10n_sk_dppo_annexes.field_cssk_income_tax_return__l10n_sk_annexes_evidence
msgid "Tax adjustment and depreciation workpaper evidence"
msgstr "Podklady daňových úprav a odpisov"

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid ""
"The DPPO annex inputs, main rows or posted ledger changed. Recalculate "
"before export or filing."
msgstr ""
"Zmenili sa vstupy príloh DPPO, hlavné riadky alebo zaúčtované knihy. Pred "
"exportom alebo podaním výpočet zopakujte."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "The Table A item must belong to its DPPO company."
msgstr "Položka tabuľky A musí patriť firme priznania DPPO."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "The active or filed DPPO annex XML must be retained."
msgstr "Aktívne alebo podané XML s prílohami DPPO musí zostať uchované."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "This annex layout requires the reviewed Slovak DPPOv25 edition."
msgstr "Táto štruktúra príloh vyžaduje overenú slovenskú verziu DPPOv25."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Use finite nonnegative annex amounts in whole eurocents."
msgstr "V prílohách použite konečné nezáporné sumy v celých eurocentoch."

#. module: l10n_sk_dppo_annexes
#: model:ir.model.fields,field_description:l10n_sk_dppo_annexes.field_cssk_income_tax_return__l10n_sk_annexes_enabled
msgid "Use reviewed Tables A and B"
msgstr "Použiť overené tabuľky A a B"
