#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Recalculate the reviewed DPPO annexes before export or filing."
msgstr ""
"Pred exportom alebo zaevidovaním podania prepočítajte overené prílohy DPPO."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid ""
"Reconcile the manual main DPPO row with its reviewed Table A or B before "
"calculation."
msgstr ""
"Pred výpočtom zosúlaďte ručne zadaný hlavný riadok DPPO s overenou tabuľkou "
"A alebo B."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Reset the unfiled DPPO to draft before changing its annex workpapers."
msgstr "Pred zmenou podkladov príloh vráťte nepodané DPPO do konceptu."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid ""
"Retain the exact DPPO annex XML. Export a new snapshot instead of replacing "
"this file."
msgstr ""
"Uchovajte presné XML s prílohami DPPO. Namiesto nahradenia súboru "
"vyexportujte novú snímku."

#. module: l10n_sk_dppo_annexes
#: model:ir.model.fields,field_description:l10n_sk_dppo_annexes.field_l10n_sk_dppo_annex_a_line__return_id
msgid "Return"
msgstr "Priznanie"

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid ""
"Review complete Tables A and B and retain the tax adjustment/depreciation "
"evidence."
msgstr ""
"Overte úplné tabuľky A a B a uchovajte podklady daňových úprav a odpisov."

#. module: l10n_sk_dppo_annexes
#. odoo-python
#: code:addons/l10n_sk_dppo_annexes/models/annexes.py:0
msgid "Reviewed Table A/B workpaper"
msgstr "Overený podklad tabuliek A/B"

