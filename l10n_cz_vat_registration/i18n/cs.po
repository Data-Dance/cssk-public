#. module: l10n_cz_vat_registration
#: model:ir.model.fields,help:l10n_cz_vat_registration.field_cssk_tax_authority__l10n_cz_is_full_vat_payer
#: model:ir.model.fields,help:l10n_cz_vat_registration.field_res_partner__l10n_cz_is_full_vat_payer
#: model:ir.model.fields,help:l10n_cz_vat_registration.field_res_users__l10n_cz_is_full_vat_payer
msgid ""
"True for a plátce and for a skupina. False for an identifikovaná osoba and a"
" neplátce, and unset when the category is unknown."
msgstr ""
"Zaškrtnuto u plátce a u skupiny. Nezaškrtnuto u identifikované osoby a u "
"neplátce a také tehdy, když druh registrace není znám."

#. module: l10n_cz_vat_registration
#: model:ir.model.fields,help:l10n_cz_vat_registration.field_cssk_tax_authority__l10n_cz_vat_registration_category
