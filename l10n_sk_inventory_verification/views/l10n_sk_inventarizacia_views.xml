<odoo>
    <record id="view_inventarizacia_list" model="ir.ui.view">
        <field name="name">l10n.sk.inventarizacia.list</field>
        <field name="model">l10n.sk.inventarizacia</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date_as_of"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="supis_count"/>
                <field name="book_amount" sum="Účtovný stav"/>
                <field name="actual_amount" sum="Skutočný stav"/>
                <field name="difference" sum="Rozdiel"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_inventarizacia_form" model="ir.ui.view">
        <field name="name">l10n.sk.inventarizacia.form</field>
        <field name="model">l10n.sk.inventarizacia</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Začať"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Ukončiť"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_draft" type="object" string="Späť na návrh"
                            invisible="state == 'draft'"/>
                    <button name="action_refresh_book_amounts" type="object"
                            string="Načítať účtovné stavy"
                            invisible="state == 'done' or not supis_ids"/>
                    <button name="action_print_supisy" type="object"
                            string="Tlačiť inventúrne súpisy"
                            invisible="not supis_ids"/>
                    <button name="action_propose_differences" type="object"
                            string="Navrhnúť vyúčtovanie rozdielov"
                            invisible="state == 'draft' or difference_state != 'to_settle'"/>
                    <button name="action_create_difference_entries" type="object"
                            string="Zaúčtovať rozdiely" class="oe_highlight"
                            invisible="state == 'draft' or difference_state != 'ready'"
                            groups="account.group_account_invoice"/>
                    <button name="action_cancel_difference_entries" type="object"
                            string="Zrušiť zaúčtovanie rozdielov"
                            invisible="difference_state not in ('draft', 'posted')"
                            confirm="Účtovný zápis v návrhu sa vymaže, zaúčtovaný sa stornuje k rovnakému dňu. Pokračovať?"
                            groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not difference_stale">
                    Inventúrne súpisy sa od zaúčtovania rozdielov zmenili: zaúčtované sumy už rozdielom nezodpovedajú. Zrušte zaúčtovanie rozdielov a zaúčtujte ich znova.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="not difference_misdated">
                    Účtovný zápis rozdielov má iný dátum ako deň, ku ktorému bola inventúra vykonaná: rozdiely tak nie sú zaúčtované v období, za ktoré sa stav overuje (§ 30 ods. 7). Stáva sa to, keď je obdobie uzamknuté — Odoo pri zaúčtovaní posunie dátum za uzamknutie.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_difference_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="difference_move_count == 0">
                            <field name="difference_move_count" widget="statinfo"
                                   string="Účtovné zápisy"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Termíny (§ 30 ods. 2)">
                            <field name="date_start"/>
                            <field name="date_as_of"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Súhrn">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="book_amount"/>
                            <field name="actual_amount"/>
                            <field name="difference"/>
                            <field name="difference_state" widget="badge"
                                   decoration-warning="difference_state == 'to_settle'"
                                   decoration-info="difference_state in ('ready', 'draft')"
                                   decoration-success="difference_state == 'posted'"/>
                            <field name="difference_stale" invisible="1"/>
                            <field name="difference_misdated" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inventúrne súpisy">
                            <field name="supis_ids">
                                <!-- not editable inline: a súpis has položky,
                                     which only its form can take -->
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="inventory_type"/>
                                    <field name="account_id"/>
                                    <field name="location"/>
                                    <field name="responsible_person_id"/>
                                    <field name="counted_by_id"/>
                                    <field name="book_amount"/>
                                    <field name="actual_amount"/>
                                    <field name="difference"/>
                                    <field name="difference_residual"
                                           decoration-danger="difference_residual != 0"
                                           optional="show"/>
                                    <field name="difference_skip" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="inventory_type"/>
                                            <field name="account_id"/>
                                            <field name="location"/>
                                        </group>
                                        <group>
                                            <field name="responsible_person_id"/>
                                            <field name="counted_by_id"/>
                                            <field name="book_amount"/>
                                            <field name="actual_amount"/>
                                            <field name="difference"/>
                                            <field name="difference_residual"/>
                                            <field name="difference_skip"/>
                                            <field name="difference_skip_reason"
                                                   invisible="not difference_skip"
                                                   required="difference_skip"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <button name="action_refresh_book_amount" type="object"
                                            string="Načítať zostatok účtu"
                                            invisible="inventory_type != 'dokladova' or not account_id"/>
                                    <field name="line_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="uom_name"/>
                                            <field name="unit_price"/>
                                            <field name="amount"/>
                                            <field name="note"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                    <group string="Poznámky">
                                        <field name="note" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Inventarizačné rozdiely (§ 30 ods. 5 až 7)" name="differences">
                            <group>
                                <field name="difference_journal_id"
                                       readonly="difference_state in ('draft', 'posted')"/>
                            </group>
                            <field name="difference_line_ids"
                                   context="{'default_inventory_id': id}">
                                <list editable="bottom"
                                      decoration-muted="move_state == 'posted'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="sheet_id" options="{'no_create': True}"
                                           domain="[('inventarizacia_id', '=', parent.id)]"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="kind"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="amount"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="account_id"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="counterpart_account_id"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="partner_id" optional="show"
                                           readonly="move_state in ('draft', 'posted')"/>
                                    <field name="name" optional="hide"/>
                                    <field name="move_id" widget="many2one" optional="show"/>
                                    <field name="move_state" widget="badge" optional="show"/>
                                    <field name="warning" optional="show"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <p class="text-muted">Manko (pri peňažných prostriedkoch a ceninách schodok) a úbytok do normy znižujú skutočný stav pod účtovný, prebytok ho zvyšuje; spolu musia vysvetliť celý rozdiel súpisu. Náhrada je predpis pohľadávky voči hmotne zodpovednej osobe. Účtovný zápis vzniká v návrhu ku dňu, ku ktorému bola inventúra vykonaná (§ 30 ods. 7); zaúčtuje ho účtovník.</p>
                        </page>
                        <page string="Inventarizačný zápis (§ 30 ods. 3)">
                            <group>
                                <field name="comparison_note"/>
                                <field name="valuation_note"/>
                                <field name="approved_by_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inventarizacia" model="ir.actions.act_window">
        <field name="name">Inventarizácia</field>
        <field name="res_model">l10n.sk.inventarizacia</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_inventarizacia" name="Inventarizácia"
              parent="account.menu_finance_entries"
              action="action_inventarizacia" sequence="95"/>
</odoo>
