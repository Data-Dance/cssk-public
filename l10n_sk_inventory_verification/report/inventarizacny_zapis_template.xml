<odoo>
    <template id="report_inventarizacny_zapis">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Inventarizačný zápis</h2>
                        <p class="text-muted">
                            podľa § 30 ods. 3 zákona č. 431/2002 Z. z. o účtovníctve
                        </p>

                        <div class="row mb-3">
                            <!-- § 30 ods. 3 písm. a) -->
                            <div class="col-6">
                                <strong>Účtovná jednotka:</strong>
                                <span t-field="doc.company_id.name"/><br/>
                                <!-- právnická osoba: sídlo; fyzická osoba: bydlisko
                                     (a miesto podnikania) — the company address -->
                                <strong>Sídlo:</strong>
                                <span t-field="doc.company_id.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "separator": ", "}'/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Inventarizácia:</strong>
                                <span t-field="doc.name"/><br/>
                                <strong>Ku dňu:</strong>
                                <span t-field="doc.date_as_of"/>
                            </div>
                        </div>

                        <h4>Výsledky porovnania skutočného a účtovného stavu</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Inventúrny súpis</th>
                                    <th>Druh</th>
                                    <th>Účet</th>
                                    <th class="text-end">Účtovný stav</th>
                                    <th class="text-end">Skutočný stav</th>
                                    <th class="text-end">Rozdiel</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.supis_ids" t-as="supis">
                                    <td><span t-field="supis.name"/></td>
                                    <td><span t-field="supis.inventory_type"/></td>
                                    <td><span t-field="supis.account_id.code"/></td>
                                    <td class="text-end">
                                        <span t-field="supis.book_amount"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="supis.actual_amount"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="supis.difference"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"><strong>Spolu</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.book_amount"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                                    <td class="text-end"><strong><span t-field="doc.actual_amount"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                                    <td class="text-end"><strong><span t-field="doc.difference"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p t-if="doc.comparison_note"><span t-field="doc.comparison_note"/></p>

                        <t t-set="skipped" t-value="doc.supis_ids.filtered('difference_skip')"/>
                        <t t-if="doc.difference_line_ids or skipped">
                            <h4>Vyúčtovanie inventarizačných rozdielov (§ 30 ods. 5 až 7)</h4>
                            <table class="table table-sm" t-if="doc.difference_line_ids">
                                <thead>
                                    <tr>
                                        <th>Inventúrny súpis</th>
                                        <th>Druh rozdielu</th>
                                        <th>MD</th>
                                        <th>D</th>
                                        <th class="text-end">Suma</th>
                                        <th>Účtovný zápis</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.difference_line_ids" t-as="rozdiel">
                                        <t t-set="lowers" t-value="rozdiel.kind in ('shortage', 'natural_loss')"/>
                                        <td><span t-field="rozdiel.sheet_id.name"/></td>
                                        <td><span t-field="rozdiel.kind"/></td>
                                        <td><span t-out="(rozdiel.counterpart_account_id if lowers else rozdiel.account_id).with_company(doc.company_id).code"/></td>
                                        <td><span t-out="(rozdiel.account_id if lowers else rozdiel.counterpart_account_id).with_company(doc.company_id).code"/></td>
                                        <td class="text-end">
                                            <span t-field="rozdiel.amount"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td>
                                            <t t-if="rozdiel.move_id and rozdiel.move_id.state == 'posted'">
                                                <span t-field="rozdiel.move_id.name"/>,
                                                <span t-field="rozdiel.move_id.date"/>
                                            </t>
                                            <t t-elif="rozdiel.move_id and rozdiel.move_id.state == 'draft'">v návrhu</t>
                                            <t t-else="">nezaúčtované</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-foreach="skipped" t-as="sheet">
                                <strong><span t-field="sheet.name"/></strong>
                                (<span t-field="sheet.difference"
                                       t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>):
                                rozdiel sa týmto zápisom neúčtuje — <span t-field="sheet.difference_skip_reason"/>
                            </p>
                        </t>

                        <h4>Posúdenie reálnosti ocenenia (§ 26)</h4>
                        <p>
                            <span t-field="doc.valuation_note"/>
                            <span t-if="not doc.valuation_note" class="text-muted">
                                Neuvedené.
                            </span>
                        </p>

                        <div class="row mt-5">
                            <div class="col-6">
                                <!-- § 30 ods. 3 písm. d) -->
                                <p>Za vykonanie inventarizácie zodpovedá:
                                    <strong><span t-field="doc.approved_by_id.name"/></strong>
                                </p>
                                <p>.................................................</p>
                                <p class="text-muted">podpisový záznam</p>
                            </div>
                            <div class="col-6">
                                <p>Za účtovnú jednotku:</p>
                                <p>.................................................</p>
                                <p class="text-muted">podpisový záznam</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
