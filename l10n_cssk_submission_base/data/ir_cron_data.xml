<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The fallback path. Where queue_job is installed a transport module can
         route _attempt_send through it instead; this cron is what makes the
         framework work without it. Five minutes is short enough that a
         transient gateway failure clears well inside a filing day, and long
         enough not to hammer a provider that is down. -->
    <record id="cron_cssk_submission_send" model="ir.cron">
        <field name="name">Statutory submissions: send queued</field>
        <field name="model_id" ref="model_cssk_submission"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_queued()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_cssk_submission_poll" model="ir.cron">
        <field name="name">Statutory submissions: poll for acceptance</field>
        <field name="model_id" ref="model_cssk_submission"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_delivered()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
