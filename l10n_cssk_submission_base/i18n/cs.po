#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(filing)s was exported again after this submission was queued, so the "
"queued XML is no longer the filing. Queue the submission anew to send the "
"current export."
msgstr ""
"%(filing)s bylo po zařazení tohoto doručení do fronty znovu exportováno, "
"takže XML ve frontě už není podáním. Zařaďte doručení do fronty znovu, aby "
"se odeslal aktuální export."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(filing)s was reset to draft after this submission was queued. Export it "
"again and queue the submission anew."
msgstr ""
"%(filing)s bylo po zařazení tohoto doručení do fronty vráceno do konceptu. "
"Znovu je exportujte a doručení zařaďte do fronty znovu."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(name)s has already reached the authority and cannot be cancelled. File a "
"correction instead."
msgstr ""
"%(name)s se již dostalo k úřadu a nelze je zrušit. Podejte místo toho "
"opravu."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submittable_mixin.py:0
msgid "%(name)s has no XML to file."
msgstr "%(name)s nemá XML k podání."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(name)s has no filed payload. Export and submit the statement first — a "
"submission carries the statement's filed copy, it does not produce one."
msgstr ""
"%(name)s nemá podávaný soubor. Nejprve výkaz exportujte a označte jako "
"podaný — doručení nese podanou kopii výkazu, samo ji nevytváří."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(name)s is being sent right now by another process (the scheduled sender or "
"another user). Reload it in a moment to see the outcome."
msgstr ""
"%(name)s právě odesílá jiný proces (plánované odesílání nebo jiný "
"uživatel). Za chvíli ho obnovte a uvidíte výsledek."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid "%(name)s is %(state)s and cannot be queued."
msgstr "%(name)s je ve stavu %(state)s a nelze je zařadit do fronty."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid "%(name)s is already attested."
msgstr "%(name)s je již potvrzeno."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid "%(name)s is not a manual filing."
msgstr "%(name)s není ruční podání."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"%(name)s is not a manual filing; its channel records acceptance itself."
msgstr "%(name)s není ruční podání; přijetí zaznamenává jeho kanál sám."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submittable_mixin.py:0
msgid ""
"%(name)s is not exported yet. A submission carries the filed copy, so export"
" and submit it first."
msgstr ""
"%(name)s ještě není exportováno. Doručení nese podanou kopii, proto je "
"nejprve exportujte a označte jako podané."

#. module: l10n_cssk_submission_base
#. odoo-python
#: code:addons/l10n_cssk_submission_base/models/cssk_submission.py:0
msgid ""
"A filing on the authority's portal is made by a person, not by this server. "
"Use 'Attest filing' once it has been submitted."
msgstr ""
"Podání na portálu úřadu provádí člověk, ne tento server. Po podání použijte "
"„Potvrdit podání“."

#. module: l10n_cssk_submission_base
#: model:ir.model.constraint,message:l10n_cssk_submission_base.constraint_cssk_submission_check_res
msgid "A submission must point at a statement."
msgstr "Doručení musí odkazovat na výkaz."

#. module: l10n_cssk_submission_base
#: model_terms:ir.actions.act_window,help:l10n_cssk_submission_base.cssk_submission_action
msgid ""
"A submission records how a statutory filing reached the\n"
"                authority and what came back. Create one from the filing\n"
"                itself once it has been exported."
msgstr ""
"Doručení zaznamenává, jak se zákonné podání dostalo\n"
"                k úřadu a co se vrátilo. Vytvořte je přímo z podání,\n"
"                jakmile je exportováno."

