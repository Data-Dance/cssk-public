<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Filing is an accounting act, so these sit under the accounting
         category rather than inventing a parallel one. Sending is separated
         from seeing: a bookkeeper prepares and reads the evidence trail, a
         manager is the one who actually files or cancels.

         19.0 groups these with res.groups.privilege (privilege_id); 18.0 has
         no such model and uses ir.module.category (category_id), which is
         what account's own groups use on this series. -->
    <record id="group_cssk_submission_user" model="res.groups">
        <field name="name">Statutory submissions: prepare</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_cssk_submission_manager" model="res.groups">
        <field name="name">Statutory submissions: file</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_cssk_submission_user')),
                                         (4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
