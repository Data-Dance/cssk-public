<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_list" model="ir.ui.view">
        <field name="name">l10n.sk.travel.order.list</field>
        <field name="model">l10n.sk.travel.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="destination"/>
                <field name="trip_kind" optional="show"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">l10n.sk.travel.order.form</field>
        <field name="model">l10n.sk.travel.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_days" type="object" string="Compute Days" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'" groups="hr_expense.group_hr_expense_team_approver"/>
                    <button name="action_settle" type="object" string="Settle" class="btn-primary" invisible="state != 'approved'" groups="hr_expense.group_hr_expense_team_approver"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="destination" readonly="state != 'draft'"/>
                            <field name="trip_kind" readonly="state != 'draft'"/>
                            <field name="border_out" invisible="trip_kind != 'foreign'" required="trip_kind == 'foreign'" readonly="state != 'draft'"/>
                            <field name="border_in" invisible="trip_kind != 'foreign'" required="trip_kind == 'foreign'" readonly="state != 'draft'"/>
                            <field name="road_transport" invisible="trip_kind != 'foreign'" readonly="state != 'draft'"/>
                            <field name="pocket_money_percent" invisible="trip_kind != 'foreign'" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="vehicle_mode" readonly="state != 'draft'"/>
                            <field name="vehicle_category" invisible="vehicle_mode != 'own'" readonly="state != 'draft'"/>
                            <field name="trailer" invisible="vehicle_mode != 'own'" readonly="state != 'draft'"/>
                            <field name="kilometres" invisible="vehicle_mode != 'own'" readonly="state != 'draft'"/>
                            <field name="consumption" invisible="vehicle_mode != 'own'" readonly="state != 'draft'"/>
                            <field name="fuel_price" invisible="vehicle_mode != 'own'" readonly="state != 'draft'"/>
                            <field name="advance" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Days" name="days">
                            <field name="day_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="date" readonly="1"/>
                                    <field name="hours" widget="float_time"/>
                                    <field name="rate"/>
                                    <field name="hours_abroad" widget="float_time" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="country_id" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="foreign_base" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="foreign_currency_id" optional="hide" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="breakfast"/>
                                    <field name="lunch"/>
                                    <field name="dinner"/>
                                    <field name="meals_abroad" column_invisible="parent.trip_kind != 'foreign'" readonly="not foreign_base"/>
                                    <field name="foreign_amount" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="pocket_money" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="foreign_rate" optional="hide" column_invisible="parent.trip_kind != 'foreign'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Countries" name="countries" invisible="trip_kind != 'foreign'">
                            <field name="stay_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="country_id"/>
                                    <field name="date_arrival"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logbook Trips" name="trips">
                            <field name="trip_ids" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="meal_amount"/>
                        <field name="kilometre_amount"/>
                        <field name="fuel_amount"/>
                        <field name="total_amount"/>
                        <field name="amount_due"/>
                        <field name="expense_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_order" model="ir.actions.act_window">
        <field name="name">Travel Orders</field>
        <field name="res_model">l10n.sk.travel.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
