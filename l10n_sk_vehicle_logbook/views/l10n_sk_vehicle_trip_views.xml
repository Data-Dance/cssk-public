<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trip_list" model="ir.ui.view">
        <field name="name">l10n.sk.vehicle.trip.list</field>
        <field name="model">l10n.sk.vehicle.trip</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="trip_type"/>
                <field name="purpose"/>
                <field name="odometer_start"/>
                <field name="odometer_end"/>
                <field name="distance" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_trip_form" model="ir.ui.view">
        <field name="name">l10n.sk.vehicle.trip.form</field>
        <field name="model">l10n.sk.vehicle.trip</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="trip_type"/>
                            <field name="purpose"/>
                            <field name="travel_order_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="origin"/>
                            <field name="destination"/>
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="distance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_trip" model="ir.actions.act_window">
        <field name="name">Vehicle Logbook</field>
        <field name="res_model">l10n.sk.vehicle.trip</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
