#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/hr_expense.py:0
msgid "%(expense)s belongs to the travel order %(order)s of another employee."
msgstr "%(expense)s patrí k cestovnému príkazu %(order)s iného zamestnanca."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/hr_expense.py:0
msgid "%(expense)s is part of the settlement of %(order)s."
msgstr "%(expense)s je súčasťou vyúčtovania %(order)s."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/hr_expense.py:0
msgid "%(expenses)s are part of a settlement waiting for approval."
msgstr "%(expenses)s sú súčasťou vyúčtovania, ktoré čaká na schválenie."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/hr_expense.py:0
msgid ""
"%(expenses)s belong to a travel order; they are approved with its "
"settlement, not on their own."
msgstr ""
"%(expenses)s patria k cestovnému príkazu; schvaľujú sa s jeho vyúčtovaním, "
"nie samostatne."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(fields)s change only through the travel order's buttons."
msgstr "%(fields)s sa menia len tlačidlami cestovného príkazu."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(order)s can only be deleted as a draft or once cancelled."
msgstr "%(order)s možno zmazať len ako návrh alebo po zrušení."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(order)s is %(state)s; this step is not available."
msgstr "%(order)s je v stave %(state)s; tento krok nie je dostupný."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid ""
"%(order)s is no longer a draft; %(fields)s cannot be changed. Reset it to "
"draft first."
msgstr ""
"%(order)s už nie je návrh; %(fields)s nemožno meniť. Najprv ho vráťte do "
"návrhu."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid ""
"%(order)s is no longer a draft; its days and countries cannot be changed."
msgstr "%(order)s už nie je návrh; jeho dni a krajiny nemožno meniť."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/hr_expense.py:0
