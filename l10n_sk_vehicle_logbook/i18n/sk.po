#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(order)s: not a company you work in."
msgstr "%(order)s: nie je to spoločnosť, v ktorej pracujete."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(order)s: only the employee or an expense officer can do this."
msgstr "%(order)s: toto môže urobiť len zamestnanec alebo referent výdavkov."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid ""
"%(order)s: the advance %(advance)s is already booked. Settle the order "
"instead, with no days if the trip did not take place, so the advance is "
"returned."
msgstr ""
"%(order)s: preddavok %(advance)s je už zaúčtovaný. Príkaz namiesto toho "
"vyúčtujte, bez dní, ak sa cesta neuskutočnila, aby sa preddavok vrátil."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid ""
"%(order)s: the advance %(advance)s is not paid out yet. Pay it, or have it "
"refused if it was never handed over, before approving the settlement."
msgstr ""
"%(order)s: preddavok %(advance)s ešte nie je vyplatený. Pred schválením "
"vyúčtovania ho vyplaťte, alebo ho dajte zamietnuť, ak nebol odovzdaný."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid ""
"%(order)s: the other costs must still be drafts; they are approved here, "
"with the settlement."
msgstr ""
"%(order)s: ostatné výdavky musia byť ešte návrhy; schvaľujú sa tu, s "
"vyúčtovaním."

#. module: l10n_sk_vehicle_logbook
#. odoo-python
#: code:addons/l10n_sk_vehicle_logbook/models/l10n_sk_travel_order.py:0
msgid "%(order)s: you are neither its approver nor an expense officer."
msgstr "%(order)s: nie ste jeho schvaľovateľ ani referent výdavkov."

