<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_nace" model="ir.ui.view">
        <field name="name">res.partner.form.nace</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="industry_id" position="after">
                <field name="nace_code" invisible="not is_company"
                       readonly="parent_id"/>
            </field>
        </field>
    </record>
</odoo>
