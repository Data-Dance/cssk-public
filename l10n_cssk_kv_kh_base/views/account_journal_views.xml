<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forces one control-statement section on every line of the journal,
         ahead of the resolver: e.g. "D.1" on the journal of a Slovak eKasa
         till, so its sales are reported as eKasa turnover. -->
    <record id="view_account_journal_form_cssk_control" model="ir.ui.view">
        <field name="name">account.journal.form.cssk.control</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="VAT control statement" name="cssk_control">
                    <field name="cssk_control_section_override"
                           placeholder="e.g. D.1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
