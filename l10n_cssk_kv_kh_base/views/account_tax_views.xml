<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The resolver checks the reverse-charge flag FIRST; it decides
         A.2/B.1 (SK) and A.1/B.1 (CZ), so a user must be able to see and
         set it. -->
    <record id="view_tax_form_cssk_control" model="ir.ui.view">
        <field name="name">account.tax.form.cssk.control</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']//group[@name='advanced_booleans']"
                   position="inside">
                <field name="cssk_control_is_reverse_charge"
                       invisible="country_code not in ('SK', 'CZ')"/>
            </xpath>
        </field>
    </record>
</odoo>
