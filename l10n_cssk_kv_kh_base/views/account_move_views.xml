<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The original document's number on a correction that is not linked to
        it. Shown only where it can matter: a credit note (or an entry marked
        as a correction) of a Czech or Slovak company, with no linked original.
    -->
    <record id="view_move_form_cssk_control_original_ref" model="ir.ui.view">
        <field name="name">account.move.form.cssk.control.original.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']"
                   position="inside">
                <field name="reversed_entry_id" invisible="1"/>
                <field name="cssk_control_original_ref"
                       invisible="country_code not in ('SK', 'CZ') or reversed_entry_id or move_type not in ('out_refund', 'in_refund')"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//group[@name='misc_group']"
                   position="inside">
                <field name="cssk_vat_correction" invisible="1"/>
                <field name="cssk_control_original_ref"
                       invisible="country_code not in ('SK', 'CZ') or cssk_vat_correction != 'yes'"/>
            </xpath>
        </field>
    </record>
</odoo>
