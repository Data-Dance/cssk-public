<odoo>
    <record id="settlement_list" model="ir.ui.view">
        <field name="name">l10n.sk.income.settlement.list</field>
        <field name="model">l10n.sk.income.settlement</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="allocation_id"/><field name="state"/></list></field>
    </record>
    <record id="settlement_form" model="ir.ui.view">
        <field name="name">l10n.sk.income.settlement.form</field>
        <field name="model">l10n.sk.income.settlement</field>
        <field name="arch" type="xml">
            <form><header>
                <button name="action_calculate" type="object" string="Calculate tax and health" class="oe_highlight"/>
                <button name="action_reset" type="object" string="Reset calculation" invisible="state == 'draft'"/>
                <field name="state" widget="statusbar"/>
            </header><sheet>
                <div class="alert alert-warning" role="status">Calculation evidence only. No payslip, accounting entry, registration or official report is generated by this action.</div>
                <group><field name="name" readonly="state != 'draft'"/>
                    <field name="allocation_id" readonly="state != 'draft'"/>
                    <field name="employee_id"/><field name="company_id" groups="base.group_multi_company"/>
                    <field name="facts" invisible="True"/>
                    <field name="currency_id" invisible="True"/>
                    <field name="paid_on" readonly="state != 'draft'"/>
                    <field name="agreement" readonly="state != 'draft'"/>
                    <field name="pension" readonly="state != 'draft'"/>
                    <field name="disabled" readonly="state != 'draft'"/>
                    <field name="minimum_exception" readonly="state != 'draft'"/>
                    <field name="tax_declaration" readonly="state != 'draft'"/>
                    <field name="pension_at_jan1" readonly="state != 'draft'"/>
                    <field name="no_child_bonus" readonly="state != 'draft'"/>
                    <field name="no_other_adjustments" readonly="state != 'draft'"/>
                    <field name="only_2y_health_day" readonly="state != 'draft'"/>
                    <field name="other_tax_base" readonly="state != 'draft'"/>
                    <field name="other_tax_withheld" readonly="state != 'draft'"/>
                    <field name="other_health_base" readonly="state != 'draft'"/>
                    <field name="other_health_employee" readonly="state != 'draft'"/>
                    <field name="other_health_employer" readonly="state != 'draft'"/>
                    <field name="other_health_topup" readonly="state != 'draft'"/>
                    <field name="evidence" readonly="state != 'draft'"/>
                    <field name="input_digest"/><field name="attachment_id"/>
                    <field name="result"/>
                </group>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="settlement_action" model="ir.actions.act_window">
        <field name="name">Additional income tax and health</field>
        <field name="res_model">l10n.sk.income.settlement</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="settlement_menu" name="Additional income tax and health" parent="l10n_cssk_payroll_declaration_base.menu_cssk_payroll_declaration_root" action="settlement_action" sequence="44"/>
</odoo>
