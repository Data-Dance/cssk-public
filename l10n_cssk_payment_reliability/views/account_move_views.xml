<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_move_form_cssk_reliability" model="ir.ui.view">
        <field name="name">account.move.form.cssk.reliability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Warning banner at the top of vendor bills -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not cssk_reliability_alert">
                    <field name="cssk_reliability_alert" invisible="1" />
                    <strong>⚠ Supplier reliability:</strong>
                    <field name="cssk_reliability_warning" readonly="1" nolabel="1"
                           class="mb-0" style="white-space: pre-line;" />
                </div>
            </xpath>
            <!-- Manual check button + snapshot fields, on vendor bills only -->
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="cssk_bank_acc_status"
                       invisible="move_type not in ('in_invoice','in_refund')" />
                <field name="cssk_supplier_reliability"
                       invisible="move_type not in ('in_invoice','in_refund')" />
                <field name="cssk_registered_accounts"
                       invisible="move_type not in ('in_invoice','in_refund') or not cssk_registered_accounts" />
                <field name="cssk_reliability_checked_on"
                       invisible="move_type not in ('in_invoice','in_refund') or not cssk_reliability_checked_on" />
                <button name="action_cssk_check_reliability" type="object"
                        string="Check supplier reliability" class="btn-link"
                        icon="fa-shield"
                        invisible="move_type not in ('in_invoice','in_refund')" />
            </xpath>
        </field>
    </record>

</odoo>
