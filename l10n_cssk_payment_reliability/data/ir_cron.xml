<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            Unpaid vendor bills are checked again, not only when posted: a
            supplier can drop its registered account or its rating before the
            bill is paid, and the payment is what the liability attaches to.
        -->
        <record id="cron_cssk_recheck_open_bills" model="ir.cron">
            <field name="name">Supplier reliability: re-check unpaid bills (CZ/SK)</field>
            <field name="model_id" ref="account.model_account_move" />
            <field name="state">code</field>
            <field name="code">model._cron_cssk_recheck_open_bills()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
