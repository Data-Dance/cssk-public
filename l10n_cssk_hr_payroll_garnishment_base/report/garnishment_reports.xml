<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_garnishment_settlement" model="ir.actions.report">
        <field name="name">Account of Deductions</field>
        <field name="model">hr.wage.garnishment.notice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cssk_hr_payroll_garnishment_base.report_garnishment_settlement</field>
        <field name="report_file">l10n_cssk_hr_payroll_garnishment_base.report_garnishment_settlement</field>
        <field name="print_report_name">'Vyuctovani srazek - %s' % (object.employee_id.name or '')</field>
    </record>

    <record id="action_report_garnishment_notice" model="ir.actions.report">
        <field name="name">Garnishment Notice</field>
        <field name="model">hr.wage.garnishment.notice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_cssk_hr_payroll_garnishment_base.report_garnishment_notice</field>
        <field name="report_file">l10n_cssk_hr_payroll_garnishment_base.report_garnishment_notice</field>
        <field name="print_report_name">'Oznameni - %s' % (object.employee_id.name or '')</field>
    </record>
</odoo>
