<odoo>
    <record id="view_account_fiscalyear_closing_form_pre_close" model="ir.ui.view">
        <field name="name">account.fiscalyear.closing.form.sk.pre.close</field>
        <field name="model">account.fiscalyear.closing</field>
        <field name="inherit_id" ref="account_fiscal_year_closing.view_account_fiscalyear_closing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/*[1]" position="before">
                <div role="alert" class="alert alert-warning" invisible="not l10n_sk_pre_close_warning">
                    <strong>Before closing the year</strong>
                    <field name="l10n_sk_pre_close_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
